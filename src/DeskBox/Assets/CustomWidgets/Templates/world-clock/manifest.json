  "sources": [
    {
      "type": "clock",
      "intervalMs": 1000
    }
  ],
  "capsule": {
    "title": "${tzCity($settings.city1)} ${tz($settings.city1, 'HH:mm', state.scrubHours)} ${tzWorkState($settings.city1, $settings.workWindow, state.scrubHours) == 'work' ? $i18n.gWork : tzWorkState($settings.city1, $settings.workWindow, state.scrubHours) == 'edge' ? $i18n.gEdge : $i18n.gSleep} · ${tzCity($settings.city2)} ${tz($settings.city2, 'HH:mm', state.scrubHours)} ${tzWorkState($settings.city2, $settings.workWindow, state.scrubHours) == 'work' ? $i18n.gWork : tzWorkState($settings.city2, $settings.workWindow, state.scrubHours) == 'edge' ? $i18n.gEdge : $i18n.gSleep}",
    "summary": "${$i18n.localNow} ${tz('local', 'HH:mm', state.scrubHours)} ${state.scrubHours > 0 ? $i18n.capScrub : ''}",
    "glyph": "\uE774",
    "badge": "${tzWorkState($settings.city1, $settings.workWindow, 0) == 'sleep' ? $i18n.gSleep : $clock.localOffset}",
    "badgeIsWarning": "${tzWorkState($settings.city1, $settings.workWindow, 0) == 'sleep'}"
  },
  "view": {
    "type": "Stack",
    "spacing": 8,
    "padding": "10,6,10,10",
    "children": [
      {
        "type": "ModuleStack",
        "bind": "settings.modules",
        "spacing": 8,
        "children": [
          {
            "id": "cities",
            "type": "Card",
            "tone": "subtle",
            "padding": "10,8,10,8",
            "children": [
              {
                "type": "Grid",
                "columns": "Auto,1*",
                "spacing": 8,
                "children": [
                  {
                    "type": "Text",
                    "column": 0,
                    "text": "\uD83D\uDCCD ${$i18n.localNow}",
                    "style": "caption",
                    "color": "secondary"
                  },
                  {
                    "type": "Text",
                    "column": 1,
                    "text": "${tz('local', $settings.hourFormat == '12h' ? 'hh:mm tt' : 'HH:mm', state.scrubHours)} · ${$clock.localOffset}",
                    "style": "mono",
                    "color": "secondary",
                    "horizontalAlignment": "Right"
                  }
                ]
              },
              {
                "type": "Divider"
              },
              {
                "type": "Grid",
                "columns": "1*,Auto",
                "spacing": 8,
                "children": [
                  {
                    "type": "Stack",
                    "column": 0,
                    "spacing": 2,
                    "children": [
                      {
                        "type": "Text",
                        "text": "${tzCity($settings.city1)}",
                        "style": "bodyStrong",
                        "maxLines": 1
                      },
                      {
                        "type": "Text",
                        "text": "UTC${tz($settings.city1, 'zzz', state.scrubHours)} · ${tzDiffLabel($settings.city1, state.scrubHours)}",
                        "style": "caption",
                        "color": "secondary",
                        "maxLines": 1
                      }
                    ]
                  },
                  {
                    "type": "Stack",
                    "column": 1,
                    "spacing": 2,
                    "children": [
                      {
                        "type": "Text",
                        "text": "${tz($settings.city1, $settings.hourFormat == '12h' ? 'hh:mm tt' : 'HH:mm', state.scrubHours)}",
                        "style": "title",
                        "color": "${tzWorkState($settings.city1, $settings.workWindow, state.scrubHours) == 'sleep' ? 'muted' : 'default'}",
                        "horizontalAlignment": "Right"
                      },
                      {
                        "type": "Badge",
                        "text": "${tzWorkState($settings.city1, $settings.workWindow, state.scrubHours) == 'work' ? $i18n.stWork : tzWorkState($settings.city1, $settings.workWindow, state.scrubHours) == 'edge' ? $i18n.stEdge : $i18n.stSleep}",
                        "tone": "${tzWorkState($settings.city1, $settings.workWindow, state.scrubHours) == 'work' ? 'success' : tzWorkState($settings.city1, $settings.workWindow, state.scrubHours) == 'edge' ? 'warning' : 'subtle'}",
                        "horizontalAlignment": "Right"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Grid",
                "columns": "1*,Auto",
                "spacing": 8,
                "children": [
                  {
                    "type": "Stack",
                    "column": 0,
                    "spacing": 2,
                    "children": [
                      {
                        "type": "Text",
                        "text": "${tzCity($settings.city2)}",
                        "style": "bodyStrong",
                        "maxLines": 1
                      },
                      {
                        "type": "Text",
                        "text": "UTC${tz($settings.city2, 'zzz', state.scrubHours)} · ${tzDiffLabel($settings.city2, state.scrubHours)}",
                        "style": "caption",
                        "color": "secondary",
                        "maxLines": 1
                      }
                    ]
                  },
                  {
                    "type": "Stack",
                    "column": 1,
                    "spacing": 2,
                    "children": [
                      {
                        "type": "Text",
                        "text": "${tz($settings.city2, $settings.hourFormat == '12h' ? 'hh:mm tt' : 'HH:mm', state.scrubHours)}",
                        "style": "title",
                        "color": "${tzWorkState($settings.city2, $settings.workWindow, state.scrubHours) == 'sleep' ? 'muted' : 'default'}",
                        "horizontalAlignment": "Right"
                      },
                      {
                        "type": "Badge",
                        "text": "${tzWorkState($settings.city2, $settings.workWindow, state.scrubHours) == 'work' ? $i18n.stWork : tzWorkState($settings.city2, $settings.workWindow, state.scrubHours) == 'edge' ? $i18n.stEdge : $i18n.stSleep}",
                        "tone": "${tzWorkState($settings.city2, $settings.workWindow, state.scrubHours) == 'work' ? 'success' : tzWorkState($settings.city2, $settings.workWindow, state.scrubHours) == 'edge' ? 'warning' : 'subtle'}",
                        "horizontalAlignment": "Right"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Grid",
                "columns": "1*,Auto",
                "spacing": 8,
                "children": [
                  {
                    "type": "Stack",
                    "column": 0,
                    "spacing": 2,
                    "children": [
                      {
                        "type": "Text",
                        "text": "${tzCity($settings.city3)}",
                        "style": "bodyStrong",
                        "maxLines": 1
                      },
                      {
                        "type": "Text",
                        "text": "UTC${tz($settings.city3, 'zzz', state.scrubHours)} · ${tzDiffLabel($settings.city3, state.scrubHours)}",
                        "style": "caption",
                        "color": "secondary",
                        "maxLines": 1
                      }
                    ]
                  },
                  {
                    "type": "Stack",
                    "column": 1,
                    "spacing": 2,
                    "children": [
                      {
                        "type": "Text",
                        "text": "${tz($settings.city3, $settings.hourFormat == '12h' ? 'hh:mm tt' : 'HH:mm', state.scrubHours)}",
                        "style": "title",
                        "color": "${tzWorkState($settings.city3, $settings.workWindow, state.scrubHours) == 'sleep' ? 'muted' : 'default'}",
                        "horizontalAlignment": "Right"
                      },
                      {
                        "type": "Badge",
                        "text": "${tzWorkState($settings.city3, $settings.workWindow, state.scrubHours) == 'work' ? $i18n.stWork : tzWorkState($settings.city3, $settings.workWindow, state.scrubHours) == 'edge' ? $i18n.stEdge : $i18n.stSleep}",
                        "tone": "${tzWorkState($settings.city3, $settings.workWindow, state.scrubHours) == 'work' ? 'success' : tzWorkState($settings.city3, $settings.workWindow, state.scrubHours) == 'edge' ? 'warning' : 'subtle'}",
                        "horizontalAlignment": "Right"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Grid",
                "columns": "1*,Auto",
                "spacing": 8,
                "when": "${$settings.city4 != 'none'}",
                "children": [
                  {
                    "type": "Stack",
                    "column": 0,
                    "spacing": 2,
                    "children": [
                      {
                        "type": "Text",
                        "text": "${tzCity($settings.city4)}",
                        "style": "bodyStrong",
                        "maxLines": 1
                      },
                      {
                        "type": "Text",
                        "text": "UTC${tz($settings.city4, 'zzz', state.scrubHours)} · ${tzDiffLabel($settings.city4, state.scrubHours)}",
                        "style": "caption",
                        "color": "secondary",
                        "maxLines": 1
                      }
                    ]
                  },
                  {
                    "type": "Stack",
                    "column": 1,
                    "spacing": 2,
                    "children": [
                      {
                        "type": "Text",
                        "text": "${tz($settings.city4, $settings.hourFormat == '12h' ? 'hh:mm tt' : 'HH:mm', state.scrubHours)}",
                        "style": "title",
                        "color": "${tzWorkState($settings.city4, $settings.workWindow, state.scrubHours) == 'sleep' ? 'muted' : 'default'}",
                        "horizontalAlignment": "Right"
                      },
                      {
                        "type": "Badge",
                        "text": "${tzWorkState($settings.city4, $settings.workWindow, state.scrubHours) == 'work' ? $i18n.stWork : tzWorkState($settings.city4, $settings.workWindow, state.scrubHours) == 'edge' ? $i18n.stEdge : $i18n.stSleep}",
                        "tone": "${tzWorkState($settings.city4, $settings.workWindow, state.scrubHours) == 'work' ? 'success' : tzWorkState($settings.city4, $settings.workWindow, state.scrubHours) == 'edge' ? 'warning' : 'subtle'}",
                        "horizontalAlignment": "Right"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "scrubber",
            "type": "Card",
            "tone": "subtle",
            "padding": "10,8,10,8",
            "children": [
              {
                "type": "Slider",
                "title": "${$i18n.scrubTitle}",
                "bind": "state.scrubHours",
                "min": 0,
                "max": 23,
                "step": 0.5,
                "unit": "h"
              },
              {
                "type": "Text",
                "when": "${state.scrubHours == 0}",
                "text": "${$i18n.liveNow}",
                "style": "caption",
                "color": "muted"
              },
              {
                "type": "Stack",
                "when": "${state.scrubHours > 0}",
                "orientation": "horizontal",
                "spacing": 6,
                "children": [
                  {
                    "type": "Button",
                    "text": "${$i18n.backToNow}",
                    "variant": "subtle",
                    "onClick": {
                      "type": "state.set",
                      "key": "scrubHours",
                      "value": "0"
                    }
                  },
                  {
                    "type": "Button",
                    "text": "${$i18n.copyTimes}",
                    "variant": "accent",
                    "onClick": [
                      {
                        "type": "clipboard.copy",
                        "guard": "${$settings.city4 != 'none'}",
                        "text": "\uD83D\uDCC5 ${$i18n.meetingAt}: ${$i18n.localNow} ${tz('local', $settings.hourFormat == '12h' ? 'hh:mm tt' : 'HH:mm', state.scrubHours)} | ${tzCity($settings.city1)} ${tz($settings.city1, $settings.hourFormat == '12h' ? 'hh:mm tt' : 'HH:mm', state.scrubHours)} | ${tzCity($settings.city2)} ${tz($settings.city2, $settings.hourFormat == '12h' ? 'hh:mm tt' : 'HH:mm', state.scrubHours)} | ${tzCity($settings.city3)} ${tz($settings.city3, $settings.hourFormat == '12h' ? 'hh:mm tt' : 'HH:mm', state.scrubHours)} | ${tzCity($settings.city4)} ${tz($settings.city4, $settings.hourFormat == '12h' ? 'hh:mm tt' : 'HH:mm', state.scrubHours)}"
                      },
                      {
                        "type": "clipboard.copy",
                        "guard": "${$settings.city4 == 'none'}",
                        "text": "\uD83D\uDCC5 ${$i18n.meetingAt}: ${$i18n.localNow} ${tz('local', $settings.hourFormat == '12h' ? 'hh:mm tt' : 'HH:mm', state.scrubHours)} | ${tzCity($settings.city1)} ${tz($settings.city1, $settings.hourFormat == '12h' ? 'hh:mm tt' : 'HH:mm', state.scrubHours)} | ${tzCity($settings.city2)} ${tz($settings.city2, $settings.hourFormat == '12h' ? 'hh:mm tt' : 'HH:mm', state.scrubHours)} | ${tzCity($settings.city3)} ${tz($settings.city3, $settings.hourFormat == '12h' ? 'hh:mm tt' : 'HH:mm', state.scrubHours)}"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Card",
        "tone": "subtle",
        "padding": "10,6,10,6",
        "when": "${$settings.showDevUnix == 'true'}",
        "tooltip": "${$i18n.devCopy}",
        "onClick": {
          "type": "clipboard.copy",
          "text": "UTC ${tz('UTC', 'yyyy-MM-dd HH:mm:ss', 0)} · Unix ${$clock.unixSeconds}"
        },
        "children": [
          {
            "type": "Grid",
            "columns": "1*,Auto",
            "spacing": 6,
            "children": [
              {
                "type": "Text",
                "column": 0,
                "text": "UTC ${tz('UTC', 'yyyy-MM-dd HH:mm:ss', 0)}",
                "style": "mono",
                "color": "secondary"
              },
              {
                "type": "Text",
                "column": 1,
                "text": "Unix ${$clock.unixSeconds}",
                "style": "mono",
                "color": "secondary"
              }
            ]
          }
        ]
      }
    ]
  }
}
