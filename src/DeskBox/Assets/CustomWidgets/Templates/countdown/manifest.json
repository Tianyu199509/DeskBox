{
  "schemaVersion": 1,
  "id": "deskbox.countdown",
  "name": "${$i18n.widgetName}",
  "version": "1.0.0",
  "author": "DeskBox",
  "origin": "official",
  "description": "${$i18n.widgetDescription}",
  "icon": "📅",
  "minSize": {
    "width": 292,
    "height": 280
  },
  "defaultSize": {
    "width": 344,
    "height": 356
  },
  "settings": [
    {
      "key": "modules",
      "type": "moduleList",
      "label": "${$i18n.setModules}",
      "default": "hero:1,list:1,yearProgress:1",
      "options": [
        {
          "value": "hero",
          "label": "${$i18n.modHero}"
        },
        {
          "value": "list",
          "label": "${$i18n.modList}"
        },
        {
          "value": "yearProgress",
          "label": "${$i18n.modYearProgress}"
        }
      ]
    },
    {
      "key": "expiredMode",
      "type": "choice",
      "label": "${$i18n.setExpired}",
      "default": "countup",
      "options": [
        {
          "value": "countup",
          "label": "${$i18n.optExpCountup}"
        },
        {
          "value": "archive",
          "label": "${$i18n.optExpArchive}"
        }
      ]
    },
    {
      "key": "sortMode",
      "type": "choice",
      "label": "${$i18n.setSort}",
      "default": "smart",
      "options": [
        {
          "value": "smart",
          "label": "${$i18n.optSortSmart}"
        },
        {
          "value": "custom",
          "label": "${$i18n.optSortCustom}"
        }
      ]
    },
    {
      "key": "progressScope",
      "type": "choice",
      "label": "${$i18n.setProgressScope}",
      "default": "workAndYear",
      "options": [
        {
          "value": "workAndYear",
          "label": "${$i18n.optScopeWorkYear}"
        },
        {
          "value": "allFour",
          "label": "${$i18n.optScopeAllFour}"
        },
        {
          "value": "year",
          "label": "${$i18n.optScopeYear}"
        },
        {
          "value": "month",
          "label": "${$i18n.optScopeMonth}"
        },
        {
          "value": "both",
          "label": "${$i18n.optScopeBoth}"
        }
      ]
    },
    {
      "key": "workHours",
      "type": "choice",
      "label": "${$i18n.setWorkHours}",
      "default": "09:00-18:00",
      "options": [
        {
          "value": "08:30-17:30",
          "label": "${$i18n.optWork1}"
        },
        {
          "value": "09:00-18:00",
          "label": "${$i18n.optWork2}"
        },
        {
          "value": "09:30-18:30",
          "label": "${$i18n.optWork3}"
        },
        {
          "value": "10:00-19:00",
          "label": "${$i18n.optWork4}"
        },
        {
          "value": "day24h",
          "label": "${$i18n.optWorkDay24h}"
        }
      ]
    },
    {
      "key": "urgentDays",
      "type": "choice",
      "label": "${$i18n.setUrgentDays}",
      "default": "7",
      "options": [
        {
          "value": "3",
          "label": "${$i18n.optUrgent3}"
        },
        {
          "value": "7",
          "label": "${$i18n.optUrgent7}"
        },
        {
          "value": "14",
          "label": "${$i18n.optUrgent14}"
        },
        {
          "value": "30",
          "label": "${$i18n.optUrgent30}"
        }
      ]
    },
    {
      "key": "showNextHoliday",
      "type": "toggle",
      "label": "${$i18n.setShowNextHoliday}",
      "default": true
    },
    {
      "key": "notifyDueToday",
      "type": "toggle",
      "label": "${$i18n.setNotifyDueToday}",
      "default": true
    }
  ],
  "state": {
    "editingEventId": "",
    "draftTitle": "",
    "draftDate": "",
    "draftEmoji": "📅",
    "draftKind": "",
    "draftCategory": "",
    "draftCalendar": "solar",
    "draftRepeat": "none",
    "draftWeekendRule": "none",
    "draftPinned": false,
    "draftLunarYear": "2026",
    "draftLunarMonth": "01",
    "draftLunarDay": "01",
    "draftLunarLeap": false
  },
  "collections": {
    "events": {
      "maxItems": 200,
      "sort": "newestFirst"
    }
  },
  "sources": [
    {
      "type": "countdown",
      "intervalMs": 60000
    }
  ],
  "capsule": {
    "title": "${$countdown.hasHero ? $countdown.hero.title : $countdown.capsuleTitle}",
    "summary": "${$countdown.hasHero ? $countdown.hero.subtitle : $countdown.capsuleSummary}",
    "glyph": "📅",
    "badge": "${$countdown.hasHero ? $countdown.hero.badge : $countdown.capsuleBadge}",
    "badgeIsWarning": "${$countdown.capsuleIsWarning}",
    "progress": "${$countdown.capsuleProgress}"
  },
  "root": "main",
  "popovers": {
    "addEventPop": {
      "title": "${state.editingEventId != '' ? $i18n.popEditTitle : $i18n.popAddTitle}",
      "width": 320,
      "placement": "bottom",
      "root": "pop_add_event_body"
    },
    "timeProgressPop": {
      "title": "${$i18n.popProgressTitle}",
      "width": 308,
      "placement": "top",
      "root": "pop_time_progress_body"
    }
  },
  "elements": {
    "main": {
      "type": "ModuleStack",
      "bind": "settings.modules",
      "spacing": 8,
      "padding": "12,12,12,10",
      "children": [
        "hero",
        "event_list_module",
        "year_progress_module"
      ]
    },
    "hero": {
      "type": "Card",
      "tone": "subtle",
      "padding": "12,10,12,10",
      "spacing": 8,
      "children": [
        "hero_content_grid",
        "hero_empty_stack"
      ]
    },
    "hero_content_grid": {
      "type": "Grid",
      "when": "${$countdown.hasHero}",
      "columns": "76,*",
      "rows": "Auto",
      "columnSpacing": 12,
      "children": [
        "hero_days_card",
        "hero_details_stack"
      ]
    },
    "hero_days_card": {
      "type": "Card",
      "column": 0,
      "tone": "default",
      "padding": "8,7,8,7",
      "spacing": 1,
      "verticalAlignment": "center",
      "children": [
        "hero_status_word",
        "hero_days_number",
        "hero_days_unit"
      ]
    },
    "hero_status_word": {
      "type": "Text",
      "text": "${$countdown.hero.statusWord}",
      "style": "caption",
      "color": "${$countdown.hero.tone}",
      "fontWeight": "semiBold",
      "horizontalAlignment": "center",
      "maxLines": 1
    },
    "hero_days_number": {
      "type": "Text",
      "text": "${$countdown.hero.isToday ? '0' : $countdown.hero.days}",
      "fontFamily": "mono",
      "fontSize": 28,
      "fontWeight": "bold",
      "color": "${$countdown.hero.isToday ? 'accent' : 'default'}",
      "horizontalAlignment": "center",
      "maxLines": 1
    },
    "hero_days_unit": {
      "type": "Text",
      "text": "${$i18n.daysUnitShort}",
      "style": "caption",
      "color": "muted",
      "horizontalAlignment": "center",
      "maxLines": 1
    },
    "hero_details_stack": {
      "type": "Stack",
      "column": 1,
      "spacing": 5,
      "verticalAlignment": "center",
      "children": [
        "hero_header_grid",
        "hero_subtitle_text",
        "hero_milestone_text",
        "hero_progress_bar"
      ]
    },
    "hero_header_grid": {
      "type": "Grid",
      "columns": "*,Auto",
      "rows": "Auto",
      "columnSpacing": 6,
      "children": [
        "hero_title_row",
        "hero_actions_row"
      ]
    },
    "hero_title_row": {
      "type": "Stack",
      "column": 0,
      "orientation": "horizontal",
      "spacing": 6,
      "verticalAlignment": "center",
      "children": [
        "hero_title_text",
        "hero_lunar_badge",
        "hero_yearly_badge"
      ]
    },
    "hero_title_text": {
      "type": "Text",
      "text": "${$countdown.hero.title}",
      "style": "subtitle",
      "maxLines": 1,
      "verticalAlignment": "center"
    },
    "hero_lunar_badge": {
      "type": "Badge",
      "when": "${$countdown.hero.isLunar == 'true'}",
      "text": "${$i18n.optLunar}",
      "tone": "cyan"
    },
    "hero_yearly_badge": {
      "type": "Badge",
      "when": "${$countdown.hero.isLunar != 'true' && $countdown.hero.recurrence == 'yearly'}",
      "text": "${$i18n.optRepeatYearly}",
      "tone": "subtle"
    },
    "hero_actions_row": {
      "type": "Stack",
      "column": 1,
      "orientation": "horizontal",
      "spacing": 2,
      "verticalAlignment": "center",
      "children": [
        "btn_pin_hero",
        "btn_edit_hero",
        "btn_add_event"
      ]
    },
    "btn_pin_hero": {
      "type": "IconButton",
      "when": "${$countdown.hero.id != ''}",
      "icon": "pin",
      "size": 24,
      "variant": "subtle",
      "tooltip": "${$countdown.hero.isPinned == 'true' ? $i18n.unpinTooltip : $i18n.pinTooltip}",
      "onClick": {
        "type": "countdown.pin",
        "targetId": "${$countdown.hero.id}"
      }
    },
    "btn_edit_hero": {
      "type": "IconButton",
      "when": "${$countdown.hero.id != ''}",
      "icon": "edit",
      "size": 24,
      "variant": "subtle",
      "tooltip": "${$i18n.popEditTitle}",
      "onClick": [
        {
          "type": "state.set",
          "key": "editingEventId",
          "value": "${$countdown.hero.id}"
        },
        {
          "type": "state.set",
          "key": "draftTitle",
          "value": "${$countdown.hero.title}"
        },
        {
          "type": "state.set",
          "key": "draftDate",
          "value": "${$countdown.hero.rawDate}"
        },
        {
          "type": "state.set",
          "key": "draftEmoji",
          "value": "📅"
        },
        {
          "type": "state.set",
          "key": "draftKind",
          "value": "${$countdown.hero.kind}"
        },
        {
          "type": "state.set",
          "key": "draftCategory",
          "value": "${$countdown.hero.category}"
        },
        {
          "type": "state.set",
          "key": "draftCalendar",
          "value": "${$countdown.hero.isLunar == 'true' ? 'lunar' : 'solar'}"
        },
        {
          "type": "state.set",
          "key": "draftRepeat",
          "value": "${$countdown.hero.recurrence != '' ? $countdown.hero.recurrence : 'none'}"
        },
        {
          "type": "state.set",
          "key": "draftWeekendRule",
          "value": "${$countdown.hero.weekendRule != '' ? $countdown.hero.weekendRule : 'none'}"
        },
        {
          "type": "state.set",
          "key": "draftPinned",
          "value": "${$countdown.hero.isPinned == 'true'}"
        },
        {
          "type": "state.set",
          "key": "draftLunarYear",
          "value": "${$countdown.hero.lunarYear != '' ? $countdown.hero.lunarYear : '2026'}"
        },
        {
          "type": "state.set",
          "key": "draftLunarMonth",
          "value": "${$countdown.hero.lunarMonth != '' ? $countdown.hero.lunarMonth : '01'}"
        },
        {
          "type": "state.set",
          "key": "draftLunarDay",
          "value": "${$countdown.hero.lunarDay != '' ? $countdown.hero.lunarDay : '01'}"
        },
        {
          "type": "state.set",
          "key": "draftLunarLeap",
          "value": "${$countdown.hero.isLunarLeap == 'true'}"
        }
      ],
      "popover": "addEventPop"
    },
    "btn_add_event": {
      "type": "IconButton",
      "icon": "add",
      "size": 24,
      "variant": "subtle",
      "tooltip": "${$i18n.addEventTooltip}",
      "onClick": [
        {
          "type": "state.set",
          "key": "editingEventId",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftTitle",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftDate",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftEmoji",
          "value": "📅"
        },
        {
          "type": "state.set",
          "key": "draftKind",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftCategory",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftCalendar",
          "value": "solar"
        },
        {
          "type": "state.set",
          "key": "draftRepeat",
          "value": "none"
        },
        {
          "type": "state.set",
          "key": "draftWeekendRule",
          "value": "none"
        },
        {
          "type": "state.set",
          "key": "draftPinned",
          "value": false
        },
        {
          "type": "state.set",
          "key": "draftLunarYear",
          "value": "2026"
        },
        {
          "type": "state.set",
          "key": "draftLunarMonth",
          "value": "01"
        },
        {
          "type": "state.set",
          "key": "draftLunarDay",
          "value": "01"
        },
        {
          "type": "state.set",
          "key": "draftLunarLeap",
          "value": false
        }
      ],
      "popover": "addEventPop"
    },
    "hero_subtitle_text": {
      "type": "Text",
      "text": "${$countdown.hero.subtitle}",
      "style": "caption",
      "color": "secondary",
      "maxLines": 1
    },
    "hero_milestone_text": {
      "type": "Text",
      "when": "${$countdown.hero.milestone != ''}",
      "text": "${$countdown.hero.milestone}",
      "style": "caption",
      "color": "accent",
      "maxLines": 1
    },
    "hero_progress_bar": {
      "type": "ProgressBar",
      "progress": "${$countdown.hero.progress}",
      "color": "accent",
      "warningThreshold": 999,
      "dangerThreshold": 999
    },
    "hero_empty_stack": {
      "type": "Stack",
      "when": "${!$countdown.hasHero}",
      "spacing": 6,
      "children": [
        "hero_empty_title",
        "hero_empty_subtitle",
        "btn_add_first_event"
      ]
    },
    "hero_empty_title": {
      "type": "Text",
      "text": "${$i18n.emptyHeroTitle}",
      "style": "bodyStrong"
    },
    "hero_empty_subtitle": {
      "type": "Text",
      "text": "${$i18n.emptyHeroSub}",
      "style": "caption",
      "color": "secondary",
      "maxLines": 2
    },
    "btn_add_first_event": {
      "type": "Button",
      "icon": "add",
      "text": "${$i18n.addFirstBtn}",
      "variant": "standard",
      "onClick": [
        {
          "type": "state.set",
          "key": "editingEventId",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftTitle",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftDate",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftEmoji",
          "value": "📅"
        },
        {
          "type": "state.set",
          "key": "draftKind",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftCategory",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftCalendar",
          "value": "solar"
        },
        {
          "type": "state.set",
          "key": "draftRepeat",
          "value": "none"
        },
        {
          "type": "state.set",
          "key": "draftWeekendRule",
          "value": "none"
        },
        {
          "type": "state.set",
          "key": "draftPinned",
          "value": false
        },
        {
          "type": "state.set",
          "key": "draftLunarYear",
          "value": "2026"
        },
        {
          "type": "state.set",
          "key": "draftLunarMonth",
          "value": "01"
        },
        {
          "type": "state.set",
          "key": "draftLunarDay",
          "value": "01"
        },
        {
          "type": "state.set",
          "key": "draftLunarLeap",
          "value": false
        }
      ],
      "popover": "addEventPop"
    },
    "event_list_module": {
      "id": "list",
      "type": "Stack",
      "spacing": 5,
      "children": [
        "secondary_events_list"
      ]
    },
    "secondary_events_list": {
      "type": "List",
      "items": "$countdown.secondaryItems",
      "maxHeight": 168,
      "spacing": 5,
      "emptyState": {
        "icon": "calendar",
        "title": "${$i18n.emptyListTitle}",
        "subtitle": "${$i18n.emptyListSub}"
      },
      "hoverActions": [
        "btn_pin_event",
        "btn_delete_event"
      ],
      "itemTemplate": "secondary_event_item"
    },
    "btn_pin_event": {
      "type": "IconButton",
      "icon": "pin",
      "size": 22,
      "variant": "subtle",
      "tooltip": "${$i18n.pinTooltip}",
      "onClick": {
        "type": "countdown.pin",
        "targetId": "${$item.id}"
      }
    },
    "btn_delete_event": {
      "type": "IconButton",
      "icon": "delete",
      "size": 22,
      "variant": "subtle",
      "tooltip": "${$i18n.deleteTooltip}",
      "onClick": {
        "type": "countdown.delete",
        "targetId": "${$item.id}"
      }
    },
    "secondary_event_item": {
      "type": "Card",
      "tone": "subtle",
      "padding": "0",
      "background": "transparent",
      "borderWidth": "0",
      "horizontalAlignment": "stretch",
      "popover": "addEventPop",
      "onClick": [
        {
          "type": "state.set",
          "key": "editingEventId",
          "value": "${$item.id}"
        },
        {
          "type": "state.set",
          "key": "draftTitle",
          "value": "${$item.title}"
        },
        {
          "type": "state.set",
          "key": "draftDate",
          "value": "${$item.rawDate}"
        },
        {
          "type": "state.set",
          "key": "draftEmoji",
          "value": "${$item.emoji}"
        },
        {
          "type": "state.set",
          "key": "draftKind",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftCategory",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftCalendar",
          "value": "${$item.calendar}"
        },
        {
          "type": "state.set",
          "key": "draftRepeat",
          "value": "${$item.repeat}"
        },
        {
          "type": "state.set",
          "key": "draftWeekendRule",
          "value": "${$item.weekendRule}"
        },
        {
          "type": "state.set",
          "key": "draftPinned",
          "value": "${$item.isPinned == 'true'}"
        },
        {
          "type": "state.set",
          "key": "draftLunarYear",
          "value": "${$item.lunarYear != '' ? $item.lunarYear : '2026'}"
        },
        {
          "type": "state.set",
          "key": "draftLunarMonth",
          "value": "${$item.lunarMonth != '' ? $item.lunarMonth : '01'}"
        },
        {
          "type": "state.set",
          "key": "draftLunarDay",
          "value": "${$item.lunarDay != '' ? $item.lunarDay : '01'}"
        },
        {
          "type": "state.set",
          "key": "draftLunarLeap",
          "value": "${$item.isLunarLeap == 'true'}"
        }
      ],
      "children": [
        "event_item_grid"
      ]
    },
    "event_item_grid": {
      "type": "Grid",
      "horizontalAlignment": "stretch",
      "columns": "Auto,*,Auto",
      "rows": "Auto",
      "columnSpacing": 10,
      "children": [
        "event_item_dot",
        "event_item_text_stack",
        "event_item_delta_badge"
      ]
    },
    "event_item_dot": {
      "type": "Text",
      "column": 0,
      "text": "●",
      "fontSize": 10,
      "color": "${$item.isUrgent == 'true' ? 'danger' : ($item.isCountUp == 'true' ? 'emerald' : 'accent')}",
      "verticalAlignment": "center"
    },
    "event_item_text_stack": {
      "type": "Stack",
      "column": 1,
      "spacing": 1,
      "verticalAlignment": "center",
      "children": [
        "event_item_title",
        "event_item_subtitle"
      ]
    },
    "event_item_title": {
      "type": "Text",
      "text": "${$item.title}",
      "style": "bodyStrong",
      "maxLines": 1
    },
    "event_item_subtitle": {
      "type": "Text",
      "text": "${$item.subtitle}",
      "style": "caption",
      "color": "muted",
      "maxLines": 1
    },
    "event_item_delta_badge": {
      "type": "Badge",
      "column": 2,
      "text": "${$item.deltaText}",
      "tone": "${$item.isUrgent == 'true' ? 'danger' : ($item.isCountUp == 'true' ? 'emerald' : 'accent')}",
      "verticalAlignment": "center"
    },
    "year_progress_module": {
      "id": "yearProgress",
      "type": "Card",
      "tone": "subtle",
      "padding": "10,6,10,6",
      "popover": "timeProgressPop",
      "children": [
        "footer_progress_grid"
      ]
    },
    "footer_progress_grid": {
      "type": "Grid",
      "columns": "*,Auto",
      "rows": "Auto",
      "columnSpacing": 8,
      "children": [
        "footer_left_row",
        "footer_year_percent_text"
      ]
    },
    "footer_left_row": {
      "type": "Stack",
      "column": 0,
      "orientation": "horizontal",
      "spacing": 6,
      "verticalAlignment": "center",
      "children": [
        "footer_holiday_icon",
        "footer_holiday_text",
        "footer_workday_text"
      ]
    },
    "footer_holiday_icon": {
      "type": "Text",
      "when": "${$countdown.hasHoliday && $settings.showNextHoliday != 'false'}",
      "text": "🏖️",
      "style": "caption",
      "verticalAlignment": "center"
    },
    "footer_holiday_text": {
      "type": "Text",
      "when": "${$countdown.hasHoliday && $settings.showNextHoliday != 'false'}",
      "text": "${$countdown.holiday.inProgress ? t('holidayOngoingFmt', $countdown.holiday.title) : t('holidayFooterFmt', $countdown.holiday.title, $countdown.holiday.days)}",
      "style": "caption",
      "color": "secondary",
      "maxLines": 1,
      "verticalAlignment": "center"
    },
    "footer_workday_text": {
      "type": "Text",
      "when": "${!$countdown.hasHoliday || $settings.showNextHoliday == 'false'}",
      "text": "${$countdown.work.title} · ${$countdown.work.summary}",
      "style": "caption",
      "color": "secondary",
      "maxLines": 1,
      "verticalAlignment": "center"
    },
    "footer_year_percent_text": {
      "type": "Text",
      "column": 1,
      "text": "${$settings.progressScope == 'month' ? t('monthProgressShort', $countdown.month.percent) : t('yearProgressShort', $countdown.year.percent)}",
      "style": "caption",
      "color": "muted",
      "verticalAlignment": "center"
    },
    "pop_add_event_body": {
      "type": "Stack",
      "padding": "12",
      "spacing": 8,
      "children": [
        "input_event_title",
        "picker_solar_date",
        "lunar_date_section",
        "seg_calendar_type",
        "seg_repeat_mode",
        "weekend_rule_section",
        "btn_save_event",
        "btn_delete_editing_event"
      ]
    },
    "input_event_title": {
      "type": "Input",
      "bind": "state.draftTitle",
      "placeholder": "${$i18n.popTitlePlaceholder}"
    },
    "picker_solar_date": {
      "type": "DatePicker",
      "when": "${state.draftCalendar != 'lunar'}",
      "bind": "state.draftDate",
      "value": "${state.draftDate != '' ? state.draftDate : $time.date}"
    },
    "lunar_date_section": {
      "type": "Stack",
      "when": "${state.draftCalendar == 'lunar'}",
      "spacing": 6,
      "children": [
        "lunar_current_date_text",
        "lunar_selectors_grid",
        "toggle_lunar_leap"
