    },
    "seg_calendar_type": {
      "type": "Segmented",
      "bind": "state.draftCalendar",
      "options": [
        {
          "value": "solar",
          "label": "${$i18n.optSolar}"
        },
        {
          "value": "lunar",
          "label": "${$i18n.optLunar}"
        }
      ]
    },
    "seg_repeat_mode": {
      "type": "Segmented",
      "bind": "state.draftRepeat",
      "options": [
        {
          "value": "none",
          "label": "${$i18n.optRepeatOnce}"
        },
        {
          "value": "yearly",
          "label": "${$i18n.optRepeatYearly}"
        },
        {
          "value": "monthly",
          "label": "${$i18n.optRepeatMonthly}"
        }
      ]
    },
    "weekend_rule_section": {
      "type": "Stack",
      "when": "${state.draftRepeat == 'monthly'}",
      "spacing": 4,
      "children": [
        "weekend_rule_label",
        "seg_weekend_rule"
      ]
    },
    "weekend_rule_label": {
      "type": "Text",
      "text": "${$i18n.paydayRuleLabel}",
      "style": "caption",
      "color": "secondary"
    },
    "seg_weekend_rule": {
      "type": "Segmented",
      "bind": "state.draftWeekendRule",
      "options": [
        {
          "value": "none",
          "label": "${$i18n.paydayNone}"
        },
        {
          "value": "friday",
          "label": "${$i18n.paydayFri}"
        },
        {
          "value": "monday",
          "label": "${$i18n.paydayMon}"
        }
      ]
    },
    "btn_save_event": {
      "type": "Button",
      "icon": "check",
      "text": "${$i18n.popSaveBtn}",
      "variant": "standard",
      "horizontalAlignment": "stretch",
      "onClick": [
        {
          "type": "state.set",
          "guard": "${state.draftTitle != '' && state.draftCalendar == 'lunar' && state.draftLunarYear == ''}",
          "key": "draftLunarYear",
          "value": "2026"
        },
        {
          "type": "state.set",
          "guard": "${state.draftTitle != '' && state.draftCalendar == 'lunar' && state.draftLunarMonth != '' && state.draftLunarDay == ''}",
          "key": "draftLunarDay",
          "value": "01"
        },
        {
          "type": "state.set",
          "guard": "${state.draftTitle != '' && state.draftCalendar == 'lunar' && state.draftLunarDay != '' && state.draftLunarMonth == ''}",
          "key": "draftLunarMonth",
          "value": "01"
        },
        {
          "type": "state.set",
          "guard": "${state.draftTitle != '' && state.draftCalendar == 'lunar' && state.draftLunarMonth != '' && state.draftLunarDay != ''}",
          "key": "draftDate",
          "value": "${state.draftLunarYear}-${state.draftLunarMonth}-${state.draftLunarDay}"
        },
        {
          "type": "countdown.upsert",
          "guard": "${state.draftTitle != ''}",
          "targetId": "${state.editingEventId}",
          "item": {
            "title": "${state.draftTitle}",
            "date": "${state.draftDate != '' ? state.draftDate : $time.date}",
            "emoji": "${state.draftEmoji}",
            "kind": "${state.draftKind}",
            "category": "${state.draftCategory}",
            "calendar": "${state.draftCalendar}",
            "repeat": "${state.draftRepeat}",
            "weekendRule": "${state.draftWeekendRule}",
            "pinned": "${state.draftPinned}",
            "lunarLeap": "${state.draftLunarLeap}"
          }
        },
        {
          "type": "state.set",
          "key": "editingEventId",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftTitle",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftDate",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftEmoji",
          "value": "📅"
        },
        {
          "type": "state.set",
          "key": "draftKind",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftCategory",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftCalendar",
          "value": "solar"
        },
        {
          "type": "state.set",
          "key": "draftRepeat",
          "value": "none"
        },
        {
          "type": "state.set",
          "key": "draftWeekendRule",
          "value": "none"
        },
        {
          "type": "state.set",
          "key": "draftPinned",
          "value": false
        },
        {
          "type": "state.set",
          "key": "draftLunarYear",
          "value": "2026"
        },
        {
          "type": "state.set",
          "key": "draftLunarMonth",
          "value": "01"
        },
        {
          "type": "state.set",
          "key": "draftLunarDay",
          "value": "01"
        },
        {
          "type": "state.set",
          "key": "draftLunarLeap",
          "value": false
        },
        {
          "type": "popover.close",
          "popoverId": "addEventPop"
        }
      ]
    },
    "btn_delete_editing_event": {
      "type": "Button",
      "when": "${state.editingEventId != ''}",
      "icon": "delete",
      "text": "${$i18n.deleteTooltip}",
      "variant": "danger",
      "horizontalAlignment": "stretch",
      "onClick": [
        {
          "type": "countdown.delete",
          "guard": "${state.editingEventId != ''}",
          "targetId": "${state.editingEventId}"
        },
        {
          "type": "state.set",
          "key": "editingEventId",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftTitle",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftDate",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftKind",
          "value": ""
        },
        {
          "type": "state.set",
          "key": "draftCategory",
          "value": ""
        },
        {
          "type": "popover.close",
          "popoverId": "addEventPop"
        }
      ]
    },
    "pop_time_progress_body": {
      "type": "Stack",
      "padding": "12",
      "spacing": 10,
      "children": [
        "progress_row_year",
        "progress_row_month",
        "progress_row_week",
        "progress_row_workday"
      ]
    },
    "progress_row_year": {
      "type": "ProgressRow",
      "title": "${$countdown.year.title}",
      "value": "${$countdown.year.summary}",
      "progress": "${$countdown.year.percent}",
      "warningThreshold": 999,
      "dangerThreshold": 999
    },
    "progress_row_month": {
      "type": "ProgressRow",
      "title": "${$countdown.month.title}",
      "value": "${$countdown.month.summary}",
      "progress": "${$countdown.month.percent}",
      "warningThreshold": 999,
      "dangerThreshold": 999
    },
    "progress_row_week": {
      "type": "ProgressRow",
      "title": "${$countdown.week.title}",
      "value": "${$countdown.week.summary}",
      "progress": "${$countdown.week.percent}",
      "warningThreshold": 999,
      "dangerThreshold": 999
    },
    "progress_row_workday": {
      "type": "ProgressRow",
      "title": "${$countdown.work.title}",
      "value": "${$countdown.work.summary}",
      "progress": "${$countdown.work.percent}",
      "warningThreshold": 999,
      "dangerThreshold": 999
    }
  }
}
