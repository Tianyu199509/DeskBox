<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetIconCustomizer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:DeskBox.Helpers"
    xmlns:controls="using:DeskBox.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DeskBox.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Width="336" Spacing="10">

        <!-- Live preview + heading -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="PreviewSurface"
                Width="44"
                Height="44"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <controls:WidgetTitleIcon
                        x:Name="PreviewDefaultIcon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IconSize="18" />
                    <Image
                        x:Name="PreviewImage"
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="PreviewEmojiText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Emoji"
                        FontSize="24"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" />
                <TextBlock
                    x:Name="SubtitleText"
                    FontSize="11"
                    MaxLines="2"
                    Opacity="0.7"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- Emoji / Image segmented tabs -->
        <toolkit:Segmented x:Name="IconTabSegmented" HorizontalAlignment="Stretch">
            <toolkit:SegmentedItem x:Name="EmojiTabItem" HorizontalAlignment="Stretch" />
            <toolkit:SegmentedItem x:Name="ImageTabItem" HorizontalAlignment="Stretch" />
        </toolkit:Segmented>

        <!-- Emoji panel -->
        <StackPanel x:Name="EmojiPanel" Spacing="8">
            <GridView
                x:Name="CategoryList"
                MaxHeight="76"
                SelectionMode="Single">
                <GridView.ItemContainerTransitions>
                    <TransitionCollection />
                </GridView.ItemContainerTransitions>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:WidgetEmojiCategoryOption">
                        <Border
                            Padding="10,4"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <TextBlock helpers:WidgetTextShadow.Cast="False" Text="{x:Bind Label}" />
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <GridView
                x:Name="EmojiGrid"
                MaxHeight="264"
                IsItemClickEnabled="True"
                SelectionMode="Single">
                <GridView.ItemContainerTransitions>
                    <TransitionCollection />
                </GridView.ItemContainerTransitions>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Width="38" Height="38">
                            <TextBlock
                                helpers:WidgetTextShadow.Cast="False"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe UI Emoji"
                                FontSize="20"
                                Text="{x:Bind}" />
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <StackPanel x:Name="RecentPanel" Spacing="4" Visibility="Collapsed">
                <TextBlock x:Name="RecentLabel" FontSize="11" Opacity="0.7" />
                <StackPanel x:Name="RecentHost" Orientation="Horizontal" Spacing="4" />
            </StackPanel>
        </StackPanel>

        <!-- Image panel -->
        <StackPanel x:Name="ImagePanel" Spacing="8" Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="56"
                    Height="56"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Image
                        x:Name="ImagePreview"
                        Width="40"
                        Height="40"
                        Stretch="Uniform" />
                </Border>
                <TextBlock
                    x:Name="ImagePanelHint"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.7"
                    TextWrapping="Wrap" />
            </Grid>
            <Button
                x:Name="ChooseImageButton"
                HorizontalAlignment="Stretch" />
            <TextBlock
                x:Name="ImageFormatsHint"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock
            x:Name="ErrorText"
            FontSize="11"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!-- Footer -->
        <Grid>
            <Button
                x:Name="RandomButton"
                HorizontalAlignment="Left" />
            <Button
                x:Name="ResetButton"
                HorizontalAlignment="Right" />
        </Grid>
    </StackPanel>
</UserControl>
