<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.DesktopOrganizationPreviewCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PreviewFileToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="TileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="TileBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="TileBorder.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GroupSelectionToggleStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="RootGrid" ColumnDefinitions="Auto,*"
                              Padding="4,2,8,2"
                              Background="{TemplateBinding Background}"
                              CornerRadius="6">
                            <Border x:Name="SelectionBox" Width="20" Height="20" CornerRadius="4"
                                    VerticalAlignment="Center"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                    Background="Transparent">
                                <FontIcon x:Name="CheckIcon" Glyph="&#xE73E;" FontSize="11"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="Collapsed" Foreground="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Content="{TemplateBinding Content}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CombinedStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="UncheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource ControlAltFillColorTertiaryBrush}" />
                                            <Setter Target="SelectionBox.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="UncheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource ControlAltFillColorQuarternaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="UncheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="SelectionBox.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="SelectionBox.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.4" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                            <Setter Target="CheckIcon.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminatePointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="SelectionBox.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                            <Setter Target="CheckIcon.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminatePressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                            <Setter Target="CheckIcon.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminateDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.4" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                            <Setter Target="CheckIcon.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="CardRootGrid"
        Width="320"
        Height="216"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        AllowDrop="True"
        PointerEntered="CardRootGrid_PointerEntered"
        PointerExited="CardRootGrid_PointerExited"
        Tapped="CardRootGrid_Tapped"
        DragOver="CardRootGrid_DragOver"
        DragLeave="CardRootGrid_DragLeave"
        Drop="CardRootGrid_Drop">
        <SystemBackdropElement x:Name="MaterialSurface" IsHitTestVisible="False" />
        <Border x:Name="FallbackSurface" IsHitTestVisible="False" />
        <Border
            x:Name="CardOutline"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Grid RowDefinitions="38,*">
                <Border
                    x:Name="HeaderDivider"
                    Height="38"
                    Padding="14,0,8,0"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <!-- Hidden compatibility elements -->
                        <StackPanel Visibility="Collapsed">
                            <StackPanel x:Name="ReadOnlyHeaderPanel">
                                <Border x:Name="ReadOnlyIconBadge">
                                    <FontIcon x:Name="ReadOnlyCategoryIcon" />
                                </Border>
                                <TextBlock x:Name="ReadOnlyTitleText" />
                            </StackPanel>
                            <CheckBox
                                x:Name="GroupCheckBox"
                                Style="{StaticResource GroupSelectionToggleStyle}"
                                Checked="GroupCheckBox_Changed"
                                Unchecked="GroupCheckBox_Changed" />
                            <Border x:Name="CategoryIconBadge">
                                <FontIcon x:Name="CategoryIcon" />
                            </Border>
                            <Border x:Name="DestinationBadge">
                                <TextBlock x:Name="DestinationBadgeText" />
                            </Border>
                            <TextBlock x:Name="GroupDescriptionText" />
                            <TextBlock x:Name="RoutePrefixText" />
                            <TextBlock x:Name="DestinationText" />
                            <Button x:Name="InlineIncludeButton" Click="InlineIncludeButton_Click">
                                <TextBlock x:Name="InlineIncludeText" />
                            </Button>
                        </StackPanel>

                        <!-- Pure DeskBox Widget Title (Double-click to rename) -->
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel
                                x:Name="TitleDisplayPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                DoubleTapped="TitleDisplayPanel_DoubleTapped">
                                <TextBlock
                                    x:Name="TitleText"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    MaxWidth="172"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBox
                                x:Name="TitleRenameBox"
                                Visibility="Collapsed"
                                FontSize="12.5"
                                MinHeight="26"
                                Width="172"
                                HorizontalAlignment="Left"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                LostFocus="TitleRenameBox_LostFocus"
                                KeyDown="TitleRenameBox_KeyDown" />
                        </Grid>

                        <!-- Plain-text metadata + subtle '...' button -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="CountText"
                                FontSize="12"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel x:Name="DestinationPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button
                                    x:Name="DestinationButton"
                                    Width="26"
                                    Height="26"
                                    MinWidth="26"
                                    MinHeight="26"
                                    Padding="0"
                                    CornerRadius="5"
                                    Opacity="0.52"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center">
                                    <FontIcon
                                        Glyph="&#xE712;"
                                        FontSize="13"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button.Flyout>
                                        <MenuFlyout
                                            x:Name="DestinationFlyout"
                                            Placement="BottomEdgeAlignedRight"
                                            Opened="DestinationFlyout_Opened"
                                            Closed="DestinationFlyout_Closed" />
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Inner ScrollViewer: scrolls vertically inside the fixed 320x216 box when > 8 items -->
                <ScrollViewer
                    x:Name="InnerItemsScrollViewer"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto"
                    Padding="10,6,10,8">
                    <Grid
                        x:Name="ItemsPanel"
                        ColumnSpacing="4"
                        RowSpacing="4"
                        VerticalAlignment="Top"
                        SizeChanged="ItemsPanel_SizeChanged" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
