<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.DesktopOrganizationPreviewCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PreviewTileHostStyle" TargetType="ContentControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border
                            x:Name="TileBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="CardRootGrid"
        Width="320"
        Height="216"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        PointerEntered="CardRootGrid_PointerEntered"
        PointerExited="CardRootGrid_PointerExited"
        Tapped="CardRootGrid_Tapped">
        <SystemBackdropElement x:Name="MaterialSurface" IsHitTestVisible="False" />
        <Border x:Name="FallbackSurface" IsHitTestVisible="False" />
        <Border
            x:Name="CardOutline"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Grid RowDefinitions="38,*">
                <Border
                    x:Name="HeaderDivider"
                    Height="38"
                    Padding="14,0,8,0"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <!-- Pure DeskBox Widget Title (Double-click to rename) -->
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel
                                x:Name="TitleDisplayPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                DoubleTapped="TitleDisplayPanel_DoubleTapped">
                                <TextBlock
                                    x:Name="TitleText"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    MaxWidth="172"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBox
                                x:Name="TitleRenameBox"
                                Visibility="Collapsed"
                                MaxLength="64"
                                FontSize="12.5"
                                MinHeight="26"
                                Width="172"
                                HorizontalAlignment="Left"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                LostFocus="TitleRenameBox_LostFocus"
                                KeyDown="TitleRenameBox_KeyDown" />
                        </Grid>

                        <!-- Plain-text metadata + subtle '...' button -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="CountText"
                                FontSize="12"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel x:Name="DestinationPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button
                                    x:Name="DestinationButton"
                                    Width="26"
                                    Height="26"
                                    MinWidth="26"
                                    MinHeight="26"
                                    Padding="0"
                                    CornerRadius="5"
                                    Opacity="0.52"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center">
                                    <FontIcon
                                        Glyph="&#xE712;"
                                        FontSize="13"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button.Flyout>
                                        <MenuFlyout
                                            x:Name="DestinationFlyout"
                                            Placement="BottomEdgeAlignedRight"
                                            Opened="DestinationFlyout_Opened"
                                            Closed="DestinationFlyout_Closed" />
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Inner ScrollViewer: scrolls vertically inside the fixed 320x216 box -->
                <ScrollViewer
                    x:Name="InnerItemsScrollViewer"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto"
                    Padding="10,6,10,8">
                    <Grid
                        x:Name="ItemsPanel"
                        ColumnSpacing="4"
                        RowSpacing="4"
                        VerticalAlignment="Top"
                        SizeChanged="ItemsPanel_SizeChanged" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
