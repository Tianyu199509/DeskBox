<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.Todo.TodoExportPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:DeskBox.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowDrop="False"
    CanDrag="False"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ExportFlyoutPresenterStyle" TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="16,14,16,16" />
            <Setter Property="MaxWidth" Value="380" />
        </Style>

        <Style x:Key="ExportSegmentIdleButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="ExportSegmentActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="ExportChipIdleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="ExportChipActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="ExportColorDotButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="RootPanel" Spacing="10">
        <!-- Flyout Chrome Header -->
        <Grid x:Name="FlyoutHeaderGrid" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="FlyoutTitleText"
                    helpers:WidgetTextShadow.Cast="False"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="FlyoutSelectionSubtitleText"
                    helpers:WidgetTextShadow.Cast="False"
                    FontSize="11.5"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="2"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <Button
                x:Name="HeaderCloseButton"
                Grid.Column="1"
                Width="26"
                Height="26"
                MinWidth="26"
                MinHeight="26"
                Padding="0"
                VerticalAlignment="Top"
                Click="CancelButton_Click"
                CornerRadius="4"
                Style="{StaticResource SubtleButtonStyle}">
                <FontIcon
                    FontSize="10"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE711;" />
            </Button>
        </Grid>

        <!-- Dialog-mode Selection Subset Subtitle -->
        <TextBlock
            x:Name="DialogSubtitleText"
            helpers:WidgetTextShadow.Cast="False"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!-- Card 1: Filter Scope, Date Range, and Color Tags -->
        <Border
            x:Name="FilterCardBorder"
            Padding="12,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="10">
                <!-- 1. Task Status -->
                <StackPanel Spacing="5">
                    <TextBlock
                        x:Name="StatusSectionLabel"
                        helpers:WidgetTextShadow.Cast="False"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Border
                        Padding="2"
                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Button x:Name="StatusAllButton" Click="StatusAllButton_Click" Style="{StaticResource ExportSegmentActiveButtonStyle}" />
                                <Border x:Name="StatusAllIndicator" Width="16" Height="2.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.25" IsHitTestVisible="False" />
                            </Grid>

                            <Grid Grid.Column="1">
                                <Button x:Name="StatusCompletedButton" Click="StatusCompletedButton_Click" Style="{StaticResource ExportSegmentIdleButtonStyle}" />
                                <Border x:Name="StatusCompletedIndicator" Width="16" Height="2.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.25" IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>

                            <Grid Grid.Column="2">
                                <Button x:Name="StatusActiveButton" Click="StatusActiveButton_Click" Style="{StaticResource ExportSegmentIdleButtonStyle}" />
                                <Border x:Name="StatusActiveIndicator" Width="16" Height="2.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.25" IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 2. Date Range -->
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="DateRangeSectionLabel"
                        helpers:WidgetTextShadow.Cast="False"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid ColumnSpacing="5" RowSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button x:Name="PresetAllTimeButton" Grid.Row="0" Grid.Column="0" Click="PresetButton_Click" Style="{StaticResource ExportChipActiveButtonStyle}" Tag="AllTime" />
                        <Button x:Name="PresetThisWeekButton" Grid.Row="0" Grid.Column="1" Click="PresetButton_Click" Style="{StaticResource ExportChipIdleButtonStyle}" Tag="ThisWeek" />
                        <Button x:Name="PresetLastWeekButton" Grid.Row="0" Grid.Column="2" Click="PresetButton_Click" Style="{StaticResource ExportChipIdleButtonStyle}" Tag="LastWeek" />
                        <Button x:Name="PresetThisMonthButton" Grid.Row="0" Grid.Column="3" Click="PresetButton_Click" Style="{StaticResource ExportChipIdleButtonStyle}" Tag="ThisMonth" />
                        <Button x:Name="PresetLastMonthButton" Grid.Row="1" Grid.Column="0" Click="PresetButton_Click" Style="{StaticResource ExportChipIdleButtonStyle}" Tag="LastMonth" />
                        <Button x:Name="PresetThisQuarterButton" Grid.Row="1" Grid.Column="1" Click="PresetButton_Click" Style="{StaticResource ExportChipIdleButtonStyle}" Tag="ThisQuarter" />
                        <Button x:Name="PresetThisYearButton" Grid.Row="1" Grid.Column="2" Click="PresetButton_Click" Style="{StaticResource ExportChipIdleButtonStyle}" Tag="ThisYear" />
                        <Button x:Name="PresetCustomButton" Grid.Row="1" Grid.Column="3" Click="PresetButton_Click" Style="{StaticResource ExportChipIdleButtonStyle}" Tag="CustomRange" />
                    </Grid>

                    <!-- Custom Date Inputs -->
                    <Grid
                        x:Name="CustomDateGrid"
                        ColumnSpacing="6"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="CustomStartBox"
                            Grid.Column="0"
                            FontSize="12"
                            PlaceholderText="yyyy-MM-dd"
                            TextChanged="CustomDateBox_TextChanged" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            helpers:WidgetTextShadow.Cast="False"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="–" />
                        <TextBox
                            x:Name="CustomEndBox"
                            Grid.Column="2"
                            FontSize="12"
                            PlaceholderText="yyyy-MM-dd"
                            TextChanged="CustomDateBox_TextChanged" />
                    </Grid>

                    <!-- Date Basis Sub-section -->
                    <StackPanel
                        x:Name="DateBasisSection"
                        Spacing="4"
                        Visibility="Collapsed">
                        <StackPanel
                            x:Name="LockedCompletedBasisHint"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="Collapsed">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE946;" />
                            <TextBlock
                                x:Name="LockedCompletedBasisText"
                                VerticalAlignment="Center"
                                helpers:WidgetTextShadow.Cast="False"
                                FontSize="11.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="DateBasisInteractivePanel" Spacing="4">
                            <TextBlock
                                x:Name="BasisSectionLabel"
                                helpers:WidgetTextShadow.Cast="False"
                                FontSize="11.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <Border
                                Padding="2"
                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Button x:Name="BasisActiveInPeriodButton" Click="BasisButton_Click" Style="{StaticResource ExportSegmentActiveButtonStyle}" Tag="ActiveInPeriod" />
                                        <Border x:Name="BasisActiveInPeriodIndicator" Width="14" Height="2.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.25" IsHitTestVisible="False" />
                                    </Grid>
                                    <Grid Grid.Column="1">
                                        <Button x:Name="BasisCompletedAtButton" Click="BasisButton_Click" Style="{StaticResource ExportSegmentIdleButtonStyle}" Tag="CompletedAt" />
                                        <Border x:Name="BasisCompletedAtIndicator" Width="14" Height="2.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.25" IsHitTestVisible="False" Visibility="Collapsed" />
                                    </Grid>
                                    <Grid Grid.Column="2">
                                        <Button x:Name="BasisCreatedAtButton" Click="BasisButton_Click" Style="{StaticResource ExportSegmentIdleButtonStyle}" Tag="CreatedAt" />
                                        <Border x:Name="BasisCreatedAtIndicator" Width="14" Height="2.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.25" IsHitTestVisible="False" Visibility="Collapsed" />
                                    </Grid>
                                    <Grid Grid.Column="3">
                                        <Button x:Name="BasisDueDateButton" Click="BasisButton_Click" Style="{StaticResource ExportSegmentIdleButtonStyle}" Tag="DueDate" />
                                        <Border x:Name="BasisDueDateIndicator" Width="14" Height="2.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.25" IsHitTestVisible="False" Visibility="Collapsed" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Divider -->
                <Border
                    Height="1"
                    Margin="-12,0,-12,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- 3. Color Tags -->
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="ColorSectionLabel"
                            VerticalAlignment="Center"
                            helpers:WidgetTextShadow.Cast="False"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock
                            x:Name="AllColorsHintText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            helpers:WidgetTextShadow.Cast="False"
                            FontSize="11.5"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                        <Button
                            x:Name="ClearColorsButton"
                            Grid.Column="1"
                            MinWidth="0"
                            MinHeight="20"
                            Padding="6,1"
                            VerticalAlignment="Center"
                            Click="ClearColorsButton_Click"
                            CornerRadius="4"
                            FontSize="11.5"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Style="{StaticResource SubtleButtonStyle}"
                            Visibility="Collapsed" />
                    </Grid>

                    <Grid x:Name="ColorDotsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Card 2: Export Format -->
        <Border
            x:Name="FormatCardBorder"
            Padding="12,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="6">
                <TextBlock
                    x:Name="FormatSectionLabel"
                    helpers:WidgetTextShadow.Cast="False"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Border
                    Padding="2"
                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid ColumnSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Button x:Name="FormatXlsxButton" Click="FormatXlsxButton_Click" Style="{StaticResource ExportSegmentActiveButtonStyle}" />
                            <Border x:Name="FormatXlsxIndicator" Width="18" Height="2.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.25" IsHitTestVisible="False" />
                        </Grid>

                        <Grid Grid.Column="1">
                            <Button x:Name="FormatCsvButton" Click="FormatCsvButton_Click" Style="{StaticResource ExportSegmentIdleButtonStyle}" />
                            <Border x:Name="FormatCsvIndicator" Width="18" Height="2.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1.25" IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock
                    x:Name="FormatHintText"
                    helpers:WidgetTextShadow.Cast="False"
                    FontSize="11.5"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Live Summary Row -->
        <Grid Padding="2,0" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <FontIcon
                x:Name="PreviewStatusIcon"
                Margin="0,2,0,0"
                VerticalAlignment="Top"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE946;" />

            <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock
                    x:Name="PreviewPrimaryText"
                    helpers:WidgetTextShadow.Cast="False"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="PreviewSecondaryText"
                    helpers:WidgetTextShadow.Cast="False"
                    FontSize="11.5"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- Flyout Footer Actions -->
        <StackPanel
            x:Name="FlyoutFooterPanel"
            Margin="0,2,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="CancelActionButton"
                MinWidth="80"
                Click="CancelButton_Click" />
            <Button
                x:Name="ConfirmActionButton"
                MinWidth="88"
                Click="ConfirmButton_Click"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </StackPanel>
</UserControl>
