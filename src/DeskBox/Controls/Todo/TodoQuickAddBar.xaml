<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.Todo.TodoQuickAddBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="False"
    mc:Ignorable="d">

    <Grid>
        <Button
            x:Name="AddTaskCardButton"
            MinHeight="44"
            Padding="8,6"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.Name="{x:Bind PlaceholderText, Mode=OneWay}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="Transparent"
            BorderThickness="0"
            Click="AddTaskCardButton_Click"
            CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
            Style="{StaticResource WidgetQuickAddCardButtonStyle}"
            Visibility="{x:Bind CollapsedButtonVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="13.5"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE710;" />
                <TextBlock
                    Grid.Column="1"
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="{x:Bind InputFontSize, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Text="{x:Bind CollapsedCardText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Button>

        <Border
            x:Name="InlineComposerCard"
            Padding="10,8,10,6"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
            Visibility="{x:Bind ExpandedCardVisibility, Mode=OneWay}">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox
                    x:Name="InlineComposerTextBox"
                    Grid.Row="0"
                    MinHeight="60"
                    MaxHeight="136"
                    Padding="2,2,2,4"
                    VerticalContentAlignment="Top"
                    AcceptsReturn="True"
                    AutomationProperties.Name="{x:Bind PlaceholderText, Mode=OneWay}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
                    FontSize="{x:Bind InputFontSize, Mode=OneWay}"
                    MaxLength="2000"
                    PlaceholderText="{x:Bind PlaceholderText, Mode=OneWay}"
                    PointerPressed="InlineComposerTextBox_PointerPressed"
                    PreviewKeyDown="InlineComposerTextBox_PreviewKeyDown"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Style="{StaticResource WidgetBorderlessInputTextBoxStyle}"
                    Text="{x:Bind InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                </TextBox>

                <Grid Grid.Row="1" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Grid>
                            <Border
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="5"
                                IsHitTestVisible="False"
                                Visibility="{x:Bind DueDateChipVisibility, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <Button
                                    x:Name="QuickDueDateButton"
                                    MinWidth="26"
                                    Height="26"
                                    MinHeight="26"
                                    Padding="5,0"
                                    AutomationProperties.Name="{x:Bind DueDateTooltipText, Mode=OneWay}"
                                    Click="QuickDueDateButton_Click"
                                    IsTabStop="False"
                                    Style="{StaticResource WidgetCompactIconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind DueDateTooltipText, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE787;" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="{x:Bind SecondaryFontSize, Mode=OneWay}"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            MaxLines="1"
                                            Text="{x:Bind DueDateChipText, Mode=OneWay}"
                                            Visibility="{x:Bind DueDateChipVisibility, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="ClearDraftDueDateButton"
                                    Width="20"
                                    Height="26"
                                    MinWidth="20"
                                    MinHeight="26"
                                    Padding="0"
                                    AutomationProperties.Name="{x:Bind ClearChipTooltipText, Mode=OneWay}"
                                    Click="ClearDraftDueDateButton_Click"
                                    IsTabStop="False"
                                    Style="{StaticResource WidgetCompactIconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind ClearChipTooltipText, Mode=OneWay}"
                                    Visibility="{x:Bind DueDateChipVisibility, Mode=OneWay}">
                                    <FontIcon
                                        FontSize="8.5"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Border
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="5"
                                IsHitTestVisible="False"
                                Visibility="{x:Bind RecurrenceChipVisibility, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <Button
                                    x:Name="QuickRecurrenceButton"
                                    MinWidth="26"
                                    Height="26"
                                    MinHeight="26"
                                    Padding="5,0"
                                    AutomationProperties.Name="{x:Bind RecurrenceTooltipText, Mode=OneWay}"
                                    Click="QuickRecurrenceButton_Click"
                                    IsTabStop="False"
                                    Style="{StaticResource WidgetCompactIconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind RecurrenceTooltipText, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE823;" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="{x:Bind SecondaryFontSize, Mode=OneWay}"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            MaxLines="1"
                                            Text="{x:Bind RecurrenceChipText, Mode=OneWay}"
                                            Visibility="{x:Bind RecurrenceChipVisibility, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="ClearDraftRecurrenceButton"
                                    Width="20"
                                    Height="26"
                                    MinWidth="20"
                                    MinHeight="26"
                                    Padding="0"
                                    AutomationProperties.Name="{x:Bind ClearChipTooltipText, Mode=OneWay}"
                                    Click="ClearDraftRecurrenceButton_Click"
                                    IsTabStop="False"
                                    Style="{StaticResource WidgetCompactIconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind ClearChipTooltipText, Mode=OneWay}"
                                    Visibility="{x:Bind RecurrenceChipVisibility, Mode=OneWay}">
                                    <FontIcon
                                        FontSize="8.5"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Button
                            x:Name="QuickImportantButton"
                            Width="26"
                            Height="26"
                            MinWidth="26"
                            MinHeight="26"
                            Padding="0"
                            AutomationProperties.Name="{x:Bind ImportantTooltipText, Mode=OneWay}"
                            Click="QuickImportantButton_Click"
                            IsTabStop="False"
                            Style="{StaticResource WidgetCompactIconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ImportantTooltipText, Mode=OneWay}">
                            <Grid>
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE734;"
                                    Visibility="{x:Bind ImportantInactiveVisibility, Mode=OneWay}" />
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE735;"
                                    Visibility="{x:Bind ImportantActiveVisibility, Mode=OneWay}" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="ExpandToDetailButton"
                            Width="26"
                            Height="26"
                            MinWidth="26"
                            MinHeight="26"
                            Padding="0"
                            AutomationProperties.Name="{x:Bind ExpandTooltipText, Mode=OneWay}"
                            Click="ExpandToDetailButton_Click"
                            IsTabStop="False"
                            Style="{StaticResource WidgetCompactIconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ExpandTooltipText, Mode=OneWay}">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8A7;" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <Button
                            x:Name="InlineComposerCancelButton"
                            Width="26"
                            Height="26"
                            MinWidth="26"
                            MinHeight="26"
                            Padding="0"
                            AutomationProperties.Name="{x:Bind CancelTooltipText, Mode=OneWay}"
                            Click="InlineComposerCancelButton_Click"
                            IsTabStop="False"
                            Style="{StaticResource WidgetCompactIconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind CancelTooltipText, Mode=OneWay}">
                            <FontIcon
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE711;" />
                        </Button>

                        <Button
                            x:Name="InlineComposerSaveButton"
                            Width="26"
                            Height="26"
                            MinWidth="26"
                            MinHeight="26"
                            Padding="0"
                            AutomationProperties.Name="{x:Bind SaveTooltipText, Mode=OneWay}"
                            Click="InlineComposerSaveButton_Click"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            IsEnabled="{x:Bind CanSaveDraft, Mode=OneWay}"
                            IsTabStop="False"
                            Opacity="{x:Bind SaveButtonOpacity, Mode=OneWay}"
                            Style="{StaticResource WidgetCompactIconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind SaveTooltipText, Mode=OneWay}">
                            <FontIcon
                                FontSize="12"
                                Glyph="&#xE73E;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
