<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.Todo.TodoQuickAddBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="False"
    mc:Ignorable="d">

    <Grid>
        <Button
            x:Name="AddTaskCardButton"
            MinHeight="42"
            Padding="8,5"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.Name="{x:Bind PlaceholderText, Mode=OneWay}"
            Background="{ThemeResource WidgetLayerFillSecondaryBrush}"
            BorderBrush="Transparent"
            BorderThickness="0"
            Click="AddTaskCardButton_Click"
            CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
            Visibility="{x:Bind CollapsedButtonVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE710;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="{x:Bind InputFontSize, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Text="{x:Bind CollapsedCardText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Button>

        <Border
            x:Name="InlineComposerCard"
            Padding="8,6"
            Background="{ThemeResource WidgetLayerFillSecondaryBrush}"
            BorderBrush="{ThemeResource WidgetLayerStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
            Visibility="{x:Bind ExpandedCardVisibility, Mode=OneWay}">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox
                    x:Name="InlineComposerTextBox"
                    Grid.Row="0"
                    MinHeight="62"
                    MaxHeight="132"
                    Padding="4,2"
                    AcceptsReturn="True"
                    AutomationProperties.Name="{x:Bind PlaceholderText, Mode=OneWay}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
                    FontSize="{x:Bind InputFontSize, Mode=OneWay}"
                    MaxLength="2000"
                    PlaceholderText="{x:Bind PlaceholderText, Mode=OneWay}"
                    PreviewKeyDown="InlineComposerTextBox_PreviewKeyDown"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{x:Bind InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextBoxBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextBoxBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextBoxBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextBoxBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextBoxBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextBoxBorderBrushFocused" Color="Transparent" />
                        <Thickness x:Key="TextBoxBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextBoxBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                </TextBox>

                <Grid Grid.Row="1" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button
                            x:Name="QuickDueDateButton"
                            MinWidth="24"
                            Height="24"
                            MinHeight="24"
                            Padding="4,0"
                            AutomationProperties.Name="{x:Bind DueDateTooltipText, Mode=OneWay}"
                            Click="QuickDueDateButton_Click"
                            IsTabStop="False"
                            Style="{StaticResource WidgetCompactIconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind DueDateTooltipText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon
                                    FontSize="11.5"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE787;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{x:Bind SecondaryFontSize, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    Text="{x:Bind DueDateChipText, Mode=OneWay}"
                                    Visibility="{x:Bind DueDateChipVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="QuickImportantButton"
                            Width="24"
                            Height="24"
                            MinWidth="24"
                            MinHeight="24"
                            Padding="0"
                            AutomationProperties.Name="{x:Bind ImportantTooltipText, Mode=OneWay}"
                            Click="QuickImportantButton_Click"
                            IsTabStop="False"
                            Style="{StaticResource WidgetCompactIconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ImportantTooltipText, Mode=OneWay}">
                            <FontIcon
                                FontSize="11.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{x:Bind ImportantGlyph, Mode=OneWay}" />
                        </Button>

                        <Button
                            x:Name="ExpandToDetailButton"
                            Width="24"
                            Height="24"
                            MinWidth="24"
                            MinHeight="24"
                            Padding="0"
                            AutomationProperties.Name="{x:Bind ExpandTooltipText, Mode=OneWay}"
                            Click="ExpandToDetailButton_Click"
                            IsTabStop="False"
                            Style="{StaticResource WidgetCompactIconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ExpandTooltipText, Mode=OneWay}">
                            <FontIcon
                                FontSize="11.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8A7;" />
                        </Button>
                    </StackPanel>

                    <TextBlock
                        x:Name="InlineComposerHintText"
                        Grid.Column="1"
                        Margin="2,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        MaxLines="1"
                        Text="{x:Bind HintText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                        <Button
                            x:Name="InlineComposerCancelButton"
                            Width="24"
                            Height="24"
                            MinWidth="24"
                            MinHeight="24"
                            Padding="0"
                            AutomationProperties.Name="{x:Bind CancelTooltipText, Mode=OneWay}"
                            Click="InlineComposerCancelButton_Click"
                            IsTabStop="False"
                            Style="{StaticResource WidgetCompactIconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind CancelTooltipText, Mode=OneWay}">
                            <FontIcon
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE711;" />
                        </Button>

                        <Button
                            x:Name="InlineComposerSaveButton"
                            Width="24"
                            Height="24"
                            MinWidth="24"
                            MinHeight="24"
                            Padding="0"
                            AutomationProperties.Name="{x:Bind SaveTooltipText, Mode=OneWay}"
                            Click="InlineComposerSaveButton_Click"
                            IsEnabled="{x:Bind CanSaveDraft, Mode=OneWay}"
                            IsTabStop="False"
                            Style="{StaticResource WidgetCompactIconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind SaveTooltipText, Mode=OneWay}">
                            <FontIcon
                                FontSize="11.5"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Glyph="&#xE73E;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
