<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetInlineEditor"
    x:Name="InlineEditorRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Border
        x:Name="OverlayRoot"
        Style="{StaticResource WidgetInlineEditorOverlayStyle}">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="TitleTextBlockElement"
                    Grid.Column="0"
                    FontSize="{x:Bind TitleFontSize, Mode=OneWay}"
                    Style="{StaticResource WidgetInlineEditorTitleTextStyle}"
                    Text="{x:Bind Title, Mode=OneWay}" />

                <Button
                    x:Name="CloseButtonElement"
                    AutomationProperties.Name="{x:Bind CancelText, Mode=OneWay}"
                    Grid.Column="1"
                    Click="CancelButton_Click"
                    Style="{StaticResource WidgetInlineEditorCloseButtonStyle}">
                    <FontIcon FontSize="10" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <TextBox
                x:Name="EditorTextBoxElement"
                AutomationProperties.LabeledBy="{Binding ElementName=TitleTextBlockElement}"
                Grid.Row="1"
                FontSize="{x:Bind EditorFontSize, Mode=OneWay}"
                Style="{StaticResource WidgetEditorTextBoxStyle}"
                Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <!-- Affirmative (Save) sits on the left, matching the app-wide
                     ContentDialog convention (Primary = affirmative = left). -->
                <Button
                    x:Name="SaveButtonElement"
                    Click="SaveButton_Click"
                    Content="{x:Bind SaveText, Mode=OneWay}"
                    FontSize="{x:Bind CommandFontSize, Mode=OneWay}"
                    Style="{StaticResource WidgetEditorCommandButtonStyle}" />
                <Button
                    x:Name="CancelButtonElement"
                    Click="CancelButton_Click"
                    Content="{x:Bind CancelText, Mode=OneWay}"
                    FontSize="{x:Bind CommandFontSize, Mode=OneWay}"
                    Style="{StaticResource WidgetEditorCommandButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
