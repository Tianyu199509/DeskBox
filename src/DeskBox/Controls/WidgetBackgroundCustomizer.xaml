<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetBackgroundCustomizer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Width="336" Spacing="10">

        <!-- State preview + heading -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="PreviewSurface"
                Width="56"
                Height="44"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Image
                        x:Name="PreviewImage"
                        Stretch="UniformToFill"
                        Visibility="Collapsed" />
                    <FontIcon
                        x:Name="PreviewEmptyIcon"
                        FontSize="16"
                        Glyph="&#xE91B;" />
                </Grid>
            </Border>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" />
                <TextBlock
                    x:Name="SubtitleText"
                    FontSize="11"
                    MaxLines="2"
                    Opacity="0.7"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Button
            x:Name="ChooseImageButton"
            HorizontalAlignment="Stretch" />
        <TextBlock
            x:Name="ImageFormatsHint"
            FontSize="11"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <!-- Solid per-widget background color; mutually exclusive with the
             image above (picking a color retires the image). -->
        <StackPanel x:Name="ColorPanel" Spacing="4">
            <TextBlock x:Name="ColorLabel" FontSize="11" Opacity="0.7" />
            <ColorPicker
                x:Name="BackgroundColorPicker"
                IsAlphaEnabled="False"
                MinWidth="256" />
        </StackPanel>

        <!-- Fit + dim, only meaningful while an image is set -->
        <StackPanel x:Name="OptionsPanel" Spacing="10" Visibility="Collapsed">
            <StackPanel Spacing="4">
                <TextBlock x:Name="FitLabel" FontSize="11" Opacity="0.7" />
                <toolkit:Segmented x:Name="FitSegmented" HorizontalAlignment="Stretch">
                    <toolkit:SegmentedItem x:Name="FitFillItem" HorizontalAlignment="Stretch" />
                    <toolkit:SegmentedItem x:Name="FitContainItem" HorizontalAlignment="Stretch" />
                </toolkit:Segmented>
            </StackPanel>
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="DimLabel"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Opacity="0.7" />
                    <TextBlock
                        x:Name="DimValueText"
                        Grid.Column="1"
                        FontSize="11"
                        Opacity="0.7" />
                </Grid>
                <Slider
                    x:Name="DimSlider"
                    Maximum="100"
                    Minimum="0"
                    SmallChange="5"
                    StepFrequency="5" />
            </StackPanel>
        </StackPanel>

        <!-- Always reachable: clears whichever background kind is set. -->
        <Button
            x:Name="ClearButton"
            HorizontalAlignment="Stretch" />

        <TextBlock
            x:Name="ErrorText"
            FontSize="11"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
