<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.DesktopOrganizationTaskView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeskBox.Controls">
    <UserControl.Resources>
        <Style x:Key="DesktopOrganizationSecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="NeutralSourceCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" ColumnDefinitions="Auto,*">
                            <Border x:Name="SelectionBox" Width="20" Height="20" CornerRadius="4"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <FontIcon x:Name="CheckIcon" Glyph="&#xE73E;" FontSize="11"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="Collapsed" Foreground="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CombinedStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="UncheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource ControlAltFillColorTertiaryBrush}" />
                                            <Setter Target="SelectionBox.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="UncheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource ControlAltFillColorQuarternaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="UncheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="SelectionBox.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="SelectionBox.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Opacity" Value="0.4" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                            <Setter Target="CheckIcon.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminatePointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="SelectionBox.BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                            <Setter Target="CheckIcon.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminatePressed">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Background" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                            <Setter Target="CheckIcon.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminateDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionBox.Opacity" Value="0.4" />
                                            <Setter Target="CheckIcon.Visibility" Value="Visible" />
                                            <Setter Target="CheckIcon.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Padding="20,0,20,14" RowSpacing="10" RowDefinitions="Auto,*,Auto">
        <!-- Row 0: Fluent 2 Command Row + Contextual InfoBars -->
        <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <!-- Retained hidden elements for XAML field compatibility -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock x:Name="PageHeaderTitleText" />
                    <Border x:Name="HeaderSafetyDot" />
                    <TextBlock x:Name="PageHeaderSubtitleText" />
                    <TextBlock x:Name="SummaryDescription" />
                    <TextBlock x:Name="CanvasHintText" />
                    <SelectorBar x:Name="PreviewSections" SelectionChanged="PreviewSections_SelectionChanged">
                        <SelectorBarItem x:Name="SummaryTitle" IsSelected="True" />
                        <SelectorBarItem x:Name="ExcludedItemsButton" />
                    </SelectorBar>
                    <Button x:Name="ViewModeButton" Click="ViewModeButton_Click">
                        <FontIcon x:Name="ViewModeIcon" Glyph="&#xF0E2;" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ContentControl x:Name="SourceSelectionHost" VerticalAlignment="Center"
                                    HorizontalContentAlignment="Stretch">
                        <DropDownButton MinWidth="0" Height="32" Padding="10,0" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7F8;" FontSize="12.5" VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="SourceScopeText" VerticalAlignment="Center" FontSize="12.5" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Spacing="12" MinWidth="220">
                                        <CheckBox x:Name="PersonalDesktopSourceButton" MinWidth="0" MaxWidth="260"
                                                  Style="{StaticResource NeutralSourceCheckBoxStyle}" IsChecked="True"
                                                  Checked="SourceSelection_Changed" Unchecked="SourceSelection_Changed">
                                            <TextBlock x:Name="PersonalSourceText" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox x:Name="PublicDesktopSourceButton" MinWidth="0" MaxWidth="260"
                                                  Style="{StaticResource NeutralSourceCheckBoxStyle}" IsChecked="False"
                                                  Checked="SourceSelection_Changed" Unchecked="SourceSelection_Changed">
                                            <TextBlock x:Name="PublicSourceText" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </ContentControl>

                    <FontIcon Glyph="&#xE72A;" FontSize="10" Margin="2,0" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <Button x:Name="LocationsButton" VerticalAlignment="Center"
                            Height="32" Padding="10,0" CornerRadius="6" MaxWidth="380"
                            HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="5">
                            <FontIcon Glyph="&#xE8B7;" FontSize="12.5" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="StoragePillPrefixText" Grid.Column="1" FontSize="12.5"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="StoragePillPathText" Grid.Column="2" FontSize="12.5"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <FontIcon Grid.Column="3" Glyph="&#xE70D;" FontSize="9" Opacity="0.7" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout x:Name="LocationsFlyout" Placement="BottomEdgeAlignedLeft">
                                <StackPanel Spacing="8" MaxWidth="420" MinWidth="320">
                                    <TextBlock x:Name="SourcePathsTitle" FontWeight="SemiBold" />
                                    <TextBlock x:Name="PersonalDesktopPathText" FontSize="12" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PublicDesktopPathText" FontSize="12" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2" />
                                    <TextBlock x:Name="StorageSectionTitleText" FontWeight="SemiBold" />
                                    <TextBlock x:Name="StorageSectionDescriptionText" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PathTitleText" Visibility="Collapsed" />
                                    <TextBlock x:Name="StoragePathText" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"
                                               IsTextSelectionEnabled="True"
                                               ToolTipService.ToolTip="{x:Bind StoragePathText.Text, Mode=OneWay}" />
                                    <TextBlock x:Name="StorageFreeSpaceText" FontSize="12" Visibility="Collapsed"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel x:Name="DestinationPathsPanel" Spacing="6" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <Button x:Name="OpenStorageFolderButton" Click="OpenStorageFolder_Click" />
                                        <Button x:Name="ChangePathButton" Click="ChangePathButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- Right: Clean Icon-Only Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,0,-4,0" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Height="30" Width="32" Padding="0" CornerRadius="6"
                            Background="Transparent" BorderThickness="0"
                            Click="RefreshButton_Click">
                        <Grid>
                            <FontIcon Glyph="&#xE72C;" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="RefreshButtonText" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Name="MoreButton" Height="30" Width="32" Padding="0" CornerRadius="6"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE712;" FontSize="14.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem x:Name="ResetSelectionMenuItem" Click="ResetSelectionMenuItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE777;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="OpenStorageMenuItem" Click="OpenStorageFolder_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="StorageWarningInfo" IsClosable="True" IsOpen="False" Severity="Warning" />
            <InfoBar x:Name="SelectionFeedbackInfo" IsClosable="True" IsOpen="False">
                <InfoBar.ActionButton>
                    <Button x:Name="ViewPendingButton" Click="ViewPendingButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="ResultInfo" IsClosable="True" IsOpen="False" />
            <InfoBar x:Name="RecoveryInfo" IsClosable="False" Severity="Warning" IsOpen="False">
                <InfoBar.Content>
                    <HyperlinkButton x:Name="AbandonRecoveryButton" Click="AbandonRecoveryButton_Click"
                                     VerticalAlignment="Center" Padding="0" />
                </InfoBar.Content>
                <InfoBar.ActionButton>
                    <Button x:Name="RecoverButton" Click="RecoverButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- Row 1: Main Split Workspace (Left: Adaptive Fixed-Size Boxes Grid | Right: Full-Height "Stay on Desktop" Pane) -->
        <Grid x:Name="PreviewViewport" Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <ScrollViewer
                x:Name="PreviewScrollViewer"
                Grid.Column="0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <ContentControl x:Name="PreviewContent" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12" Padding="0,0,2,4">
                        <ContentControl x:Name="TargetSelectionHost" HorizontalContentAlignment="Stretch">
                            <controls:OrganizationWrapPanel
                                x:Name="TargetRows"
                                HorizontalSpacing="12"
                                VerticalSpacing="12" />
                        </ContentControl>

                        <Border x:Name="EmptyPreviewCard" Visibility="Collapsed"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="24,28">
                            <StackPanel HorizontalAlignment="Center" Spacing="8" MaxWidth="460">
                                <FontIcon Glyph="&#xE73E;" FontSize="24" HorizontalAlignment="Center"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock x:Name="EmptyPreviewText" TextWrapping="Wrap" TextAlignment="Center"
                                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="RetainedItemsPanel" Spacing="10" Visibility="Collapsed">
                            <StackPanel x:Name="RetainedRows" Spacing="10" />
                            <Border x:Name="RetainedEmptyCard" Visibility="Collapsed">
                                <TextBlock x:Name="RetainedEmptyText" />
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="CompletedViewPanel" Spacing="12" Visibility="Collapsed">
                            <Border x:Name="CompletedHeroCard"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="18,16">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Width="38" Height="38" CornerRadius="19" VerticalAlignment="Top"
                                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <FontIcon Glyph="&#xE73E;" FontSize="16"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock x:Name="CompletedHeroTitleText" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock x:Name="CompletedHeroBodyText" FontSize="12.5" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:Name="CompletedOpenFolderButton" Click="OpenStorageFolder_Click" />
                                        <Button x:Name="CompletedUndoButton" Click="UndoButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <controls:OrganizationWrapPanel
                                x:Name="CompletedItemsPanel"
                                HorizontalSpacing="12"
                                VerticalSpacing="12" />
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </ScrollViewer>

            <!-- Right Column: Full-Height "Stay on Desktop" Pane (Aligned 38px Header) -->
            <Border
                x:Name="StayOnDesktopTrayBorder"
                Grid.Column="1"
                Width="236"
                Margin="0,0,0,4"
                VerticalAlignment="Stretch"
                CornerRadius="8"
                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                AllowDrop="True"
                DragOver="StayOnDesktopTray_DragOver"
                DragLeave="StayOnDesktopTray_DragLeave"
                Drop="StayOnDesktopTray_Drop">
                <Grid RowDefinitions="38,*">
                    <Border
                        Height="38"
                        Padding="14,0,10,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <TextBlock
                                x:Name="StayOnDesktopHeaderTitleText"
                                FontSize="13"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="StayOnDesktopTrayTitleText"
                                Grid.Column="1"
                                FontSize="12"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button
                                x:Name="RestoreAllExcludedButton"
                                Grid.Column="2"
                                FontSize="11.5"
                                Padding="6,2"
                                MinHeight="24"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Visibility="Collapsed"
                                Click="RestoreAllExcludedButton_Click" />
                            <TextBlock
                                x:Name="StayOnDesktopTrayHintText"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Padding="6,6,6,8">
                        <StackPanel Spacing="2">
                            <StackPanel x:Name="TrayItemsPanel" Spacing="2" />
                            <TextBlock x:Name="TrayEmptyHintText" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel x:Name="ScanBusyPanel" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <ProgressRing Width="30" Height="30" IsActive="True" />
                <TextBlock x:Name="ScanBusyText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Row 2: Execution Progress + Clean Single-Line Action Footer -->
        <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel x:Name="ExecutionProgressPanel" Spacing="6" Visibility="Collapsed">
                <ProgressBar x:Name="ExecutionProgressBar" Maximum="1" Minimum="0" Value="0" />
                <TextBlock x:Name="ExecutionProgressText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="0,0,12,0">
                        <FontIcon Glyph="&#xEA18;" FontSize="13.5" VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="FooterSummaryText" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="FooterSafetyHintText" FontSize="12.5" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="UndoButton" Grid.Column="1" Click="UndoButton_Click" Visibility="Collapsed" />
                    <Button x:Name="AbandonUndoButton" Grid.Column="2" Click="AbandonUndoButton_Click" Visibility="Collapsed" />
                    <Button x:Name="CancelButton" Grid.Column="3" MinWidth="84" Height="32" Click="CancelButton_Click" />
                    <Button x:Name="DoneButton" Grid.Column="3" MinWidth="88" Height="32" Click="DoneButton_Click"
                            Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
                    <Button x:Name="RetryPublicButton" Grid.Column="4" Height="32" Click="RetryPublicButton_Click"
                            Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
                    <Button x:Name="ExecuteButton" Grid.Column="4" MinWidth="128" Height="32" Click="ExecuteButton_Click"
                            IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Pointer Drag Floating Pill Overlay -->
        <Canvas
            x:Name="PointerDragOverlayCanvas"
            Grid.RowSpan="3"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border
                x:Name="PointerDragBadge"
                Padding="10,6"
                CornerRadius="6"
                Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        Glyph="&#xE8C8;"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock
                        x:Name="PointerDragBadgeText"
                        FontSize="12"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
