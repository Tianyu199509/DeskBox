                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AccentBrush="{x:Bind ViewModel.MusicAccentBrush, Mode=OneWay}"
                Visibility="Collapsed" />

            <Grid
                x:Name="RecordVinylHost"
                Grid.Row="0"
                Width="160"
                Height="160"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Tapped="ArtworkLyricsTrigger_Tapped">
                <local:MusicVinylControl
                    x:Name="RecordVinylDisc"
                    ImageSource="{Binding ThumbnailImage}" />
            </Grid>

            <!--
                Tonearm overlaid on the vinyl (rotates between play/pause around the pivot).
                Drawn in a 64x166 canvas where 1 unit = vinylSize / 200; the pivot sits at (44,22),
                just outside the platter's upper-right edge. UpdateTonearmLayout keeps size, margin
                and composition CenterPoint in sync with these coordinates.
            -->
            <Grid
                x:Name="RecordTonearm"
                Grid.Row="0"
                Width="51"
                Height="133"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Margin="115,-30,0,0">
                <Viewbox Stretch="Uniform">
                    <Canvas Width="64" Height="166">
                        <!-- Whole arm assembly tilted 6 degrees so the stylus lands mid-groove when playing -->
                        <Canvas>
                            <Canvas.RenderTransform>
                                <RotateTransform Angle="6" CenterX="44" CenterY="22" />
                            </Canvas.RenderTransform>

                            <!-- Cast shadow on the record -->
                            <Canvas Opacity="0.34">
                                <Canvas.RenderTransform>
                                    <TranslateTransform X="2.4" Y="3.2" />
                                </Canvas.RenderTransform>
                                <Rectangle Canvas.Left="42.3" Canvas.Top="24" Width="3.4" Height="108" RadiusX="1.7" RadiusY="1.7" Fill="#FF000000" />
                                <Canvas>
                                    <Canvas.RenderTransform>
                                        <RotateTransform Angle="16" CenterX="44" CenterY="130" />
                                    </Canvas.RenderTransform>
                                    <Path Fill="#FF000000" Data="M 40.2,128 L 47.8,128 L 49,135 L 49,149.5 Q 49,151 47.5,151 L 40.5,151 Q 39,151 39,149.5 L 39,135 Z" />
                                </Canvas>
                            </Canvas>

                            <!-- Counterweight stub + machined weight -->
                            <Rectangle Canvas.Left="42.9" Canvas.Top="6" Width="2.2" Height="10" Fill="#FF8D8E95" />
                            <Rectangle Canvas.Left="37.5" Canvas.Top="0" Width="13" Height="9" RadiusX="2" RadiusY="2">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#FF35363C" />
                                        <GradientStop Offset="0.28" Color="#FFB9BAC1" />
                                        <GradientStop Offset="0.42" Color="#FFF4F5F8" />
                                        <GradientStop Offset="0.7" Color="#FF85868D" />
                                        <GradientStop Offset="1" Color="#FF2A2B30" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Canvas.Left="37.5" Canvas.Top="5.6" Width="13" Height="0.7" Fill="#55000000" />

                            <!-- Chrome arm tube -->
                            <Rectangle Canvas.Left="42.4" Canvas.Top="24" Width="3.2" Height="108" RadiusX="1.6" RadiusY="1.6">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#FF55565D" />
                                        <GradientStop Offset="0.32" Color="#FFEFF0F3" />
                                        <GradientStop Offset="0.52" Color="#FFCDCED4" />
                                        <GradientStop Offset="0.8" Color="#FF8A8B92" />
                                        <GradientStop Offset="1" Color="#FF45464C" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- Headshell with offset angle, cartridge, finger lift and stylus -->
                            <Canvas>
                                <Canvas.RenderTransform>
                                    <RotateTransform Angle="16" CenterX="44" CenterY="130" />
                                </Canvas.RenderTransform>
                                <Rectangle Canvas.Left="41.6" Canvas.Top="126.5" Width="4.8" Height="5" RadiusX="1" RadiusY="1">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#FF5A5B62" />
                                            <GradientStop Offset="0.35" Color="#FFF2F3F6" />
                                            <GradientStop Offset="1" Color="#FF50515A" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Path
                                    Data="M 40.2,131.5 L 47.8,131.5 L 49,134.5 L 49,149.5 Q 49,151 47.5,151 L 40.5,151 Q 39,151 39,149.5 L 39,134.5 Z"
                                    Stroke="#3DFFFFFF"
                                    StrokeThickness="0.45">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#FF3E3F46" />
                                            <GradientStop Offset="0.4" Color="#FF2C2D33" />
                                            <GradientStop Offset="1" Color="#FF18191D" />
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                                <Rectangle Canvas.Left="40.9" Canvas.Top="139" Width="6.2" Height="11" RadiusX="0.8" RadiusY="0.8" Fill="#FF0D0E11" />
                                <Rectangle
                                    Canvas.Left="40.9"
                                    Canvas.Top="139"
                                    Width="6.2"
                                    Height="1.3"
                                    Fill="{x:Bind ViewModel.MusicAccentBrush, Mode=OneWay}" />
                                <Path
                                    Data="M 48.8,137 C 51.5,136.2 53.6,133.6 55.2,131.2"
                                    Stroke="#FFD5D6DB"
                                    StrokeThickness="1.2"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round" />
                                <Rectangle Canvas.Left="43.4" Canvas.Top="150" Width="1.2" Height="2.4" RadiusX="0.4" RadiusY="0.4" Fill="#FFB6B7BE" />
                            </Canvas>

                            <!-- Pivot: contact shadow, gunmetal base, chrome bearing, cap -->
                            <Ellipse Canvas.Left="33.6" Canvas.Top="13.4" Width="23" Height="23" Fill="#40000000" />
                            <Ellipse Canvas.Left="33" Canvas.Top="11" Width="22" Height="22" StrokeThickness="0.5">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.36,0.3" Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                                        <GradientStop Offset="0" Color="#FF4A4B53" />
                                        <GradientStop Offset="0.7" Color="#FF2A2B31" />
                                        <GradientStop Offset="1" Color="#FF1A1B1F" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0.2,0.1" EndPoint="0.8,0.9">
                                        <GradientStop Offset="0" Color="#40FFFFFF" />
                                        <GradientStop Offset="1" Color="#0AFFFFFF" />
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <Ellipse Canvas.Left="37.5" Canvas.Top="15.5" Width="13" Height="13" Stroke="#60000000" StrokeThickness="0.4">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.34,0.28" Center="0.5,0.5" RadiusX="0.62" RadiusY="0.62">
                                        <GradientStop Offset="0" Color="#FFF7F7FA" />
                                        <GradientStop Offset="0.55" Color="#FFB8B9C0" />
                                        <GradientStop Offset="1" Color="#FF6A6B72" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Canvas.Left="41.5" Canvas.Top="19.5" Width="5" Height="5" Fill="#FF2C2D33" Stroke="#50FFFFFF" StrokeThickness="0.35" />
                        </Canvas>
                    </Canvas>
                </Viewbox>
            </Grid>

            <StackPanel
                x:Name="RecordTitlePanel"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                MinWidth="0"
                Spacing="2"
                Margin="0,4,0,0">
                <Grid
                    x:Name="RecordTitleMarqueeHost"
                    HorizontalAlignment="Stretch"
                    MinWidth="0"
                    SizeChanged="TitleMarqueeHost_SizeChanged">
                    <Grid.Clip>
                        <RectangleGeometry x:Name="RecordTitleMarqueeClip" Rect="0,-12,4096,128" />
                    </Grid.Clip>
                    <TextBlock
                        x:Name="RecordTitleText"
                        MaxLines="1"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{Binding Title}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <Grid
                        x:Name="RecordTitleMarqueeCanvas"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="RecordTitleTextPrimary"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            TextTrimming="Clip"
                            TextWrapping="NoWrap" />
                    </Grid>
                    <Canvas
                        Width="0"
                        Height="0"
                        IsHitTestVisible="False"
                        Opacity="0">
                        <TextBlock
                            x:Name="RecordTitleMeasureText"
                            FontSize="16"
                            FontWeight="SemiBold"
                            helpers:WidgetTextShadow.Cast="False"
                            MaxLines="1"
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            TextTrimming="Clip"
                            TextWrapping="NoWrap" />
                    </Canvas>
                </Grid>
                <Grid
                    x:Name="RecordArtistMarqueeHost"
                    HorizontalAlignment="Stretch"
                    MinWidth="0"
                    SizeChanged="ArtistMarqueeHost_SizeChanged">
                    <Grid.Clip>
                        <RectangleGeometry x:Name="RecordArtistMarqueeClip" Rect="0,-12,4096,128" />
                    </Grid.Clip>
                    <TextBlock
                        x:Name="RecordArtistText"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        MaxLines="1"
                        MinWidth="0"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Artist}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <Grid
                        x:Name="RecordArtistMarqueeCanvas"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="RecordArtistTextPrimary"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                            TextTrimming="Clip"
                            TextWrapping="NoWrap" />
                    </Grid>
                    <Canvas
                        Width="0"
                        Height="0"
                        IsHitTestVisible="False"
                        Opacity="0">
                        <TextBlock
                            x:Name="RecordArtistMeasureText"
                            FontSize="12"
                            helpers:WidgetTextShadow.Cast="False"
                            MaxLines="1"
                            Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                            TextTrimming="Clip"
                            TextWrapping="NoWrap" />
                    </Canvas>
                </Grid>
            </StackPanel>

            <Grid
                x:Name="RecordLyricRow"
                Grid.Row="2"
                MinHeight="20"
                Padding="4,1"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                PointerEntered="InlineLyricRow_PointerEntered"
                PointerExited="InlineLyricRow_PointerExited"
                Tapped="ArtworkLyricsTrigger_Tapped"
                Visibility="{x:Bind ViewModel.InlineLyricVisibility, Mode=OneWay}">
                <Border
                    Margin="-2,-1,-2,-1"
                    Background="{ThemeResource MusicInlineLyricHoverBrush}"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Tag="HoverPill" />
                <Grid
                    x:Name="RecordLyricMarqueeHost"
                    MinWidth="0"
                    HorizontalAlignment="Stretch"
                    Opacity="{x:Bind ViewModel.SubtitleOpacity, Mode=OneWay}"
                    SizeChanged="LyricMarqueeHost_SizeChanged"
                    ToolTipService.ToolTip="{x:Bind ViewModel.InlineLyricTooltip, Mode=OneWay}">
                    <Grid.Clip>
                        <RectangleGeometry x:Name="RecordLyricMarqueeClip" Rect="0,-12,4096,128" />
                    </Grid.Clip>
                    <TextBlock
                        x:Name="RecordLyricText"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        FontSize="{x:Bind ViewModel.ControlsSecondaryTextSize, Mode=OneWay}"
                        FontWeight="Normal"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        MaxLines="1"
                        MinWidth="0"
                        Text="{x:Bind ViewModel.InlineLyricText, Mode=OneWay}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <Grid
                        x:Name="RecordLyricMarqueeCanvas"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="RecordLyricTextPrimary"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="{x:Bind ViewModel.ControlsSecondaryTextSize, Mode=OneWay}"
                            FontWeight="Normal"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            MaxLines="1"
                            Text="{x:Bind ViewModel.InlineLyricText, Mode=OneWay}"
                            TextTrimming="Clip"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            x:Name="RecordLyricTextClone"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="{x:Bind ViewModel.ControlsSecondaryTextSize, Mode=OneWay}"
                            FontWeight="Normal"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            MaxLines="1"
                            Text="{x:Bind ViewModel.InlineLyricText, Mode=OneWay}"
                            TextTrimming="Clip"
                            TextWrapping="NoWrap" />
                    </Grid>
                    <Canvas
                        Width="0"
                        Height="0"
                        IsHitTestVisible="False"
                        Opacity="0">
                        <TextBlock
                            x:Name="RecordLyricMeasureText"
                            FontSize="{x:Bind ViewModel.ControlsSecondaryTextSize, Mode=OneWay}"
                            FontWeight="Normal"
                            helpers:WidgetTextShadow.Cast="False"
                            MaxLines="1"
                            Text="{x:Bind ViewModel.InlineLyricText, Mode=OneWay}"
                            TextTrimming="Clip"
                            TextWrapping="NoWrap" />
                    </Canvas>
                </Grid>
            </Grid>

            <Grid
                x:Name="RecordProgressRow"
                Grid.Row="3"
                Margin="0,2,0,0"
                HorizontalAlignment="Stretch"
                MaxWidth="420"
                ColumnSpacing="6"
                Visibility="{Binding TimelineRowVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="30" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Typography.NumeralAlignment="Tabular"
                    FontSize="{x:Bind ViewModel.CaptionTextSize, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{Binding PositionText}" />
                <Grid
                    x:Name="RecordProgressHost"
                    Grid.Column="1"
                    Height="24"
                    MinWidth="80"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    PointerEntered="ProgressHost_PointerEntered"
                    PointerExited="ProgressHost_PointerExited"
                    PointerMoved="ProgressHost_PointerMoved"
                    PointerPressed="ProgressHost_PointerPressed"
                    PointerReleased="ProgressHost_PointerReleased">
                    <Border
                        x:Name="RecordProgressTrack"
                        Height="4"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                        CornerRadius="2"
                        Opacity="0.34" />
                    <Border
                        x:Name="RecordProgressFill"
                        Height="4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="{Binding MusicAccentBrush}"
                        CornerRadius="2"
                        RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="RecordProgressFillScale" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                    <Border
                        x:Name="RecordProgressThumb"
                        Width="10"
                        Height="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{x:Bind ViewModel.MusicAccentBrush, Mode=OneWay}"
                        BorderBrush="#E6FFFFFF"
                        BorderThickness="1.5"
                        CornerRadius="3.5"
                        IsHitTestVisible="False"
                        Opacity="0"
                        Translation="-5,0,0" />
                </Grid>
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Typography.NumeralAlignment="Tabular"
                    FontSize="{x:Bind ViewModel.CaptionTextSize, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{Binding DurationText}"
                    TextAlignment="Right" />
            </Grid>

            <local:MusicSpectrumControl
                x:Name="RecordSpectrumBar"
                Grid.Row="0"
                Grid.RowSpan="5"
                Margin="-2,0,-2,-8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                AccentBrush="{x:Bind ViewModel.MusicAccentBrush, Mode=OneWay}"
                Visibility="Collapsed" />

            <StackPanel
                x:Name="RecordControlsPanel"
                Grid.Row="4"
                Margin="0,3,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Button AutomationProperties.Name="{Binding PlaybackModeTooltip}"
                    x:Name="RecordPlaybackModeButton"
                    VerticalAlignment="Center"
                    Click="PlaybackModeButton_Click"
                    IsEnabled="{Binding CanChangePlaybackMode}"
                    Opacity="{Binding PlaybackModeOpacity}"
                    Style="{StaticResource MusicIconButtonStyle}"
                    ToolTipService.ToolTip="{Binding PlaybackModeTooltip}">
                    <FontIcon
                        Glyph="{Binding PlaybackModeGlyph}"
                        Style="{StaticResource MusicSecondaryFontIconStyle}" />
                </Button>
                <Button AutomationProperties.Name="{Binding PreviousTooltip}"
                    x:Name="RecordPreviousButton"
                    VerticalAlignment="Center"
                    Click="PreviousButton_Click"
                    IsEnabled="{Binding CanGoPrevious}"
                    Style="{StaticResource MusicIconButtonStyle}"
                    ToolTipService.ToolTip="{Binding PreviousTooltip}">
                    <local:MusicTransportIcon
                        FontSize="14.5"
                        Foreground="{x:Bind RecordPreviousButton.Foreground, Mode=OneWay}"
                        Kind="Previous" />
                </Button>
                <Button AutomationProperties.Name="{Binding PlayPauseTooltip}"
                    x:Name="RecordPlayPauseButton"
                    VerticalAlignment="Center"
                    Click="PlayPauseButton_Click"
                    IsEnabled="{Binding CanPlayPause}"
                    Style="{StaticResource MusicPrimaryTransportButtonStyle}"
                    ToolTipService.ToolTip="{Binding PlayPauseTooltip}">
                    <Grid>
                        <local:MusicTransportIcon
                            FontSize="16.5"
                            Foreground="{x:Bind RecordPlayPauseButton.Foreground, Mode=OneWay}"
                            Kind="Play"
                            Visibility="{Binding PlayIconVisibility}" />
                        <local:MusicTransportIcon
                            FontSize="16.5"
                            Foreground="{x:Bind RecordPlayPauseButton.Foreground, Mode=OneWay}"
                            Kind="Pause"
                            Visibility="{Binding PauseIconVisibility}" />
                    </Grid>
                </Button>
                <Button AutomationProperties.Name="{Binding NextTooltip}"
                    x:Name="RecordNextButton"
                    VerticalAlignment="Center"
                    Click="NextButton_Click"
                    IsEnabled="{Binding CanGoNext}"
                    Style="{StaticResource MusicIconButtonStyle}"
                    ToolTipService.ToolTip="{Binding NextTooltip}">
                    <local:MusicTransportIcon
                        FontSize="14.5"
                        Foreground="{x:Bind RecordNextButton.Foreground, Mode=OneWay}"
                        Kind="Next" />
                </Button>
                <Button AutomationProperties.Name="{Binding VolumeTooltip}"
                    x:Name="RecordVolumeButton"
                    VerticalAlignment="Center"
                    Click="VolumeButton_Click"
                    Style="{StaticResource MusicIconButtonStyle}"
                    ToolTipService.ToolTip="{Binding VolumeTooltip}">
                    <FontIcon
                        Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}"
                        Style="{StaticResource MusicSecondaryFontIconStyle}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Record mode: Horizontal - vinyl left, info right. -->
        <Grid
            x:Name="RecordHorizontalLayout" x:Load="{x:Bind IsRecordHorizontalLayoutLoaded}" Loaded="PlayerSubtree_Loaded"
            Padding="12"
            ColumnSpacing="14"
            VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <local:MusicSpectrumControl
                x:Name="RecordHorizontalVinylHalo"
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AccentBrush="{x:Bind ViewModel.MusicAccentBrush, Mode=OneWay}"
                Visibility="Collapsed" />

            <Grid
                x:Name="RecordHorizontalVinylHost"
                Grid.Column="0"
                Width="110"
                Height="110"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Tapped="ArtworkLyricsTrigger_Tapped">
                <local:MusicVinylControl
                    x:Name="RecordHorizontalVinylDisc"
                    ImageSource="{Binding ThumbnailImage}" />
            </Grid>

            <local:MusicSpectrumControl
                x:Name="RecordHorizontalSpectrumBar"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="-2,0,-2,-8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                AccentBrush="{x:Bind ViewModel.MusicAccentBrush, Mode=OneWay}"
                Visibility="Collapsed" />

            <Grid x:Name="RecordHorizontalRightPanel" Grid.Column="1" MinWidth="0" RowSpacing="4" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" MinWidth="0" Spacing="2">
                    <Grid
                        x:Name="RecordHorizontalTitleMarqueeHost"
                        MinWidth="0"
                        SizeChanged="TitleMarqueeHost_SizeChanged">
                        <Grid.Clip>
                            <RectangleGeometry x:Name="RecordHorizontalTitleMarqueeClip" Rect="0,-12,4096,128" />
                        </Grid.Clip>
                        <TextBlock
                            x:Name="RecordHorizontalTitleText"
                            MaxLines="1"
                            MinWidth="0"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <Grid
                            x:Name="RecordHorizontalTitleMarqueeCanvas"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="RecordHorizontalTitleTextPrimary"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                TextTrimming="Clip"
                                TextWrapping="NoWrap" />
                        </Grid>
                        <Canvas
                            Width="0"
                            Height="0"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <TextBlock
                                x:Name="RecordHorizontalTitleMeasureText"
                                FontSize="15"
                                FontWeight="SemiBold"
                                helpers:WidgetTextShadow.Cast="False"
                                MaxLines="1"
                                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                TextTrimming="Clip"
                                TextWrapping="NoWrap" />
                        </Canvas>
                    </Grid>
                    <Grid ColumnSpacing="6" MinWidth="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            x:Name="RecordHorizontalArtistMarqueeHost"
                            Grid.Column="0"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            SizeChanged="ArtistMarqueeHost_SizeChanged">
                            <Grid.Clip>
                                <RectangleGeometry x:Name="RecordHorizontalArtistMarqueeClip" Rect="0,-12,4096,128" />
                            </Grid.Clip>
                            <TextBlock
                                x:Name="RecordHorizontalArtistText"
                                VerticalAlignment="Center"
                                MaxLines="1"
                                MinWidth="0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding Artist}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <Grid
                                x:Name="RecordHorizontalArtistMarqueeCanvas"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="RecordHorizontalArtistTextPrimary"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                                    TextTrimming="Clip"
                                    TextWrapping="NoWrap" />
                            </Grid>
                            <Canvas
                                Width="0"
                                Height="0"
                                IsHitTestVisible="False"
                                Opacity="0">
                                <TextBlock
                                    x:Name="RecordHorizontalArtistMeasureText"
                                    FontSize="12"
                                    helpers:WidgetTextShadow.Cast="False"
                                    MaxLines="1"
                                    Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                                    TextTrimming="Clip"
                                    TextWrapping="NoWrap" />
                            </Canvas>
                        </Grid>
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Button
                                x:Name="RecordHorizontalSourceButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="SourceButton_Click"
                                Style="{StaticResource MusicSourcePillButtonStyle}">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                                    <Grid Width="14" Height="14">
                                        <Image
                                            Width="14"
                                            Height="14"
                                            Source="{x:Bind ViewModel.SourceAppIcon, Mode=OneWay}"
                                            Stretch="Uniform"
                                            Visibility="{x:Bind ViewModel.SourceAppIconVisibility, Mode=OneWay}" />
                                        <local:MusicSourceIcon
                                            Width="13"
                                            Height="13"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Visibility="{x:Bind ViewModel.SourceFallbackIconVisibility, Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="RecordHorizontalSourceButtonText"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        FontWeight="Medium"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        MaxLines="1"
                                        Text="{x:Bind ViewModel.SourceBadgeText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind ViewModel.SourceBadgeTextVisibility, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <Grid
                    x:Name="RecordHorizontalLyricRow"
                    Grid.Row="1"
                    MinHeight="19"
                    MinWidth="0"
                    Padding="0,1"
                    Background="Transparent"
                    PointerEntered="InlineLyricRow_PointerEntered"
                    PointerExited="InlineLyricRow_PointerExited"
                    Tapped="ArtworkLyricsTrigger_Tapped"
                    Visibility="{x:Bind ViewModel.InlineLyricVisibility, Mode=OneWay}">
                    <Border
                        Margin="-4,-1,-4,-1"
                        Background="{ThemeResource MusicInlineLyricHoverBrush}"
                        CornerRadius="4"
                        IsHitTestVisible="False"
                        Opacity="0"
                        Tag="HoverPill" />
                    <Grid
                        x:Name="RecordHorizontalLyricMarqueeHost"
                        MinWidth="0"
                        Opacity="{x:Bind ViewModel.SubtitleOpacity, Mode=OneWay}"
                        SizeChanged="LyricMarqueeHost_SizeChanged"
                        ToolTipService.ToolTip="{x:Bind ViewModel.InlineLyricTooltip, Mode=OneWay}">
                        <Grid.Clip>
                            <RectangleGeometry x:Name="RecordHorizontalLyricMarqueeClip" Rect="0,-12,4096,128" />
                        </Grid.Clip>
                        <TextBlock
                            x:Name="RecordHorizontalLyricText"
                            VerticalAlignment="Center"
                            FontSize="{x:Bind ViewModel.ControlsSecondaryTextSize, Mode=OneWay}"
                            FontWeight="Normal"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            MaxLines="1"
                            MinWidth="0"
                            Text="{x:Bind ViewModel.InlineLyricText, Mode=OneWay}"
                            TextAlignment="Left"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <Grid
                            x:Name="RecordHorizontalLyricMarqueeCanvas"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="RecordHorizontalLyricTextPrimary"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="{x:Bind ViewModel.ControlsSecondaryTextSize, Mode=OneWay}"
                                FontWeight="Normal"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                MaxLines="1"
                                Text="{x:Bind ViewModel.InlineLyricText, Mode=OneWay}"
                                TextTrimming="Clip"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                x:Name="RecordHorizontalLyricTextClone"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="{x:Bind ViewModel.ControlsSecondaryTextSize, Mode=OneWay}"
                                FontWeight="Normal"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                MaxLines="1"
                                Text="{x:Bind ViewModel.InlineLyricText, Mode=OneWay}"
                                TextTrimming="Clip"
                                TextWrapping="NoWrap" />
                        </Grid>
                        <Canvas
                            Width="0"
                            Height="0"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <TextBlock
                                x:Name="RecordHorizontalLyricMeasureText"
                                FontSize="{x:Bind ViewModel.ControlsSecondaryTextSize, Mode=OneWay}"
                                FontWeight="Normal"
                                helpers:WidgetTextShadow.Cast="False"
                                MaxLines="1"
                                Text="{x:Bind ViewModel.InlineLyricText, Mode=OneWay}"
                                TextTrimming="Clip"
                                TextWrapping="NoWrap" />
                        </Canvas>
                    </Grid>
                </Grid>
                <Grid
                    Grid.Row="2"
                    Margin="0,2,0,0"
                    ColumnSpacing="6"
                    Visibility="{Binding TimelineRowVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Typography.NumeralAlignment="Tabular"
                        FontSize="{x:Bind ViewModel.CaptionTextSize, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{Binding PositionText}" />
                    <Grid
                        x:Name="RecordHorizontalProgressHost"
                        Grid.Column="1"
                        Height="24"
                        MinWidth="60"
                        Background="Transparent"
                        VerticalAlignment="Center"
                        PointerEntered="ProgressHost_PointerEntered"
                        PointerExited="ProgressHost_PointerExited"
                        PointerMoved="ProgressHost_PointerMoved"
                        PointerPressed="ProgressHost_PointerPressed"
                        PointerReleased="ProgressHost_PointerReleased">
                        <Border
                            x:Name="RecordHorizontalProgressTrack"
                            Height="4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                            CornerRadius="2"
                            Opacity="0.34" />
                        <Border
                            x:Name="RecordHorizontalProgressFill"
                            Height="4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="{Binding MusicAccentBrush}"
                            CornerRadius="2"
                            RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="RecordHorizontalProgressFillScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                        <Border
                            x:Name="RecordHorizontalProgressThumb"
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{x:Bind ViewModel.MusicAccentBrush, Mode=OneWay}"
                            BorderBrush="#E6FFFFFF"
                            BorderThickness="1.5"
                            CornerRadius="3.5"
                            IsHitTestVisible="False"
                            Opacity="0"
                            Translation="-5,0,0" />
                    </Grid>
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Typography.NumeralAlignment="Tabular"
                        FontSize="{x:Bind ViewModel.CaptionTextSize, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{Binding DurationText}"
                        TextAlignment="Right" />
                </Grid>
                <StackPanel
                    x:Name="RecordHorizontalControlsPanel"
                    Grid.Row="3"
                    Margin="0,2,0,0"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button AutomationProperties.Name="{Binding PlaybackModeTooltip}"
                        x:Name="RecordHorizontalPlaybackModeButton"
                        VerticalAlignment="Center"
                        Click="PlaybackModeButton_Click"
                        IsEnabled="{Binding CanChangePlaybackMode}"
                        Opacity="{Binding PlaybackModeOpacity}"
                        Style="{StaticResource MusicIconButtonStyle}"
                        ToolTipService.ToolTip="{Binding PlaybackModeTooltip}">
                        <FontIcon
                            Glyph="{Binding PlaybackModeGlyph}"
                            Style="{StaticResource MusicSecondaryFontIconStyle}" />
                    </Button>
                    <Button AutomationProperties.Name="{Binding PreviousTooltip}"
                        x:Name="RecordHorizontalPreviousButton"
                        VerticalAlignment="Center"
                        Click="PreviousButton_Click"
                        IsEnabled="{Binding CanGoPrevious}"
                        Style="{StaticResource MusicIconButtonStyle}"
                        ToolTipService.ToolTip="{Binding PreviousTooltip}">
                        <local:MusicTransportIcon
                            FontSize="14.5"
                            Foreground="{x:Bind RecordHorizontalPreviousButton.Foreground, Mode=OneWay}"
                            Kind="Previous" />
                    </Button>
                    <Button AutomationProperties.Name="{Binding PlayPauseTooltip}"
                        x:Name="RecordHorizontalPlayPauseButton"
                        VerticalAlignment="Center"
                        Click="PlayPauseButton_Click"
                        IsEnabled="{Binding CanPlayPause}"
                        Style="{StaticResource MusicPrimaryTransportButtonStyle}"
                        ToolTipService.ToolTip="{Binding PlayPauseTooltip}">
                        <Grid>
                            <local:MusicTransportIcon
                                FontSize="16.5"
                                Foreground="{x:Bind RecordHorizontalPlayPauseButton.Foreground, Mode=OneWay}"
                                Kind="Play"
                                Visibility="{Binding PlayIconVisibility}" />
                            <local:MusicTransportIcon
                                FontSize="16.5"
                                Foreground="{x:Bind RecordHorizontalPlayPauseButton.Foreground, Mode=OneWay}"
                                Kind="Pause"
                                Visibility="{Binding PauseIconVisibility}" />
                        </Grid>
                    </Button>
                    <Button AutomationProperties.Name="{Binding NextTooltip}"
                        x:Name="RecordHorizontalNextButton"
                        VerticalAlignment="Center"
                        Click="NextButton_Click"
                        IsEnabled="{Binding CanGoNext}"
                        Style="{StaticResource MusicIconButtonStyle}"
                        ToolTipService.ToolTip="{Binding NextTooltip}">
                        <local:MusicTransportIcon
                            FontSize="14.5"
                            Foreground="{x:Bind RecordHorizontalNextButton.Foreground, Mode=OneWay}"
                            Kind="Next" />
                    </Button>
                    <Button AutomationProperties.Name="{Binding VolumeTooltip}"
                        x:Name="RecordHorizontalVolumeButton"
                        VerticalAlignment="Center"
                        Click="VolumeButton_Click"
                        Style="{StaticResource MusicIconButtonStyle}"
                        ToolTipService.ToolTip="{Binding VolumeTooltip}">
                        <FontIcon
                            Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}"
                            Style="{StaticResource MusicSecondaryFontIconStyle}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Frosted glass synchronized lyrics mode over album artwork & widget material -->
        <Grid
            x:Name="LyricsOverlayPanel" x:Load="{x:Bind IsLyricsOverlayLoaded}" Loaded="LyricsOverlayPanel_Loaded"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            Tapped="LyricsOverlayPanel_Tapped">
            <Grid
                x:Name="LyricsOverlayClipHost"
                CornerRadius="{StaticResource WidgetCornerRadiusLarge}">
                <Image
                    x:Name="LyricsOverlayBackdropImage"
                    IsHitTestVisible="False"
                    Opacity="0.72"
                    RenderTransformOrigin="0.5,0.5"
                    Source="{x:Bind ViewModel.ThumbnailImage, Mode=OneWay}"
                    Stretch="UniformToFill"
                    Visibility="{x:Bind ViewModel.ThumbnailVisibility, Mode=OneWay}">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="1.08" ScaleY="1.08" />
                    </Image.RenderTransform>
                </Image>
                <Border
                    x:Name="LyricsOverlayAmbientWash"
                    Background="{x:Bind ViewModel.LyricsAmbientWashBrush, Mode=OneWay}"
                    IsHitTestVisible="False" />
                <Border
                    x:Name="LyricsOverlayFrostLayer"
                    Background="{ThemeResource MusicLyricsCoverContrastBrush}"
                    IsHitTestVisible="False"
                    Opacity="0.94" />

                <ListView
                    x:Name="LyricsListView" ContainerContentChanging="LyricsListView_ContainerContentChanging"
                    Padding="18,44,18,44"
                    IsItemClickEnabled="False"
                    ItemContainerStyle="{StaticResource MusicLyricsItemContainerStyle}"
                    ItemsSource="{x:Bind ViewModel.LyricLines, Mode=OneWay}"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.LyricsListVisibility, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="lyrics:LrcLine">
                            <Grid
                                Background="Transparent"
                                DoubleTapped="LyricLineItem_DoubleTapped"
                                IsDoubleTapEnabled="True">
                                <StackPanel
                                    HorizontalAlignment="Stretch"
                                    Spacing="3">
                                    <TextBlock
                                        FontSize="15.5"
                                        helpers:WidgetTextShadow.Cast="True"
                                        Text="{x:Bind PrimaryText}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        helpers:WidgetTextShadow.Cast="True"
                                        Opacity="0.88"
                                        Text="{x:Bind SecondaryText}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind HasSecondaryText}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border
                    Height="26"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="{ThemeResource MusicLyricsEdgeFadeTopBrush}"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind ViewModel.LyricsListVisibility, Mode=OneWay}" />
                <Border
                    Height="26"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource MusicLyricsEdgeFadeBottomBrush}"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind ViewModel.LyricsListVisibility, Mode=OneWay}" />

                <TextBlock
                    Margin="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Medium"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.LyricsPlaceholderText, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.LyricsPlaceholderVisibility, Mode=OneWay}" />
            </Grid>
        </Grid>

        <Border
            x:Name="InlineVolumePanel" x:Load="{x:Bind IsInlineVolumeLoaded}" Loaded="InlineVolumePanel_Loaded"
            Visibility="Collapsed"
            Width="238"
            Padding="10,8"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{ThemeResource MusicVolumeBubbleAcrylicBrush}"
            BorderBrush="{ThemeResource MusicVolumeBubbleStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource WidgetCornerRadiusLarge}"
            PointerPressed="InlineVolumePanel_PointerPressed"
            PointerWheelChanged="InlineVolumePanel_PointerWheelChanged">
            <StackPanel Spacing="4">
                <Grid
                    ColumnSpacing="8"
                    MinHeight="32"
                    Visibility="{x:Bind ViewModel.SessionVolumeRowVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="26" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="InlineSessionMuteButton"
                        AutomationProperties.Name="{x:Bind ViewModel.SessionVolumeLabel, Mode=OneWay}"
                        Grid.Column="0"
                        Width="28"
                        Height="28"
                        MinWidth="28"
                        MinHeight="28"
                        VerticalAlignment="Center"
                        Click="SessionMuteButton_Click"
                        Style="{StaticResource MusicIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SessionVolumeLabel, Mode=OneWay}">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind ViewModel.SessionVolumeGlyph, Mode=OneWay}" />
                    </Button>

                    <Slider
                        x:Name="InlineSessionVolumeSlider"
                        AutomationProperties.Name="{x:Bind ViewModel.SessionVolumeLabel, Mode=OneWay}"
                        Grid.Column="1"
                        MinHeight="32"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        IsThumbToolTipEnabled="False"
                        LargeChange="0.1"
                        Maximum="1"
                        Minimum="0"
                        Orientation="Horizontal"
                        SmallChange="0.01"
                        StepFrequency="0.01"
                        ValueChanged="InlineSessionVolumeSlider_ValueChanged" />

                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Typography.NumeralAlignment="Tabular"
                        FontSize="{x:Bind ViewModel.VolumeTextSize, Mode=OneWay}"
                        FontWeight="Medium"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SessionVolumeText, Mode=OneWay}"
                        TextAlignment="Right" />
                </Grid>

                <Grid
                    ColumnSpacing="8"
                    MinHeight="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="26" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="InlineSystemMuteButton"
                        AutomationProperties.Name="{x:Bind ViewModel.SystemVolumeLabel, Mode=OneWay}"
                        Grid.Column="0"
                        Width="28"
                        Height="28"
                        MinWidth="28"
                        MinHeight="28"
                        VerticalAlignment="Center"
                        Click="SystemMuteButton_Click"
                        Style="{StaticResource MusicIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SystemVolumeLabel, Mode=OneWay}">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" />
                    </Button>

                    <Slider
                        x:Name="InlineSystemVolumeSlider"
                        AutomationProperties.Name="{Binding SystemVolumeLabel}"
                        Grid.Column="1"
                        MinHeight="32"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        IsThumbToolTipEnabled="False"
                        LargeChange="0.1"
                        Maximum="1"
                        Minimum="0"
                        Orientation="Horizontal"
                        SmallChange="0.01"
                        StepFrequency="0.01"
                        ValueChanged="InlineSystemVolumeSlider_ValueChanged" />

                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Typography.NumeralAlignment="Tabular"
                        FontSize="{Binding VolumeTextSize}"
                        FontWeight="Medium"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding SystemVolumeText}"
                        TextAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <Border
            x:Name="MediaServiceUnavailableBanner"
            Margin="10"
            Padding="10,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource MusicVolumeBubbleAcrylicBrush}"
            BorderBrush="{ThemeResource MusicVolumeBubbleStrokeBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="{x:Bind ViewModel.MediaServiceUnavailableVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE7BA;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    MaxLines="1"
                    Text="{x:Bind ViewModel.MediaServiceUnavailableText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <Button
                    x:Name="MediaServiceRetryButton"
                    Grid.Column="2"
                    MinHeight="24"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.RetryMediaServiceConnectionCommand, Mode=OneWay}"
                    Content="{x:Bind ViewModel.RetryMediaServiceText, Mode=OneWay}"
                    CornerRadius="6"
                    FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
