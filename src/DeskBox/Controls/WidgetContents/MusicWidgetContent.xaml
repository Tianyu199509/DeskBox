                                MinWidth="0"
                                Text="{Binding Title}"
                                TextAlignment="Left"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <Grid
                                x:Name="MinimalTitleMarqueeCanvas"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="MinimalTitleTextPrimary"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="{Binding MinimalTitleTextSize}"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    MaxLines="1"
                                    Text="{Binding Title}"
                                    TextTrimming="Clip"
                                    TextWrapping="NoWrap" />
