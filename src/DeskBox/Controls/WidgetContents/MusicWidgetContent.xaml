                            TextWrapping="NoWrap" />
                        <Grid
                            x:Name="TitleMarqueeCanvas"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="TitleTextPrimary"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="{x:Bind ViewModel.ControlsTitleTextSize, Mode=OneWay}"
