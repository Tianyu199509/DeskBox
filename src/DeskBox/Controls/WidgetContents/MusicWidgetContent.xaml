                                    x:Name="MinimalTitleTextClone"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="{Binding MinimalTitleTextSize}"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    MaxLines="1"
                                    Text="{Binding Title}"
                                    TextTrimming="Clip"
                                    TextWrapping="NoWrap" />
