                                Width="14"
                                Height="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind ViewModel.SourceFallbackIconVisibility, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            x:Name="ControlsSourceButtonText"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
