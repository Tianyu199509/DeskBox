<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetContents.QuickCaptureSurfaceContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeskBox.Controls"
    xmlns:viewModels="using:DeskBox.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <x:Double x:Key="QuickCaptureDetailActionIconSize">13</x:Double>

        <Style x:Key="QuickCaptureSharedDetailIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource WidgetCornerRadiusSmall}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="QuickCaptureSharedMaterialButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource WidgetCornerRadiusSmall}" />
        </Style>
        <Style x:Key="QuickCaptureSharedAttachmentActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource WidgetCornerRadiusSmall}" />
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="ResponsiveContentGrid"
        AllowDrop="True"
        DragOver="Root_DragOver"
        Drop="Root_Drop"
        Padding="{Binding RootPadding}"
        SizeChanged="ResponsiveContentGrid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MasterColumn" Width="*" />
            <ColumnDefinition x:Name="SplitterColumn" Width="0" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="ListPage" Grid.Column="0" RowSpacing="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <toolkit:Segmented
                    x:Name="QuickCaptureViewSegmented"
                    Grid.Column="0"
                    MinWidth="96"
                    MinHeight="{Binding SegmentHeight}"
                    FontSize="{Binding SegmentTextSize}"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="QuickCaptureViewSegmented_SelectionChanged"
                    SizeChanged="QuickCaptureViewSegmented_SizeChanged"
                    Visibility="Collapsed">
                    <toolkit:SegmentedItem AllowDrop="True" DragOver="QuickCaptureTab_DragOver" Drop="QuickCaptureTab_Drop" Tag="Records" Visibility="{Binding RecordsTabVisibility}">
                        <TextBlock FontSize="{Binding SegmentTextSize}" MaxLines="1" Text="{Binding RecordsTabText}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </toolkit:SegmentedItem>
                    <toolkit:SegmentedItem AllowDrop="True" DragOver="QuickCaptureTab_DragOver" Drop="QuickCaptureTab_Drop" Tag="Pinned" Visibility="{Binding PinnedTabVisibility}">
                        <TextBlock FontSize="{Binding SegmentTextSize}" MaxLines="1" Text="{Binding PinnedTabText}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </toolkit:SegmentedItem>
                    <toolkit:SegmentedItem Tag="Recent" Visibility="{Binding RecentTabVisibility}">
                        <TextBlock FontSize="{Binding SegmentTextSize}" MaxLines="1" Text="{Binding RecentTabText}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </toolkit:SegmentedItem>
                </toolkit:Segmented>
                <Button
                    x:Name="SearchButton"
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    MinWidth="24"
                    AutomationProperties.Name="{Binding SearchPlaceholderText}"
                    Click="SearchButton_Click"
                    Style="{StaticResource WidgetCompactIconButtonStyle}"
                    ToolTipService.ToolTip="{Binding SearchPlaceholderText}"
                    Visibility="{Binding SearchButtonVisibility}">
                    <FontIcon FontSize="12" Glyph="&#xE721;" />
                </Button>
                <TextBox
                    x:Name="SearchTextBox"
                    Grid.Column="0"
                    MinHeight="{Binding InputHeight}"
                    Padding="{Binding InputPadding}"
                    AutomationProperties.Name="{Binding SearchPlaceholderText}"
                    FontSize="{Binding TextSize}"
                    KeyDown="SearchTextBox_KeyDown"
                    PlaceholderText="{Binding SearchPlaceholderText}"
                    Style="{StaticResource WidgetSearchTextBoxStyle}"
                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{Binding SearchBoxVisibility}" />
                <Button
                    x:Name="CloseSearchButton"
                    Grid.Column="1"
                    MinWidth="0"
                    MinHeight="{Binding InputHeight}"
                    Padding="8,0"
                    AutomationProperties.Name="{Binding CloseSearchText}"
                    Click="CloseSearchButton_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="{Binding CloseSearchText}"
                    Visibility="{Binding SearchBoxVisibility}">
                    <TextBlock FontSize="{Binding SecondaryTextSize}" Text="{Binding SearchCancelText}" />
                </Button>
            </Grid>

            <Button
                Grid.Row="1"
                MinHeight="42"
                Padding="8,5"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="Transparent"
                BorderThickness="0"
                Click="AddNoteCardButton_Click"
                CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
                Visibility="{Binding InputAreaVisibility}">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon HorizontalAlignment="Center" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE710;" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{Binding TextSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding AddNoteText}" />
                </Grid>
            </Button>

            <Grid Grid.Row="2">
                <ListView
                    x:Name="ItemsList"
                    AllowDrop="True"
                    Background="Transparent"
                    CanDragItems="True"
                    CanReorderItems="False"
                    DragItemsCompleted="ItemsList_DragItemsCompleted"
                    DragItemsStarting="ItemsList_DragItemsStarting"
                    IsItemClickEnabled="True"
                    ItemClick="ItemsList_ItemClick"
                    ItemsSource="{Binding VisibleItemsSource}"
                    KeyDown="ItemsList_KeyDown"
                    SelectionMode="Extended"
                    Visibility="{Binding ListVisibility}">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="QuickCaptureSurfaceItemRoot"
                                AllowDrop="True"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
                                DataContextChanged="QuickCaptureItem_DataContextChanged"
                                DragLeave="QuickCaptureItem_DragLeave"
                                DragOver="QuickCaptureItem_DragOver"
                                Drop="QuickCaptureItem_Drop"
                                Loaded="QuickCaptureItem_Loaded"
                                Margin="0,2"
                                PointerEntered="QuickCaptureItem_PointerEntered"
                                PointerExited="QuickCaptureItem_PointerExited"
                                PointerPressed="QuickCaptureItem_PointerPressed"
                                PointerReleased="QuickCaptureItem_PointerReleased"
                                RightTapped="QuickCaptureItem_RightTapped">
                                <Grid MinHeight="50" Padding="8,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl
                                        Grid.Column="0"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Content="{Binding PrimaryImageAttachment}"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding ListImagePreviewVisibility}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate x:DataType="viewModels:TodoAttachmentViewModel">
                                                <Border
                                                    Width="64"
                                                    Height="48"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
                                                    DataContextChanged="QuickCaptureAttachmentPreview_DataContextChanged"
                                                    Loaded="QuickCaptureAttachmentPreview_Loaded">
                                                    <Grid>
                                                        <FontIcon
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Glyph="&#xEB9F;"
                                                            Visibility="{x:Bind FileIconVisibility, Mode=OneWay}" />
                                                        <Image
                                                            AutomationProperties.AccessibilityView="Raw"
                                                            Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                            Stretch="Uniform"
                                                            Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                    <StackPanel
                                        Grid.Column="1"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock
                                            FontSize="{Binding TextSize}"
                                            MaxLines="{Binding ElementName=ItemsList, Path=DataContext.ItemPreviewLineCount}"
                                            Text="{Binding DisplayText}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding TextPreviewVisibility}" />
                                        <TextBlock
                                            FontSize="{Binding SecondaryTextSize}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding CreatedAtText}"
                                            Visibility="{Binding ElementName=ItemsList, Path=DataContext.CreatedTimeVisibility}" />
                                    </StackPanel>
                                    <Border
                                        Grid.ColumnSpan="2"
                                        x:Name="QuickCaptureItemActionButtons"
                                        Padding="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource WidgetOverlaySurfaceBrush}"
                                        CornerRadius="4"
                                        IsHitTestVisible="False"
                                        Opacity="0"
                                        Canvas.ZIndex="2">
                                        <StackPanel Orientation="Horizontal" Spacing="1">
                                            <Button
                                                x:Name="QuickCaptureCopyItemButton"
                                                Width="26"
                                                Height="26"
                                                MinWidth="26"
                                                MinHeight="26"
                                                AutomationProperties.Name="{Binding ElementName=ItemsList, Path=DataContext.DetailCopyText}"
                                                Click="CopyItemButton_Click"
                                                IsTabStop="False"
                                                Style="{StaticResource WidgetCompactIconButtonStyle}"
                                                Tag="{Binding}"
                                                ToolTipService.ToolTip="{Binding ElementName=ItemsList, Path=DataContext.DetailCopyText}">
                                                <FontIcon FontSize="11" Glyph="&#xE8C8;" Opacity="0.82" />
                                            </Button>
                                            <Button
                                                x:Name="QuickCapturePinItemButton"
                                                Width="26"
                                                Height="26"
                                                MinWidth="26"
                                                MinHeight="26"
                                                AutomationProperties.Name="{Binding PinTooltip}"
                                                Click="PinItemButton_Click"
                                                IsTabStop="False"
                                                Style="{StaticResource WidgetCompactIconButtonStyle}"
                                                Tag="{Binding}"
                                                ToolTipService.ToolTip="{Binding PinTooltip}">
                                                <controls:PinStateIcon Width="13" Height="13" IsPinned="{Binding IsPinned}" Opacity="0.82" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.ColumnSpan="2" Margin="-8,-6" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="{StaticResource WidgetCornerRadiusSmall}" Opacity="0.10" IsHitTestVisible="False" Visibility="{Binding DetailSelectionVisibility}" />
                                    <Border Grid.ColumnSpan="2" Width="2" Margin="-8,-6" HorizontalAlignment="Left" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1" IsHitTestVisible="False" Visibility="{Binding DetailSelectionVisibility}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7" Visibility="{Binding EmptyStateVisibility}">
                    <FontIcon HorizontalAlignment="Center" FontSize="{Binding EmptyIconSize}" Glyph="&#xE8A5;" />
                    <TextBlock HorizontalAlignment="Center" FontSize="{Binding TitleTextSize}" Text="{Binding EmptyStateTitle}" />
                    <TextBlock HorizontalAlignment="Center" FontSize="{Binding TextSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding EmptyStateText}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>

        <toolkit:GridSplitter
            x:Name="PaneSplitter"
            Grid.Column="1"
            Margin="-3,0"
            HorizontalAlignment="Stretch"
            DoubleTapped="PaneSplitter_DoubleTapped"
            DragIncrement="1"
            IsTabStop="True"
            IsThumbVisible="True"
            KeyboardIncrement="8"
            ManipulationCompleted="PaneSplitter_ManipulationCompleted"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            Style="{StaticResource WidgetMasterDetailSplitterStyle}" />

        <Grid
            x:Name="DetailPage"
            Grid.Column="2"
            Margin="{Binding DetailPageMargin}"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                x:Name="DetailHeader"
                Grid.Row="0"
                MinHeight="40"
                Padding="4,2"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0">
                <Grid>
                    <Border
                        x:Name="DetailHeaderAcrylicSurface"
                        Background="{ThemeResource SystemControlAcrylicElementBrush}"
                        BorderBrush="{ThemeResource WidgetLayerStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
                        IsHitTestVisible="False"
                        Opacity="0.42" />
                    <Grid MinHeight="36" Padding="2,0" ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="DetailBackColumn" Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="DetailBackButton"
                        Grid.Column="0"
                        Click="DetailBackButton_Click"
                        Style="{StaticResource QuickCaptureSharedDetailIconButtonStyle}"
                        ToolTipService.ToolTip="{Binding DetailBackText}">
                        <FontIcon FontSize="{StaticResource QuickCaptureDetailActionIconSize}" Glyph="&#xE72B;" />
                    </Button>
                    <Grid
                        x:Name="DetailEditSaveHost"
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Left">
                        <Button x:Name="DetailEditButton" Click="DetailEditButton_Click" Style="{StaticResource QuickCaptureSharedDetailIconButtonStyle}" ToolTipService.ToolTip="{Binding DetailEditText}"><FontIcon FontSize="{StaticResource QuickCaptureDetailActionIconSize}" Glyph="&#xE70F;" /></Button>
                        <Button x:Name="DetailDoneButton" Click="DetailDoneButton_Click" Style="{StaticResource QuickCaptureSharedDetailIconButtonStyle}" ToolTipService.ToolTip="{Binding DetailDoneText}" Visibility="Collapsed"><FontIcon FontSize="{StaticResource QuickCaptureDetailActionIconSize}" Glyph="&#xE73E;" /></Button>
                    </Grid>
                    <StackPanel
                        x:Name="DetailHeaderActions"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button x:Name="DetailPinButton" Click="DetailPinButton_Click" Style="{StaticResource QuickCaptureSharedDetailIconButtonStyle}" ToolTipService.ToolTip="{Binding DetailPinText}"><controls:PinStateIcon x:Name="DetailPinIcon" Width="13" Height="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Button>
                        <Button x:Name="DetailCopyButton" Click="DetailCopyButton_Click" Style="{StaticResource QuickCaptureSharedDetailIconButtonStyle}" ToolTipService.ToolTip="{Binding DetailCopyText}"><FontIcon FontSize="{StaticResource QuickCaptureDetailActionIconSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8C8;" /></Button>
                        <Button x:Name="DetailDeleteButton" Click="DetailDeleteButton_Click" Style="{StaticResource QuickCaptureSharedDetailIconButtonStyle}" ToolTipService.ToolTip="{Binding DetailDeleteText}"><FontIcon FontSize="{StaticResource QuickCaptureDetailActionIconSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE74D;" /></Button>
                    </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="DetailContent" Grid.Row="1" Margin="4,0,4,6" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    x:Name="DetailMaterialSurface"
                    Grid.Row="0"
                    MinHeight="132"
                    Padding="8,2,8,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="{StaticResource WidgetCornerRadiusSmall}">
                    <Grid RowSpacing="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <controls:AttachmentTileStrip
                            x:Name="DetailAttachmentStrip"
                            Grid.Row="1"
                            Margin="0,2,0,0"
                            OpenRequested="DetailAttachmentStrip_OpenRequested"
                            RemoveAutomationName="{Binding DetailRemoveAttachmentText}"
                            RemoveRequested="DetailAttachmentStrip_RemoveRequested"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="DetailAddFileButton"
                            Grid.Row="2"
                            MinHeight="32"
                            Padding="6,3"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="DetailAddFileButton_Click"
                            Style="{StaticResource SubtleButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="12" Glyph="&#xE723;" />
                                <TextBlock VerticalAlignment="Center" FontSize="{Binding ContentTextSize}" Text="{Binding AddFileText}" />
                            </StackPanel>
                        </Button>
                        <Grid
                            x:Name="DetailBodyReaderSurface"
                            Grid.Row="0"
                            MinHeight="80"
                            Margin="2,2,2,2">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="DetailPrimaryImageRow" Height="0" />
                                <RowDefinition x:Name="DetailBodyTextRow" Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="DetailPrimaryImageHost"
                                Grid.Row="0"
                                MinHeight="120"
                                Margin="2,2,2,6"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
                                Visibility="Collapsed">
                                <Grid>
                                    <Image
                                        x:Name="DetailPrimaryImage"
                                        AutomationProperties.AccessibilityView="Raw"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Stretch="Uniform" />
                                    <ProgressRing
                                        x:Name="DetailPrimaryImageLoadingRing"
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <controls:MarkdownDocumentView
                                x:Name="DetailMarkdownView"
                                Grid.Row="1"
                                MinHeight="80"
                                Margin="8,4,0,6"
                                FontSize="{Binding ContentTextSize}"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                TaskToggleRequested="DetailMarkdownView_TaskToggleRequested"
                                Visibility="Collapsed" />
                            <controls:MarkdownSourceEditor
                                x:Name="DetailMarkdownEditor"
                                Grid.Row="1"
                                MinHeight="80"
                                EditorFontSize="{Binding ContentTextSize}"
                                EditorEnterBehavior="{Binding EditorEnterBehavior}"
                                EnableCtrlSSaveShortcut="True"
                                PlaceholderText="{Binding DetailBodyPlaceholderText}"
                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>
                <StackPanel x:Name="DetailMaterialPalette" Grid.Row="1" Margin="2,0,0,0" Orientation="Horizontal" Spacing="5" Visibility="Collapsed">
                    <Button x:Name="DefaultMaterialButton" Click="DetailMaterialButton_Click" Style="{StaticResource QuickCaptureSharedMaterialButtonStyle}" Tag="Default" ToolTipService.ToolTip="{Binding MaterialDefaultText}"><Border Width="18" Height="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="3" /></Button>
                    <Button x:Name="PaperMaterialButton" Click="DetailMaterialButton_Click" Style="{StaticResource QuickCaptureSharedMaterialButtonStyle}" Tag="Paper" ToolTipService.ToolTip="{Binding MaterialPaperText}"><Border Width="18" Height="12" Background="#FFF4EEE2" CornerRadius="3" /></Button>
                    <Button x:Name="YellowMaterialButton" Click="DetailMaterialButton_Click" Style="{StaticResource QuickCaptureSharedMaterialButtonStyle}" Tag="StickyYellow" ToolTipService.ToolTip="{Binding MaterialYellowText}"><Border Width="18" Height="12" Background="#FFFFD96A" CornerRadius="3" /></Button>
                    <Button x:Name="RoseMaterialButton" Click="DetailMaterialButton_Click" Style="{StaticResource QuickCaptureSharedMaterialButtonStyle}" Tag="Rose" ToolTipService.ToolTip="{Binding MaterialRoseText}"><Border Width="18" Height="12" Background="#FFF2A7B8" CornerRadius="3" /></Button>
                    <Button x:Name="MintMaterialButton" Click="DetailMaterialButton_Click" Style="{StaticResource QuickCaptureSharedMaterialButtonStyle}" Tag="Mint" ToolTipService.ToolTip="{Binding MaterialMintText}"><Border Width="18" Height="12" Background="#FFA8D8B5" CornerRadius="3" /></Button>
                    <Button x:Name="BlueMaterialButton" Click="DetailMaterialButton_Click" Style="{StaticResource QuickCaptureSharedMaterialButtonStyle}" Tag="MistBlue" ToolTipService.ToolTip="{Binding MaterialBlueText}"><Border Width="18" Height="12" Background="#FFA9C7E8" CornerRadius="3" /></Button>
                </StackPanel>
                <TextBlock
                    x:Name="DetailTimestampText"
                    Grid.Row="2"
                    Margin="8,0,4,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="{Binding ContentDetailHeaderTextSize}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding CreatedTimeVisibility}" />
            </Grid>

            <Grid x:Name="DetailEmptyState" Grid.RowSpan="3" Background="Transparent" Visibility="Collapsed">
                <StackPanel
                    MaxWidth="260"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="24"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE70F;"
                        Opacity="0.72" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="{Binding ContentTitleTextSize}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding EmptyStateTitle}"
                        TextAlignment="Center" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="{Binding ContentSecondaryTextSize}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{Binding EmptyStateText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Center"
                        Click="AddNoteCardButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{Binding InputAreaVisibility}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE710;" />
                            <TextBlock Text="{Binding AddNoteText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
        <TextBox x:Name="InputTextBox" Visibility="Collapsed" />
    </Grid>
</UserControl>
