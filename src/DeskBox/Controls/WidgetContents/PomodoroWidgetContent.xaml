<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetContents.PomodoroWidgetContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PomodoroFocusBrush" Color="#F47B67" />
                    <SolidColorBrush x:Key="PomodoroFocusStrongBrush" Color="#DB5549" />
                    <SolidColorBrush x:Key="PomodoroFocusSoftBrush" Color="#42F5A99D" />
                    <SolidColorBrush x:Key="PomodoroShortBreakBrush" Color="#70AE8B" />
                    <SolidColorBrush x:Key="PomodoroShortBreakStrongBrush" Color="#4D8D6C" />
                    <SolidColorBrush x:Key="PomodoroShortBreakSoftBrush" Color="#3D70AE8B" />
                    <SolidColorBrush x:Key="PomodoroLongBreakBrush" Color="#5796A6" />
                    <SolidColorBrush x:Key="PomodoroLongBreakStrongBrush" Color="#397787" />
                    <SolidColorBrush x:Key="PomodoroLongBreakSoftBrush" Color="#3D5796A6" />
                    <SolidColorBrush x:Key="PomodoroDiscShadowBrush" Color="#240D0705" />
                    <SolidColorBrush x:Key="PomodoroDiscHighlightBrush" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="PomodoroDialTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="PomodoroPendingDotBrush" Color="#2E524743" />
                    <SolidColorBrush x:Key="PomodoroLeafBrush" Color="#3F8050" />
                    <SolidColorBrush x:Key="PomodoroLeafHighlightBrush" Color="#67A86D" />
                    <SolidColorBrush x:Key="PomodoroLeafShadowBrush" Color="#2E643D" />
                    <SolidColorBrush x:Key="PomodoroAccentTextBrush" Color="#FF351714" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PomodoroFocusBrush" Color="#FF8978" />
                    <SolidColorBrush x:Key="PomodoroFocusStrongBrush" Color="#E7685B" />
                    <SolidColorBrush x:Key="PomodoroFocusSoftBrush" Color="#45FF8978" />
                    <SolidColorBrush x:Key="PomodoroShortBreakBrush" Color="#79C49C" />
                    <SolidColorBrush x:Key="PomodoroShortBreakStrongBrush" Color="#54A27C" />
                    <SolidColorBrush x:Key="PomodoroShortBreakSoftBrush" Color="#4279C49C" />
                    <SolidColorBrush x:Key="PomodoroLongBreakBrush" Color="#67B2C2" />
                    <SolidColorBrush x:Key="PomodoroLongBreakStrongBrush" Color="#438D9D" />
                    <SolidColorBrush x:Key="PomodoroLongBreakSoftBrush" Color="#4267B2C2" />
                    <SolidColorBrush x:Key="PomodoroDiscShadowBrush" Color="#4A000000" />
                    <SolidColorBrush x:Key="PomodoroDiscHighlightBrush" Color="#30FFFFFF" />
                    <SolidColorBrush x:Key="PomodoroDialTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="PomodoroPendingDotBrush" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="PomodoroLeafBrush" Color="#72B77D" />
                    <SolidColorBrush x:Key="PomodoroLeafHighlightBrush" Color="#91CE92" />
                    <SolidColorBrush x:Key="PomodoroLeafShadowBrush" Color="#4D915F" />
                    <SolidColorBrush x:Key="PomodoroAccentTextBrush" Color="#FF171312" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PomodoroFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PomodoroFocusStrongBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PomodoroFocusSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="PomodoroShortBreakBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PomodoroShortBreakStrongBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PomodoroShortBreakSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="PomodoroLongBreakBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PomodoroLongBreakStrongBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PomodoroLongBreakSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="PomodoroDiscShadowBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PomodoroDiscHighlightBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PomodoroDialTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PomodoroPendingDotBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="PomodoroLeafBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PomodoroLeafHighlightBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PomodoroLeafShadowBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PomodoroAccentTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style
                x:Key="PomodoroSideButtonStyle"
                BasedOn="{StaticResource SubtleButtonStyle}"
                TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="RootGrid"
        Padding="16,10,16,14"
        SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="DialHost"
            Grid.Row="0"
            Width="190"
            Height="208"
            Margin="0,4,0,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Viewbox
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"
                Stretch="Uniform">
                <Grid Width="190" Height="208">
                    <Grid
                        x:Name="TomatoDiscHost"
                        Width="190"
                        Height="190"
                        VerticalAlignment="Bottom">
                        <Ellipse
                            x:Name="DiscShadow"
                            Margin="10,15,5,3"
                            Fill="{ThemeResource PomodoroDiscShadowBrush}" />
                        <Ellipse
                            x:Name="AmbientDisc"
                            Fill="{ThemeResource PomodoroFocusSoftBrush}" />
                        <Ellipse
                            x:Name="TomatoDiscShape"
                            Margin="7"
                            Fill="{ThemeResource PomodoroFocusBrush}"
                            Stroke="{ThemeResource PomodoroFocusStrongBrush}"
                            StrokeThickness="1.5" />
                        <Ellipse
                            x:Name="TomatoHighlight"
                            Width="78"
                            Height="42"
                            Margin="34,29,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Fill="{ThemeResource PomodoroDiscHighlightBrush}"
                            IsHitTestVisible="False" />
                        <Ellipse
                            x:Name="ProgressTrackRing"
                            Margin="5"
                            Fill="Transparent"
                            Stroke="{ThemeResource PomodoroFocusSoftBrush}"
                            StrokeThickness="4" />
                        <Path
                            x:Name="ProgressArc"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Stroke="{ThemeResource PomodoroFocusBrush}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="4" />

                        <StackPanel
                            x:Name="CountdownPanel"
                            Margin="0,-8,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="5">
                            <TextBlock
                                x:Name="CountdownTextBlock"
                                MinWidth="120"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource PomodoroDialTextBrush}"
                                FontFamily="Bahnschrift"
                                FontSize="54"
                                FontWeight="Bold"
                                CharacterSpacing="8"
                                TextAlignment="Center" />
                            <TextBlock
                                x:Name="PhaseTextBlock"
                                HorizontalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource PomodoroDialTextBrush}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Opacity="0.88"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Viewbox
                        x:Name="LeafCrownViewbox"
                        Width="94"
                        Height="46"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        Stretch="Fill">
                        <Canvas Width="120" Height="58">
                            <Border
                                Canvas.Left="58"
                                Canvas.Top="0"
                                Width="8"
                                Height="27"
                                Background="{ThemeResource PomodoroLeafShadowBrush}"
                                CornerRadius="4"
                                RenderTransformOrigin="0.5,1">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="12" />
                                </Border.RenderTransform>
                            </Border>
                            <Path
                                Data="M58,42 C43,39 25,42 13,51 C24,61 45,56 58,42 Z"
                                Fill="{ThemeResource PomodoroLeafBrush}" />
                            <Path
                                Data="M59,41 C48,27 36,20 27,23 C31,38 44,48 59,41 Z"
                                Fill="{ThemeResource PomodoroLeafHighlightBrush}" />
                            <Path
                                Data="M60,41 C51,27 52,10 61,3 C71,13 70,30 60,41 Z"
                                Fill="{ThemeResource PomodoroLeafBrush}" />
                            <Path
                                Data="M61,41 C74,27 87,20 96,24 C91,39 77,48 61,41 Z"
                                Fill="{ThemeResource PomodoroLeafHighlightBrush}" />
                            <Path
                                Data="M62,42 C79,39 97,42 108,51 C96,61 77,56 62,42 Z"
                                Fill="{ThemeResource PomodoroLeafBrush}" />
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Viewbox>
        </Grid>

        <StackPanel
            x:Name="RoundPanel"
            Grid.Row="1"
            Margin="0,0,0,10"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="9">
            <StackPanel
                x:Name="RoundDotsPanel"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="5" />
            <TextBlock
                x:Name="RoundSummaryTextBlock"
                VerticalAlignment="Center"
                FontSize="10.5"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid
            x:Name="ActionBar"
            Grid.Row="2"
            HorizontalAlignment="Center"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="ResetButton"
                Click="ResetButton_Click"
                Style="{StaticResource PomodoroSideButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>

            <Button
                x:Name="PrimaryActionButton"
                Grid.Column="1"
                Width="112"
                Height="44"
                MinWidth="96"
                Padding="14,0"
                Click="PrimaryActionButton_Click"
                CornerRadius="22">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="PrimaryActionIcon" FontSize="13" />
                    <TextBlock
                        x:Name="PrimaryActionTextBlock"
                        MaxLines="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Button
                x:Name="SkipButton"
                Grid.Column="2"
                Click="SkipButton_Click"
                Style="{StaticResource PomodoroSideButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE893;" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
