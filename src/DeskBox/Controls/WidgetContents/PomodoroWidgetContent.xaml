<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetContents.PomodoroWidgetContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PomodoroFocusBrush" Color="#C8463C" />
                    <SolidColorBrush x:Key="PomodoroFocusSoftBrush" Color="#1FC8463C" />
                    <SolidColorBrush x:Key="PomodoroBreakBrush" Color="#2F7C65" />
                    <SolidColorBrush x:Key="PomodoroBreakSoftBrush" Color="#1F2F7C65" />
                    <SolidColorBrush x:Key="PomodoroDialSurfaceBrush" Color="#EFFFFFFF" />
                    <SolidColorBrush x:Key="PomodoroDialStrokeBrush" Color="#18524743" />
                    <SolidColorBrush x:Key="PomodoroTrackBrush" Color="#24524743" />
                    <SolidColorBrush x:Key="PomodoroPendingDotBrush" Color="#2E524743" />
                    <SolidColorBrush x:Key="PomodoroAccentTextBrush" Color="#FFFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PomodoroFocusBrush" Color="#FF7B70" />
                    <SolidColorBrush x:Key="PomodoroFocusSoftBrush" Color="#32FF7B70" />
                    <SolidColorBrush x:Key="PomodoroBreakBrush" Color="#64C3A0" />
                    <SolidColorBrush x:Key="PomodoroBreakSoftBrush" Color="#3264C3A0" />
                    <SolidColorBrush x:Key="PomodoroDialSurfaceBrush" Color="#B81D1A19" />
                    <SolidColorBrush x:Key="PomodoroDialStrokeBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="PomodoroTrackBrush" Color="#32FFFFFF" />
                    <SolidColorBrush x:Key="PomodoroPendingDotBrush" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="PomodoroAccentTextBrush" Color="#FF171312" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PomodoroFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PomodoroFocusSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="PomodoroBreakBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PomodoroBreakSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="PomodoroDialSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PomodoroDialStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PomodoroTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="PomodoroPendingDotBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="PomodoroAccentTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style
                x:Key="PomodoroSideButtonStyle"
                BasedOn="{StaticResource SubtleButtonStyle}"
                TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="RootGrid"
        Padding="16,10,16,14"
        SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="PhasePill"
            HorizontalAlignment="Center"
            Padding="10,4"
            CornerRadius="12">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse
                    x:Name="PhaseDot"
                    Width="6"
                    Height="6"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="PhaseTextBlock"
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="11"
                    FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <Grid
            x:Name="DialHost"
            Grid.Row="1"
            Width="180"
            Height="180"
            Margin="0,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="DialScaleTransform" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <Ellipse x:Name="AmbientDisc" />
            <Ellipse
                x:Name="ProgressTrack"
                Fill="Transparent"
                Stroke="{ThemeResource PomodoroTrackBrush}"
                StrokeThickness="9" />
            <Path
                x:Name="ProgressArc"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeThickness="9" />
            <Ellipse
                x:Name="CenterDisc"
                Margin="15"
                Fill="{ThemeResource PomodoroDialSurfaceBrush}"
                Stroke="{ThemeResource PomodoroDialStrokeBrush}"
                StrokeThickness="1" />

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="5">
                <TextBlock
                    x:Name="CountdownTextBlock"
                    HorizontalAlignment="Center"
                    FontFamily="Bahnschrift"
                    FontSize="52"
                    FontWeight="SemiBold"
                    CharacterSpacing="15"
                    TextAlignment="Center" />
                <TextBlock
                    x:Name="DescriptionTextBlock"
                    MaxWidth="150"
                    HorizontalAlignment="Center"
                    FontSize="10.5"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Grid>

        <StackPanel
            x:Name="RoundPanel"
            Grid.Row="2"
            Margin="0,0,0,10"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="9">
            <StackPanel
                x:Name="RoundDotsPanel"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="5">
                <Ellipse x:Name="RoundDot1" Width="6" Height="6" />
                <Ellipse x:Name="RoundDot2" Width="6" Height="6" />
                <Ellipse x:Name="RoundDot3" Width="6" Height="6" />
                <Ellipse x:Name="RoundDot4" Width="6" Height="6" />
            </StackPanel>
            <TextBlock
                x:Name="RoundSummaryTextBlock"
                VerticalAlignment="Center"
                FontSize="10.5"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid
            x:Name="ActionBar"
            Grid.Row="3"
            HorizontalAlignment="Center"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="ResetButton"
                Click="ResetButton_Click"
                Style="{StaticResource PomodoroSideButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>

            <Button
                x:Name="PrimaryActionButton"
                Grid.Column="1"
                Width="112"
                Height="44"
                MinWidth="96"
                Padding="14,0"
                Click="PrimaryActionButton_Click"
                CornerRadius="22">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="PrimaryActionIcon" FontSize="13" />
                    <TextBlock
                        x:Name="PrimaryActionTextBlock"
                        MaxLines="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Button
                x:Name="SkipButton"
                Grid.Column="2"
                Click="SkipButton_Click"
                Style="{StaticResource PomodoroSideButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE893;" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
