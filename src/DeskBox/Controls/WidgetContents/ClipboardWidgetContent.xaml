<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetContents.ClipboardWidgetContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:DeskBox.Helpers"
    xmlns:controls="using:DeskBox.Controls"
    xmlns:viewModels="using:DeskBox.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    CharacterReceived="Root_CharacterReceived"
    KeyDown="Root_KeyDown"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Fluent 2 SelectorBar-style compact scrollable filter pill button -->
        <Style x:Key="ClipboardFilterTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource WidgetCornerRadiusSmall}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverOverlay"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="HoverOverlay"
                                                Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverOverlay"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Border
                                x:Name="TabPlate"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />

                            <Border
                                x:Name="HoverOverlay"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />

                            <ContentPresenter
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop"
        Padding="{x:Bind ViewModel.RootPadding, Mode=OneWay}"
        PointerEntered="RootGrid_PointerEntered"
        SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Horizontally Scrollable Fluent 2 Filter Strip + ViewMode/Search Controls (or Search Box) -->
        <Grid Grid.Row="0" Margin="0,0,0,6" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                x:Name="FilterScrollViewer"
                Grid.Column="0"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                PointerCanceled="FilterScrollViewer_PointerReleased"
                PointerCaptureLost="FilterScrollViewer_PointerReleased"
                PointerMoved="FilterScrollViewer_PointerMoved"
                PointerReleased="FilterScrollViewer_PointerReleased"
                PointerWheelChanged="FilterScrollViewer_PointerWheelChanged"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                Visibility="{x:Bind ViewModel.TopFilterBarVisibility, Mode=OneWay}">
                <StackPanel
                    x:Name="FilterTabPanel"
                    Orientation="Horizontal"
                    Padding="0,0,2,0"
                    Spacing="2">
                    <Button
                        MinWidth="{x:Bind ViewModel.FilterTabButtonMinWidth, Mode=OneWay}"
                        Padding="{x:Bind ViewModel.FilterTabButtonPadding, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.FilterAllTooltip, Mode=OneWay}"
                        Click="FilterTabButton_Click"
                        Style="{StaticResource ClipboardFilterTabButtonStyle}"
                        Tag="All"
                        ToolTipService.ToolTip="{x:Bind ViewModel.FilterAllTooltip, Mode=OneWay}">
                        <Grid VerticalAlignment="Stretch">
                            <StackPanel Margin="0,0,0,1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="{x:Bind ViewModel.FilterIconFontSize, Mode=OneWay}"
                                    Glyph="&#xE71D;"
                                    Visibility="{x:Bind ViewModel.FilterIconVisibility, Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    helpers:WidgetTextShadow.Cast="True"
                                    FontSize="{x:Bind ViewModel.SegmentTextSize, Mode=OneWay}"
                                    MaxLines="1"
                                    Text="{x:Bind ViewModel.FilterAllText, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.FilterLabelVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <Border
                                Width="14"
                                Height="2.5"
                                Margin="0,0,0,1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="1.25"
                                Tag="ActiveIndicator"
                                Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button
                        MinWidth="{x:Bind ViewModel.FilterTabButtonMinWidth, Mode=OneWay}"
                        Padding="{x:Bind ViewModel.FilterTabButtonPadding, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.FilterTextTooltip, Mode=OneWay}"
                        Click="FilterTabButton_Click"
                        Style="{StaticResource ClipboardFilterTabButtonStyle}"
                        Tag="Text"
                        ToolTipService.ToolTip="{x:Bind ViewModel.FilterTextTooltip, Mode=OneWay}">
                        <Grid VerticalAlignment="Stretch">
                            <StackPanel Margin="0,0,0,1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="{x:Bind ViewModel.FilterIconFontSize, Mode=OneWay}"
                                    Glyph="&#xE8E4;"
                                    Visibility="{x:Bind ViewModel.FilterIconVisibility, Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    helpers:WidgetTextShadow.Cast="True"
                                    FontSize="{x:Bind ViewModel.SegmentTextSize, Mode=OneWay}"
                                    MaxLines="1"
                                    Text="{x:Bind ViewModel.FilterTextText, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.FilterLabelVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <Border
                                Width="14"
                                Height="2.5"
                                Margin="0,0,0,1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="1.25"
                                Tag="ActiveIndicator"
                                Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button
                        MinWidth="{x:Bind ViewModel.FilterTabButtonMinWidth, Mode=OneWay}"
                        Padding="{x:Bind ViewModel.FilterTabButtonPadding, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.FilterImagesTooltip, Mode=OneWay}"
                        Click="FilterTabButton_Click"
                        Style="{StaticResource ClipboardFilterTabButtonStyle}"
                        Tag="Images"
                        ToolTipService.ToolTip="{x:Bind ViewModel.FilterImagesTooltip, Mode=OneWay}">
                        <Grid VerticalAlignment="Stretch">
                            <StackPanel Margin="0,0,0,1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="{x:Bind ViewModel.FilterIconFontSize, Mode=OneWay}"
                                    Glyph="&#xEB9F;"
                                    Visibility="{x:Bind ViewModel.FilterIconVisibility, Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    helpers:WidgetTextShadow.Cast="True"
                                    FontSize="{x:Bind ViewModel.SegmentTextSize, Mode=OneWay}"
                                    MaxLines="1"
                                    Text="{x:Bind ViewModel.FilterImagesText, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.FilterLabelVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <Border
                                Width="14"
                                Height="2.5"
                                Margin="0,0,0,1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="1.25"
                                Tag="ActiveIndicator"
                                Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button
                        MinWidth="{x:Bind ViewModel.FilterTabButtonMinWidth, Mode=OneWay}"
                        Padding="{x:Bind ViewModel.FilterTabButtonPadding, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.FilterLinksTooltip, Mode=OneWay}"
                        Click="FilterTabButton_Click"
                        Style="{StaticResource ClipboardFilterTabButtonStyle}"
                        Tag="Links"
                        ToolTipService.ToolTip="{x:Bind ViewModel.FilterLinksTooltip, Mode=OneWay}">
                        <Grid VerticalAlignment="Stretch">
                            <StackPanel Margin="0,0,0,1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="{x:Bind ViewModel.FilterIconFontSize, Mode=OneWay}"
                                    Glyph="&#xE71B;"
                                    Visibility="{x:Bind ViewModel.FilterIconVisibility, Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    helpers:WidgetTextShadow.Cast="True"
                                    FontSize="{x:Bind ViewModel.SegmentTextSize, Mode=OneWay}"
                                    MaxLines="1"
                                    Text="{x:Bind ViewModel.FilterLinksText, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.FilterLabelVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <Border
                                Width="14"
                                Height="2.5"
                                Margin="0,0,0,1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="1.25"
                                Tag="ActiveIndicator"
                                Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button
                        MinWidth="{x:Bind ViewModel.FilterTabButtonMinWidth, Mode=OneWay}"
                        Padding="{x:Bind ViewModel.FilterTabButtonPadding, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.FilterFilesTooltip, Mode=OneWay}"
                        Click="FilterTabButton_Click"
                        Style="{StaticResource ClipboardFilterTabButtonStyle}"
                        Tag="Files"
                        ToolTipService.ToolTip="{x:Bind ViewModel.FilterFilesTooltip, Mode=OneWay}">
                        <Grid VerticalAlignment="Stretch">
                            <StackPanel Margin="0,0,0,1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="{x:Bind ViewModel.FilterIconFontSize, Mode=OneWay}"
                                    Glyph="&#xE8B7;"
                                    Visibility="{x:Bind ViewModel.FilterIconVisibility, Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    helpers:WidgetTextShadow.Cast="True"
                                    FontSize="{x:Bind ViewModel.SegmentTextSize, Mode=OneWay}"
                                    MaxLines="1"
                                    Text="{x:Bind ViewModel.FilterFilesText, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.FilterLabelVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <Border
                                Width="14"
                                Height="2.5"
                                Margin="0,0,0,1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="1.25"
                                Tag="ActiveIndicator"
                                Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button
                        MinWidth="{x:Bind ViewModel.FilterTabButtonMinWidth, Mode=OneWay}"
                        Padding="{x:Bind ViewModel.FilterTabButtonPadding, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.FilterPinnedTooltip, Mode=OneWay}"
                        Click="FilterTabButton_Click"
                        Style="{StaticResource ClipboardFilterTabButtonStyle}"
                        Tag="Pinned"
                        ToolTipService.ToolTip="{x:Bind ViewModel.FilterPinnedTooltip, Mode=OneWay}">
                        <Grid VerticalAlignment="Stretch">
                            <StackPanel Margin="0,0,0,1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="{x:Bind ViewModel.FilterIconFontSize, Mode=OneWay}"
                                    Glyph="&#xE718;"
                                    Visibility="{x:Bind ViewModel.FilterIconVisibility, Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    helpers:WidgetTextShadow.Cast="True"
                                    FontSize="{x:Bind ViewModel.SegmentTextSize, Mode=OneWay}"
                                    MaxLines="1"
                                    Text="{x:Bind ViewModel.FilterPinnedText, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.FilterLabelVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <Border
                                Width="14"
                                Height="2.5"
                                Margin="0,0,0,1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="1.25"
                                Tag="ActiveIndicator"
                                Visibility="Collapsed" />
                        </Grid>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="2"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.TopFilterBarVisibility, Mode=OneWay}">
                <Button
                    x:Name="PasteQueueToggleButton"
                    Width="26"
                    Height="26"
                    MinWidth="26"
                    MinHeight="26"
                    AutomationProperties.Name="{x:Bind ViewModel.PasteQueueToggleTooltip, Mode=OneWay}"
                    Click="PasteQueueToggleButton_Click"
                    Style="{StaticResource WidgetCompactIconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PasteQueueToggleTooltip, Mode=OneWay}">
                    <FontIcon FontSize="12" Glyph="&#xE8B5;" />
                </Button>
                <Button
                    x:Name="ViewModeToggleButton"
                    Width="26"
                    Height="26"
                    MinWidth="26"
                    MinHeight="26"
                    AutomationProperties.Name="{x:Bind ViewModel.ViewModeToggleTooltip, Mode=OneWay}"
                    Click="ViewModeToggleButton_Click"
                    Style="{StaticResource WidgetCompactIconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.ViewModeToggleTooltip, Mode=OneWay}">
                    <FontIcon FontSize="12" Glyph="{x:Bind ViewModel.ViewModeToggleGlyph, Mode=OneWay}" />
                </Button>
                <Button
                    x:Name="SearchButton"
                    Width="26"
                    Height="26"
                    MinWidth="26"
                    MinHeight="26"
                    AutomationProperties.Name="{x:Bind ViewModel.SearchPlaceholderText, Mode=OneWay}"
                    Click="SearchButton_Click"
                    Style="{StaticResource WidgetCompactIconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.SearchPlaceholderText, Mode=OneWay}">
                    <FontIcon FontSize="12" Glyph="&#xE721;" />
                </Button>
            </StackPanel>

            <TextBox
                x:Name="SearchTextBox"
                Grid.Column="0"
                MinHeight="{x:Bind ViewModel.InputHeight, Mode=OneWay}"
                Padding="8,4"
                AutomationProperties.Name="{x:Bind ViewModel.SearchPlaceholderText, Mode=OneWay}"
                FontSize="{x:Bind ViewModel.TextSize, Mode=OneWay}"
                KeyDown="SearchTextBox_KeyDown"
                PlaceholderText="{x:Bind ViewModel.SearchPlaceholderText, Mode=OneWay}"
                Style="{StaticResource WidgetSearchTextBoxStyle}"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind ViewModel.SearchBoxVisibility, Mode=OneWay}" />

            <Button
                x:Name="CloseSearchButton"
                Grid.Column="1"
                MinWidth="0"
                MinHeight="{x:Bind ViewModel.InputHeight, Mode=OneWay}"
                Padding="8,0"
                AutomationProperties.Name="{x:Bind ViewModel.SearchCancelText, Mode=OneWay}"
                Click="CloseSearchButton_Click"
                Style="{StaticResource SubtleButtonStyle}"
                Visibility="{x:Bind ViewModel.SearchBoxVisibility, Mode=OneWay}">
                <TextBlock FontSize="{x:Bind ViewModel.SecondaryTextSize, Mode=OneWay}" Text="{x:Bind ViewModel.SearchCancelText, Mode=OneWay}" />
            </Button>
        </Grid>

        <!-- Row 1: Subtle Status Banners (Paused Recording / Sequential Paste Queue) -->
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,6"
            Spacing="4"
            Visibility="{x:Bind ViewModel.StatusBannersVisibility, Mode=OneWay}">
            <Border
                Padding="8,4"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
                Visibility="{x:Bind ViewModel.PausedBannerVisibility, Mode=OneWay}">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE769;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="{x:Bind ViewModel.SecondaryTextSize, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Text="{x:Bind ViewModel.PausedBannerText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Grid.Column="2"
                        MinWidth="0"
                        MinHeight="22"
                        Height="22"
                        Padding="8,0"
                        AutomationProperties.Name="{x:Bind ViewModel.ResumeActionText, Mode=OneWay}"
                        Click="ResumeBannerButton_Click"
                        CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
                        Style="{StaticResource SubtleButtonStyle}">
                        <TextBlock
                            FontSize="{x:Bind ViewModel.SecondaryTextSize, Mode=OneWay}"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.ResumeActionText, Mode=OneWay}" />
                    </Button>
                </Grid>
            </Border>

            <Border
                Padding="8,5"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
                Visibility="{x:Bind ViewModel.PasteQueueBannerVisibility, Mode=OneWay}">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE8B5;" />
                    <StackPanel Grid.Column="1" MinWidth="0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            FontSize="{x:Bind ViewModel.SecondaryTextSize, Mode=OneWay}"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{x:Bind ViewModel.PasteQueueBannerTitle, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            Text="{x:Bind ViewModel.PasteQueueHeadPreview, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="3">
                        <Button
                            MinWidth="0"
                            MinHeight="22"
                            Height="22"
                            Padding="7,0"
                            AutomationProperties.Name="{x:Bind ViewModel.PasteQueuePasteText, Mode=OneWay}"
                            Click="PasteQueueNextButton_Click"
                            CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
                            IsEnabled="{x:Bind ViewModel.CanPasteOrSkipQueue, Mode=OneWay}"
                            Style="{StaticResource SubtleButtonStyle}">
                            <TextBlock
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="{x:Bind ViewModel.PasteQueuePasteText, Mode=OneWay}" />
                        </Button>
                        <Button
                            MinWidth="0"
                            MinHeight="22"
                            Height="22"
                            Padding="6,0"
                            AutomationProperties.Name="{x:Bind ViewModel.PasteQueueSkipText, Mode=OneWay}"
                            Click="PasteQueueSkipButton_Click"
                            CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
                            IsEnabled="{x:Bind ViewModel.CanPasteOrSkipQueue, Mode=OneWay}"
                            Style="{StaticResource SubtleButtonStyle}">
                            <TextBlock
                                FontSize="11.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.PasteQueueSkipText, Mode=OneWay}" />
                        </Button>
                        <Button
                            Width="22"
                            Height="22"
                            MinWidth="22"
                            MinHeight="22"
                            AutomationProperties.Name="{x:Bind ViewModel.PasteQueueStopTooltip, Mode=OneWay}"
                            Click="PasteQueueStopButton_Click"
                            Style="{StaticResource WidgetCompactIconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.PasteQueueStopTooltip, Mode=OneWay}">
                            <FontIcon FontSize="10" Glyph="&#xE711;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Row 2: Virtualized Polymorphic Clipboard Card Stream + Empty State -->
        <Grid Grid.Row="2">
            <ListView
                x:Name="ItemsList"
                Padding="0"
                AllowDrop="True"
                Background="Transparent"
                CanDragItems="True"
                CanReorderItems="False"
                ContainerContentChanging="ItemsList_ContainerContentChanging"
                DragItemsStarting="ItemsList_DragItemsStarting"
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind ViewModel.VisibleItems, Mode=OneWay}"
                KeyDown="ItemsList_KeyDown"
                SelectionMode="Single"
                Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ClipboardItemViewModel">
                        <Border
                            x:Name="CardRoot"
                            Margin="0,2"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
                            DoubleTapped="CardRoot_DoubleTapped"
                            Loaded="CardRoot_Loaded"
                            PointerEntered="CardRoot_PointerEntered"
                            PointerExited="CardRoot_PointerExited"
                            PointerPressed="CardRoot_PointerPressed"
                            RightTapped="CardRoot_RightTapped"
                            Tapped="CardRoot_Tapped">
                            <Grid x:Name="CardOuterGrid" MinHeight="{x:Bind CardMinHeight, Mode=OneWay}">
                                <!-- Fluent 2 hover wash (edge-to-edge, zero layout shift) -->
                                <Border
                                    x:Name="HoverWash"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
                                    IsHitTestVisible="False"
                                    Opacity="0" />

                                <!-- Live System Clipboard Left Accent Indicator -->
                                <Border
                                    Width="3"
                                    Height="14"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="1.5"
                                    IsHitTestVisible="False"
                                    Visibility="{x:Bind CurrentClipboardIndicatorVisibility, Mode=OneWay}" />

                                <!-- Subtle 2px Left Neutral Bar While Peek Preview Is Open -->
                                <Border
                                    Width="2"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                    CornerRadius="1"
                                    IsHitTestVisible="False"
                                    Visibility="{x:Bind PeekSelectionVisibility, Mode=OneWay}" />

                                <!-- Padded Card Layout: Col 0 Optional MultiSelect/Queue Badge, Col 1 Row 0 Micro-Header + Row 1 Body -->
                                <Grid
                                    x:Name="CardContentGrid"
                                    Padding="{x:Bind CardPadding, Mode=OneWay}"
                                    VerticalAlignment="Center"
                                    ColumnSpacing="0"
                                    RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Multi-Select Order Circle (1, 2, 3...) -->
                                    <Grid
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,7,0"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="{x:Bind MultiSelectCheckVisibility, Mode=OneWay}">
                                        <Border
                                            Width="18"
                                            Height="18"
                                            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="9"
                                            Visibility="{x:Bind MultiSelectEmptyRingVisibility, Mode=OneWay}" />
                                        <Border
                                            Width="18"
                                            Height="18"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="9"
                                            Visibility="{x:Bind MultiSelectFilledBadgeVisibility, Mode=OneWay}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                helpers:WidgetTextShadow.Cast="True"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Text="{x:Bind MultiSelectBadgeText, Mode=OneWay}" />
                                        </Border>
                                    </Grid>

                                    <!-- Sequential Paste Queue Order Pill (#1, #2...) -->
                                    <Border
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="0"
                                        MinWidth="20"
                                        Margin="0,0,7,0"
                                        Padding="4,1"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="4"
                                        IsHitTestVisible="False"
                                        Visibility="{x:Bind PasteQueueBadgeVisibility, Mode=OneWay}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            helpers:WidgetTextShadow.Cast="True"
                                            FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Text="{x:Bind PasteQueueBadgeText, Mode=OneWay}" />
                                    </Border>

                                    <!-- Row 0: Micro-Header (App Icon + Semantic/OCR/Note Pill + Clean Meta | Pin + #Slot + Time) -->
                                    <Grid
                                        x:Name="HeaderRowGrid"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        MinHeight="16"
                                        Margin="0,0,0,4"
                                        Visibility="{x:Bind HeaderRowVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Metadata Cluster (ColumnSpacing="0" + item Margin prevents phantom gaps when Collapsed) -->
                                        <Grid Grid.Column="0" MinWidth="0" VerticalAlignment="Center" ColumnSpacing="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Image
                                                Grid.Column="0"
                                                Width="12"
                                                Height="12"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Opacity="0.86"
                                                Source="{x:Bind SourceAppIcon, Mode=OneWay}"
                                                Visibility="{x:Bind SourceAppIconVisibility, Mode=OneWay}" />

                                            <Border
                                                Grid.Column="1"
                                                Margin="0,0,5,0"
                                                Padding="4,1"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="3"
                                                Visibility="{x:Bind SemanticBadgeVisibility, Mode=OneWay}">
                                                <TextBlock
                                                    helpers:WidgetTextShadow.Cast="True"
                                                    FontSize="10"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxLines="1"
                                                    Text="{x:Bind SemanticBadgeText, Mode=OneWay}" />
                                            </Border>

                                            <Border
                                                Grid.Column="2"
                                                Margin="0,0,5,0"
                                                Padding="4,1"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="3"
                                                Visibility="{x:Bind OcrBadgeVisibility, Mode=OneWay}">
                                                <TextBlock
                                                    helpers:WidgetTextShadow.Cast="True"
                                                    FontSize="9.5"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxLines="1"
                                                    Text="OCR" />
                                            </Border>

                                            <Border
                                                Grid.Column="3"
                                                MaxWidth="116"
                                                Margin="0,0,5,0"
                                                Padding="4,1"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Visibility="{x:Bind NoteVisibility, Mode=OneWay}">
                                                <TextBlock
                                                    helpers:WidgetTextShadow.Cast="True"
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    MaxLines="1"
                                                    Text="{x:Bind NoteText, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>

                                            <TextBlock
                                                Grid.Column="4"
                                                VerticalAlignment="Center"
                                                helpers:WidgetTextShadow.Cast="True"
                                                FontSize="{x:Bind MetaFontSize, Mode=OneWay}"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                MaxLines="1"
                                                Text="{x:Bind MetaText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{x:Bind MetaVisibility, Mode=OneWay}" />
                                        </Grid>

                                        <!-- Right Default Cluster: Pin Indicator + #1..#9 Slot + Relative Time -->
                                        <StackPanel
                                            x:Name="HeaderMetaRightCluster"
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="5">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Glyph="&#xE718;"
                                                Opacity="0.86"
                                                Visibility="{x:Bind PinnedBadgeVisibility, Mode=OneWay}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                helpers:WidgetTextShadow.Cast="True"
                                                FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                MaxLines="1"
                                                Opacity="0.62"
                                                Text="{x:Bind QuickSlotText, Mode=OneWay}"
                                                Visibility="{x:Bind QuickSlotVisibility, Mode=OneWay}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                helpers:WidgetTextShadow.Cast="True"
                                                FontSize="{x:Bind MetaFontSize, Mode=OneWay}"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                MaxLines="1"
                                                Text="{x:Bind RelativeTimeText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 1: Polymorphic Body -->
                                    <Grid x:Name="BodyRowGrid" Grid.Row="1" Grid.Column="1" MinWidth="0" VerticalAlignment="Center" Opacity="{x:Bind ContentOpacity, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" MinWidth="0" VerticalAlignment="Center">
                                            <!-- 1. Standard / Compact Text, Link, Multi-File, and Compact Code Body -->
                                            <StackPanel VerticalAlignment="Center" Spacing="2" Visibility="{x:Bind StandardBodyVisibility, Mode=OneWay}">
                                                <Grid VerticalAlignment="Center" ColumnSpacing="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <FontIcon
                                                        Grid.Column="0"
                                                        Margin="{x:Bind KindPrefixMargin, Mode=OneWay}"
                                                        VerticalAlignment="{x:Bind KindPrefixVerticalAlignment, Mode=OneWay}"
                                                        FontSize="11.5"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="{x:Bind KindPrefixGlyph, Mode=OneWay}"
                                                        Visibility="{x:Bind KindPrefixVisibility, Mode=OneWay}" />

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        helpers:WidgetTextShadow.Cast="True"
                                                        FontSize="{x:Bind TextSize, Mode=OneWay}"
                                                        MaxLines="{x:Bind PreviewMaxLines, Mode=OneWay}"
                                                        Text="{x:Bind DisplayText, Mode=OneWay}"
                                                        TextDecorations="{x:Bind TitleDecorations, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="{x:Bind BodyTextWrapping, Mode=OneWay}" />
                                                </Grid>

                                                <TextBlock
                                                    helpers:WidgetTextShadow.Cast="True"
                                                    FontSize="{x:Bind MetaFontSize, Mode=OneWay}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxLines="1"
                                                    Text="{x:Bind UrlSubtitleText, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{x:Bind UrlSubtitleVisibility, Mode=OneWay}" />
                                            </StackPanel>

                                            <!-- 2. Code Snippet Monospace Well (Standard View Only) -->
                                            <Border
                                                Padding="7,5"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Visibility="{x:Bind CodeBodyVisibility, Mode=OneWay}">
                                                <TextBlock
                                                    helpers:WidgetTextShadow.Cast="True"
                                                    FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                    FontSize="{x:Bind CodeTextSize, Mode=OneWay}"
                                                    MaxLines="{x:Bind CodePreviewMaxLines, Mode=OneWay}"
                                                    Text="{x:Bind DisplayText, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </Border>

                                            <!-- 3. Color Swatch Card Body -->
                                            <Grid VerticalAlignment="Center" ColumnSpacing="7" Visibility="{x:Bind ColorBodyVisibility, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Grid.Column="0"
                                                    Width="{x:Bind ColorSwatchSize, Mode=OneWay}"
                                                    Height="{x:Bind ColorSwatchSize, Mode=OneWay}"
                                                    VerticalAlignment="Center"
                                                    Background="{x:Bind ColorSwatchBrush, Mode=OneWay}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{x:Bind ColorSwatchCornerRadius, Mode=OneWay}" />

                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="7">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        helpers:WidgetTextShadow.Cast="True"
                                                        FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                        FontSize="{x:Bind TextSize, Mode=OneWay}"
                                                        FontWeight="SemiBold"
                                                        MaxLines="1"
                                                        Text="{x:Bind ColorPrimaryText, Mode=OneWay}" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        helpers:WidgetTextShadow.Cast="True"
                                                        FontSize="{x:Bind MetaFontSize, Mode=OneWay}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        MaxLines="1"
                                                        Text="{x:Bind ColorSecondaryText, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- 4. Full-Width Hero Image Banner (Standard View Only) -->
                                            <StackPanel Spacing="3" Visibility="{x:Bind HeroImageVisibility, Mode=OneWay}">
                                                <Border
                                                    MinHeight="48"
                                                    MaxHeight="{x:Bind ImageBannerMaxHeight, Mode=OneWay}"
                                                    Padding="2"
                                                    HorizontalAlignment="Stretch"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    IsHitTestVisible="False">
                                                    <Grid>
                                                        <FontIcon
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="18"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Glyph="&#xEB9F;"
                                                            Visibility="{x:Bind ImagePlaceholderVisibility, Mode=OneWay}" />
                                                        <Image
                                                            MaxHeight="{x:Bind ImageBannerMaxHeight, Mode=OneWay}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.AccessibilityView="Raw"
                                                            Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                            Stretch="Uniform"
                                                            Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}" />
                                                    </Grid>
                                                </Border>

                                                <TextBlock
                                                    helpers:WidgetTextShadow.Cast="True"
                                                    FontSize="{x:Bind MetaFontSize, Mode=OneWay}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxLines="1"
                                                    Text="{x:Bind ImageFileCaptionText, Mode=OneWay}"
                                                    TextDecorations="{x:Bind TitleDecorations, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{x:Bind ImageFileCaptionVisibility, Mode=OneWay}" />
                                            </StackPanel>

                                            <!-- 5. Compact Inline Image Row (Compact View Only — Exact Single-Line Text Height) -->
                                            <Grid
                                                Height="18"
                                                VerticalAlignment="Center"
                                                ColumnSpacing="7"
                                                Visibility="{x:Bind CompactImageVisibility, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Grid.Column="0"
                                                    Width="22"
                                                    Height="18"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    IsHitTestVisible="False">
                                                    <Grid>
                                                        <FontIcon
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Glyph="&#xEB9F;"
                                                            Visibility="{x:Bind ImagePlaceholderVisibility, Mode=OneWay}" />
                                                        <Image
                                                            Width="22"
                                                            Height="18"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.AccessibilityView="Raw"
                                                            Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                            Stretch="UniformToFill"
                                                            Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}" />
                                                    </Grid>
                                                </Border>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    helpers:WidgetTextShadow.Cast="True"
                                                    FontSize="{x:Bind TextSize, Mode=OneWay}"
                                                    MaxLines="1"
                                                    Text="{x:Bind CompactImageText, Mode=OneWay}"
                                                    TextDecorations="{x:Bind TitleDecorations, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Grid>

                                        <!-- Subtle Pin Indicator + #1..#9 Slot in Compact View -->
                                        <StackPanel
                                            x:Name="CompactRightCluster"
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            Visibility="{x:Bind CompactRightClusterVisibility, Mode=OneWay}">
                                            <FontIcon
                                                x:Name="CompactPinBadge"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Glyph="&#xE718;"
                                                Opacity="0.86"
                                                Visibility="{x:Bind CompactPinVisibility, Mode=OneWay}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                helpers:WidgetTextShadow.Cast="True"
                                                FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                MaxLines="1"
                                                Opacity="0.62"
                                                Text="{x:Bind QuickSlotText, Mode=OneWay}"
                                                Visibility="{x:Bind CompactQuickSlotVisibility, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- Hover Quick-Action Strip (Top-Right in Standard View, Center-Right in Compact View) -->
                                <Border
                                    x:Name="ActionButtonsOverlay"
                                    Margin="{x:Bind ActionOverlayMargin, Mode=OneWay}"
                                    Padding="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="{x:Bind ActionOverlayVerticalAlignment, Mode=OneWay}"
                                    Background="{ThemeResource WidgetOverlaySurfaceBrush}"
                                    Canvas.ZIndex="2"
                                    CornerRadius="4"
                                    IsHitTestVisible="False"
                                    Opacity="0">
                                    <StackPanel Orientation="Horizontal" Spacing="1">
                                        <Button
                                            Width="22"
                                            Height="22"
                                            MinWidth="22"
                                            MinHeight="22"
                                            AutomationProperties.Name="{x:Bind QuickActionTooltip, Mode=OneWay}"
                                            Click="QuickActionItemButton_Click"
                                            IsTabStop="False"
                                            Style="{StaticResource WidgetCompactIconButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind QuickActionTooltip, Mode=OneWay}"
                                            Visibility="{x:Bind QuickActionVisibility, Mode=OneWay}">
                                            <FontIcon FontSize="10.5" Glyph="{x:Bind QuickActionGlyph, Mode=OneWay}" Opacity="0.86" />
                                        </Button>
                                        <Button
                                            Width="22"
                                            Height="22"
                                            MinWidth="22"
                                            MinHeight="22"
                                            AutomationProperties.Name="{x:Bind PeekEditTooltip, Mode=OneWay}"
                                            Click="PeekEditItemButton_Click"
                                            IsTabStop="False"
                                            Style="{StaticResource WidgetCompactIconButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind PeekEditTooltip, Mode=OneWay}">
                                            <FontIcon FontSize="10.5" Glyph="&#xE70F;" Opacity="0.84" />
                                        </Button>
                                        <Button
                                            Width="22"
                                            Height="22"
                                            MinWidth="22"
                                            MinHeight="22"
                                            AutomationProperties.Name="{x:Bind CopyTooltip, Mode=OneWay}"
                                            Click="CopyItemButton_Click"
                                            IsTabStop="False"
                                            Style="{StaticResource WidgetCompactIconButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind CopyTooltip, Mode=OneWay}">
                                            <FontIcon FontSize="10.5" Glyph="{x:Bind CopyButtonGlyph, Mode=OneWay}" Opacity="0.86" />
                                        </Button>
                                        <Button
                                            Width="22"
                                            Height="22"
                                            MinWidth="22"
                                            MinHeight="22"
                                            AutomationProperties.Name="{x:Bind PinTooltip, Mode=OneWay}"
                                            Click="PinItemButton_Click"
                                            IsTabStop="False"
                                            Style="{StaticResource WidgetCompactIconButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind PinTooltip, Mode=OneWay}">
                                            <controls:PinStateIcon Width="12" Height="12" IsPinned="{x:Bind IsPinned, Mode=OneWay}" Opacity="0.84" />
                                        </Button>
                                        <Button
                                            Width="22"
                                            Height="22"
                                            MinWidth="22"
                                            MinHeight="22"
                                            AutomationProperties.Name="{x:Bind DeleteTooltip, Mode=OneWay}"
                                            Click="DeleteItemButton_Click"
                                            IsTabStop="False"
                                            Style="{StaticResource WidgetCompactIconButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind DeleteTooltip, Mode=OneWay}">
                                            <FontIcon FontSize="10.5" Glyph="&#xE74D;" Opacity="0.84" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty State -->
            <StackPanel
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="7"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="24"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="{x:Bind ViewModel.EmptyStateGlyph, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="{x:Bind ViewModel.TitleTextSize, Mode=OneWay}"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}"
                    TextAlignment="Center" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="{x:Bind ViewModel.SecondaryTextSize, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EmptyStateSubtitle, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Row 3: Multi-Select Action Bar -->
        <Border
            Grid.Row="3"
            Margin="0,6,0,0"
            Padding="8,5"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
            Visibility="{x:Bind ViewModel.MultiSelectBarVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="{x:Bind ViewModel.SecondaryTextSize, Mode=OneWay}"
                    FontWeight="SemiBold"
                    MaxLines="1"
                    Text="{x:Bind ViewModel.MultiSelectStatusText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                    <Button
                        MinWidth="0"
                        MinHeight="24"
                        Height="24"
                        Padding="8,0,6,0"
                        AutomationProperties.Name="{x:Bind ViewModel.MergeCopyLabel, Mode=OneWay}"
                        Click="MergeCopyButton_Click"
                        CornerRadius="{StaticResource WidgetCornerRadiusSmall}"
                        IsEnabled="{x:Bind ViewModel.HasMultiSelection, Mode=OneWay}"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.MergeCopyLabel, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8C8;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="{x:Bind ViewModel.MergeCopyLabel, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Width="20"
                        Height="24"
                        MinWidth="20"
                        MinHeight="24"
                        Padding="0"
                        AutomationProperties.Name="{x:Bind ViewModel.MergeCopyLabel, Mode=OneWay}"
                        Click="MergeCopyOptionsButton_Click"
                        IsEnabled="{x:Bind ViewModel.HasMultiSelection, Mode=OneWay}"
                        Style="{StaticResource WidgetCompactIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.MergeCopyLabel, Mode=OneWay}">
                        <FontIcon FontSize="9.5" Glyph="&#xE70D;" />
                    </Button>

                    <Button
                        x:Name="MergeSaveQuickCaptureButton"
                        Width="24"
                        Height="24"
                        MinWidth="24"
                        MinHeight="24"
                        AutomationProperties.Name="{x:Bind ViewModel.MergeSaveQuickCaptureTooltip, Mode=OneWay}"
                        Click="MergeSaveQuickCaptureButton_Click"
                        IsEnabled="{x:Bind ViewModel.HasMultiSelection, Mode=OneWay}"
                        Style="{StaticResource WidgetCompactIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.MergeSaveQuickCaptureTooltip, Mode=OneWay}">
                        <FontIcon FontSize="11" Glyph="&#xE77B;" />
                    </Button>

                    <Button
                        Width="24"
                        Height="24"
                        MinWidth="24"
                        MinHeight="24"
                        AutomationProperties.Name="{x:Bind ViewModel.EnqueueSelectedTooltip, Mode=OneWay}"
                        Click="EnqueueSelectedButton_Click"
                        IsEnabled="{x:Bind ViewModel.HasMultiSelection, Mode=OneWay}"
                        Style="{StaticResource WidgetCompactIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.EnqueueSelectedTooltip, Mode=OneWay}">
                        <FontIcon FontSize="11" Glyph="&#xE8B5;" />
                    </Button>

                    <Button
                        Width="24"
                        Height="24"
                        MinWidth="24"
                        MinHeight="24"
                        AutomationProperties.Name="{x:Bind ViewModel.BatchPinTooltip, Mode=OneWay}"
                        Click="BatchPinButton_Click"
                        IsEnabled="{x:Bind ViewModel.HasMultiSelection, Mode=OneWay}"
                        Style="{StaticResource WidgetCompactIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.BatchPinTooltip, Mode=OneWay}">
                        <FontIcon FontSize="11" Glyph="&#xE718;" />
                    </Button>

                    <Button
                        Width="24"
                        Height="24"
                        MinWidth="24"
                        MinHeight="24"
                        AutomationProperties.Name="{x:Bind ViewModel.BatchDeleteTooltip, Mode=OneWay}"
                        Click="BatchDeleteButton_Click"
                        IsEnabled="{x:Bind ViewModel.HasMultiSelection, Mode=OneWay}"
                        Style="{StaticResource WidgetCompactIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.BatchDeleteTooltip, Mode=OneWay}">
                        <FontIcon FontSize="11" Glyph="&#xE74D;" />
                    </Button>

                    <Button
                        Width="24"
                        Height="24"
                        MinWidth="24"
                        MinHeight="24"
                        AutomationProperties.Name="{x:Bind ViewModel.ExitMultiSelectTooltip, Mode=OneWay}"
                        Click="ExitMultiSelectButton_Click"
                        Style="{StaticResource WidgetCompactIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ExitMultiSelectTooltip, Mode=OneWay}">
                        <FontIcon FontSize="10.5" Glyph="&#xE711;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
