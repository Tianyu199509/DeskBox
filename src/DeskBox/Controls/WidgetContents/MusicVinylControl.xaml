<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetContents.MusicVinylControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    UseLayoutRounding="True">

    <Viewbox Stretch="Uniform">
        <Grid Width="160" Height="160">
            <!-- Stationary platter: soft studio drop shadow, outer rim, grooves, and light reflection -->
            <Ellipse Margin="-4,2,-4,-6" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Offset="0.72" Color="#44000000" />
                        <GradientStop Offset="0.88" Color="#1F000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Fill="#09090C" Stroke="#2AFFFFFF" StrokeThickness="0.7" />
            <Ellipse Stroke="#1C1C20" StrokeThickness="0.7" Margin="3" IsHitTestVisible="False" />
            <Ellipse Stroke="#242429" StrokeThickness="0.6" Margin="6" IsHitTestVisible="False" />
            <Ellipse Stroke="#1B1B20" StrokeThickness="0.5" Margin="9" IsHitTestVisible="False" />
            <Ellipse Stroke="#27272D" StrokeThickness="0.5" Margin="13" IsHitTestVisible="False" />
            <Ellipse Stroke="#1D1D22" StrokeThickness="0.45" Margin="17" IsHitTestVisible="False" />
            <Ellipse Stroke="#25252B" StrokeThickness="0.4" Margin="21" IsHitTestVisible="False" />
            <Ellipse Stroke="#1A1A1F" StrokeThickness="0.4" Margin="25" IsHitTestVisible="False" />
            <Ellipse Stroke="#232328" StrokeThickness="0.35" Margin="29" IsHitTestVisible="False" />

            <!-- Stationary directional sheen (light source does not spin with the disc) -->
            <Ellipse IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.30,0.24" Center="0.5,0.5" RadiusX="0.55" RadiusY="0.55">
                        <GradientStop Offset="0" Color="#58FFFFFF" />
                        <GradientStop Offset="0.36" Color="#10FFFFFF" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Center label recess ring -->
            <Ellipse Fill="#14151A" Stroke="#000000" StrokeThickness="1.2" Margin="31" IsHitTestVisible="False" />

            <!-- Rotating center label (96x96 inside 160x160 = Margin 32) -->
            <Grid
                x:Name="RotatingLabelHost"
                Width="96"
                Height="96"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <!-- Default pressed studio label when artwork is unavailable -->
                <Grid x:Name="PlaceholderLabel">
                    <Ellipse>
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.30" Center="0.5,0.5" RadiusX="0.65" RadiusY="0.65">
                                <GradientStop Offset="0" Color="#FF2E313B" />
                                <GradientStop Offset="0.68" Color="#FF1E2028" />
                                <GradientStop Offset="1" Color="#FF15161C" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Stroke="#28FFFFFF" StrokeThickness="0.8" Margin="7" />
                    <Ellipse Stroke="#18FFFFFF" StrokeThickness="0.6" Margin="18" />
                    <FontIcon
                        Margin="0,-20,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="#78FFFFFF"
                        Glyph="&#xEC4F;" />
                </Grid>

                <!-- Album artwork center label -->
                <Ellipse x:Name="CoverEllipse" Visibility="Collapsed">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse
                    x:Name="CoverRim"
                    Stroke="#26FFFFFF"
                    StrokeThickness="0.8"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
            </Grid>

            <!-- Stationary metallic spindle -->
            <Ellipse
                Width="9"
                Height="9"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Stroke="#50000000"
                StrokeThickness="0.8">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.32,0.28" Center="0.5,0.5" RadiusX="0.62" RadiusY="0.62">
                        <GradientStop Offset="0" Color="#FFF3F3F6" />
                        <GradientStop Offset="0.7" Color="#FFB6B6BE" />
                        <GradientStop Offset="1" Color="#FF7E7E86" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse
                Width="3"
                Height="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Fill="#CC1A1A1E"
                IsHitTestVisible="False" />
        </Grid>
    </Viewbox>
</UserControl>
