<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.SearchResultRowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    IsTabStop="False"
    AutomationProperties.Name="{x:Bind Item.Title, Mode=OneTime}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="RowQuickActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="AllowFocusOnInteraction" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionPill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActionPill"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActionContent"
                                                                           Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActionPill"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource ControlFillColorTertiaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ActionContent"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        CmdPal-inspired compact single-line result row (10px concentric inner radius inside 16px popup):
        flush left accent pill selection bar, crisp 24px icon, single-line horizontal Title + muted Subtitle
        baseline, and metadata delegated to the right-side Details sidebar.
    -->
    <Grid x:Name="RowRoot" Padding="10,0" Margin="0,1" CornerRadius="10" Height="44" MinHeight="44"
          Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
          IsTabStop="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="TypeColumn" Width="0"/>
            <ColumnDefinition x:Name="SizeColumn" Width="0"/>
            <ColumnDefinition x:Name="DateColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <Rectangle x:Name="SelectionBar" Grid.Column="0" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                   Fill="{ThemeResource AccentFillColorDefaultBrush}"
                   Margin="-6,0,0,0"
                   Visibility="Collapsed" VerticalAlignment="Center"
                   HorizontalAlignment="Left"/>

        <Grid x:Name="IconColumn" Grid.Column="0" Width="26" Height="26"
              HorizontalAlignment="Left" VerticalAlignment="Center" IsTabStop="False">
            <Border x:Name="GlyphBlock" Width="26" Height="26"
                    Background="Transparent"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="{x:Bind Item.DisplayGlyph, Mode=OneTime}" FontSize="17"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Image x:Name="FileIcon" Source="{x:Bind Item.Icon, Mode=OneTime}" Width="24" Height="24"
                   Stretch="Uniform" Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Column="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Grid.Column="0" Text="{x:Bind Item.Title, Mode=OneTime}" FontSize="14"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
            <TextBlock x:Name="SubtitleText" Grid.Column="1" Text="{x:Bind Item.Subtitle, Mode=OneTime}" FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="10,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxLines="1"
                       ToolTipService.ToolTip="{x:Bind Item.DetailPath, Mode=OneTime}"/>
        </Grid>

        <TextBlock x:Name="TypeText" Grid.Column="2" Text="{x:Bind Item.TypeDisplay, Mode=OneTime}" FontSize="12"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   VerticalAlignment="Center" Margin="6,0,6,0"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="SizeText" Grid.Column="3" Text="{x:Bind Item.SizeDisplay, Mode=OneTime}" FontSize="12"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   VerticalAlignment="Center" Margin="6,0,6,0"/>
        <TextBlock x:Name="DateText" Grid.Column="4" Text="{x:Bind Item.DateDisplay, Mode=OneTime}" FontSize="12"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   VerticalAlignment="Center" Margin="6,0,0,0"/>

        <StackPanel x:Name="QuickActionsPanel" Grid.Column="1" Grid.ColumnSpan="4"
                    HorizontalAlignment="Right" Orientation="Horizontal" Spacing="2"
                    VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed">
            <Button x:Name="QuickOpenLocationButton" Style="{StaticResource RowQuickActionButtonStyle}"
                    Click="QuickOpenLocationButton_Click">
                <FontIcon Glyph="&#xEC50;" FontSize="13.5"/>
            </Button>
            <Button x:Name="QuickPrimaryButton" Style="{StaticResource RowQuickActionButtonStyle}"
                    Click="QuickPrimaryButton_Click">
                <FontIcon x:Name="QuickPrimaryGlyph" Glyph="&#xE8A7;" FontSize="13.5"/>
            </Button>
            <Button x:Name="QuickMoreButton" Style="{StaticResource RowQuickActionButtonStyle}"
                    Click="QuickMoreButton_Click">
                <FontIcon Glyph="&#xE712;" FontSize="13.5"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
