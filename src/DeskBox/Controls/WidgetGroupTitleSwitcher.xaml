<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetGroupTitleSwitcher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeskBox.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="32"
    d:DesignWidth="224"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    IsTabStop="False"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--
            The selector owns its interaction chrome. A deliberately neutral
            template prevents the Button's built-in hover plate from stacking
            with the title capsule.
        -->
        <Style x:Key="GroupTitleSelectorButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="Root"
        MinHeight="32"
        MinWidth="0"
        Background="Transparent"
        PointerEntered="SelectorButton_PointerEntered"
        PointerExited="SelectorButton_PointerExited"
        RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform
                x:Name="DetachScaleTransform"
                ScaleX="1"
                ScaleY="1" />
        </Grid.RenderTransform>
        <Border
            x:Name="TitleInteractionChrome"
            MinHeight="28"
            Margin="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0.5"
            CornerRadius="7"
            IsHitTestVisible="False"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform
                    x:Name="TitleInteractionChromeTransform"
                    ScaleX="1"
                    ScaleY="1" />
            </Border.RenderTransform>
        </Border>
        <Button
            x:Name="SelectorButton"
            MinHeight="32"
            MinWidth="0"
            CanDrag="False"
            HorizontalAlignment="Stretch"
            Click="SelectorButton_Click"
            DragStarting="GroupTitle_DragStarting"
            DropCompleted="GroupTitle_DropCompleted"
            KeyDown="SelectorButton_KeyDown"
            Style="{StaticResource GroupTitleSelectorButtonStyle}"
            UseSystemFocusVisuals="True">
            <Border
                x:Name="CapsuleSurface"
                MinHeight="28"
                Margin="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="Transparent"
                CornerRadius="7">
                <Grid>
                    <Border
                        x:Name="CapsuleChrome"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderThickness="0"
                        CornerRadius="7"
                        IsHitTestVisible="False"
                        Opacity="0" />

                    <Grid Padding="6,0,7,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            x:Name="PositionRailViewport"
                            Grid.Column="0"
                            Width="5"
                            Height="20"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                            <StackPanel
                                x:Name="OutgoingPositionRailLayer"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Opacity="0"
                                Orientation="Vertical"
                                Spacing="2" />
                            <StackPanel
                                x:Name="CurrentPositionRailLayer"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Opacity="1"
                                Orientation="Vertical"
                                Spacing="2" />
                        </Grid>

                        <Grid
                            x:Name="IdentityViewport"
                            Grid.Column="1"
                            Width="64"
                            MinHeight="26"
                            VerticalAlignment="Center">
                            <StackPanel
                                x:Name="OutgoingIdentityLayer"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Opacity="0"
                                Orientation="Horizontal"
                                Spacing="5">
                                <controls:WidgetTitleIcon
                                    x:Name="OutgoingIcon"
                                    IsHitTestVisible="False" />
                                <TextBlock
                                    x:Name="OutgoingTitle"
                                    MaxWidth="132"
                                    FontSize="{StaticResource WidgetTitleTextSize}"
                                    FontWeight="Normal"
                                    IsHitTestVisible="False"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel
                                x:Name="CurrentIdentityLayer"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Opacity="1"
                                Orientation="Horizontal"
                                Spacing="5">
                                <controls:WidgetTitleIcon
                                    x:Name="CurrentIcon"
                                    IsHitTestVisible="False"
                                    RenderTransformOrigin="0.5,0.5">
                                    <controls:WidgetTitleIcon.RenderTransform>
                                        <ScaleTransform
                                            x:Name="CurrentIconScaleTransform"
                                            ScaleX="1"
                                            ScaleY="1" />
                                    </controls:WidgetTitleIcon.RenderTransform>
                                </controls:WidgetTitleIcon>
                                <TextBlock
                                    x:Name="CurrentTitle"
                                    MaxWidth="132"
                                    FontSize="{StaticResource WidgetTitleTextSize}"
                                    FontWeight="Normal"
                                    IsHitTestVisible="False"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                        </Grid>

                        <ProgressRing
                            x:Name="LoadingRing"
                            Grid.Column="2"
                            Width="9"
                            Height="9"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsActive="False"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>

                </Grid>
            </Border>
        </Button>

        <TabView
            x:Name="TabsView"
            Canvas.ZIndex="1"
            MinHeight="32"
            MinWidth="0"
            Margin="0"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            IsAddTabButtonVisible="False"
            CanDragTabs="True"
            CanReorderTabs="True"
            AllowDrop="True"
            AllowDropTabs="True"
            CanTearOutTabs="False"
            TabWidthMode="SizeToContent"
            Visibility="Collapsed"
            SelectionChanged="TabsView_SelectionChanged"
            TabDragStarting="TabsView_TabDragStarting"
            TabDragCompleted="TabsView_TabDragCompleted"
            TabStripDragOver="TabsView_TabStripDragOver"
            PointerEntered="TabsPanel_PointerEntered"
            PointerExited="TabsPanel_PointerExited">
            <TabView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <!-- Translucent semantic fills preserve the widget's material.
                             Keep the native template, including its joined lower corners. -->
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{ThemeResource TextFillColorPrimary}" Opacity="0.09" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{ThemeResource TextFillColorPrimary}" Opacity="0.045" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="{ThemeResource TextFillColorPrimary}" Opacity="0.03" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="TabViewBorderBrush" Color="{ThemeResource TextFillColorPrimary}" Opacity="0.10" />
                            <SolidColorBrush x:Key="TabViewItemSeparator" Color="{ThemeResource TextFillColorPrimary}" Opacity="0.08" />
                            <LinearGradientBrush x:Key="TabViewSelectedItemBorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,4" Opacity="0.10">
                                <LinearGradientBrush.RelativeTransform>
                                    <ScaleTransform ScaleY="-1" CenterY="0.5" />
                                </LinearGradientBrush.RelativeTransform>
                                <GradientStop Offset="1" Color="Transparent" />
                                <GradientStop Offset="1" Color="{ThemeResource TextFillColorPrimary}" />
                            </LinearGradientBrush>
                            <!-- The host updates these brushes in place for custom
                                 widget foreground colors. High contrast stays system-owned. -->
                            <SolidColorBrush x:Key="TabViewItemHeaderForeground" Color="{ThemeResource TextFillColorSecondary}" />
                            <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="{ThemeResource TextFillColorPrimary}" />
                            <SolidColorBrush x:Key="TabViewItemHeaderForegroundPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                            <SolidColorBrush x:Key="TabViewItemHeaderForegroundPressed" Color="{ThemeResource TextFillColorSecondary}" />
                            <SolidColorBrush x:Key="TabViewItemHeaderForegroundDisabled" Color="{ThemeResource TextFillColorDisabled}" />
                            <SolidColorBrush x:Key="TabViewScrollButtonForeground" Color="{ThemeResource TextFillColorSecondary}" />
                            <SolidColorBrush x:Key="TabViewScrollButtonForegroundPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                            <SolidColorBrush x:Key="TabViewScrollButtonForegroundPressed" Color="{ThemeResource TextFillColorSecondary}" />
                            <SolidColorBrush x:Key="TabViewScrollButtonForegroundDisabled" Color="{ThemeResource TextFillColorDisabled}" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{ThemeResource SystemColorWindowColor}" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundDisabled" Color="{ThemeResource SystemColorWindowColor}" />
                            <SolidColorBrush x:Key="TabViewBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="TabViewItemSeparator" Color="{ThemeResource SystemColorWindowTextColor}" />
                            <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="TabViewItemHeaderForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
                            <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="TabViewItemHeaderForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            <SolidColorBrush x:Key="TabViewItemHeaderForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            <SolidColorBrush x:Key="TabViewItemHeaderForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                            <SolidColorBrush x:Key="TabViewScrollButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
                            <SolidColorBrush x:Key="TabViewScrollButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            <SolidColorBrush x:Key="TabViewScrollButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            <SolidColorBrush x:Key="TabViewScrollButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                    <x:Double x:Key="TabViewItemMinWidth">32</x:Double>
                    <x:Double x:Key="TabViewItemMaxWidth">180</x:Double>
                    <x:Double x:Key="TabViewItemMinHeight">32</x:Double>
                </ResourceDictionary>
            </TabView.Resources>
        </TabView>

        <!--
            Directional wheel feedback lives above both stack and tab title
            presentations. The accent fades from the approached edge toward
            the center, so it reads as motion intent without obscuring text.
        -->
        <Grid
            x:Name="WheelDirectionFeedbackLayer"
            Canvas.ZIndex="2"
            IsHitTestVisible="False">
            <Border
                x:Name="UpWheelFeedback"
                Height="16"
                Margin="0,2,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                CornerRadius="7,7,0,0"
                Opacity="0"
                RenderTransformOrigin="0.5,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop x:Name="UpWheelFeedbackAccentStart" Offset="0" />
                        <GradientStop x:Name="UpWheelFeedbackAccentEnd" Offset="0.24" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="UpWheelFeedbackTransform" ScaleY="1" />
                </Border.RenderTransform>
            </Border>
            <Border
                x:Name="DownWheelFeedback"
                Height="16"
                Margin="0,0,0,4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                CornerRadius="0,0,7,7"
                Opacity="0"
                RenderTransformOrigin="0.5,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                        <GradientStop x:Name="DownWheelFeedbackAccentStart" Offset="0" />
                        <GradientStop x:Name="DownWheelFeedbackAccentEnd" Offset="0.24" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DownWheelFeedbackTransform" ScaleY="1" />
                </Border.RenderTransform>
            </Border>
        </Grid>
    </Grid>
</UserControl>
