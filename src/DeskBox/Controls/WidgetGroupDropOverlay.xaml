<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetGroupDropOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsHitTestVisible="False"
    IsTabStop="False"
    mc:Ignorable="d">

    <Grid>
        <!--  Whole-surface wash and outer frame: target content beneath is dimmed by WidgetShell.  -->
        <Border
            x:Name="MaskBorder"
            BorderBrush="Transparent"
            BorderThickness="1.5" />

        <!--  Title fast-lane highlight when aiming at the header strip.  -->
        <Border
            x:Name="TitleHighlight"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            BorderBrush="Transparent"
            BorderThickness="2"
            CornerRadius="6"
            Visibility="Collapsed" />

        <!--  High-contrast solid pill badge so icon + caption never collide with underlying content.  -->
        <Border
            x:Name="BadgeBorder"
            Padding="13,8,15,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            BorderThickness="1"
            CornerRadius="20">
            <Border.RenderTransform>
                <TranslateTransform x:Name="BadgeTranslate" />
            </Border.RenderTransform>
            <StackPanel
                Orientation="Horizontal"
                Spacing="9"
                VerticalAlignment="Center">
                <Grid
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center">
                    <Border
                        x:Name="RingHost"
                        Width="24"
                        Height="24" />
                    <FontIcon
                        x:Name="StateIcon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xE8F1;" />
                </Grid>
                <TextBlock
                    x:Name="StateLabel"
                    MaxWidth="210"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
