<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetGroupDropOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:DeskBox.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsHitTestVisible="False"
    IsTabStop="False"
    mc:Ignorable="d">

    <!-- Re-scope text foregrounds to the overlay's own ActualTheme so widget-level
         mutable foreground overrides never invert contrast over the acrylic plate. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4000000" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#93000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Single outer frame matching the widget surface corner radius; no wash over header or content. -->
        <Border
            x:Name="MaskBorder"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1" />

        <!-- Windows 11 Fluent flyout chip: 8 DIP corner radius, in-app acrylic plate, 1px hairline stroke, 16px status slot. -->
        <Border
            x:Name="BadgeBorder"
            MinHeight="34"
            Padding="12,7"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource SystemControlAcrylicElementBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Border.RenderTransform>
                <TranslateTransform x:Name="BadgeTranslate" />
            </Border.RenderTransform>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Grid
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center">
                    <Border
                        x:Name="RingHost"
                        Width="16"
                        Height="16" />
                    <FontIcon
                        x:Name="StateIcon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Glyph="&#xE73E;"
                        Visibility="Collapsed" />
                </Grid>
                <TextBlock
                    x:Name="StateLabel"
                    MaxWidth="216"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Normal"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="WrapWholeWords"
                    helpers:WidgetTextShadow.Cast="False" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
