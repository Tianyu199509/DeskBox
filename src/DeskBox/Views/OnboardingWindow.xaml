                                        <Grid Margin="13" RowDefinitions="Auto,*" RowSpacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE73E;"/>
                                                <Border Width="40" Height="4" VerticalAlignment="Center" Background="{ThemeResource TextFillColorSecondaryBrush}" CornerRadius="2" Opacity="0.46"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Spacing="7">
                                                <Border Height="5" Background="{ThemeResource TextFillColorSecondaryBrush}" CornerRadius="3" Opacity="0.20"/>
                                                <Border Width="72" Height="5" HorizontalAlignment="Left" Background="{ThemeResource TextFillColorSecondaryBrush}" CornerRadius="3" Opacity="0.14"/>
