<?xml version="1.0" encoding="utf-8"?>
<!-- Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V5 · macrostructure: Guided workbench · genre: playful · tone: practical and reassuring · palette: existing WinUI resources · slop: pass -->
<Window
    x:Class="DeskBox.Views.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeskBox.Controls"
    xmlns:svc="using:DeskBox.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DeskBox Onboarding">

    <Grid
        x:Name="RootGrid"
        MinWidth="660"
        MinHeight="540"
        Padding="40"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

        <Grid.Resources>
            <!-- ── Shared text styles ── -->
            <Style x:Key="StepEyebrowText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Style>
            <Style x:Key="StepTitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="34"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="StepBodyText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="LineHeight" Value="21"/>
                <Setter Property="TextWrapping" Value="WrapWholeWords"/>
            </Style>

            <!-- ── Card style ── -->
            <Style x:Key="SettingCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,14"/>
            </Style>

            <!-- ── Feature card style ── -->
            <Style x:Key="FeatureCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="18,16"/>
            </Style>

            <!-- ── Value highlight card style ── -->
            <Style x:Key="ValueCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="20,18"/>
            </Style>

            <!-- ── Hint row style ── -->
            <Style x:Key="HintIcon" TargetType="FontIcon">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Lightweight visual guidance: one shared surface, icons inline with actions. -->
            <Style x:Key="VisualStageLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
            </Style>
            <Style x:Key="StatusBadge" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="13,10"/>
            </Style>
            <Style x:Key="TaskVisualSurface" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="Padding" Value="24"/>
            </Style>
            <Style x:Key="TaskStepBadge" TargetType="Border">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="10,5"/>
            </Style>
            <Style x:Key="FeatureChoiceCard" TargetType="Border">
                <Setter Property="MinHeight" Value="94"/>
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="14"/>
            </Style>
            <Style x:Key="FeatureHintBar" TargetType="Border">
                <Setter Property="MinHeight" Value="48"/>
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="14,9"/>
            </Style>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Low-contrast theme-aware depth behind the guided workbench. -->
        <Border
            Grid.RowSpan="3"
            Width="360"
            Height="360"
            Margin="0,-210,-170,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            CornerRadius="180"
            IsHitTestVisible="False"
            Opacity="0.035"/>
        <Border
            Grid.RowSpan="3"
            Width="280"
            Height="280"
            Margin="-170,0,0,-190"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            CornerRadius="140"
            IsHitTestVisible="False"
            Opacity="0.025"/>

        <!-- ═════════════ Title Bar ═════════════ -->
        <Grid x:Name="TitleBarHost" Height="36" Margin="-40,-40,-40,6" Background="Transparent"/>

        <!-- ═════════════ Content Area ═════════════ -->
        <ScrollViewer
            x:Name="ContentScrollViewer"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">

            <Grid x:Name="StepContainer" MinHeight="420">

                <!-- Hallmark · Workbench task flow · existing WinUI theme · motion restrained -->
                <StackPanel
                    x:Name="TaskStep1Panel"
                    MaxWidth="700"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="22"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image Width="28" Height="28" Source="ms-appx:///Assets/deskbox.svg"/>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="DeskBox"/>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource StepTitleText}" svc:Localized.Key="Onboarding.Task.Step1.Title"/>
                        <TextBlock
                            MaxWidth="600"
                            HorizontalAlignment="Left"
                            Style="{StaticResource StepBodyText}"
                            svc:Localized.Key="Onboarding.Task.Step1.Body"/>
                    </StackPanel>
                    <Border Style="{StaticResource FeatureCard}" Padding="20,18">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Grid Width="48" Height="48" VerticalAlignment="Center">
                                <Border
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="10"
                                    Opacity="0.12"/>
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="21"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE8B7;"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    svc:Localized.Key="Onboarding.Task.Step1.LocationTitle"/>
                                <TextBlock
                                    Style="{StaticResource StepBodyText}"
                                    svc:Localized.Key="Onboarding.Task.Step1.LocationBody"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="1.08*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Style="{StaticResource SettingCard}">
                            <StackPanel Spacing="6">
                                <FontIcon
                                    HorizontalAlignment="Left"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE72E;"/>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    svc:Localized.Key="Onboarding.Task.Step1.LocalTitle"/>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    svc:Localized.Key="Onboarding.Task.Step1.LocalBody"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource SettingCard}">
                            <StackPanel Spacing="6">
                                <FontIcon
                                    HorizontalAlignment="Left"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE7E8;"/>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    svc:Localized.Key="Onboarding.Task.Step1.ToggleTitle"/>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    svc:Localized.Key="Onboarding.Task.Step1.ToggleBody"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <Grid
                    x:Name="TaskStep2Panel"
                    MaxWidth="820"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <Grid
                        x:Name="TaskStep2Layout"
                        ColumnDefinitions="0.88*,1.12*"
                        ColumnSpacing="36"
                        RowDefinitions="Auto,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="18">
                            <Border Style="{StaticResource TaskStepBadge}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="03  /  04"/>
                            </Border>
                            <StackPanel Spacing="9">
                                <TextBlock Style="{StaticResource StepTitleText}" svc:Localized.Key="Onboarding.Task.Step4.TrayTitle"/>
                                <TextBlock
                                    MaxWidth="320"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource StepBodyText}"
                                    svc:Localized.Key="Onboarding.Task.Step4.TrayBody"/>
                            </StackPanel>
                            <Button
                                x:Name="TaskStep2OpenTrayMenuButton"
                                MinHeight="42"
                                HorizontalAlignment="Left"
                                Click="TaskStep4OpenTrayMenu_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                svc:Localized.Key="Onboarding.Task.Step4.TrayButton"/>
                        </StackPanel>

                        <Border x:Name="TaskStep2VisualStage" Grid.Column="1" Style="{StaticResource TaskVisualSurface}">
                            <Grid Height="350">
                                <Border
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <Grid RowDefinitions="Auto,*,Auto">
                                        <Grid Height="38" Margin="14,0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Image Width="18" Height="18" VerticalAlignment="Center" Source="ms-appx:///Assets/deskbox.svg"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="DeskBox"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="14,2,14,12" ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="*,*" RowSpacing="10" Opacity="0.82">
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8"/>
                                            <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8"/>
                                            <Border Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8"/>
                                            <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8"/>
                                        </Grid>
                                        <Border
                                            Grid.Row="2"
                                            Height="48"
                                            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                                            CornerRadius="0,0,14,14">
                                            <Grid Margin="14,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                <Border Height="3" VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" CornerRadius="2"/>
                                                <FontIcon Grid.Column="1" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE70E;"/>
                                                <Grid Grid.Column="2" Width="32" Height="32" VerticalAlignment="Center">
                                                    <Border
                                                        x:Name="TaskStep2TrayHalo"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="16"
                                                        Opacity="0.18"/>
                                                    <Image Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Source="ms-appx:///Assets/deskbox.svg"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border
                                    x:Name="TaskStep2MenuPreview"
                                    Width="248"
                                    Margin="0,0,26,66"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Margin="8,5,8,7" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" svc:Localized.Key="Onboarding.Step2.TrayActionTitle"/>
                                        <Grid MinHeight="38" Margin="8,0" ColumnDefinitions="Auto,*" ColumnSpacing="11">
                                            <FontIcon VerticalAlignment="Center" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE710;"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" svc:Localized.Key="Onboarding.Task.Step4.ManagedEntry"/>
                                        </Grid>
                                        <Grid MinHeight="38" Margin="8,0" ColumnDefinitions="Auto,*" ColumnSpacing="11">
                                            <FontIcon VerticalAlignment="Center" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8B7;"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" svc:Localized.Key="Onboarding.Task.Step4.MappedEntry"/>
                                        </Grid>
                                        <Rectangle Height="1" Margin="6,2" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                        <Grid MinHeight="38" Margin="8,0" ColumnDefinitions="Auto,*" ColumnSpacing="11">
                                            <FontIcon VerticalAlignment="Center" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE713;"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" svc:Localized.Key="Onboarding.Task.Step5.Settings"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid
                    x:Name="TaskStep3Panel"
                    MaxWidth="820"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <Grid
                        x:Name="TaskStep3Layout"
                        ColumnDefinitions="0.88*,1.12*"
                        ColumnSpacing="36"
                        RowDefinitions="Auto,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="18">
                            <Border Style="{StaticResource TaskStepBadge}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="01  /  04"/>
                            </Border>
                            <StackPanel Spacing="9">
                                <TextBlock Style="{StaticResource StepTitleText}" svc:Localized.Key="Onboarding.Task.Step3.Title"/>
                                <TextBlock
                                    MaxWidth="320"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource StepBodyText}"
                                    svc:Localized.Key="Onboarding.Task.Step3.Body"/>
                            </StackPanel>
                            <Border x:Name="TaskStep3StatusBadge" Style="{StaticResource StatusBadge}" MaxWidth="320" HorizontalAlignment="Left">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <FontIcon
                                        x:Name="TaskStep3StatusIcon"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE946;"/>
                                    <TextBlock
                                        x:Name="TaskStep3StatusText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource HintText}"
                                        TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border x:Name="TaskStep3VisualStage" Grid.Column="1" Style="{StaticResource TaskVisualSurface}">
                            <Grid Height="350" RowDefinitions="Auto,*" RowSpacing="18">
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <Border Padding="9,7" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="9">
                                        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                            <FontIcon FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE7C1;"/>
                                            <TextBlock Style="{StaticResource VisualStageLabel}" svc:Localized.Key="Onboarding.Task.Step3.DragTitle"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Padding="9,7" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="9">
                                        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                            <FontIcon FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE77F;"/>
                                            <TextBlock Style="{StaticResource VisualStageLabel}" svc:Localized.Key="Onboarding.Task.Step3.PasteTitle"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Padding="9,7" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="9">
                                        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                            <FontIcon FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE710;"/>
                                            <TextBlock Style="{StaticResource VisualStageLabel}" svc:Localized.Key="Onboarding.Task.Step3.AddTitle"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Path
                                        Margin="54,26,100,56"
                                        Data="M 34,185 C 112,164 134,84 236,76"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                        StrokeDashArray="3,4"
                                        StrokeThickness="2"
                                        Opacity="0.42"/>

                                    <Border
                                        x:Name="TaskStep3FileToken"
                                        Width="116"
                                        Height="58"
                                        Margin="4,0,0,38"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="11">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                            <Grid Width="32" Height="32" VerticalAlignment="Center">
                                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8" Opacity="0.14"/>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="PDF"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <Border Height="4" Background="{ThemeResource TextFillColorSecondaryBrush}" CornerRadius="2" Opacity="0.62"/>
                                                <Border Width="34" Height="4" HorizontalAlignment="Left" Background="{ThemeResource TextFillColorSecondaryBrush}" CornerRadius="2" Opacity="0.28"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Width="224"
                                        Height="190"
                                        Margin="0,14,4,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="15"
                                        Padding="14">
                                        <Grid RowDefinitions="Auto,*" RowSpacing="12">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <FontIcon VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8B7;"/>
                                                <Border Grid.Column="1" Width="48" Height="4" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{ThemeResource TextFillColorSecondaryBrush}" CornerRadius="2" Opacity="0.55"/>
                                                <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE712;"/>
                                            </Grid>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="*,*" RowSpacing="10">
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="9"/>
                                                <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="9"/>
                                                <Border Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="9"/>
                                                <Grid Grid.Row="1" Grid.Column="1">
                                                    <Border
                                                        x:Name="TaskStep3DropHalo"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="9"
                                                        Opacity="0.13"/>
                                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="19" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE710;"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid
                    x:Name="TaskStep4Panel"
                    MaxWidth="820"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <Grid
                        x:Name="TaskStep4Layout"
                        ColumnDefinitions="0.88*,1.12*"
                        ColumnSpacing="36"
                        RowDefinitions="Auto,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="18">
                            <Border Style="{StaticResource TaskStepBadge}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="02  /  04"/>
                            </Border>
                            <StackPanel Spacing="9">
                                <TextBlock Style="{StaticResource StepTitleText}" svc:Localized.Key="Onboarding.Task.Step4.Title"/>
                                <TextBlock
                                    MaxWidth="320"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource StepBodyText}"
                                    svc:Localized.Key="Onboarding.Task.Step4.Body"/>
                            </StackPanel>
                            <StackPanel Spacing="10">
                                <TextBlock
                                    x:Name="TaskStep4HotkeyText"
                                    MaxWidth="320"
                                    FontSize="12.5"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    LineHeight="19"
                                    TextWrapping="Wrap"/>
                                <Button
                                    x:Name="TaskStep4ToggleButton"
                                    MinHeight="42"
                                    HorizontalAlignment="Left"
                                    Click="TaskStep4ToggleWidgets_Click"
                                    svc:Localized.Key="Onboarding.Task.Step4.ToggleButton"/>
                            </StackPanel>
                            <Border x:Name="TaskStep4StatusBadge" Style="{StaticResource StatusBadge}" HorizontalAlignment="Left" MaxWidth="320">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <FontIcon
                                        x:Name="TaskStep4StatusIcon"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE946;"/>
                                    <TextBlock x:Name="TaskStep4StatusText" Grid.Column="1" Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border x:Name="TaskStep4VisualStage" Grid.Column="1" Style="{StaticResource TaskVisualSurface}">
                            <Grid Height="350">
                                <Border
                                    Margin="0,14,22,22"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <Grid RowDefinitions="40,*">
                                        <Grid Margin="14,0" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.30"/>
                                            <Ellipse Grid.Column="1" Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.22"/>
                                            <Ellipse Grid.Column="2" Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.16"/>
                                            <Border Grid.Column="3" Height="20" Margin="16,0,0,0" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10"/>
                                        </Grid>
