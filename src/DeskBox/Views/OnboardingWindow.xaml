                                            </StackPanel>
                                            <Grid Grid.Row="1" Margin="0,12,0,0" ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <Border Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" CornerRadius="7" Opacity="0.16"/>
                                                <Border Grid.Column="1" Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" CornerRadius="7" Opacity="0.16"/>
                                            </Grid>
                                        </Grid>
