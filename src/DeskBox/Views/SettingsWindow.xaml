                                x:Name="AutomaticBackupSubPagePanel"
                                Visibility="Collapsed"
                                Margin="0,8,0,0"
                                Spacing="4">
                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    svc:Localized.DescriptionKey="Settings.DataBackup.AutomaticBackup.Description"
                                    svc:Localized.HeaderKey="Settings.DataBackup.AutomaticBackup.Title">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE823;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <ToggleSwitch svc:Localized.AutomationNameKey="Settings.DataBackup.AutomaticBackup.Title"
                                        OnContent=""
                                        OffContent=""
                                        MinWidth="0"
                                        IsOn="{Binding LocalBackupEnabled, Mode=TwoWay}" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    svc:Localized.DescriptionKey="Settings.DataBackup.AutomaticBackupInterval.Description"
                                    svc:Localized.HeaderKey="Settings.DataBackup.AutomaticBackupInterval.Title">
                                    <ComboBox svc:Localized.AutomationNameKey="Settings.DataBackup.AutomaticBackupInterval.Title"
                                        MinWidth="150"
                                        IsEnabled="{Binding LocalBackupEnabled}"
                                        ItemsSource="{Binding AvailableLocalIntervalOptions}"
                                        controls:SettingsComboBox.Value="{Binding SelectedLocalIntervalMinutes, Mode=TwoWay}" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    svc:Localized.DescriptionKey="Settings.DataBackup.AutomaticBackupRetention.Description"
                                    svc:Localized.HeaderKey="Settings.DataBackup.AutomaticBackupRetention.Title">
                                    <ComboBox svc:Localized.AutomationNameKey="Settings.DataBackup.AutomaticBackupRetention.Title"
