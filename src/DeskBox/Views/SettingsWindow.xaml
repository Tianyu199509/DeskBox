                        <sections:DisplaySettingsSection x:Name="DisplaysSection" Visibility="Collapsed" />
                    </DataTemplate>
                    <DataTemplate x:Key="FileStackSettingsSectionTemplate" x:DataType="fileStack:FileStackSettingsViewModel">
                        <StackPanel
                            x:Name="FileStackSettingsSection"
                            Visibility="Collapsed"
                            Style="{StaticResource SectionPanelStyle}">
                            <StackPanel Margin="0,8,0,0" Spacing="4">
                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    svc:Localized.DescriptionKey="Settings.FileStacks.Auto.Description"
                                    svc:Localized.HeaderKey="Settings.FileStacks.Auto.Title">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE81E;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <ToggleSwitch svc:Localized.AutomationNameKey="Settings.FileStacks.Auto.Title"
                                        OnContent=""
                                        OffContent=""
                                        MinWidth="0"
                                        IsOn="{Binding AutoStacking, Mode=TwoWay}" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    svc:Localized.DescriptionKey="Settings.FileStacks.OpenMode.Description"
                                    svc:Localized.HeaderKey="Settings.FileStacks.OpenMode.Title">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE8E5;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <toolkit:Segmented
                                        controls:SettingsSegmented.Options="{x:Bind AvailableOpenModeOptions, Mode=OneWay}"
                                        controls:SettingsSegmented.Value="{x:Bind OpenMode, Mode=TwoWay}"
                                        svc:Localized.AutomationNameKey="Settings.FileStacks.OpenMode.Title" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    Visibility="{Binding IsPopoverOpenMode, Converter={StaticResource SettingsBoolToVisibilityConverter}}"
                                    svc:Localized.DescriptionKey="Settings.FileStacks.PopoverLayout.Description"
                                    svc:Localized.HeaderKey="Settings.FileStacks.PopoverLayout.Title">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xECA5;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <toolkit:Segmented
                                        controls:SettingsSegmented.Options="{x:Bind AvailablePopoverLayoutOptions, Mode=OneWay}"
                                        controls:SettingsSegmented.Value="{x:Bind PopoverLayout, Mode=TwoWay}"
                                        svc:Localized.AutomationNameKey="Settings.FileStacks.PopoverLayout.Title" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    Visibility="{Binding IsPopoverOpenMode, Converter={StaticResource SettingsBoolToVisibilityConverter}}"
                                    svc:Localized.DescriptionKey="Settings.FileStacks.PopoverStyle.Description"
                                    svc:Localized.HeaderKey="Settings.FileStacks.PopoverStyle.Title"
                                    svc:InfoTip.TitleKey="Settings.FileStacks.PopoverStyle.InfoTip.Title"
                                    svc:InfoTip.BodyKey="Settings.FileStacks.PopoverStyle.InfoTip.Description">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE790;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <ComboBox svc:Localized.AutomationNameKey="Settings.FileStacks.PopoverStyle.Title"
                                        MinWidth="{StaticResource SettingsControlMinWidth}"
                                        ItemsSource="{x:Bind AvailablePopoverStyleOptions, Mode=OneWay}"
                                        controls:SettingsComboBox.Value="{x:Bind PopoverStyle, Mode=TwoWay}" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    IsEnabled="{Binding AutoStacking}"
                                    svc:Localized.DescriptionKey="Settings.FileStacks.Threshold.Description"
                                    svc:Localized.HeaderKey="Settings.FileStacks.Threshold.Title">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE8EF;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <ComboBox svc:Localized.AutomationNameKey="Settings.FileStacks.Threshold.Title"
                                        MinWidth="{StaticResource SettingsControlMinWidth}"
                                        ItemsSource="{Binding AvailableThresholdOptions}"
                                        controls:SettingsComboBox.Value="{Binding Threshold, Mode=TwoWay}" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    IsEnabled="{Binding AutoStacking}"
                                    svc:Localized.DescriptionKey="Settings.FileStacks.GroupBy.Description"
                                    svc:Localized.HeaderKey="Settings.FileStacks.GroupBy.Title">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE8FD;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <ComboBox svc:Localized.AutomationNameKey="Settings.FileStacks.GroupBy.Title"
                                        MinWidth="{StaticResource SettingsControlMinWidth}"
                                        ItemsSource="{Binding AvailableGroupByOptions}"
                                        controls:SettingsComboBox.Value="{Binding GroupBy, Mode=TwoWay}" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    IsEnabled="{Binding AutoStacking}"
                                    Visibility="{Binding ShowCustomRules, Converter={StaticResource SettingsBoolToVisibilityConverter}}"
                                    svc:Localized.DescriptionKey="Settings.FileStacks.Unmatched.Description"
                                    svc:Localized.HeaderKey="Settings.FileStacks.Unmatched.Title">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <ComboBox svc:Localized.AutomationNameKey="Settings.FileStacks.Unmatched.Title"
                                        MinWidth="{StaticResource SettingsControlMinWidth}"
                                        ItemsSource="{Binding AvailableUnmatchedBehaviorOptions}"
                                        controls:SettingsComboBox.Value="{Binding UnmatchedBehavior, Mode=TwoWay}" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    svc:Localized.DescriptionKey="Settings.FileStacks.OrderBy.Description"
                                    svc:Localized.HeaderKey="Settings.FileStacks.OrderBy.Title">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE8CB;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <ComboBox svc:Localized.AutomationNameKey="Settings.FileStacks.OrderBy.Title"
                                        MinWidth="{StaticResource SettingsControlMinWidth}"
                                        ItemsSource="{Binding AvailableOrderByOptions}"
                                        controls:SettingsComboBox.Value="{Binding OrderBy, Mode=TwoWay}" />
                                </toolkit:SettingsCard>

                                <StackPanel
                                    Spacing="4"
                                    Visibility="{Binding ShowCustomRules, Converter={StaticResource SettingsBoolToVisibilityConverter}}">

                                    <Border Style="{StaticResource SettingsGroupStyle}">
                                        <StackPanel Padding="16,14" Spacing="12">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <TextBlock
                                                        Style="{StaticResource SettingTitleTextStyle}"
                                                        svc:Localized.Key="Settings.FileStacks.Custom.Rules.Title" />
                                                    <TextBlock
                                                        Style="{StaticResource SettingDescriptionTextStyle}"
                                                        svc:Localized.Key="Settings.FileStacks.Custom.Rules.Description" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    Click="AddFileStackRuleButton_Click"
                                                    IsEnabled="{Binding CanAddRule}"
                                                    Style="{StaticResource ActionButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                                                        <TextBlock svc:Localized.Key="Settings.FileStacks.Custom.AddRule" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <TextBlock
                                                Style="{StaticResource SettingDescriptionTextStyle}"
                                                svc:Localized.Key="Settings.FileStacks.Custom.Empty"
                                                Visibility="{Binding HasNoRules, Converter={StaticResource SettingsBoolToVisibilityConverter}}" />

                                            <ListView
                                                x:Name="FileStackRulesListView"
                                                AllowDrop="True"
                                                Background="Transparent"
                                                CanDragItems="True"
                                                CanReorderItems="True"
                                                DragItemsCompleted="FileStackRulesListView_DragItemsCompleted"
                                                Loaded="FileStackRulesListView_Loaded"
                                                IsEnabled="{Binding AutoStacking}"
                                                ItemsSource="{x:Bind CustomRules, Mode=OneWay}"
                                                ReorderMode="Enabled"
                                                SelectionMode="None"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid
                                                            Padding="0,10"
                                                            ColumnDefinitions="Auto,*"
                                                            ColumnSpacing="10"
                                                            RowDefinitions="Auto,Auto,Auto"
                                                            RowSpacing="8">
                                                            <FontIcon
                                                                Grid.Row="0"
                                                                Grid.RowSpan="3"
                                                                Grid.Column="0"
                                                                FontSize="14"
                                                                Glyph="&#xE700;"
                                                                Opacity="0.7"
                                                                svc:Localized.ToolTipKey="Settings.FileStacks.Custom.DragTooltip"
                                                                VerticalAlignment="Center" />
                                                            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    Style="{StaticResource SettingValueTextStyle}"
                                                                    Text="{Binding PriorityText}"
                                                                    VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                                    <Button svc:Localized.AutomationNameKey="Settings.FileStacks.Custom.MoveUp"
                                                                        Click="MoveFileStackRuleUpButton_Click"
                                                                        IsEnabled="{Binding CanMoveUp}"
                                                                        Style="{StaticResource IconActionButtonStyle}"
                                                                        svc:Localized.ToolTipKey="Settings.FileStacks.Custom.MoveUp">
                                                                        <FontIcon FontSize="16" Glyph="&#xE70E;" />
                                                                    </Button>
                                                                    <Button svc:Localized.AutomationNameKey="Settings.FileStacks.Custom.MoveDown"
                                                                        Click="MoveFileStackRuleDownButton_Click"
                                                                        IsEnabled="{Binding CanMoveDown}"
                                                                        Style="{StaticResource IconActionButtonStyle}"
                                                                        svc:Localized.ToolTipKey="Settings.FileStacks.Custom.MoveDown">
                                                                        <FontIcon FontSize="16" Glyph="&#xE70D;" />
                                                                    </Button>
                                                                    <Button svc:Localized.AutomationNameKey="Settings.FileStacks.Custom.Remove"
                                                                        Click="RemoveFileStackRuleButton_Click"
                                                                        Style="{StaticResource IconActionButtonStyle}"
                                                                        svc:Localized.ToolTipKey="Settings.FileStacks.Custom.Remove">
                                                                        <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="2*,3*" ColumnSpacing="10">
                                                                <TextBox svc:Localized.AutomationNameKey="Settings.FileStacks.Custom.Name"
                                                                    Grid.Column="0"
                                                                    MaxLength="80"
                                                                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    svc:Localized.HeaderKey="Settings.FileStacks.Custom.Name" />
                                                                <TextBox svc:Localized.AutomationNameKey="Settings.FileStacks.Custom.Extensions"
                                                                    Grid.Column="1"
                                                                    MaxLength="1024"
                                                                    svc:Localized.PlaceholderKey="Settings.FileStacks.Custom.Extensions.Placeholder"
                                                                    Text="{Binding ExtensionsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    svc:Localized.HeaderKey="Settings.FileStacks.Custom.Extensions" />
                                                            </Grid>
                                                            <TextBlock
                                                                Grid.Row="2"
                                                                Grid.Column="1"
                                                                Style="{StaticResource SettingDescriptionTextStyle}"
                                                                Text="{Binding PreviewText}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>

                                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.35" />
                                            <TextBlock
                                                Style="{StaticResource SettingDescriptionTextStyle}"
                                                Text="{Binding PreviewSummaryText}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate x:Key="InteractionSectionTemplate" x:DataType="viewModels:SettingsViewModel">
                        <StackPanel
                            x:Name="InteractionSection"
                            Visibility="Collapsed"
                            Style="{StaticResource SectionPanelStyle}">
                            <StackPanel x:Name="InteractionOverviewPanel" Spacing="4">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level1" svc:Localized.Key="Settings.Section.Interaction" />

                            <StackPanel Style="{StaticResource SettingsSubsectionHeaderStyle}">
                                <TextBlock Style="{StaticResource SettingsSubsectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" svc:Localized.Key="Settings.Interaction.Group.Invocation" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    Description="{Binding HotkeyStatusText}"
                                    svc:Localized.HeaderKey="Settings.GlobalHotkey.Title"
                                    svc:InfoTip.TitleKey="Settings.GlobalHotkey.ElevatedNotice.Title"
                                    svc:InfoTip.BodyKey="Settings.GlobalHotkey.ElevatedNotice.Description">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE765;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <Grid x:Name="GlobalHotkeyCustomRow" VerticalAlignment="Center">
                                        <Grid
                                            x:Name="GlobalHotkeyActionsPanel"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                x:Name="GlobalHotkeyCaptureButton"
                                                Grid.Column="0"
                                                Click="ChangeGlobalHotkeyButton_Click"
                                                Style="{StaticResource ShortcutCaptureButtonStyle}"
                                                svc:Localized.ToolTipKey="Settings.GlobalHotkey.ChangeTooltip" />
                                            <ToggleSwitch svc:Localized.AutomationNameKey="Settings.GlobalHotkey.Title"
                                                Grid.Column="1"
                                                MinWidth="0"
                                                VerticalAlignment="Center"
                                                IsOn="{Binding HotkeyEnabled, Mode=TwoWay}"
                                                OffContent=""
                                                OnContent="" />
                                        </Grid>
                                    </Grid>
                                </toolkit:SettingsCard>

                                <InfoBar
                                    x:Name="GlobalHotkeyReservedWarning"
                                    IsClosable="False"
                                    IsOpen="{Binding CanShowHotkeyWarning, Mode=OneWay}"
                                    Message="{Binding HotkeyWarningText}"
                                    Severity="Warning"
                                    Title="{Binding HotkeyText}" />

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    svc:Localized.DescriptionKey="Settings.DesktopDoubleClick.Description"
                                    svc:Localized.HeaderKey="Settings.DesktopDoubleClick.Title"
                                    svc:InfoTip.TitleKey="Settings.DesktopDoubleClick.InfoTip.Title"
                                    svc:InfoTip.BodyKey="Settings.DesktopDoubleClick.InfoTip.Description">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE8B0;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <ToggleSwitch svc:Localized.AutomationNameKey="Settings.DesktopDoubleClick.Title"
                                        x:Name="DesktopDoubleClickToggle"
                                        MinWidth="0"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="DesktopDoubleClickToggle_Toggled" />
                                </toolkit:SettingsCard>
                            </StackPanel>

                            <StackPanel Style="{StaticResource SettingsSubsectionHeaderStyle}">
                                <TextBlock Style="{StaticResource SettingsSubsectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" svc:Localized.Key="Settings.Interaction.Group.Layout" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <toolkit:SettingsCard
                                    x:Name="CapsuleModeEntryCard"
                                    Click="CapsuleModeEntryCard_Click"
                                    HorizontalContentAlignment="Right"
                                    IsClickEnabled="True"
                                    svc:Localized.HeaderKey="Settings.Section.CapsuleMode">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE73F;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <ComboBox
                                        x:Name="CapsuleModeEntryComboBox"
                                        DisplayMemberPath="DisplayName"
                                        MinWidth="{StaticResource SettingsControlMinWidth}"
                                        SelectionChanged="CapsuleModeEntryComboBox_SelectionChanged"
                                        svc:Localized.AutomationNameKey="Settings.CollapseBehavior.Title" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    Click="NestedSettingsButton_Click"
                                    Description="{x:Bind WidgetGroupsEntrySummary, Mode=OneWay}"
                                    HorizontalContentAlignment="Right"
                                    IsClickEnabled="True"
                                    Tag="WidgetGroups"
                                    svc:Localized.HeaderKey="Settings.Section.WidgetGroups">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE8A1;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    x:Name="DisplaysEntryCard"
                                    Click="NestedSettingsButton_Click"
                                    HorizontalContentAlignment="Right"
                                    IsClickEnabled="True"
                                    Tag="Displays"
                                    svc:Localized.DescriptionKey="Settings.Displays.Description"
                                    svc:Localized.HeaderKey="Settings.Displays.Title">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE7F4;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                </toolkit:SettingsCard>
                            </StackPanel>

                            <StackPanel Style="{StaticResource SettingsSubsectionHeaderStyle}">
                                <TextBlock Style="{StaticResource SettingsSubsectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" svc:Localized.Key="Settings.Interaction.Group.WindowBehavior" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <toolkit:SettingsExpander
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="False"
                                    svc:Localized.DescriptionKey="Settings.WidgetLayerMode.Description"
                                    svc:Localized.HeaderKey="Settings.WidgetLayerMode.Title"
                                    svc:InfoTip.TitleKey="Settings.WidgetLayer.InfoTip.Title"
                                    svc:InfoTip.BodyKey="Settings.WidgetLayer.InfoTip.Description">
                                    <toolkit:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE81E;" />
                                    </toolkit:SettingsExpander.HeaderIcon>
                                    <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetLayerMode.Title"
                                        MinWidth="{StaticResource SettingsControlMinWidth}"
                                        ItemsSource="{Binding AvailableLayerModeOptions}"
                                        controls:SettingsComboBox.Value="{Binding LayerMode, Mode=TwoWay}" />
                                    <toolkit:SettingsExpander.Items>
                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            IsEnabled="{Binding IsDynamicLayerMode}"
                                            svc:Localized.DescriptionKey="Settings.ClickRaiseScope.Description"
                                            svc:Localized.HeaderKey="Settings.ClickRaiseScope.Title">
                                            <ComboBox svc:Localized.AutomationNameKey="Settings.ClickRaiseScope.Title"
                                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                                ItemsSource="{Binding AvailableClickRaiseScopeOptions}"
                                                controls:SettingsComboBox.Value="{Binding ClickRaiseScope, Mode=TwoWay}" />
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            svc:Localized.DescriptionKey="Settings.ShowDesktopBehavior.Description"
                                            svc:Localized.HeaderKey="Settings.ShowDesktopBehavior.Title">
                                            <ComboBox svc:Localized.AutomationNameKey="Settings.ShowDesktopBehavior.Title"
                                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                                ItemsSource="{Binding AvailableShowDesktopBehaviorOptions}"
                                                controls:SettingsComboBox.Value="{Binding ShowDesktopBehavior, Mode=TwoWay}" />
                                        </toolkit:SettingsCard>
                                    </toolkit:SettingsExpander.Items>
                                </toolkit:SettingsExpander>

                                <toolkit:SettingsExpander
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="False"
                                    svc:Localized.DescriptionKey="Settings.ResizeSnap.Description"
                                    svc:Localized.HeaderKey="Settings.ResizeSnap.Title"
                                    svc:InfoTip.TitleKey="Settings.ResizeSnap.InfoTip.Title"
                                    svc:InfoTip.BodyKey="Settings.ResizeSnap.InfoTip.Description">
                                    <toolkit:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE742;" />
                                    </toolkit:SettingsExpander.HeaderIcon>
                                    <ToggleSwitch svc:Localized.AutomationNameKey="Settings.ResizeSnap.Title"
                                        MinWidth="0"
                                        IsOn="{Binding SnapEnabled, Mode=TwoWay}"
                                        OffContent=""
                                        OnContent="" />
                                    <toolkit:SettingsExpander.Items>
                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            IsEnabled="{Binding SnapEnabled}"
                                            svc:Localized.DescriptionKey="Settings.WidgetSnap.Spacing.Description"
                                            svc:Localized.HeaderKey="Settings.WidgetSnap.Spacing.Title">
                                            <StackPanel
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <TextBlock
                                                    Style="{StaticResource SliderSettingValueTextStyle}"
                                                    Text="{Binding SnapSpacingText}" />
                                                <Slider svc:Localized.AutomationNameKey="Settings.WidgetSnap.Spacing.Title"
                                                    Maximum="32"
                                                    Minimum="0"
                                                    StepFrequency="1"
                                                    Style="{StaticResource InlineMetricSliderStyle}"
                                                    Value="{Binding SnapSpacing, Mode=TwoWay}" />
