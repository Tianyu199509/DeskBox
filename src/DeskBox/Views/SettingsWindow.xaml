                                                <CheckBox MinWidth="0" IsEnabled="{Binding ActionsEnabled}" IsChecked="{Binding IncludeTodoData, Mode=TwoWay}" svc:Localized.AutomationNameKey="Settings.CloudBackup.TodoData.Title">
                                                    <TextBlock svc:Localized.Key="Settings.CloudBackup.TodoData.Title" />
                                                </CheckBox>
                                                <CheckBox MinWidth="0" IsEnabled="{Binding ActionsEnabled}" IsChecked="{Binding IncludeQuickCaptureData, Mode=TwoWay}" svc:Localized.AutomationNameKey="Settings.CloudBackup.QuickCaptureData.Title">
                                                    <TextBlock svc:Localized.Key="Settings.CloudBackup.QuickCaptureData.Title" />
                                                </CheckBox>
                                                <CheckBox MinWidth="0" IsEnabled="{Binding ActionsEnabled}" IsChecked="{Binding IncludeWidgetStyle, Mode=TwoWay}" svc:Localized.AutomationNameKey="Settings.CloudBackup.WidgetStyle.Title">
                                                    <TextBlock svc:Localized.Key="Settings.CloudBackup.WidgetStyle.Title" />
                                                </CheckBox>
                                                <CheckBox MinWidth="0" IsEnabled="{Binding ActionsEnabled}" IsChecked="{Binding IncludeCustomWidgets, Mode=TwoWay}" svc:Localized.AutomationNameKey="Settings.CloudBackup.CustomWidgets.Title">
                                                    <TextBlock svc:Localized.Key="Settings.CloudBackup.CustomWidgets.Title" />
                                                </CheckBox>
                                            </controls:WrapFlowPanel>
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            IsEnabled="{Binding CloudBackupEnabled}"
                                            svc:Localized.DescriptionKey="Settings.CloudBackup.Interval.Description"
                                            svc:Localized.HeaderKey="Settings.CloudBackup.Interval.Title">
                                            <ComboBox svc:Localized.AutomationNameKey="Settings.CloudBackup.Interval.Title"
                                                MinWidth="150"
                                                IsEnabled="{Binding ActionsEnabled}"
                                                ItemsSource="{Binding AvailableIntervalOptions}"
                                                controls:SettingsComboBox.Value="{Binding SelectedIntervalMinutes, Mode=TwoWay}" />
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            IsEnabled="{Binding CloudBackupEnabled}"
                                            svc:Localized.DescriptionKey="Settings.CloudBackup.Retention.Description"
                                            svc:Localized.HeaderKey="Settings.CloudBackup.Retention.Title">
                                            <ComboBox svc:Localized.AutomationNameKey="Settings.CloudBackup.Retention.Title"
                                                MinWidth="150"
                                                IsEnabled="{Binding ActionsEnabled}"
                                                ItemsSource="{Binding AvailableRetentionOptions}"
                                                controls:SettingsComboBox.Value="{Binding SelectedRetentionCount, Mode=TwoWay}" />
                                        </toolkit:SettingsCard>
                                    </toolkit:SettingsExpander.Items>
                                </toolkit:SettingsExpander>

                                <toolkit:SettingsExpander
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="True"
                                    svc:Localized.DescriptionKey="Settings.CloudBackup.Snapshots.Description"
                                    svc:Localized.HeaderKey="Settings.CloudBackup.Snapshots.Title"
                                    svc:InfoTip.TitleKey="Settings.CloudBackup.Snapshots.InfoTip.Title"
                                    svc:InfoTip.BodyKey="Settings.CloudBackup.Snapshots.InfoTip.Description">
                                    <toolkit:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE823;" />
                                    </toolkit:SettingsExpander.HeaderIcon>
                                    <toolkit:SettingsExpander.Items>
                                        <toolkit:SettingsCard
                                            ContentAlignment="Vertical"
                                            HorizontalContentAlignment="Stretch"
                                            IsEnabled="{Binding CloudBackupEnabled}">
                                            <StackPanel Spacing="12">
                                                <controls:WrapFlowPanel HorizontalSpacing="8" VerticalSpacing="8">
                                                    <Button x:Name="CloudBackupNowButton" Click="CloudBackupNowButton_Click" IsEnabled="{Binding ActionsEnabled}" Style="{StaticResource ActionButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontSize="16" Glyph="&#xE74E;" /><TextBlock svc:Localized.Key="Settings.CloudBackup.BackupNow" /></StackPanel>
                                                    </Button>
                                                    <Button x:Name="CloudBackupRefreshSnapshotsButton" Click="CloudBackupRefreshSnapshotsButton_Click" IsEnabled="{Binding ActionsEnabled}" Style="{StaticResource ActionButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="16" /><TextBlock svc:Localized.Key="Settings.CloudBackup.RefreshSnapshots" /></StackPanel>
                                                    </Button>
                                                </controls:WrapFlowPanel>
                                                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" Text="{Binding StatusText}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="CloudBackupSnapshotsEmptyHint" Style="{StaticResource SettingDescriptionTextStyle}" Visibility="Collapsed" svc:Localized.Key="Settings.CloudBackup.SnapshotList.Empty" />
                                                <ListView x:Name="CloudBackupSnapshotsList" SelectionMode="None" IsItemClickEnabled="False" IsEnabled="{Binding ActionsEnabled}">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="backup:CloudBackupRemoteSnapshotItem">
                                                            <Border Padding="10,8" Margin="0,2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource SettingsCardCornerRadius}">
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" Text="{x:Bind Details, Mode=OneTime}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                        <Button Click="CloudBackupRestoreSnapshotButton_Click" Style="{StaticResource ActionButtonStyle}">
                                                                            <TextBlock svc:Localized.Key="Settings.CloudBackup.Restore" />
                                                                        </Button>
                                                                        <Button Click="CloudBackupDeleteSnapshotButton_Click" Style="{StaticResource DangerActionButtonStyle}">
                                                                            <TextBlock svc:Localized.Key="Common.Delete" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </StackPanel>
                                        </toolkit:SettingsCard>
                                    </toolkit:SettingsExpander.Items>
                                </toolkit:SettingsExpander>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate x:Key="AboutSectionTemplate" x:DataType="viewModels:SettingsViewModel">
