                                        </CheckBox>
                                        <CheckBox svc:Localized.AutomationNameKey="Settings.Weather.ShowSunrise.Title" MinWidth="0" IsChecked="{Binding ShowSunrise, Mode=TwoWay}">
                                            <TextBlock svc:Localized.Key="Settings.Weather.ShowSunrise.Title" />
                                        </CheckBox>
                                        <CheckBox svc:Localized.AutomationNameKey="Settings.Weather.ShowUvIndex.Title" MinWidth="0" IsChecked="{Binding ShowUvIndex, Mode=TwoWay}">
                                            <TextBlock svc:Localized.Key="Settings.Weather.ShowUvIndex.Title" />
                                        </CheckBox>
                                        <CheckBox svc:Localized.AutomationNameKey="Settings.Weather.ShowPrecipitation.Title" MinWidth="0" IsChecked="{Binding ShowPrecipitation, Mode=TwoWay}">
                                            <TextBlock svc:Localized.Key="Settings.Weather.ShowPrecipitation.Title" />
                                        </CheckBox>
                                        <CheckBox svc:Localized.AutomationNameKey="Settings.Weather.ShowHumidity.Title" MinWidth="0" IsChecked="{Binding ShowHumidity, Mode=TwoWay}">
                                            <TextBlock svc:Localized.Key="Settings.Weather.ShowHumidity.Title" />
                                        </CheckBox>
                                        <CheckBox svc:Localized.AutomationNameKey="Settings.Weather.ShowWind.Title" MinWidth="0" IsChecked="{Binding ShowWind, Mode=TwoWay}">
                                            <TextBlock svc:Localized.Key="Settings.Weather.ShowWind.Title" />
                                        </CheckBox>
                                        <CheckBox svc:Localized.AutomationNameKey="Settings.Weather.ShowPressure.Title" MinWidth="0" IsChecked="{Binding ShowPressure, Mode=TwoWay}">
                                            <TextBlock svc:Localized.Key="Settings.Weather.ShowPressure.Title" />
                                        </CheckBox>
