                                            </Button>
                                            <Button x:Name="RestoreDataBackupButton" Click="RestoreDataBackupButton_Click" Style="{StaticResource ActionButtonStyle}" svc:Localized.ToolTipKey="Settings.DataBackup.RestoreTooltip">
                                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontSize="16" Glyph="&#xE777;" /><TextBlock svc:Localized.Key="Settings.DataBackup.Restore" /></StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </toolkit:SettingsCard>

                                    <toolkit:SettingsCard
                                        x:Name="AutomaticBackupEntryCard"
                                        Click="AutomaticBackupEntryCard_Click"
                                        HorizontalContentAlignment="Right"
                                        IsClickEnabled="True"
