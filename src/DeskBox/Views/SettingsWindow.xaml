                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level1" svc:Localized.Key="Settings.Section.Maintenance" />
                                <StackPanel Margin="0,8,0,0" Spacing="4">
                                    <InfoBar
                                        x:Name="StoreUninstallDataNoticeInfoBar"
                                        IsClosable="False"
                                        IsIconVisible="True"
                                        IsOpen="True"
