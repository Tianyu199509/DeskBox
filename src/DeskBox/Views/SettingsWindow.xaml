                                        IsEnabled="{Binding LocalBackupEnabled}"
                                        ItemsSource="{Binding AvailableLocalRetentionOptions}"
                                        controls:SettingsComboBox.Value="{Binding SelectedLocalRetentionCount, Mode=TwoWay}" />
