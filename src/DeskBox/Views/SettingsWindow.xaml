                                        x:Name="CloudBackupEntryCard"
                                        Click="CloudBackupEntryCard_Click"
                                        HorizontalContentAlignment="Right"
                                        IsClickEnabled="True"
                                        svc:Localized.HeaderKey="Settings.CloudBackup.Title"
                                        svc:InfoTip.TitleKey="Settings.CloudBackup.SyncNotice.Title"
                                        svc:InfoTip.BodyKey="Settings.CloudBackup.SyncNotice.Description">
                                        <toolkit:SettingsCard.HeaderIcon>
                                            <FontIcon Glyph="&#xE753;" />
                                        </toolkit:SettingsCard.HeaderIcon>
                                        <ToggleSwitch svc:Localized.AutomationNameKey="Settings.CloudBackup.Title"
                                            x:Name="CloudBackupEntryToggle"
                                            MinWidth="0"
                                            OffContent=""
                                            OnContent=""
                                            Toggled="CloudBackupEntryToggle_Toggled" />
                                    </toolkit:SettingsCard>

                                    <toolkit:SettingsCard
                                        HorizontalContentAlignment="Right"
                                        svc:Localized.DescriptionKey="Settings.Restore.Description"
