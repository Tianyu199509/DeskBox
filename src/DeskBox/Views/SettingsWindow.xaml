<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskBox.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media.Imaging"
    xmlns:controls="using:DeskBox.Controls"
    xmlns:sections="using:DeskBox.Views.SettingsSections"
    xmlns:viewModels="using:DeskBox.ViewModels"
    xmlns:fileStack="using:DeskBox.Features.FileStack"
    xmlns:music="using:DeskBox.Features.Music"
    xmlns:quickCapture="using:DeskBox.Features.QuickCapture"
    xmlns:todo="using:DeskBox.Features.Todo"
    xmlns:interaction="using:DeskBox.Features.Interaction"
    xmlns:backup="using:DeskBox.Features.Backup"
    xmlns:svc="using:DeskBox.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DeskBox Settings">

    <Grid
        x:Name="SettingsRoot"
        IsTabStop="True"
        KeyboardAcceleratorPlacementMode="Hidden"
        Background="Transparent">
        <Grid.KeyboardAccelerators>
            <!-- Ctrl+F jumps to the settings search box; F6 cycles the three
                 focus regions (search / navigation pane / content); Alt+Left
                 and Browser Back pop nested settings pages. WinUI 3 desktop
                 has no built-in F6/FocusScope cycling, so the rotation lives
                 in SettingsWindow.KeyboardNavigation.cs.
                 PlacementMode=Hidden: XAML-declared accelerators are otherwise
                 auto-surfaced as a tooltip on their owner element, and since
                 this grid spans the whole window a "Ctrl+F" bubble popped
                 whenever the pointer rested anywhere in settings. -->
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="SearchFocusAccelerator_Invoked" />
            <KeyboardAccelerator Key="F6" Invoked="RegionCycleAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Menu" Key="Left" Invoked="BackNavigationAccelerator_Invoked" />
            <!-- VirtualKey.GoBack (166) is handled in SettingsRoot_KeyDown: WinUI 3's native XAML parser rejects Key="GoBack" at runtime. -->
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
                </ResourceDictionary.MergedDictionaries>
            <x:Double x:Key="NavigationViewCompactPaneLength">48</x:Double>
            <x:Double x:Key="NavigationViewItemOnLeftMinHeight">40</x:Double>
            <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">20</x:Double>
            <Thickness x:Key="NavigationViewItemOnLeftIconBoxMargin">0</Thickness>
            <Thickness x:Key="NavigationViewItemButtonMargin">4,1,4,1</Thickness>

            <!-- Shared settings-page metrics keep top-level and drill-down pages aligned. -->
            <controls:SettingsBoolToVisibilityConverter x:Key="SettingsBoolToVisibilityConverter" />
            <controls:SettingsColorStringConverter x:Key="SettingsColorStringConverter" />
            <x:Double x:Key="SettingsContentMaxWidth">1000</x:Double>
            <x:Double x:Key="SettingsRowColumnSpacing">18</x:Double>

            <Style x:Key="BreadcrumbTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="SettingsNavImageIconStyle" TargetType="ImageIcon">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
            </Style>

            <Style x:Key="SettingRowStyle" TargetType="Grid">
                <Setter Property="Tag" Value="SettingRow" />
                <Setter Property="MinHeight" Value="{StaticResource SettingsRowMinHeight}" />
                <Setter Property="Padding" Value="{StaticResource SettingsRowPadding}" />
                <Setter Property="ColumnSpacing" Value="{StaticResource SettingsRowColumnSpacing}" />
                <Setter Property="RowSpacing" Value="8" />
            </Style>

            <Style x:Key="SettingTextPanelStyle" TargetType="StackPanel">
                <Setter Property="Spacing" Value="3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="16,0,0,0" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="Opacity" Value="0.72" />
            </Style>

            <Style x:Key="InlineMetricSliderStyle" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
                <Setter Property="Width" Value="200" />
                <Setter Property="MinWidth" Value="160" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsThumbToolTipEnabled" Value="False" />
            </Style>

            <Style x:Key="SliderSettingValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingValueTextStyle}">
                <Setter Property="MinWidth" Value="42" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CompactNumberBoxStyle" TargetType="NumberBox">
                <Setter Property="Width" Value="128" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CompactTextActionButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="MinWidth" Value="54" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="138" />
            </Grid.ColumnDefinitions>
            <Grid
                x:Name="TitleTextHost"
                Grid.Column="1"
                Margin="16,0,12,0"
                VerticalAlignment="Center"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    Grid.Column="0"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center">
                    <Image.Source>
                        <media:SvgImageSource UriSource="ms-appx:///Assets/deskbox.svg" />
                    </Image.Source>
                </Image>
                <TextBlock
                    x:Name="AppTitleTextBlock"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    MaxLines="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    svc:Localized.Key="Settings.WindowTitle" />
            </Grid>
        </Grid>

        <!-- Deep review R13 (R12 debt ①): a settings commit the main process
             refused (or whose pipe round trip failed) used to vanish into
             the host log while the user kept editing a surface that would
             not persist. Hosted in its own Auto flow row below AppTitleBar so
             it pushes content down instead of occluding the breadcrumb or
             top settings cards. Wired only by App.SettingsHost. -->
        <InfoBar
            x:Name="SaveFailedInfoBar"
            Grid.Row="1"
            Margin="16,4,16,4"
            HorizontalAlignment="Stretch"
            IsClosable="True"
            IsOpen="False"
            Severity="Warning"
            Visibility="Collapsed" />

        <NavigationView
            x:Name="SettingsNavigationView"
            Grid.Row="2"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="True"
            IsPaneOpen="True"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="260"
            PaneDisplayMode="Left"
            BackRequested="SettingsNavigationView_BackRequested"
            ItemInvoked="SettingsNavigationView_ItemInvoked"
            SelectionChanged="SettingsNavigationView_SelectionChanged">
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox svc:Localized.AutomationNameKey="Settings.Search.Placeholder"
                    x:Name="SettingsSearchBox"
                    VerticalAlignment="Center"
                    QueryIcon="Find"
                    GotFocus="SettingsSearchBox_GotFocus"
                    QuerySubmitted="SettingsSearchBox_QuerySubmitted"
                    TextChanged="SettingsSearchBox_TextChanged">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="8,6" Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    MaxLines="1"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <!-- Collapses for the single-line "no results" sentinel,
                                     which carries no breadcrumb. -->
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    Text="{Binding Breadcrumb}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{Binding HasBreadcrumb, Converter={StaticResource SettingsBoolToVisibilityConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="GeneralNavItem"
                    Tag="General"
                    svc:Localized.Key="Settings.Nav.General">
                    <NavigationViewItem.Icon>
                        <ImageIcon Style="{StaticResource SettingsNavImageIconStyle}">
                            <ImageIcon.Source>
                                <media:SvgImageSource UriSource="ms-appx:///Assets/SettingsNavIcons/general.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Tag="Appearance"
                    svc:Localized.Key="Settings.Nav.Appearance">
                    <NavigationViewItem.Icon>
                        <ImageIcon Style="{StaticResource SettingsNavImageIconStyle}">
                            <ImageIcon.Source>
                                <media:SvgImageSource UriSource="ms-appx:///Assets/SettingsNavIcons/appearance.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="InteractionNavItem"
                    Tag="Interaction"
                    svc:Localized.Key="Settings.Nav.Interaction">
                    <NavigationViewItem.Icon>
                        <ImageIcon Style="{StaticResource SettingsNavImageIconStyle}">
                            <ImageIcon.Source>
                                <media:SvgImageSource UriSource="ms-appx:///Assets/SettingsNavIcons/interaction.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="FileWidgetNavItem"
                    Tag="AppearanceDetail"
                    svc:Localized.Key="Settings.Nav.FileWidget">
                    <NavigationViewItem.Icon>
                        <ImageIcon Style="{StaticResource SettingsNavImageIconStyle}">
                            <ImageIcon.Source>
                                <media:SvgImageSource UriSource="ms-appx:///Assets/SettingsNavIcons/file-widget.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="FeatureWidgetsNavItem"
                    Tag="FeatureWidgets"
                    svc:Localized.Key="Settings.Nav.FeatureWidgets">
                    <NavigationViewItem.Icon>
                        <ImageIcon Style="{StaticResource SettingsNavImageIconStyle}">
                            <ImageIcon.Source>
                                <media:SvgImageSource UriSource="ms-appx:///Assets/SettingsNavIcons/feature-widgets.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="SearchNavItem"
                    Tag="SearchSettings"
                    svc:Localized.Key="Settings.Search.Title">
                    <NavigationViewItem.Icon>
                        <ImageIcon Style="{StaticResource SettingsNavImageIconStyle}">
                            <ImageIcon.Source>
                                <media:SvgImageSource UriSource="ms-appx:///Assets/SettingsNavIcons/search.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="MaintenanceNavItem"
                    Tag="Maintenance"
                    svc:Localized.Key="Settings.Nav.Maintenance">
                    <NavigationViewItem.Icon>
                        <ImageIcon Style="{StaticResource SettingsNavImageIconStyle}">
                            <ImageIcon.Source>
                                <media:SvgImageSource UriSource="ms-appx:///Assets/SettingsNavIcons/maintenance.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Tag="About"
                    svc:Localized.Key="Settings.Nav.About">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Visibility="{x:Bind ViewModel.UpdateReminderBadgeVisibility, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                    <NavigationViewItem.Icon>
                        <ImageIcon Style="{StaticResource SettingsNavImageIconStyle}">
                            <ImageIcon.Source>
                                <media:SvgImageSource UriSource="ms-appx:///Assets/SettingsNavIcons/about.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid x:Name="SettingsContentRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="SettingsBreadcrumbHost"
                    Grid.Row="0"
                    Padding="20,16,20,0"
                    Visibility="Collapsed">
                    <BreadcrumbBar
                        x:Name="SettingsBreadcrumbBar"
                        Width="{StaticResource SettingsContentMaxWidth}"
                        MaxWidth="{StaticResource SettingsContentMaxWidth}"
                        HorizontalAlignment="Left"
                        ItemClicked="SettingsBreadcrumbBar_ItemClicked"
                        Visibility="Collapsed">
                        <BreadcrumbBar.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BreadcrumbTextStyle}"
                                        Text="{Binding Title}"
                                        Visibility="{Binding IsAncestor, Converter={StaticResource SettingsBoolToVisibilityConverter}}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Style="{StaticResource BreadcrumbTextStyle}"
                                        Text="{Binding Title}"
                                        Visibility="{Binding IsCurrent, Converter={StaticResource SettingsBoolToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </BreadcrumbBar.ItemTemplate>
                    </BreadcrumbBar>
                </Grid>

                <ScrollViewer
                    x:Name="PageScroller"
                    Grid.Row="1"
                    Padding="36,16,36,38"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        x:Name="ContentHost"
                        Width="{StaticResource SettingsContentMaxWidth}"
                        MaxWidth="{StaticResource SettingsContentMaxWidth}"
                        HorizontalAlignment="Left"
                        Spacing="16">
                <StackPanel.Resources>
                    <DataTemplate x:Key="AppearanceSectionTemplate" x:DataType="viewModels:SettingsViewModel">
                        <sections:AppearanceSettingsSection
                            x:Name="AppearanceSection"
                            Visibility="Collapsed"
                            NavigationRequested="SettingsSection_NavigationRequested"
                            ChooseBackgroundImageRequested="AppearanceSection_ChooseBackgroundImageRequested"
                            ClearPerWidgetBackgroundsRequested="AppearanceSection_ClearPerWidgetBackgroundsRequested"
                            OpenSystemTransparencyRequested="AppearanceSection_OpenSystemTransparencyRequested"
                            SliderDragStarted="AppearanceSection_SliderDragStarted"
                            SliderDragCompleted="AppearanceSection_SliderDragCompleted" />
                    </DataTemplate>
                    <DataTemplate x:Key="WidgetGroupsSectionTemplate" x:DataType="viewModels:SettingsViewModel">
                        <StackPanel
                            x:Name="WidgetGroupsSection"
                            Visibility="Collapsed"
                            Style="{StaticResource SectionPanelStyle}">
                            <StackPanel x:Name="WidgetGroupsOverviewPanel" Margin="0,8,0,0" Spacing="4">
                                <toolkit:SettingsExpander
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="False"
                                    svc:Localized.DescriptionKey="Settings.WidgetGroups.Defaults.Description"
                                    svc:Localized.HeaderKey="Settings.WidgetGroups.Defaults.Title">
                                    <toolkit:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </toolkit:SettingsExpander.HeaderIcon>
                                    <toolkit:SettingsExpander.Items>
                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            svc:Localized.DescriptionKey="Settings.WidgetGroupNavigation.Description"
                                            svc:Localized.HeaderKey="Settings.WidgetGroupNavigation.Title">
                                            <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetGroupNavigation.Title"
                                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                                ItemsSource="{Binding AvailableNavigationStyleOptions}"
                                                controls:SettingsComboBox.Value="{Binding DefaultNavigationStyle, Mode=TwoWay}" />
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            svc:Localized.DescriptionKey="Settings.WidgetGroupTitle.Description"
                                            svc:Localized.HeaderKey="Settings.WidgetGroupTitle.Title">
                                            <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetGroupTitle.Title"
                                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                                ItemsSource="{Binding AvailableTitleDisplayModeOptions}"
                                                controls:SettingsComboBox.Value="{Binding DefaultTitleDisplayMode, Mode=TwoWay}" />
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            svc:Localized.DescriptionKey="Settings.WidgetGroupSwitchAnimation.Description"
                                            svc:Localized.HeaderKey="Settings.WidgetGroupSwitchAnimation.Title">
                                            <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetGroupSwitchAnimation.Title"
                                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                                ItemsSource="{Binding AvailableSwitchAnimationOptions}"
                                                controls:SettingsComboBox.Value="{Binding DefaultSwitchAnimationStyle, Mode=TwoWay}" />
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            svc:Localized.DescriptionKey="Settings.WidgetGroupWheel.Description"
                                            svc:Localized.HeaderKey="Settings.WidgetGroupWheel.Title">
                                            <ToggleSwitch svc:Localized.AutomationNameKey="Settings.WidgetGroupWheel.Title"
                                                MinWidth="0"
                                                OffContent=""
                                                OnContent=""
                                                IsOn="{Binding WheelSwitchEnabled, Mode=TwoWay}" />
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            IsEnabled="{Binding IsDefaultHoverSwitchApplicable}"
                                            svc:Localized.DescriptionKey="Settings.WidgetGroupHover.Description"
                                            svc:Localized.HeaderKey="Settings.WidgetGroupHover.Title">
                                            <ToggleSwitch svc:Localized.AutomationNameKey="Settings.WidgetGroupHover.Title"
                                                MinWidth="0"
                                                OffContent=""
                                                OnContent=""
                                                IsOn="{Binding HoverSwitchEnabled, Mode=TwoWay}" />
                                        </toolkit:SettingsCard>
                                    </toolkit:SettingsExpander.Items>
                                </toolkit:SettingsExpander>

                                <StackPanel Style="{StaticResource SettingsSubsectionHeaderStyle}">
                                    <TextBlock Style="{StaticResource SettingsSubsectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" svc:Localized.Key="Settings.WidgetGroups.Existing.Title" />
                                    <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" svc:Localized.Key="Settings.WidgetGroups.Existing.Description" />
                                </StackPanel>

                                <toolkit:SettingsCard
                                    Visibility="{Binding ShowExistingGroupsEmpty, Converter={StaticResource SettingsBoolToVisibilityConverter}}"
                                    svc:Localized.DescriptionKey="Settings.WidgetGroups.Existing.Empty.Description"
                                    svc:Localized.HeaderKey="Settings.WidgetGroups.Existing.Empty.Title">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE73E;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                </toolkit:SettingsCard>

                                <ItemsControl
                                    ItemsSource="{Binding ExistingGroups}"
                                    Visibility="{Binding HasExistingGroups, Converter={StaticResource SettingsBoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <toolkit:SettingsCard
                                                Margin="0,0,0,4"
                                                Click="WidgetGroupItemCard_Click"
                                                Description="{Binding Summary}"
                                                Header="{Binding DisplayName}"
                                                HorizontalContentAlignment="Right"
                                                IsClickEnabled="True">
                                                <toolkit:SettingsCard.HeaderIcon>
                                                    <FontIcon Glyph="&#xE8A1;" />
                                                </toolkit:SettingsCard.HeaderIcon>
                                            </toolkit:SettingsCard>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel
                                x:Name="WidgetGroupDetailSubPagePanel"
                                Visibility="Collapsed"
                                Margin="0,8,0,0"
                                Spacing="4">
                                <ContentControl
                                    x:Name="WidgetGroupDetailPresenter"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="4">
                                                <toolkit:SettingsExpander
                                                    HorizontalContentAlignment="Stretch"
                                                    IsExpanded="True"
                                                    svc:Localized.HeaderKey="Settings.WidgetGroups.Detail.Appearance">
                                                    <toolkit:SettingsExpander.HeaderIcon>
                                                        <FontIcon Glyph="&#xE790;" />
                                                    </toolkit:SettingsExpander.HeaderIcon>
                                                    <toolkit:SettingsExpander.Items>
                                                        <toolkit:SettingsCard
                                                            HorizontalContentAlignment="Right"
                                                            svc:Localized.HeaderKey="Settings.WidgetGroups.Existing.Rename.Title">
                                                            <Grid MinWidth="240" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <TextBox
                                                                    Grid.Column="0"
                                                                    MaxLength="60"
                                                                    KeyDown="WidgetGroupRenameTextBox_KeyDown"
                                                                    Tag="{Binding GroupId}"
                                                                    Text="{Binding RawName, Mode=OneWay}"
                                                                    svc:Localized.AutomationNameKey="Settings.WidgetGroups.Existing.Rename.Title"
                                                                    svc:Localized.PlaceholderKey="Settings.WidgetGroups.Existing.Rename.Placeholder" />
                                                                <Button
                                                                    Grid.Column="1"
                                                                    Click="SaveWidgetGroupRenameButton_Click"
                                                                    Style="{StaticResource ActionButtonStyle}"
                                                                    Tag="{Binding GroupId}">
                                                                    <TextBlock svc:Localized.Key="Common.Save" />
                                                                </Button>
                                                            </Grid>
                                                        </toolkit:SettingsCard>

                                                        <toolkit:SettingsCard
                                                            HorizontalContentAlignment="Right"
                                                            svc:Localized.DescriptionKey="Settings.WidgetGroupNavigation.Description"
                                                            svc:Localized.HeaderKey="Settings.WidgetGroupNavigation.Title">
                                                            <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetGroupNavigation.Title"
                                                                MinWidth="220"
                                                                ItemsSource="{Binding NavigationOptions}"
                                                                SelectionChanged="WidgetGroupNavigationComboBox_SelectionChanged"
                                                                Tag="{Binding GroupId}"
                                                                controls:SettingsComboBox.Value="{Binding NavigationStyle, Mode=OneWay}" />
                                                        </toolkit:SettingsCard>

                                                        <toolkit:SettingsCard
                                                            HorizontalContentAlignment="Right"
                                                            svc:Localized.DescriptionKey="Settings.WidgetGroupTitle.Description"
                                                            svc:Localized.HeaderKey="Settings.WidgetGroupTitle.Title">
                                                            <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetGroupTitle.Title"
                                                                MinWidth="220"
                                                                ItemsSource="{Binding TitleOptions}"
                                                                SelectionChanged="WidgetGroupTitleComboBox_SelectionChanged"
                                                                Tag="{Binding GroupId}"
                                                                controls:SettingsComboBox.Value="{Binding TitleDisplayMode, Mode=OneWay}" />
                                                        </toolkit:SettingsCard>

                                                        <toolkit:SettingsCard
                                                            HorizontalContentAlignment="Right"
                                                            svc:Localized.DescriptionKey="Settings.WidgetGroups.GroupChrome.Description"
                                                            svc:Localized.HeaderKey="Settings.WidgetGroups.GroupChrome.Title">
                                                            <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetGroups.GroupChrome.Title"
                                                                MinWidth="220"
                                                                ItemsSource="{Binding ChromeOptions}"
                                                                SelectionChanged="WidgetGroupChromeComboBox_SelectionChanged"
                                                                Tag="{Binding GroupId}"
                                                                controls:SettingsComboBox.Value="{Binding ChromeMode, Mode=OneWay}" />
                                                        </toolkit:SettingsCard>
                                                    </toolkit:SettingsExpander.Items>
                                                </toolkit:SettingsExpander>

                                                <toolkit:SettingsExpander
                                                    HorizontalContentAlignment="Stretch"
                                                    IsExpanded="True"
                                                    svc:Localized.HeaderKey="Settings.WidgetGroups.Detail.Interaction">
                                                    <toolkit:SettingsExpander.HeaderIcon>
                                                        <FontIcon Glyph="&#xE8AB;" />
                                                    </toolkit:SettingsExpander.HeaderIcon>
                                                    <toolkit:SettingsExpander.Items>
                                                        <toolkit:SettingsCard
                                                            HorizontalContentAlignment="Right"
                                                            svc:Localized.DescriptionKey="Settings.WidgetGroups.GroupDisplay.Description"
                                                            svc:Localized.HeaderKey="Settings.WidgetGroups.GroupDisplay.Title">
                                                            <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetGroups.GroupDisplay.Title"
                                                                MinWidth="220"
                                                                ItemsSource="{Binding CollapseOptions}"
                                                                SelectionChanged="WidgetGroupCollapseComboBox_SelectionChanged"
                                                                Tag="{Binding GroupId}"
                                                                controls:SettingsComboBox.Value="{Binding CollapseBehavior, Mode=OneWay}" />
                                                        </toolkit:SettingsCard>

                                                        <toolkit:SettingsCard
                                                            HorizontalContentAlignment="Right"
                                                            svc:Localized.DescriptionKey="Settings.WidgetGroupWheel.Description"
                                                            svc:Localized.HeaderKey="Settings.WidgetGroupWheel.Title">
                                                            <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetGroupWheel.Title"
                                                                MinWidth="220"
                                                                ItemsSource="{Binding WheelOptions}"
                                                                SelectionChanged="WidgetGroupWheelComboBox_SelectionChanged"
                                                                Tag="{Binding GroupId}"
                                                                controls:SettingsComboBox.Value="{Binding WheelSetting, Mode=OneWay}" />
                                                        </toolkit:SettingsCard>

                                                        <toolkit:SettingsCard
                                                            HorizontalContentAlignment="Right"
                                                            IsEnabled="{Binding IsHoverSwitchApplicable}"
                                                            svc:Localized.DescriptionKey="Settings.WidgetGroupHover.Description"
                                                            svc:Localized.HeaderKey="Settings.WidgetGroupHover.Title">
                                                            <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetGroupHover.Title"
                                                                MinWidth="220"
