                    <DataTemplate x:Key="AppearanceDetailSectionTemplate" x:DataType="viewModels:SettingsViewModel">
                        <sections:FileWidgetSettingsSection
                            x:Name="AppearanceDetailSection"
                            Visibility="Collapsed"
                            NavigationRequested="SettingsSection_NavigationRequested"
                            SubPageChanged="AppearanceDetailSection_SubPageChanged"
                            OpenStoragePathRequested="OpenManagedStoragePathButton_Click"
                            ChangeStoragePathRequested="ChangeManagedStoragePathButton_Click"
                            QuickAccessToggled="AppearanceDetailSection_QuickAccessToggled"
                            DesktopShortcutToggled="AppearanceDetailSection_DesktopShortcutToggled"
                            ManageOrphanFoldersRequested="ManageOrphanFoldersButton_Click"
