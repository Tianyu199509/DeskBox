                                                x:Name="ResetAutomaticBackupDirectoryButton"
                                                Grid.Column="2"
                                                Click="ResetAutomaticBackupDirectoryButton_Click"
                                                Style="{StaticResource ActionButtonStyle}">
                                                <TextBlock svc:Localized.Key="Settings.DataBackup.AutomaticBackupDirectory.Reset" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </toolkit:SettingsCard>

