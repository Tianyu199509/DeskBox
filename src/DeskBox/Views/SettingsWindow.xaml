                            svc:Localized.HeaderKey="Settings.CloudBackup.SyncNotice.Title" />

                        <!-- Store-channel data disclosure (same contract as
                             the sync notice above): Windows clears the
                             package-managed app-data folder on uninstall, so
                             local snapshots only survive in Store builds via
                             export or the WebDAV remote. -->
                        <InfoBar
                            x:Name="StoreUninstallDataNoticeInfoBar"
                            IsClosable="False"
