                    <DataTemplate x:Key="DataHealthSettingsSectionTemplate" x:DataType="viewModels:SettingsViewModel">
                        <StackPanel
                    x:Name="DataHealthSettingsSection"
                    Visibility="Collapsed"
                    Style="{StaticResource SectionPanelStyle}">
                    <StackPanel Margin="0,8,0,0" Spacing="4">
                        <toolkit:SettingsCard
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch"
                            svc:Localized.DescriptionKey="Settings.AttachmentHealth.Description"
                            svc:Localized.HeaderKey="Settings.AttachmentHealth.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE9D9;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock
                                    x:Name="AttachmentHealthSummaryText"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SettingDescriptionTextStyle}"
                                    TextWrapping="Wrap"
                                    svc:Localized.Key="Settings.AttachmentHealth.NotChecked" />
                                <Button
                                    x:Name="CheckAttachmentHealthButton"
                                    Grid.Column="1"
                                    Click="CheckAttachmentHealthButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"
                                    svc:Localized.ToolTipKey="Settings.AttachmentHealth.CheckTooltip">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                        <TextBlock svc:Localized.Key="Settings.AttachmentHealth.Check" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </toolkit:SettingsCard>
                    </StackPanel>
                </StackPanel>
                    </DataTemplate>
                    <DataTemplate x:Key="ResetSettingsSectionTemplate" x:DataType="viewModels:SettingsViewModel">
                        <StackPanel
                    x:Name="ResetSettingsSection"
                    Margin="0,-12,0,0"
                    Visibility="Collapsed"
                    Style="{StaticResource SectionPanelStyle}">
                    <StackPanel Spacing="4">
                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.Restore.Description"
                            svc:Localized.HeaderKey="Settings.Restore.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE72C;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <Button
                                Click="RestoreDefaultSettingsButton_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                svc:Localized.ToolTipKey="Settings.Restore.Tooltip">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                    <TextBlock svc:Localized.Key="Common.Restore" />
                                </StackPanel>
                            </Button>
                        </toolkit:SettingsCard>
                    </StackPanel>
                </StackPanel>
                    </DataTemplate>
                    <DataTemplate x:Key="CompatibilityDiagnosticsSettingsSectionTemplate" x:DataType="viewModels:SettingsViewModel">
                        <StackPanel
                    x:Name="CompatibilityDiagnosticsSettingsSection"
                    Visibility="Collapsed"
                    Style="{StaticResource SectionPanelStyle}">
                    <StackPanel Margin="0,8,0,0" Spacing="4">
                        <toolkit:SettingsCard
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch"
                            svc:Localized.DescriptionKey="Settings.DragDropPermission.Description"
                            svc:Localized.HeaderKey="Settings.DragDropPermission.Title"
                            svc:InfoTip.TitleKey="Settings.DragDropPermission.InfoTip.Title"
                            svc:InfoTip.BodyKey="Settings.DragDropPermission.InfoTip.Description">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <StackPanel Spacing="12">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Style="{StaticResource SettingDescriptionTextStyle}"
                                    Text="{Binding DragDropSummaryText}" />
                                <TextBlock
                                    Style="{StaticResource SettingDescriptionTextStyle}"
                                    Text="{Binding DragDropDetailText}" />

                                <Grid ColumnSpacing="16" RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingValueTextStyle}" svc:Localized.Key="Settings.DragDropPermission.ProcessLabel" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingDescriptionTextStyle}" Text="{Binding DragDropProcessText}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingValueTextStyle}" svc:Localized.Key="Settings.DragDropPermission.ExplorerLabel" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingDescriptionTextStyle}" Text="{Binding DragDropExplorerText}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SettingValueTextStyle}" svc:Localized.Key="Settings.DragDropPermission.UacLabel" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingDescriptionTextStyle}" Text="{Binding DragDropUacText}" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource SettingValueTextStyle}" svc:Localized.Key="Settings.DragDropPermission.AppCompatLabel" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource SettingDescriptionTextStyle}" Text="{Binding DragDropAppCompatText}" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource SettingValueTextStyle}" svc:Localized.Key="Settings.DragDropPermission.StartupLabel" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource SettingDescriptionTextStyle}" Text="{Binding DragDropStartupText}" />
                                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource SettingValueTextStyle}" svc:Localized.Key="Settings.DragDropPermission.ShortcutLabel" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource SettingDescriptionTextStyle}" Text="{Binding DragDropShortcutText}" />
                                </Grid>

                                <TextBlock
                                    Style="{StaticResource SettingDescriptionTextStyle}"
                                    Text="{Binding DragDropRepairStatusText}" />

                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Click="RefreshDragDropPermissionButton_Click"
                                        Style="{StaticResource ActionButtonStyle}"
                                        svc:Localized.ToolTipKey="Settings.DragDropPermission.RefreshTooltip">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                            <TextBlock svc:Localized.Key="Common.Refresh" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Click="RepairDragDropPermissionButton_Click"
                                        IsEnabled="{Binding CanRepairDragDrop}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        svc:Localized.ToolTipKey="Settings.DragDropPermission.RepairTooltip">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                                            <TextBlock svc:Localized.Key="Settings.DragDropPermission.RepairButton" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Click="OpenUacSettingsButton_Click"
                                        Style="{StaticResource ActionButtonStyle}"
                                        svc:Localized.ToolTipKey="Settings.DragDropPermission.OpenUacTooltip">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                                            <TextBlock svc:Localized.Key="Settings.DragDropPermission.OpenUacButton" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch"
                            svc:Localized.DescriptionKey="Settings.RuntimeHealth.Description"
                            svc:Localized.HeaderKey="Settings.RuntimeHealth.Title"
                            svc:InfoTip.TitleKey="Settings.RuntimeHealth.InfoTip.Title"
                            svc:InfoTip.BodyKey="Settings.RuntimeHealth.InfoTip.Description">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE9D9;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <StackPanel Spacing="10">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Style="{StaticResource SettingDescriptionTextStyle}"
                                    Text="{Binding RuntimeSummaryText}" />
                                <TextBlock
                                    Style="{StaticResource SettingDescriptionTextStyle}"
                                    Text="{Binding RuntimeDetailText}"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="ExportDiagnosticsButton"
                                        Click="ExportDiagnosticsButton_Click"
                                        Style="{StaticResource ActionButtonStyle}"
                                        svc:Localized.ToolTipKey="Settings.Diagnostics.ExportTooltip">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74E;" FontSize="16" />
                                            <TextBlock svc:Localized.Key="Settings.Diagnostics.Export" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Click="ResyncRuntimeStateButton_Click"
                                        IsEnabled="{Binding CanResyncRuntime}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        svc:Localized.ToolTipKey="Settings.RuntimeHealth.ResyncTooltip">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                            <TextBlock svc:Localized.Key="Settings.RuntimeHealth.Resync" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </StackPanel>
                </StackPanel>
                    </DataTemplate>
                    <DataTemplate x:Key="AboutSectionTemplate" x:DataType="viewModels:SettingsViewModel">
                        <StackPanel
                    x:Name="AboutSection"
                    Visibility="Collapsed"
                    Style="{StaticResource SectionPanelStyle}">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level1" svc:Localized.Key="Settings.Section.About" />
                    <StackPanel Margin="0,8,0,0" Spacing="4">
                        <toolkit:SettingsCard
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel>
                                <Grid
                                    x:Name="AboutInfoGrid"
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="14"
                                    RowDefinitions="Auto,Auto">
                                    <Image
                                        Width="34"
                                        Height="34"
                                        VerticalAlignment="Top">
                                        <Image.Source>
                                            <media:SvgImageSource UriSource="ms-appx:///Assets/deskbox.svg" />
                                        </Image.Source>
                                    </Image>
                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="3"
                                        VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="DeskBox"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="{Binding AppVersion}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock
                                            Style="{StaticResource SettingDescriptionTextStyle}"
                                            svc:Localized.Key="Settings.About.Description" />
                                    </StackPanel>
                                    <StackPanel
                                        x:Name="AboutRightPanel"
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        MaxWidth="300"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                        <StackPanel
                                            x:Name="AboutInfoActionsPanel"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Button
                                                x:Name="AboutMeButton"
                                                Click="ShowAboutMeButton_Click"
                                                Style="{StaticResource ActionButtonStyle}"
                                                svc:Localized.ToolTipKey="Settings.About.AboutMeTitle">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontSize="16" Glyph="&#xE77B;" />
                                                    <TextBlock svc:Localized.Key="Settings.About.AboutMeButton" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="AboutWebsiteButton"
                                                Click="OpenWebsiteButton_Click"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTipService.ToolTip="{Binding OfficialWebsiteLink}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontSize="16" Glyph="&#xE774;" />
                                                    <TextBlock svc:Localized.Key="Settings.About.Website" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsExpander
                            HorizontalAlignment="Stretch"
                            IsExpanded="True"
                            svc:Localized.DescriptionKey="Settings.Update.Description"
                            svc:Localized.HeaderKey="Settings.Update.Title">
                            <toolkit:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="&#xE895;" />
                            </toolkit:SettingsExpander.HeaderIcon>
                            <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard
                                HorizontalContentAlignment="Right"
                                svc:Localized.DescriptionKey="Settings.Update.AutoCheckDescription"
                                svc:Localized.HeaderKey="Settings.Update.AutoCheck"
                                Visibility="{Binding UpdateAutoCheckVisibility}">
                                <ToggleSwitch svc:Localized.AutomationNameKey="Settings.Update.AutoCheck"
                                    VerticalAlignment="Center"
                                    OnContent=""
                                    OffContent=""
                                    MinWidth="0"
                                    IsOn="{Binding AutoCheckForUpdates, Mode=TwoWay}" />
                            </toolkit:SettingsCard>

                            <toolkit:SettingsCard
                                HorizontalContentAlignment="Right"
                                Description="{Binding UpdateStatusText}"
                                svc:Localized.HeaderKey="Settings.Update.Status">
                                <StackPanel
                                    x:Name="UpdateCheckActionsPanel"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                                    <Button
                                        x:Name="OneClickUpdateButton"
                                        VerticalAlignment="Center"
                                        Click="OneClickUpdateButton_Click"
                                        IsEnabled="{Binding IsOneClickActionEnabled}"
                                        Style="{StaticResource ActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="16" Glyph="&#xE895;" />
                                            <TextBlock Text="{Binding OneClickActionButtonText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="ViewReleaseNotesButton"
                                        VerticalAlignment="Center"
                                        Click="ViewReleaseNotesButton_Click"
                                        Style="{StaticResource ActionButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="16" Glyph="&#xE8A5;" />
                                            <TextBlock Text="{Binding ViewReleaseNotesButtonText}" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </toolkit:SettingsCard>

                            <toolkit:SettingsCard
                                HorizontalContentAlignment="Stretch"
                                svc:Localized.HeaderKey="Settings.Update.Details">
                                <StackPanel Spacing="10" VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource SettingDescriptionTextStyle}"
                                        Text="{Binding UpdateDetailText}"
                                        TextWrapping="Wrap" />

                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="14,10"
                                        Click="ViewReleaseNotesButton_Click"
                                        IsEnabled="{Binding CanViewReleaseNotes}"
                                        AutomationProperties.Name="{Binding ViewReleaseNotesButtonText}"
                                        Visibility="{Binding UpdateSummaryVisibility}">
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="2"
                                            Text="{Binding UpdateSummaryText}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </Button>

                                    <StackPanel Spacing="6" Visibility="{Binding UpdateProgressVisibility}">
                                        <ProgressBar
                                            Height="4"
                                            Minimum="0"
                                            Maximum="100"
                                            IsIndeterminate="{Binding UpdateProgressIsIndeterminate}"
                                            Value="{Binding UpdateProgressValue}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource SettingDescriptionTextStyle}"
                                            Text="{Binding UpdateProgressText}"
                                            TextAlignment="Right"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="UpdateActionsPanel"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{Binding UpdateFallbackVisibility}">
                                        <Button
                                            x:Name="OpenManualUpdateDownloadButton"
                                            Click="OpenManualUpdateDownloadButton_Click"
                                            IsEnabled="{Binding CanOpenUpdateFallback}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            ToolTipService.ToolTip="{Binding ManualUpdateDownloadUrl}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="16" Glyph="&#xE774;" />
                                                <TextBlock Text="{Binding UpdateFallbackActionText}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </toolkit:SettingsCard>
                            </toolkit:SettingsExpander.Items>
                        </toolkit:SettingsExpander>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.About.FeedbackDescription"
                            svc:Localized.HeaderKey="Settings.About.FeedbackTitle"
                            svc:InfoTip.TitleKey="Settings.About.FeedbackDescription.InfoTip.Title"
                            svc:InfoTip.BodyKey="Settings.About.FeedbackDescription.InfoTip.Description">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE715;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="ShowFeedbackDialogButton"
                                    Click="ShowFeedbackDialogButton_Click"
                                    Style="{StaticResource AccentActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE715;" />
                                        <TextBlock svc:Localized.Key="Settings.About.FeedbackSendButton" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="ShowMyFeedbackButton"
                                    Click="ShowMyFeedbackButton_Click"
                                    Style="{StaticResource ActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE8A5;" />
                                        <TextBlock svc:Localized.Key="Settings.About.FeedbackMineButton" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.About.StoreSupportDescription"
                            svc:Localized.HeaderKey="Settings.About.StoreSupportTitle"
                            Visibility="{Binding StoreSupportCardVisibility}">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE719;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <Button
                                x:Name="StoreSupportButton"
                                Click="ShowStoreSupportDialogButton_Click"
                                HorizontalAlignment="Right"
                                Style="{StaticResource ActionButtonStyle}"
                                svc:Localized.ToolTipKey="Settings.About.StoreSupportDescription">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE719;" />
                                    <TextBlock svc:Localized.Key="Settings.About.StoreSupportButton" />
                                </StackPanel>
                            </Button>
                        </toolkit:SettingsCard>
                    </StackPanel>
                </StackPanel>
                    </DataTemplate>
                </StackPanel.Resources>

                <StackPanel
                    x:Name="GeneralSection"
                    Style="{StaticResource SectionPanelStyle}">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level1" svc:Localized.Key="Settings.Section.General" />
                    <StackPanel Margin="0,8,0,0" Spacing="4">
                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.Language.Description"
                            svc:Localized.HeaderKey="Settings.Language.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE774;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox svc:Localized.AutomationNameKey="Settings.Language.Title"
                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                ItemsSource="{Binding AvailableLanguageOptions}"
                                controls:SettingsComboBox.Value="{Binding SelectedLanguage, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsExpander
                            svc:Localized.DescriptionKey="Settings.AutoStart.Description"
                            svc:Localized.HeaderKey="Settings.AutoStart.Title">
                            <toolkit:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="&#xE7C1;" />
                            </toolkit:SettingsExpander.HeaderIcon>
                            <ToggleSwitch svc:Localized.AutomationNameKey="Settings.AutoStart.Title"
                                OnContent=""
                                OffContent=""
                                MinWidth="0"
                                IsOn="{Binding AutoStart, Mode=TwoWay}" />
                            <toolkit:SettingsExpander.Items>
                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    svc:Localized.HeaderKey="Settings.AutoStart.Mode.Title"
                                    svc:Localized.DescriptionKey="Settings.AutoStart.Mode.Description"
                                    svc:InfoTip.TitleKey="Settings.AutoStart.Mode.InfoTip.Title"
                                    svc:InfoTip.BodyKey="Settings.AutoStart.Mode.InfoTip.Description"
                                    Visibility="{Binding AutoStartModeVisibility}">
                                    <ComboBox svc:Localized.AutomationNameKey="Settings.AutoStart.Mode.Title"
                                        MinWidth="176"
                                        ItemsSource="{Binding AvailableAutoStartModeOptions}"
                                        controls:SettingsComboBox.Value="{Binding SelectedAutoStartMode, Mode=TwoWay}" />
                                </toolkit:SettingsCard>
                            </toolkit:SettingsExpander.Items>
                        </toolkit:SettingsExpander>

                        <toolkit:SettingsCard
                            Header="{Binding AutoStartStatusText}"
                            HorizontalContentAlignment="Right"
                            Visibility="{Binding AutoStartStatusVisibility}">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7BA;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <Button
                                Click="OpenStartupAppsSettingsButton_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                Visibility="{Binding AutoStartSystemSettingsVisibility}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                                    <TextBlock svc:Localized.Key="Settings.AutoStart.OpenSystemSettings" />
                                </StackPanel>
                            </Button>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.SilentStartup.Description"
                            svc:Localized.HeaderKey="Settings.SilentStartup.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7B3;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ToggleSwitch svc:Localized.AutomationNameKey="Settings.SilentStartup.Title"
                                OnContent=""
                                OffContent=""
                                MinWidth="0"
                                IsOn="{Binding SilentStartup, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            Click="NestedSettingsButton_Click"
                            IsClickEnabled="True"
                            Tag="PerformanceSettings"
                            svc:Localized.DescriptionKey="Settings.Performance.Description"
                            svc:Localized.HeaderKey="Settings.Performance.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE945;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox svc:Localized.AutomationNameKey="Settings.Performance.Title"
                                x:Name="PerformanceModeInlineComboBox"
                                MinWidth="176"
                                ItemsSource="{Binding AvailablePerformanceModeOptions}"
                                controls:SettingsComboBox.Value="{Binding SelectedPerformanceMode, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            Click="NestedSettingsButton_Click"
                            IsClickEnabled="True"
                            Tag="Displays"
                            svc:Localized.DescriptionKey="Settings.Displays.Description"
                            svc:Localized.HeaderKey="Settings.Displays.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7F4;" />
                            </toolkit:SettingsCard.HeaderIcon>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.AttachmentStorageMode.Description"
                            svc:Localized.HeaderKey="Settings.AttachmentStorageMode.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE723;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox svc:Localized.AutomationNameKey="Settings.AttachmentStorageMode.Title"
                                x:Name="AttachmentStorageModeComboBox"
                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                ItemsSource="{Binding AvailableAttachmentStorageModeOptions}"
                                controls:SettingsComboBox.Value="{Binding AttachmentStorageMode, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.Onboarding.Description"
                            svc:Localized.HeaderKey="Settings.Onboarding.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE82D;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <Button
                                Click="ShowOnboardingButton_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                svc:Localized.ToolTipKey="Settings.Onboarding.Tooltip">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE82D;" />
                                    <TextBlock svc:Localized.Key="Common.View" />
                                </StackPanel>
                            </Button>
                        </toolkit:SettingsCard>
                    </StackPanel>
                </StackPanel>

                </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <ContentDialog
            x:Name="AboutMeDialog"
            Grid.RowSpan="2"
            DefaultButton="Close">
            <ScrollViewer
                MaxHeight="520"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel
                    Width="500"
                    MaxWidth="500"
                    Spacing="18">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Image
                            Width="46"
                            Height="46"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Image.Source>
                                <media:SvgImageSource UriSource="ms-appx:///Assets/deskbox.svg" />
                            </Image.Source>
                        </Image>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="3">
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                svc:Localized.Key="Settings.Dialog.AboutMeName" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                svc:Localized.Key="Settings.Dialog.AboutMeRole" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="12">
                        <TextBlock
                            LineHeight="23"
                            TextWrapping="WrapWholeWords"
                            svc:Localized.Key="Settings.Dialog.AboutMeP1" />
                        <TextBlock
                            LineHeight="23"
                            TextWrapping="WrapWholeWords"
                            svc:Localized.Key="Settings.Dialog.AboutMeP2" />
                    </StackPanel>

                    <Border
                        Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource SettingsCardCornerRadius}">
                        <Grid ColumnDefinitions="112,*" ColumnSpacing="16">
                            <Border
                                Width="112"
                                Height="112"
                                Padding="6"
                                Background="White"
                                CornerRadius="{StaticResource SettingsCardCornerRadius}"
                                Visibility="{Binding DonationQrCodeVisibility}">
                                <Image
                                    Source="ms-appx:///Assets/wechat-qrcode.jpg"
                                    Stretch="Uniform" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="6">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    svc:Localized.Key="Settings.About.WechatTitle" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    LineHeight="21"
                                    TextWrapping="WrapWholeWords"
                                    svc:Localized.Key="Settings.About.WechatDescription" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <ContentDialog
            x:Name="SupportDeskBoxDialog"
            Grid.RowSpan="2"
            DefaultButton="Close">
            <ScrollViewer
                MaxHeight="560"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel
                    x:Name="SupportDialogContent"
                    Width="480"
                    MaxWidth="480"
                    Spacing="14">
                        <StackPanel Spacing="8">
                            <TextBlock
                                LineHeight="22"
                                TextWrapping="WrapWholeWords"
                                svc:Localized.Key="Settings.Dialog.SupportP1" />
                            <TextBlock
                                LineHeight="22"
                                TextWrapping="WrapWholeWords"
                                svc:Localized.Key="Settings.Dialog.SupportP2" />
                        </StackPanel>

                        <InfoBar
                            x:Name="AboutStoreNoticeInfoBar"
                            IsClosable="False"
                            IsIconVisible="True"
                            IsOpen="True"
                            Severity="Informational"
                            svc:Localized.DescriptionKey="Settings.Dialog.SupportStoreDescription"
                            svc:Localized.HeaderKey="Settings.About.Channel.Store">
                            <InfoBar.ActionButton>
                                <Button
                                    Click="OpenMicrosoftStoreButton_Click"
                                    Padding="12,5,12,7"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ActionButtonStyle}"
                                    ToolTipService.ToolTip="{Binding MicrosoftStoreLink}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="16" Glyph="&#xE719;" />
                                        <TextBlock FontSize="13" svc:Localized.Key="Settings.Dialog.SupportStoreButton" />
                                    </StackPanel>
                                </Button>
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border
                                Padding="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource SettingsCardCornerRadius}">
                                <StackPanel HorizontalAlignment="Center" Spacing="6">
                                    <Border
                                        Visibility="{Binding DonationQrCodeVisibility}"
                                        x:Name="WechatSupportQrContainer"
                                        Width="108"
                                        Height="108"
                                        Padding="4"
                                        Background="White"
                                        CornerRadius="{StaticResource SettingsCardCornerRadius}">
                                        <Image
                                            AutomationProperties.LabeledBy="{Binding ElementName=WechatSupportLabel}"
                                            Source="ms-appx:///Assets/Support/support-wechat.png"
                                            Stretch="Uniform" />
                                    </Border>
                                    <TextBlock
                                        x:Name="WechatSupportLabel"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        svc:Localized.Key="Settings.Dialog.SupportWechat" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource SettingsCardCornerRadius}">
                                <StackPanel HorizontalAlignment="Center" Spacing="6">
                                    <Border
                                        Visibility="{Binding DonationQrCodeVisibility}"
                                        x:Name="AlipaySupportQrContainer"
                                        Width="108"
                                        Height="108"
                                        Padding="4"
                                        Background="White"
                                        CornerRadius="{StaticResource SettingsCardCornerRadius}">
                                        <Image
                                            AutomationProperties.LabeledBy="{Binding ElementName=AlipaySupportLabel}"
                                            Source="ms-appx:///Assets/Support/support-alipay.png"
                                            Stretch="Uniform" />
                                    </Border>
                                    <TextBlock
                                        x:Name="AlipaySupportLabel"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        svc:Localized.Key="Settings.Dialog.SupportAlipay" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="12"
                                LineHeight="18"
                                TextWrapping="WrapWholeWords"
                                svc:Localized.Key="Settings.Dialog.SupportQrDescription" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="12"
                                LineHeight="18"
                                TextWrapping="WrapWholeWords"
                                svc:Localized.Key="Settings.Dialog.SupportP3" />
                        </StackPanel>

                    </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Window>
