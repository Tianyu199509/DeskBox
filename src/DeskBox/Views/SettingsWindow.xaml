                                        svc:Localized.HeaderKey="Settings.Backup.StoreUninstallDataNotice.Title" />

                                    <toolkit:SettingsCard
                                        HorizontalContentAlignment="Right"
                                        svc:Localized.DescriptionKey="Settings.DataBackup.Manual.Description"
                                        svc:Localized.HeaderKey="Settings.DataBackup.Manual.Title">
                                        <toolkit:SettingsCard.HeaderIcon>
                                            <FontIcon Glyph="&#xE74E;" />
                                        </toolkit:SettingsCard.HeaderIcon>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="ExportDataBackupButton" Click="ExportDataBackupButton_Click" Style="{StaticResource ActionButtonStyle}" svc:Localized.ToolTipKey="Settings.DataBackup.Tooltip">
