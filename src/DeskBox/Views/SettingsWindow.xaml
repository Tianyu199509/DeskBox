                                        <TextBlock svc:Localized.Key="Settings.CloudBackup.TestConnection" />
                                    </Button>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="{Binding ConnectionStatusText}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
