                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingValueTextStyle}" svc:Localized.Key="Settings.DragDropPermission.ProcessLabel" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingDescriptionTextStyle}" Text="{Binding DragDropProcessText}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingValueTextStyle}" svc:Localized.Key="Settings.DragDropPermission.ExplorerLabel" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingDescriptionTextStyle}" Text="{Binding DragDropExplorerText}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SettingValueTextStyle}" svc:Localized.Key="Settings.DragDropPermission.UacLabel" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingDescriptionTextStyle}" Text="{Binding DragDropUacText}" />
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource SettingValueTextStyle}" svc:Localized.Key="Settings.DragDropPermission.AppCompatLabel" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource SettingDescriptionTextStyle}" Text="{Binding DragDropAppCompatText}" />
                                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource SettingValueTextStyle}" svc:Localized.Key="Settings.DragDropPermission.StartupLabel" />
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource SettingDescriptionTextStyle}" Text="{Binding DragDropStartupText}" />
                                                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource SettingValueTextStyle}" svc:Localized.Key="Settings.DragDropPermission.ShortcutLabel" />
                                                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource SettingDescriptionTextStyle}" Text="{Binding DragDropShortcutText}" />
                                                </Grid>

                                                <TextBlock
                                                    Style="{StaticResource SettingDescriptionTextStyle}"
                                                    Text="{Binding DragDropRepairStatusText}" />

                                                <controls:WrapFlowPanel
                                                    HorizontalAlignment="Right"
                                                    HorizontalSpacing="8"
                                                    VerticalSpacing="8">
                                                    <Button
                                                        Click="RefreshDragDropPermissionButton_Click"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        svc:Localized.ToolTipKey="Settings.DragDropPermission.RefreshTooltip">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                                            <TextBlock svc:Localized.Key="Common.Refresh" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button
                                                        Click="RepairDragDropPermissionButton_Click"
                                                        IsEnabled="{Binding CanRepairDragDrop}"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        svc:Localized.ToolTipKey="Settings.DragDropPermission.RepairTooltip">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                                                            <TextBlock svc:Localized.Key="Settings.DragDropPermission.RepairButton" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button
                                                        Click="OpenUacSettingsButton_Click"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        svc:Localized.ToolTipKey="Settings.DragDropPermission.OpenUacTooltip">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                                                            <TextBlock svc:Localized.Key="Settings.DragDropPermission.OpenUacButton" />
                                                        </StackPanel>
                                                    </Button>
                                                </controls:WrapFlowPanel>
                                            </StackPanel>
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            ContentAlignment="Vertical"
                                            HorizontalContentAlignment="Stretch"
                                            svc:Localized.DescriptionKey="Settings.RuntimeHealth.Description"
                                            svc:Localized.HeaderKey="Settings.RuntimeHealth.Title"
                                            svc:InfoTip.TitleKey="Settings.RuntimeHealth.InfoTip.Title"
                                            svc:InfoTip.BodyKey="Settings.RuntimeHealth.InfoTip.Description">
                                            <StackPanel Spacing="10">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Style="{StaticResource SettingDescriptionTextStyle}"
                                                    Text="{Binding RuntimeSummaryText}" />
                                                <TextBlock
                                                    Style="{StaticResource SettingDescriptionTextStyle}"
                                                    Text="{Binding RuntimeDetailText}"
                                                    TextWrapping="Wrap" />
                                                <controls:WrapFlowPanel
                                                    HorizontalAlignment="Right"
                                                    HorizontalSpacing="8"
                                                    VerticalSpacing="8">
                                                    <Button
                                                        Click="ResyncRuntimeStateButton_Click"
                                                        IsEnabled="{Binding CanResyncRuntime}"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        svc:Localized.ToolTipKey="Settings.RuntimeHealth.ResyncTooltip">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                                            <TextBlock svc:Localized.Key="Settings.RuntimeHealth.Resync" />
                                                        </StackPanel>
                                                    </Button>
                                                </controls:WrapFlowPanel>
                                            </StackPanel>
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            svc:Localized.HeaderKey="Settings.AttachmentHealth.Title">
                                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <TextBlock
                                                    x:Name="AttachmentHealthSummaryText"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SettingDescriptionTextStyle}"
                                                    TextWrapping="Wrap"
                                                    svc:Localized.Key="Settings.AttachmentHealth.NotChecked" />
                                                <Button
                                                    x:Name="CheckAttachmentHealthButton"
                                                    Click="CheckAttachmentHealthButton_Click"
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    svc:Localized.ToolTipKey="Settings.AttachmentHealth.CheckTooltip">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                                        <TextBlock svc:Localized.Key="Settings.AttachmentHealth.Check" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </toolkit:SettingsCard>
                                    </toolkit:SettingsExpander.Items>
                                </toolkit:SettingsExpander>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </StackPanel.Resources>

                <StackPanel
                    x:Name="GeneralSection"
                    Style="{StaticResource SectionPanelStyle}">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level1" svc:Localized.Key="Settings.Section.General" />
                    <StackPanel Margin="0,8,0,0" Spacing="4">
                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.Language.Description"
                            svc:Localized.HeaderKey="Settings.Language.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE774;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox svc:Localized.AutomationNameKey="Settings.Language.Title"
                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                ItemsSource="{Binding AvailableLanguageOptions}"
                                controls:SettingsComboBox.Value="{Binding SelectedLanguage, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.AutoStart.Description"
                            svc:Localized.HeaderKey="Settings.AutoStart.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7C1;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ToggleSwitch svc:Localized.AutomationNameKey="Settings.AutoStart.Title"
                                OnContent=""
                                OffContent=""
                                MinWidth="0"
                                IsOn="{Binding AutoStart, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            IsEnabled="{Binding AutoStart}"
                            svc:Localized.HeaderKey="Settings.AutoStart.Mode.Title"
                            svc:Localized.DescriptionKey="Settings.AutoStart.Mode.Description"
                            svc:InfoTip.TitleKey="Settings.AutoStart.Mode.InfoTip.Title"
                            svc:InfoTip.BodyKey="Settings.AutoStart.Mode.InfoTip.Description"
                            Visibility="{Binding AutoStartModeVisibility}">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE713;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <toolkit:Segmented
                                controls:SettingsSegmented.Options="{Binding AvailableAutoStartModeOptions}"
                                controls:SettingsSegmented.Value="{Binding SelectedAutoStartMode, Mode=TwoWay}"
                                svc:Localized.AutomationNameKey="Settings.AutoStart.Mode.Title" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            Header="{Binding AutoStartStatusText}"
                            HorizontalContentAlignment="Right"
                            Visibility="{Binding AutoStartStatusVisibility}">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7BA;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <Button
                                Click="OpenStartupAppsSettingsButton_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                Visibility="{Binding AutoStartSystemSettingsVisibility}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                                    <TextBlock svc:Localized.Key="Settings.AutoStart.OpenSystemSettings" />
                                </StackPanel>
                            </Button>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.SilentStartup.Description"
                            svc:Localized.HeaderKey="Settings.SilentStartup.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7B3;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ToggleSwitch svc:Localized.AutomationNameKey="Settings.SilentStartup.Title"
                                OnContent=""
                                OffContent=""
                                MinWidth="0"
                                IsOn="{Binding SilentStartup, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsExpander
                            x:Name="PerformanceInlineCard"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="False"
                            svc:Localized.DescriptionKey="Settings.Performance.Description"
                            svc:Localized.HeaderKey="Settings.Performance.Title">
                            <toolkit:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="&#xE945;" />
                            </toolkit:SettingsExpander.HeaderIcon>
                            <ComboBox svc:Localized.AutomationNameKey="Settings.Performance.Title"
                                x:Name="PerformanceModeInlineComboBox"
                                HorizontalAlignment="Right"
                                MinWidth="176"
                                ItemsSource="{Binding AvailablePerformanceModeOptions}"
                                controls:SettingsComboBox.Value="{Binding SelectedPerformanceMode, Mode=TwoWay}" />
                            <toolkit:SettingsExpander.Items>
                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    svc:Localized.DescriptionKey="Settings.Performance.KeepWarmCache.Description"
                                    svc:Localized.HeaderKey="Settings.Performance.KeepWarmCache.Title">
                                    <ToggleSwitch svc:Localized.AutomationNameKey="Settings.Performance.KeepWarmCache.Title"
                                        MinWidth="0"
                                        OffContent=""
                                        OnContent=""
                                        IsOn="{Binding KeepWarmCacheWhenHidden, Mode=TwoWay}" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    IsEnabled="{Binding KeepWarmCacheWhenHidden}"
                                    svc:Localized.DescriptionKey="Settings.Performance.CacheBudget.Description"
                                    svc:Localized.HeaderKey="Settings.Performance.CacheBudget.Title">
                                    <ComboBox svc:Localized.AutomationNameKey="Settings.Performance.CacheBudget.Title"
                                        MinWidth="176"
                                        ItemsSource="{Binding AvailablePerformanceCacheBudgetOptions}"
                                        controls:SettingsComboBox.Value="{Binding SelectedPerformanceCacheBudget, Mode=TwoWay}" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    svc:Localized.DescriptionKey="Settings.Performance.VisibleIdleCleanup.Description"
                                    svc:Localized.HeaderKey="Settings.Performance.VisibleIdleCleanup.Title">
                                    <ComboBox svc:Localized.AutomationNameKey="Settings.Performance.VisibleIdleCleanup.Title"
                                        MinWidth="176"
                                        ItemsSource="{Binding AvailableVisibleIdleCacheCleanupDelayOptions}"
                                        controls:SettingsComboBox.Value="{Binding SelectedVisibleIdleCacheCleanupDelaySeconds, Mode=TwoWay}" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    AutomationProperties.AutomationId="IdleWorkingSetTrimCard"
                                    HorizontalContentAlignment="Right"
                                    svc:Localized.DescriptionKey="Settings.Performance.IdleWorkingSetTrim.Description"
                                    svc:Localized.HeaderKey="Settings.Performance.IdleWorkingSetTrim.Title"
                                    svc:InfoTip.TitleKey="Settings.Performance.IdleWorkingSetTrim.InfoTip.Title"
                                    svc:InfoTip.BodyKey="Settings.Performance.IdleWorkingSetTrim.InfoTip.Description">
                                    <ToggleSwitch svc:Localized.AutomationNameKey="Settings.Performance.IdleWorkingSetTrim.Title"
                                        AutomationProperties.AutomationId="IdleWorkingSetTrimToggle"
                                        OnContent=""
                                        OffContent=""
                                        MinWidth="0"
                                        IsOn="{Binding IdleWorkingSetTrimEnabled, Mode=TwoWay}" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    ContentAlignment="Vertical"
                                    HorizontalContentAlignment="Stretch"
                                    svc:Localized.DescriptionKey="Settings.Performance.DecorativeAnimations.Description"
                                    svc:Localized.HeaderKey="Settings.Performance.DecorativeAnimations.Title">
                                    <controls:WrapFlowPanel HorizontalSpacing="16" VerticalSpacing="6">
                                        <CheckBox
                                            MinWidth="0"
                                            IsChecked="{Binding AllowTextMarquee, Mode=TwoWay}"
                                            svc:Localized.AutomationNameKey="Settings.Performance.DecorativeAnimation.TextMarquee">
                                            <TextBlock svc:Localized.Key="Settings.Performance.DecorativeAnimation.TextMarquee" />
                                        </CheckBox>
                                        <CheckBox
                                            MinWidth="0"
                                            IsChecked="{Binding AllowVinylRotation, Mode=TwoWay}"
                                            svc:Localized.AutomationNameKey="Settings.Performance.DecorativeAnimation.VinylRotation">
                                            <TextBlock svc:Localized.Key="Settings.Performance.DecorativeAnimation.VinylRotation" />
                                        </CheckBox>
                                        <CheckBox
                                            MinWidth="0"
                                            IsChecked="{Binding AllowGlanceRotation, Mode=TwoWay}"
                                            svc:Localized.AutomationNameKey="Settings.Performance.DecorativeAnimation.GlanceRotation">
                                            <TextBlock svc:Localized.Key="Settings.Performance.DecorativeAnimation.GlanceRotation" />
                                        </CheckBox>
                                        <CheckBox
                                            MinWidth="0"
                                            IsChecked="{Binding AllowCompactAmbient, Mode=TwoWay}"
                                            svc:Localized.AutomationNameKey="Settings.Performance.DecorativeAnimation.CompactAmbient">
                                            <TextBlock svc:Localized.Key="Settings.Performance.DecorativeAnimation.CompactAmbient" />
                                        </CheckBox>
                                    </controls:WrapFlowPanel>
                                </toolkit:SettingsCard>
                            </toolkit:SettingsExpander.Items>
                        </toolkit:SettingsExpander>

                        <toolkit:SettingsCard
                            x:Name="AiSettingsEntryCard"
                            Click="NestedSettingsButton_Click"
                            HorizontalContentAlignment="Right"
                            IsClickEnabled="True"
                            Tag="AiSettings"
                            svc:Localized.HeaderKey="Settings.Nav.AiSettings">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE945;" />
                            </toolkit:SettingsCard.HeaderIcon>
                        </toolkit:SettingsCard>
                    </StackPanel>
                </StackPanel>

                </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <ContentDialog
            x:Name="AboutMeDialog"
            Grid.RowSpan="2"
            DefaultButton="Close">
            <ScrollViewer
                MaxHeight="520"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel
                    HorizontalAlignment="Stretch"
                    MaxWidth="500"
                    Spacing="18">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Image
                            Width="46"
                            Height="46"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Image.Source>
                                <media:SvgImageSource UriSource="ms-appx:///Assets/deskbox.svg" />
                            </Image.Source>
                        </Image>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="3">
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                svc:Localized.Key="Settings.Dialog.AboutMeName" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                svc:Localized.Key="Settings.Dialog.AboutMeRole" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="12">
                        <TextBlock
                            LineHeight="23"
                            TextWrapping="WrapWholeWords"
                            svc:Localized.Key="Settings.Dialog.AboutMeP1" />
                        <TextBlock
                            LineHeight="23"
                            TextWrapping="WrapWholeWords"
                            svc:Localized.Key="Settings.Dialog.AboutMeP2" />
                    </StackPanel>

                    <Border
                        Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource SettingsCardCornerRadius}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Border
                                Width="112"
                                Height="112"
                                Padding="6"
                                Background="White"
                                CornerRadius="{StaticResource SettingsCardCornerRadius}"
                                Visibility="{Binding DonationQrCodeVisibility}">
                                <Image
                                    Source="ms-appx:///Assets/wechat-qrcode.jpg"
                                    Stretch="Uniform" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="6">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    svc:Localized.Key="Settings.About.WechatTitle" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    LineHeight="21"
                                    TextWrapping="WrapWholeWords"
                                    svc:Localized.Key="Settings.About.WechatDescription" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <ContentDialog
            x:Name="SupportDeskBoxDialog"
            Grid.RowSpan="2"
            DefaultButton="Close">
            <ScrollViewer
                MaxHeight="560"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel
                    x:Name="SupportDialogContent"
                    HorizontalAlignment="Stretch"
                    MaxWidth="480"
                    Spacing="14">
                        <StackPanel Spacing="8">
                            <TextBlock
                                LineHeight="22"
                                TextWrapping="WrapWholeWords"
                                svc:Localized.Key="Settings.Dialog.SupportP1" />
                            <TextBlock
                                LineHeight="22"
                                TextWrapping="WrapWholeWords"
                                svc:Localized.Key="Settings.Dialog.SupportP2" />
                        </StackPanel>

                        <InfoBar
                            x:Name="AboutStoreNoticeInfoBar"
                            IsClosable="False"
                            IsIconVisible="True"
                            IsOpen="True"
                            Severity="Informational"
                            svc:Localized.DescriptionKey="Settings.Dialog.SupportStoreDescription"
                            svc:Localized.HeaderKey="Settings.About.Channel.Store">
                            <InfoBar.ActionButton>
                                <Button
                                    Click="OpenMicrosoftStoreButton_Click"
                                    Padding="12,5,12,7"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ActionButtonStyle}"
                                    ToolTipService.ToolTip="{Binding MicrosoftStoreLink}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="16" Glyph="&#xE719;" />
                                        <TextBlock FontSize="13" svc:Localized.Key="Settings.Dialog.SupportStoreButton" />
                                    </StackPanel>
                                </Button>
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border
                                Padding="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource SettingsCardCornerRadius}">
                                <StackPanel HorizontalAlignment="Center" Spacing="6">
                                    <Border
                                        Visibility="{Binding DonationQrCodeVisibility}"
                                        x:Name="WechatSupportQrContainer"
                                        Width="108"
                                        Height="108"
                                        Padding="4"
                                        Background="White"
                                        CornerRadius="{StaticResource SettingsCardCornerRadius}">
                                        <Image
                                            AutomationProperties.LabeledBy="{Binding ElementName=WechatSupportLabel}"
                                            Source="ms-appx:///Assets/Support/support-wechat.png"
                                            Stretch="Uniform" />
                                    </Border>
                                    <TextBlock
                                        x:Name="WechatSupportLabel"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        svc:Localized.Key="Settings.Dialog.SupportWechat" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Padding="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource SettingsCardCornerRadius}">
                                <StackPanel HorizontalAlignment="Center" Spacing="6">
                                    <Border
                                        Visibility="{Binding DonationQrCodeVisibility}"
                                        x:Name="AlipaySupportQrContainer"
                                        Width="108"
                                        Height="108"
                                        Padding="4"
                                        Background="White"
                                        CornerRadius="{StaticResource SettingsCardCornerRadius}">
                                        <Image
                                            AutomationProperties.LabeledBy="{Binding ElementName=AlipaySupportLabel}"
                                            Source="ms-appx:///Assets/Support/support-alipay.png"
                                            Stretch="Uniform" />
                                    </Border>
                                    <TextBlock
                                        x:Name="AlipaySupportLabel"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        svc:Localized.Key="Settings.Dialog.SupportAlipay" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="12"
                                LineHeight="18"
                                TextWrapping="WrapWholeWords"
                                svc:Localized.Key="Settings.Dialog.SupportQrDescription" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="12"
                                LineHeight="18"
                                TextWrapping="WrapWholeWords"
                                svc:Localized.Key="Settings.Dialog.SupportP3" />
                        </StackPanel>

                    </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <!-- Floating update-activity card (bottom-right, the PowerToys
             pattern): appears while an update story is live — available,
             downloading, downloaded, failed — and dismisses per window
             session. All state reuses the About section's update
             view-model properties. -->
        <Border
            x:Name="UpdateActivityCard"
            Grid.Row="2"
            MaxWidth="360"
            Margin="16,16,24,16"
            Padding="20,16"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            Canvas.ZIndex="30"
            CornerRadius="8"
            Visibility="{Binding UpdateActivityCardVisibility}">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:UpdateStatusBadgeControl
                        Margin="0,2,0,0"
                        VerticalAlignment="Top"
                        StateName="{Binding UpdateBadgeStateName}" />
                    <StackPanel
                        Grid.Column="1"
                        Spacing="4">
                        <Border
                            HorizontalAlignment="Left"
                            Padding="6,2"
                            Background="{ThemeResource SystemFillColorCriticalBrush}"
                            CornerRadius="4"
                            Visibility="{Binding UpdateMandatoryBadgeVisibility}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon
                                    FontSize="10"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Glyph="&#xE7BA;" />
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="{Binding UpdateMandatoryBadgeText}"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding UpdateStatusText}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{Binding UpdateDetailText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        svc:Localized.AutomationNameKey="Common.Close"
                        svc:Localized.ToolTipKey="Common.Close"
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Top"
                        Click="DismissUpdateActivity_Click"
                        Content="&#xE711;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="12" />
                </Grid>

                <ProgressBar
                    Height="4"
                    Maximum="100"
                    IsIndeterminate="{Binding UpdateProgressIsIndeterminate}"
                    Value="{Binding UpdateProgressValue}"
                    Visibility="{Binding UpdateProgressVisibility}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding UpdateProgressText}"
                    Visibility="{Binding UpdateProgressTextVisibility}" />

                <Button
                    HorizontalAlignment="Stretch"
                    Click="OneClickUpdateButton_Click"
                    Content="{Binding OneClickActionButtonText}"
                    IsEnabled="{Binding IsOneClickActionEnabled}"
                    Style="{StaticResource AccentButtonStyle}" />
                <HyperlinkButton
                    HorizontalAlignment="Center"
                    Click="ViewReleaseNotesButton_Click"
                    Content="{Binding ViewReleaseNotesButtonText}"
                    Padding="4,2" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
