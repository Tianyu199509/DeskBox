                                        <FontIcon Glyph="&#xE790;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <toolkit:Segmented
                                        controls:SettingsSegmented.Options="{Binding AvailableSkinOptions}"
                                        controls:SettingsSegmented.Value="{Binding SelectedSkin, Mode=TwoWay}"
                                        svc:Localized.AutomationNameKey="Settings.Weather.Skin.Title" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    svc:Localized.HeaderKey="Settings.Weather.IconStyle.Title">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE771;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <ComboBox svc:Localized.AutomationNameKey="Settings.Weather.IconStyle.Title"
                                        MinWidth="150"
                                        ItemsSource="{Binding AvailableIconStyleOptions}"
                                        controls:SettingsComboBox.Value="{Binding SelectedIconStyle, Mode=TwoWay}" />
                                </toolkit:SettingsCard>

                                <toolkit:SettingsExpander
                                    Description="{Binding UnitsAndSourceSummaryText}"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="False"
                                    svc:Localized.HeaderKey="Settings.Weather.Group.UnitsAndSource.Title">
                                    <toolkit:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE7E3;" />
                                    </toolkit:SettingsExpander.HeaderIcon>
                                    <toolkit:SettingsExpander.Items>
                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            svc:Localized.HeaderKey="Settings.Weather.TemperatureUnit.Title">
                                            <ComboBox svc:Localized.AutomationNameKey="Settings.Weather.TemperatureUnit.Title"
                                                MinWidth="150"
                                                ItemsSource="{Binding AvailableTemperatureUnitOptions}"
                                                controls:SettingsComboBox.Value="{Binding SelectedTemperatureUnit, Mode=TwoWay}" />
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            svc:Localized.HeaderKey="Settings.Weather.WindSpeedUnit.Title">
                                            <ComboBox svc:Localized.AutomationNameKey="Settings.Weather.WindSpeedUnit.Title"
                                                MinWidth="150"
                                                ItemsSource="{Binding AvailableWindSpeedUnitOptions}"
                                                controls:SettingsComboBox.Value="{Binding SelectedWindSpeedUnit, Mode=TwoWay}" />
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            svc:Localized.DescriptionKey="Settings.Weather.DataSource.Description"
                                            svc:Localized.HeaderKey="Settings.Weather.DataSource.Title">
                                            <ComboBox svc:Localized.AutomationNameKey="Settings.Weather.DataSource.Title"
                                                MinWidth="180"
                                                ItemsSource="{Binding AvailableDataSourceOptions}"
                                                controls:SettingsComboBox.Value="{Binding SelectedDataSource, Mode=TwoWay}" />
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            svc:Localized.HeaderKey="Settings.Weather.RefreshInterval.Title">
                                            <ComboBox svc:Localized.AutomationNameKey="Settings.Weather.RefreshInterval.Title"
                                                MinWidth="150"
                                                ItemsSource="{Binding AvailableRefreshIntervalOptions}"
                                                controls:SettingsComboBox.Value="{Binding SelectedRefreshInterval, Mode=TwoWay}" />
                                        </toolkit:SettingsCard>
                                    </toolkit:SettingsExpander.Items>
                                </toolkit:SettingsExpander>
                            </StackPanel>

                            <toolkit:SettingsCard
                                HorizontalContentAlignment="Right"
                                svc:Localized.DescriptionKey="Settings.Weather.ResetWidget.Description"
                                svc:Localized.HeaderKey="Settings.Weather.ResetWidget.Title">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE72C;" />
                                </toolkit:SettingsCard.HeaderIcon>
                                <Button
                                    Click="FeatureWidgetSubPageResetButton_Click"
                                    Style="{StaticResource DangerActionButtonStyle}"
                                    Tag="Weather"
                                    svc:Localized.AutomationNameKey="Settings.Weather.ResetWidget.Title">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                        <TextBlock svc:Localized.Key="Common.Reset" />
                                    </StackPanel>
                                </Button>
                            </toolkit:SettingsCard>
                        </StackPanel>
                    </DataTemplate>
