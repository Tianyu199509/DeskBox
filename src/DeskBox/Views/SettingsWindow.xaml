                                                    IsClosable="False"
                                                    IsOpen="True"
                                                    Severity="Warning"
                                                    Message="{Binding HttpWarningText}"
                                                    Visibility="{Binding ShowHttpWarning, Converter={StaticResource SettingsBoolToVisibilityConverter}}" />
