                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontSize="16" Glyph="&#xE74E;" /><TextBlock svc:Localized.Key="Settings.DataBackup.Snapshots.BackupNow" /></StackPanel>
                                    </Button>
