                    <DataTemplate x:Key="MaintenanceSectionTemplate" x:DataType="viewModels:SettingsViewModel">
                        <StackPanel
                            x:Name="MaintenanceSection"
                            Visibility="Collapsed"
                            Style="{StaticResource SectionPanelStyle}">
