<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskBox.Views.SearchPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeskBox.Controls"
    xmlns:searchControls="using:DeskBox.Controls.Search"
    xmlns:models="using:DeskBox.Models"
    xmlns:svc="using:DeskBox.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Root clips popup content to the configured XAML corner radius while the outer
        HWND remains per-pixel alpha transparent with zero DWM drop shadow.
    -->
    <Grid x:Name="RootGrid" IsTabStop="True"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          PreviewKeyDown="RootGrid_PreviewKeyDown"
          KeyDown="RootGrid_KeyDown"
          CharacterReceived="RootGrid_CharacterReceived"
          RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PopupScaleTransform" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="PopupTranslateTransform"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.Resources>
            <!-- Restrained opacity/scale motion keeps hotkey toggles calm, interruptible, and inside HWND bounds. -->
            <Storyboard x:Name="PopupShowStoryboard">
                <DoubleAnimation Storyboard.TargetName="RootGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.167">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="PopupScaleTransform"
                                 Storyboard.TargetProperty="ScaleX"
                                 From="0.985" To="1" Duration="0:0:0.167">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="PopupScaleTransform"
                                 Storyboard.TargetProperty="ScaleY"
                                 From="0.985" To="1" Duration="0:0:0.167">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Name="PopupHideStoryboard">
                <DoubleAnimation Storyboard.TargetName="RootGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.083">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="PopupScaleTransform"
                                 Storyboard.TargetProperty="ScaleX"
                                 From="1" To="0.99" Duration="0:0:0.083">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="PopupScaleTransform"
                                 Storyboard.TargetProperty="ScaleY"
                                 From="1" To="0.99" Duration="0:0:0.083">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!--
                Horizontal quick-action button (New todo / New note / Open settings).
                One row, equal-width cells, Fluent control-fill ladder on hover/press.
            -->
            <Style x:Key="QuickButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              Padding="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource ControlFillColorTertiaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compact Win11 subtle icon action inside edit-mode recommendation tiles. -->

            <!-- Subtle 26x26 clear button inside the Win11 26H2 search input box. -->
            <Style x:Key="ClearInputButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="AllowFocusOnInteraction" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ClearSurface"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ClearSurface"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ClearContent"
                                                                               Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ClearSurface"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ClearContent"
                                                                               Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ClearContent"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Fluent 2 subtle/ghost command-bar action button (transparent at rest, hover fill only). -->
            <Style x:Key="CmdBarGhostButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="AllowFocusOnInteraction" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="GhostSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="GhostSurface.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="GhostSurface.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Lightweight Win11 Fluent 2 category Filter Chip pill (28px, CornerRadius=14). -->
            <Style x:Key="TabPillItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="TabSurface.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="TabSurface.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="TabSurface.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
                                                <Setter Target="TabSurface.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                                <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                <Setter Target="TabContent.FontWeight" Value="SemiBold"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="TabSurface.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}"/>
                                                <Setter Target="TabSurface.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                                <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                <Setter Target="TabContent.FontWeight" Value="SemiBold"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="TabSurface.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                <Setter Target="TabSurface.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                                <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                <Setter Target="TabContent.FontWeight" Value="SemiBold"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="TabSurface"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter x:Name="TabContent"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      FontWeight="Normal"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Counts are intentionally omitted: Everything pages continuously, so a
                 loaded-row count would look like a total-result cap. -->
            <DataTemplate x:Key="TabPillTemplate" x:DataType="models:SearchTabItem">
                <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}" FontSize="12"
                           VerticalAlignment="Center"/>
            </DataTemplate>

            <!--
                The whole column remains clickable, but only the compact label
                surface receives hover/pressed fill. This avoids turning the wide
                name column into a long pill that visually runs into fixed columns.
                The direction glyph is toggled in code-behind.
            -->
            <Style x:Key="SortHeaderButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="Margin" Value="0,0,2,0"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="MinHeight" Value="24"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="IsTabStop" Value="True"/>
                <Setter Property="AllowFocusOnInteraction" Value="False"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="InteractionSurface"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="InteractionSurface"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="InteractionSurface"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <ContentPresenter
                                        Padding="{TemplateBinding Padding}"
                                        Content="{TemplateBinding Content}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <SystemBackdropElement x:Name="PopupMaterialSurface" Grid.RowSpan="5"
                               IsHitTestVisible="False" CornerRadius="0"/>
        <Border x:Name="PopupSurfacePlate" Grid.RowSpan="5"
                IsHitTestVisible="False" CornerRadius="16"/>

        <!-- ── Row 0: search box with icon, input, keycap badge and focus underline ── -->
        <Grid x:Name="SearchBoxRow" Grid.Row="0" Height="56" Padding="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SearchBoxBorder" Grid.Column="0" CornerRadius="12" Height="40" Margin="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    PointerPressed="SearchBoxBorder_PointerPressed">
                <Grid Padding="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid x:Name="DefaultSearchIconGrid" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE721;" FontSize="16"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="ScopeHeaderCluster" Orientation="Horizontal" Spacing="6" Margin="-2,0,10,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                            <Button svc:Localized.AutomationNameKey="Search.Scope.Back"
                                    x:Name="ScopeBackButton"
                                    Style="{StaticResource ClearInputButtonStyle}"
                                    Width="28" Height="28"
                                    Click="ScopeBackButton_Click"
                                    svc:Localized.ToolTipKey="Search.Scope.Back">
                                <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                            </Button>
                            <Border Width="22" Height="22" CornerRadius="5"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <FontIcon x:Name="ScopeHeaderIcon" Glyph="&#xE71D;" FontSize="12"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="ScopeHeaderImage" Width="15" Height="15" Stretch="Uniform"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <Border x:Name="ScopePrefixBadge" Visibility="Collapsed"
                                Padding="8,2,8,3" CornerRadius="6" Margin="0,0,8,0"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Image x:Name="ScopePrefixBadgeIcon" Width="13" Height="13" Stretch="Uniform"
                                       Visibility="Collapsed" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ScopePrefixBadgeText" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBox svc:Localized.AutomationNameKey="Search.Placeholder" x:Name="SearchTextBox" Grid.Column="1"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="15"
                             Padding="0"
                             MinHeight="0"
                             VerticalAlignment="Center"
                             Loaded="SearchTextBox_Loaded"
                             GotFocus="SearchTextBox_GotFocus"
                             LostFocus="SearchTextBox_LostFocus"
                             TextChanged="SearchTextBox_TextChanged"
                             KeyDown="SearchTextBox_KeyDown">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4" Margin="8,0,0,0">
                        <Button svc:Localized.AutomationNameKey="Common.Close"
                                x:Name="ClearQueryButton"
                                Style="{StaticResource ClearInputButtonStyle}"
                                Visibility="Collapsed"
                                Click="ClearQueryButton_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="11"/>
                        </Button>
                        <Border x:Name="HotkeyHintBadge" Padding="6,2,6,3" CornerRadius="5"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="0"
                                Opacity="0.68"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="HotkeyHintText" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ProgressBar x:Name="SearchProgressBar" Height="2"
                         Grid.Column="0"
                         Margin="18,0,18,-5" VerticalAlignment="Bottom"
                         IsIndeterminate="False" Visibility="Collapsed"/>

            <Border x:Name="HeaderBottomDivider" Grid.ColumnSpan="2"
                    Height="1" Margin="-8,0,-8,-8" VerticalAlignment="Bottom"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>

        <!-- ── Row 1: Everything connection guidance banner ── -->
        <Border x:Name="EverythingPromptBanner" Grid.Row="1" Visibility="Collapsed"
                Margin="12,10,12,6" Padding="12,7" CornerRadius="8"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="EverythingPromptIcon" Grid.Column="0"
                          Glyph="&#xE946;" FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center"/>
                <TextBlock x:Name="EverythingPromptTextBlock" Grid.Column="1"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                <Button svc:Localized.AutomationNameKey="Search.EverythingBanner.ConnectAction"
                        x:Name="EverythingConnectButton" Grid.Column="2"
                        AllowFocusOnInteraction="False" IsTabStop="False"
                        Padding="10,3" MinHeight="26" CornerRadius="6"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        Click="EverythingConnectButton_Click">
                    <TextBlock x:Name="EverythingConnectButtonText" FontSize="12" FontWeight="SemiBold"/>
                </Button>
                <Button svc:Localized.AutomationNameKey="Search.EverythingBanner.DontRemind"
                        x:Name="EverythingDismissButton" Grid.Column="3"
                        AllowFocusOnInteraction="False" IsTabStop="False"
                        Width="26" Height="26" Padding="0" CornerRadius="6"
                        Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center"
                        Click="EverythingDismissButton_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="11"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Row 2: single-line scrollable category filter chip bar + pinned rightmost manage button ── -->
        <Grid x:Name="TabsAndFilterRow" Grid.Row="2" Margin="8,8,8,0" Height="28" ColumnSpacing="6" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="TabsScrollViewer" Grid.Column="0"
                          HorizontalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          IsTabStop="False"
                          PointerWheelChanged="TabsScrollViewer_PointerWheelChanged">
                <ListView x:Name="TabsList"
                          SelectionMode="Single" IsTabStop="False"
                          AllowFocusOnInteraction="False"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          Margin="0"
                          ItemContainerStyle="{StaticResource TabPillItemStyle}"
                          ItemTemplate="{StaticResource TabPillTemplate}"
                          SelectionChanged="TabsList_SelectionChanged">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
            </ScrollViewer>

            <Button svc:Localized.AutomationNameKey="Search.Tab.Manage"
                    x:Name="ManageTabsButton"
                    Grid.Column="1"
                    Style="{StaticResource ClearInputButtonStyle}"
                    Width="28" Height="28"
                    CornerRadius="14">
                <Button.Flyout>
                    <Flyout x:Name="ManageTabsFlyout"
                            Placement="BottomEdgeAlignedRight"
                            Opening="ManageTabsFlyout_Opening"
                            Opened="ManageTabsFlyout_Opened"
                            Closed="ManageTabsFlyout_Closed">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="CornerRadius" Value="10"/>
                                <Setter Property="MinWidth" Value="314"/>
                                <Setter Property="MaxWidth" Value="334"/>
                                <Setter Property="Background" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"/>
                                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <Grid Width="320">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Padding="12,8,8,6" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ManageTabsFlyoutTitle" Grid.Column="0"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button svc:Localized.AutomationNameKey="Settings.Clipboard.TabLayout.Reset"
                                        x:Name="ManageTabsResetButton" Grid.Column="1"
                                        Style="{StaticResource CmdBarGhostButtonStyle}"
                                        Height="24" MinHeight="24" Padding="6,0"
                                        Click="ManageTabsResetButton_Click">
                                    <TextBlock x:Name="ManageTabsResetLabel" FontSize="11.5"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Button>
                                <Button svc:Localized.AutomationNameKey="Search.Action.OpenSettings"
                                        x:Name="ManageTabsOpenSettingsButton" Grid.Column="2"
                                        Style="{StaticResource ClearInputButtonStyle}"
                                        Width="24" Height="24"
                                        Click="ManageTabsOpenSettingsButton_Click">
                                    <FontIcon Glyph="&#xE713;" FontSize="12"/>
                                </Button>
                            </Grid>
                            <Border Grid.Row="1" Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            <ListView x:Name="ManageTabsListView" Grid.Row="2"
                                      MaxHeight="264" Padding="6,4,6,6"
                                      SelectionMode="None"
                                      IsItemClickEnabled="False"
                                      AllowFocusOnInteraction="False"
                                      IsTabStop="False"
                                      AllowDrop="True"
                                      CanDragItems="True"
                                      CanReorderItems="True"
                                      ReorderMode="Enabled"
                                      DragItemsCompleted="ManageTabsListView_DragItemsCompleted"/>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Glyph="&#xE71C;" FontSize="12.5"/>
            </Button>
        </Grid>

        <!-- ── Row 3: results area (optional sort header + list + empty states) ── -->
        <Grid x:Name="BodyContentRow" Grid.Row="3" MinHeight="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Split body: left compact single-line result list (3*) + right CmdPal-style Details sidebar card (2*) -->
            <Grid x:Name="ResultsSplitGrid" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ResultsListColumn" Width="3*"/>
                    <ColumnDefinition x:Name="DetailsPaneColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- Left column: optional sortable header bar + result list aligned 1:1 -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!--
                        Optional sortable column headers (hidden by default; configurable in Settings or Ctrl+K).
                        Lives inside the left column so column dividers align 1:1 with SearchResultRowControl
                        whether DetailsPaneCard is open or closed.
                    -->
                    <Grid x:Name="SortHeaderRow" Grid.Row="0" Visibility="Collapsed"
                          Height="28" Margin="8,0,8,2" Padding="9,0,9,1"
                          Background="Transparent"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="SortHeaderTypeCol" Width="72"/>
                            <ColumnDefinition x:Name="SortHeaderSizeCol" Width="84"/>
                            <ColumnDefinition x:Name="SortHeaderDateCol" Width="106"/>
                        </Grid.ColumnDefinitions>

                        <Button svc:Localized.AutomationNameKey="Search.Sort.Name" x:Name="SortNameHeader" Grid.Column="1"
                                Margin="-6,0,2,0" Padding="6,0,8,0" HorizontalContentAlignment="Left"
                                Style="{StaticResource SortHeaderButtonStyle}" Click="SortNameHeader_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SortNameLabel" FontSize="11.5"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <FontIcon x:Name="SortNameDirection" Glyph="&#xE74A;" FontSize="8.5"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Margin="4,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button svc:Localized.AutomationNameKey="Search.Sort.Type" x:Name="SortTypeHeader" Grid.Column="2"
                                Padding="6,0" HorizontalContentAlignment="Left"
                                Style="{StaticResource SortHeaderButtonStyle}" Click="SortTypeHeader_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SortTypeLabel" FontSize="11.5"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <FontIcon x:Name="SortTypeDirection" Glyph="&#xE74B;" FontSize="8.5"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Margin="4,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button svc:Localized.AutomationNameKey="Search.Sort.Size" x:Name="SortSizeHeader" Grid.Column="3"
                                Padding="6,0" HorizontalContentAlignment="Left"
                                Style="{StaticResource SortHeaderButtonStyle}" Click="SortSizeHeader_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SortSizeLabel" FontSize="11.5"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <FontIcon x:Name="SortSizeDirection" Glyph="&#xE74B;" FontSize="8.5"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Margin="4,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button svc:Localized.AutomationNameKey="Search.Sort.Date" x:Name="SortDateHeader" Grid.Column="4"
                                Margin="0,0,2,0" Padding="6,0" HorizontalContentAlignment="Left"
                                Style="{StaticResource SortHeaderButtonStyle}" Click="SortDateHeader_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SortDateLabel" FontSize="11.5"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <FontIcon x:Name="SortDateDirection" Glyph="&#xE74B;" FontSize="8.5"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Margin="4,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border x:Name="SortTypeDivider" Grid.Column="2"
                                Width="1" Height="12" HorizontalAlignment="Left"
                                VerticalAlignment="Center" IsHitTestVisible="False"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Opacity="0.18"/>
                        <Border x:Name="SortSizeDivider" Grid.Column="3"
                                Width="1" Height="12" HorizontalAlignment="Left"
                                VerticalAlignment="Center" IsHitTestVisible="False"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Opacity="0.18"/>
                        <Border x:Name="SortDateDivider" Grid.Column="4"
                                Width="1" Height="12" HorizontalAlignment="Left"
                                VerticalAlignment="Center" IsHitTestVisible="False"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Opacity="0.18"/>
                    </Grid>

                    <!-- Result rows (SearchResultRowControl owns hover/selection visuals; 7px top + 1px row margin = 8px top alignment with DetailsPaneCard) -->
                    <ScrollViewer x:Name="ResultsPanel" Grid.Row="1" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="8,7,8,8"
                                  Background="Transparent"
                                  ViewChanged="ResultsPanel_ViewChanged"
                                  SizeChanged="ResultsPanel_SizeChanged"
                                  KeyDown="ResultsPanel_KeyDown"
                                  PointerPressed="ResultsPanel_PointerPressed"
                                  PointerMoved="ResultsPanel_PointerMoved"
                                  PointerReleased="ResultsPanel_PointerReleased"
                                  PointerCaptureLost="ResultsPanel_PointerCaptureLost"
                                  DoubleTapped="ResultsPanel_DoubleTapped"
                                  RightTapped="ResultsPanel_RightTapped">
                        <ScrollViewer.RenderTransform>
                            <TranslateTransform x:Name="ResultsTranslateTransform"/>
                        </ScrollViewer.RenderTransform>
                        <Grid x:Name="ResultsSurface" Background="Transparent">
                            <ItemsRepeater x:Name="ResultsRepeater">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <controls:SearchResultRowControl/>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <Rectangle x:Name="RubberBandRect" Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                       Opacity="0.9" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                       RadiusX="2" RadiusY="2" StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Right-side Details Sidebar Card (Fluent 2 / Command Palette responsive layout) -->
                <Border x:Name="DetailsPaneCard" Grid.Column="1" Visibility="Collapsed"
                        Margin="0,8,8,8" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="DetailsTranslateTransform"/>
                    </Border.RenderTransform>
                    <ScrollViewer HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="16,16,16,16"
                                  IsTabStop="False">
                        <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                            <!-- Hero Icon (56x56; auto-hidden whenever a visual image/video/PDF preview is shown) -->
                            <Grid x:Name="DetailsHeroIconHost" Width="56" Height="56" HorizontalAlignment="Left">
                                <Border x:Name="DetailsHeroGlyphPlate" Width="56" Height="56" CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <FontIcon x:Name="DetailsHeroGlyph" Glyph="&#xE8A5;" FontSize="24"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="DetailsHeroImagePlate" Width="56" Height="56" CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Visibility="Collapsed">
                                    <Image x:Name="DetailsHeroImage" Width="44" Height="44"
                                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Rich Visual Preview Hero (Images, Video Posters, PDF Page-1, Shell Thumbnails) -->
                            <Border x:Name="DetailsImagePreviewBorder" Visibility="Collapsed"
                                    CornerRadius="6" Padding="4" MaxHeight="192"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Border CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image x:Name="DetailsImagePreview" MaxHeight="184" Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="DetailsVideoBadge" Visibility="Collapsed"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="6" Width="24" Height="24" CornerRadius="12"
                                            Background="#B8000000" IsHitTestVisible="False">
                                        <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="White"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="1,0,0,0"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Hero Title -->
                            <TextBlock x:Name="DetailsTitleText" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                       IsTextSelectionEnabled="True"/>

                            <!-- Optional Multi-line Text / Document / Code / Expression Preview -->
                            <Border x:Name="DetailsBodyPreviewBorder" Visibility="Collapsed"
                                    Padding="12,10" CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <TextBlock x:Name="DetailsBodyPreviewText" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap" MaxLines="9" TextTrimming="CharacterEllipsis"
                                           IsTextSelectionEnabled="True"/>
                            </Border>

                            <Border x:Name="DetailsMetadataDivider" Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Opacity="0.7" IsHitTestVisible="False"/>

                            <!-- Metadata Rows -->
                            <StackPanel Spacing="12">
                                <!-- Type Badge -->
                                <StackPanel x:Name="DetailsTypeSection" Spacing="4">
                                    <TextBlock x:Name="DetailsTypeLabel" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Border HorizontalAlignment="Left" Padding="8,2,8,3" CornerRadius="4"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <TextBlock x:Name="DetailsTypeBadgeText" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Path / Target -->
                                <StackPanel x:Name="DetailsPathSection" Spacing="4" Visibility="Collapsed">
                                    <TextBlock x:Name="DetailsPathLabel" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="DetailsPathValue" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis"
                                               IsTextSelectionEnabled="True"/>
                                </StackPanel>

                                <!-- Extra Metadata Grid (Size / Modified or Source App / Stats) -->
                                <Grid x:Name="DetailsExtraGrid" ColumnSpacing="12" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="DetailsMeta1Section" Grid.Column="0" Spacing="2" Visibility="Collapsed">
                                        <TextBlock x:Name="DetailsMeta1Label" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="DetailsMeta1Value" FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    </StackPanel>
                                    <StackPanel x:Name="DetailsMeta2Section" Grid.Column="1" Spacing="2" Visibility="Collapsed">
                                        <TextBlock x:Name="DetailsMeta2Label" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="DetailsMeta2Value" FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Empty tab: the selected tab has no items (empty state browsing) -->
            <StackPanel x:Name="EmptyTabHintPanel" Grid.Row="2" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="0,20">
                <FontIcon x:Name="EmptyTabHintIcon" Glyph="&#xE8B7;" FontSize="26"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyTabHintText" FontSize="12.5"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- No-results empty state (query returned nothing) -->
            <StackPanel x:Name="NoResultsPanel" Grid.Row="2" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="0,24">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="12"/>
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <FontIcon Glyph="&#xE721;" FontSize="30"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock x:Name="NoResultsTitle" FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock x:Name="NoResultsSubtitle" FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock x:Name="NoResultsEverythingHint" FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,12,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Loading indicator -->
            <StackPanel x:Name="LoadingPanel" Grid.Row="2" Visibility="Collapsed"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top"
                        Padding="18,16,18,0" Spacing="10">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="8" IsStaggeringEnabled="True"/>
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <ProgressRing x:Name="LoadingRing" Width="18" Height="18" IsActive="False"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <TextBlock x:Name="LoadingStatusText" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" TextWrapping="NoWrap"/>
                </StackPanel>
                <Border Height="46" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                <Border Height="46" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0.82"/>
                <Border Height="46" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0.64"/>
                <Border Height="46" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0.46"/>
            </StackPanel>

            <searchControls:RecommendedAppsGridControl x:Name="RecommendedAppsGrid" Grid.Row="2"
                                                       HorizontalAlignment="Stretch"/>
        </Grid>

        <!-- Persistent footer: contextual result actions on the left, settings on the right. -->
        <Grid x:Name="FooterBar" Grid.Row="4" Visibility="Collapsed">
            <!-- Layer fill is the Win11 command-bar/footer material on a Mica
                 base; large in-app acrylic reads as a washed-out hole. -->
            <Border x:Name="FooterAcrylicSurface" CornerRadius="0,0,16,16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    IsHitTestVisible="False"/>
            <Grid Padding="12,7" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

            <toolkit:WrapPanel x:Name="SelectionActionBar" Grid.Column="0"
                               Orientation="Horizontal" HorizontalSpacing="6"
                               VerticalSpacing="6" Visibility="Collapsed">
                <Button svc:Localized.AutomationNameKey="Common.Copy" x:Name="CopySelectedButton" Padding="10,5"
                        Click="CopySelectedButton_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="16"/>
                        <TextBlock x:Name="CopySelectedLabel"/>
                    </StackPanel>
                </Button>
                <Button svc:Localized.AutomationNameKey="Common.Cut" x:Name="CutSelectedButton" Padding="10,5"
                        Click="CutSelectedButton_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C6;" FontSize="16"/>
                        <TextBlock x:Name="CutSelectedLabel"/>
                    </StackPanel>
                </Button>
                <Button svc:Localized.AutomationNameKey="Search.Delete.Action" x:Name="DeleteSelectedButton" Padding="10,5"
                        Click="DeleteSelectedButton_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                        <TextBlock x:Name="DeleteSelectedLabel"/>
                    </StackPanel>
                </Button>
            </toolkit:WrapPanel>

            <Grid x:Name="StatusBar" Grid.Column="0" Visibility="Collapsed"
                  VerticalAlignment="Center" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button svc:Localized.AutomationNameKey="Search.Recommend.Hide"
                        x:Name="BatchHideSelectedButton"
                        Grid.Column="0"
                        Style="{StaticResource QuickButtonStyle}"
                        Visibility="Collapsed"
                        AllowFocusOnInteraction="False" IsTabStop="False"
                        HorizontalAlignment="Left"
                        MinHeight="30" Padding="9,0"
                        Click="BatchHideSelectedButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="BatchHideSelectedIcon" Glyph="&#xED1A;" FontSize="13.5"/>
                        <TextBlock x:Name="BatchHideSelectedLabel"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="StatusTextBlock" Grid.Column="1" FontSize="11.5"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxLines="1"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>

                <StackPanel x:Name="RecommendationFooterRightPanel" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button svc:Localized.AutomationNameKey="Search.Recommend.HiddenTitle"
                            x:Name="HiddenAppsEntryButton"
                            Style="{StaticResource QuickButtonStyle}"
                            Visibility="Collapsed"
                            AllowFocusOnInteraction="False" IsTabStop="False"
                            MinHeight="30" Padding="9,0"
                            Click="HiddenAppsEntryButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="HiddenAppsEntryIcon" Glyph="&#xED1A;" FontSize="14"/>
                            <TextBlock x:Name="HiddenAppsEntryLabel"/>
                        </StackPanel>
                    </Button>
                    <Button svc:Localized.AutomationNameKey="Search.Recommend.Edit"
                            x:Name="EditRecommendationsButton"
                            Style="{StaticResource QuickButtonStyle}"
                            Visibility="Collapsed"
                            AllowFocusOnInteraction="False" IsTabStop="False"
                            MinHeight="30" Padding="9,0"
                            Click="EditRecommendationsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="EditRecommendationsIcon" Glyph="&#xE70F;" FontSize="14"/>
                            <TextBlock x:Name="EditRecommendationsLabel"/>
                        </StackPanel>
                    </Button>
                    <Button svc:Localized.AutomationNameKey="Search.Action.OpenSettings" x:Name="OpenSettingsButton"
                            Style="{StaticResource QuickButtonStyle}"
                            MinHeight="30" Padding="9,0"
                            HorizontalAlignment="Right"
                            Click="OpenSettingsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE713;" FontSize="16"/>
                            <TextBlock x:Name="OpenSettingsLabel"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- CmdPal-style single-result CommandBar: subtle ghost actions + high-contrast keycaps -->
                <Grid x:Name="CmdPalResultFooterGrid" Grid.ColumnSpan="2" Visibility="Collapsed"
                      VerticalAlignment="Center" MinHeight="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="CmdBarContextTitle" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button svc:Localized.AutomationNameKey="Search.Menu.Open"
                                x:Name="CmdBarPrimaryButton"
                                Style="{StaticResource CmdBarGhostButtonStyle}"
                                Click="CmdBarPrimaryButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="CmdBarPrimaryLabel" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Border MinWidth="20" Height="20" Padding="5,0" CornerRadius="4"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock Text="&#x21B5;" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.85"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Border x:Name="CmdBarPrimaryDivider" Width="1" Height="14" Margin="2,0"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Opacity="0.65" VerticalAlignment="Center" IsHitTestVisible="False"/>

                        <Button svc:Localized.AutomationNameKey="Search.Menu.OpenLocation"
                                x:Name="CmdBarSecondaryButton"
                                Style="{StaticResource CmdBarGhostButtonStyle}"
                                Visibility="Collapsed"
                                Click="CmdBarSecondaryButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="CmdBarSecondaryLabel" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Border MinWidth="20" Height="20" Padding="5,0" CornerRadius="4"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1" VerticalAlignment="Center">
                                        <TextBlock Text="Ctrl" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.85"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border MinWidth="20" Height="20" Padding="5,0" CornerRadius="4"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1" VerticalAlignment="Center">
                                        <TextBlock Text="&#x21B5;" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.85"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button svc:Localized.AutomationNameKey="Search.CmdBar.More"
                                x:Name="CmdBarMoreButton"
                                Style="{StaticResource CmdBarGhostButtonStyle}">
                            <Button.Flyout>
                                <Flyout x:Name="CmdBarActionsFlyout"
                                        Placement="TopEdgeAlignedRight"
                                        Opening="CmdBarActionsFlyout_Opening"
                                        Opened="CmdBarActionsFlyout_Opened"
                                        Closed="CmdBarActionsFlyout_Closed">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="CornerRadius" Value="10"/>
                                            <Setter Property="MinWidth" Value="288"/>
                                            <Setter Property="MaxWidth" Value="320"/>
                                            <Setter Property="Background" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"/>
                                            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <Grid Width="292">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ListView x:Name="CmdBarActionsListView" Grid.Row="0"
                                                  MaxHeight="252" Padding="4,4,4,2"
                                                  SelectionMode="Single"
                                                  IsItemClickEnabled="True"
                                                  AllowFocusOnInteraction="False"
                                                  IsTabStop="False"
                                                  ItemClick="CmdBarActionsListView_ItemClick"/>
                                        <TextBlock x:Name="CmdBarActionsEmptyText" Grid.Row="0"
                                                   Visibility="Collapsed"
                                                   Padding="12,16" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <Border Grid.Row="1" Height="1"
                                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                        <Grid Grid.Row="2" Padding="10,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="12"
                                                      Margin="0,0,8,0" VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBox svc:Localized.AutomationNameKey="Search.Actions.FilterPlaceholder"
                                                     x:Name="CmdBarActionsFilterBox" Grid.Column="1"
                                                     FontSize="12" Padding="0" MinHeight="24"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center"
                                                     TextChanged="CmdBarActionsFilterBox_TextChanged"
                                                     PreviewKeyDown="CmdBarActionsFilterBox_PreviewKeyDown">
                                                <TextBox.Resources>
                                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                                </TextBox.Resources>
                                            </TextBox>
                                        </Grid>
                                    </Grid>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="CmdBarMoreLabel" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Border MinWidth="20" Height="20" Padding="5,0" CornerRadius="4"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1" VerticalAlignment="Center">
                                        <TextBlock Text="Ctrl" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.85"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border MinWidth="20" Height="20" Padding="5,0" CornerRadius="4"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1" VerticalAlignment="Center">
                                        <TextBlock Text="K" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.85"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="14" Margin="2,0"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Opacity="0.65" VerticalAlignment="Center" IsHitTestVisible="False"/>

                        <Button svc:Localized.AutomationNameKey="Search.Details.ToggleHide"
                                x:Name="ToggleDetailsPaneButton"
                                Style="{StaticResource ClearInputButtonStyle}"
                                Width="28" Height="28"
                                Click="ToggleDetailsPaneButton_Click">
                            <FontIcon x:Name="ToggleDetailsPaneIcon" Glyph="&#xE8A0;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <searchControls:RecommendationFolderOverlayControl x:Name="RecommendationOverlays" Grid.Row="1" Grid.RowSpan="4" Canvas.ZIndex="18"/>

        <!--
            Settings-driven border overlay: thickness/color follow the widget border
            style settings (see ApplyMaterialFromSettings). Hit testing stays off so it
            never intercepts row interaction.
        -->
        <Border x:Name="PopupBorderOverlay" Grid.RowSpan="5" Canvas.ZIndex="60"
                BorderBrush="Transparent" BorderThickness="0"
                IsHitTestVisible="False" CornerRadius="16"/>

        <controls:WidgetFeedbackPresenter
            x:Name="SearchFeedbackPresenter"
            Grid.RowSpan="5"
            Margin="18,0,18,48"
            Canvas.ZIndex="80" />

        <!--
            Drag hot zone is intentionally limited to a thin strip at the very top of
            the window so it no longer overlaps the search input box. The search box
            (SearchTextBox) lives inside SearchBoxRow (Grid.Row=0) below this strip and
            must remain fully clickable for text input. Only the top edge is draggable.
        -->
        <Grid x:Name="TopDragHotZone" Grid.Row="0"
              HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="10"
              Margin="6,0,6,0"
              Background="Transparent"
              PointerEntered="TopDragHotZone_PointerEntered"
              PointerExited="TopDragHotZone_PointerExited"
              PointerPressed="TopDragHotZone_PointerPressed"
              PointerMoved="WindowInteraction_PointerMoved"
              PointerReleased="WindowInteraction_PointerReleased"
              PointerCaptureLost="WindowInteraction_PointerCaptureLost"
              DoubleTapped="TopDragHotZone_DoubleTapped"/>

        <Grid x:Name="ResizeGrid" Grid.RowSpan="5" Canvas.ZIndex="20" Visibility="Visible" IsHitTestVisible="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="Transparent" Tag="Left" PointerEntered="ResizeBorder_PointerEntered" PointerPressed="ResizeBorder_PointerPressed" PointerMoved="WindowInteraction_PointerMoved" PointerReleased="WindowInteraction_PointerReleased" PointerCaptureLost="WindowInteraction_PointerCaptureLost"/>
            <Border Grid.Column="2" Background="Transparent" Tag="Right" PointerEntered="ResizeBorder_PointerEntered" PointerPressed="ResizeBorder_PointerPressed" PointerMoved="WindowInteraction_PointerMoved" PointerReleased="WindowInteraction_PointerReleased" PointerCaptureLost="WindowInteraction_PointerCaptureLost"/>
        </Grid>
    </Grid>
</Window>
