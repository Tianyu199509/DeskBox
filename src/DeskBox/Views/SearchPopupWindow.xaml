<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskBox.Views.SearchPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeskBox.Controls"
    xmlns:models="using:DeskBox.Models"
    xmlns:svc="using:DeskBox.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Root clips popup content to the configured XAML corner radius while the outer
        HWND remains per-pixel alpha transparent with zero DWM drop shadow.
    -->
    <Grid x:Name="RootGrid" IsTabStop="True"
          VerticalAlignment="Top"
          PreviewKeyDown="RootGrid_PreviewKeyDown"
          KeyDown="RootGrid_KeyDown"
          RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PopupScaleTransform" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="PopupTranslateTransform"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.Resources>
            <!-- Restrained opacity/scale motion keeps hotkey toggles calm, interruptible, and inside HWND bounds. -->
            <Storyboard x:Name="PopupShowStoryboard">
                <DoubleAnimation Storyboard.TargetName="RootGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.167">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="PopupScaleTransform"
                                 Storyboard.TargetProperty="ScaleX"
                                 From="0.985" To="1" Duration="0:0:0.167">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="PopupScaleTransform"
                                 Storyboard.TargetProperty="ScaleY"
                                 From="0.985" To="1" Duration="0:0:0.167">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Name="PopupHideStoryboard">
                <DoubleAnimation Storyboard.TargetName="RootGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.083">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="PopupScaleTransform"
                                 Storyboard.TargetProperty="ScaleX"
                                 From="1" To="0.99" Duration="0:0:0.083">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="PopupScaleTransform"
                                 Storyboard.TargetProperty="ScaleY"
                                 From="1" To="0.99" Duration="0:0:0.083">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!--
                Horizontal quick-action button (New todo / New note / Open settings).
                One row, equal-width cells, Fluent control-fill ladder on hover/press.
            -->
            <Style x:Key="QuickButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              Padding="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource ControlFillColorTertiaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compact Win11 subtle icon action inside edit-mode recommendation tiles. -->
            <Style x:Key="EditCardQuickActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ActionSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActionSurface"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActionSurface"
                                                                               Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActionContent"
                                                                               Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActionSurface"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource ControlFillColorTertiaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActionSurface"
                                                                               Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActionContent"
                                                                               Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ActionContent"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Subtle 26x26 clear button inside the Win11 26H2 search input box. -->
            <Style x:Key="ClearInputButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="AllowFocusOnInteraction" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ClearSurface"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ClearSurface"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ClearContent"
                                                                               Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ClearSurface"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ClearContent"
                                                                               Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ClearContent"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Lightweight Win11 Fluent 2 category capsule pill (28px, CornerRadius=14). -->
            <Style x:Key="TabPillItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0,0,6,4"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabSurface" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabSurface" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabSurface" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabSurface" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabSurface" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlFillColorTertiaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabSurface" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabSurface" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabSurface" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="TabSurface"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Counts are intentionally omitted: Everything pages continuously, so a
                 loaded-row count would look like a total-result cap. -->
            <DataTemplate x:Key="TabPillTemplate" x:DataType="models:SearchTabItem">
                <Grid VerticalAlignment="Stretch">
                    <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}" FontSize="12"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,0,1"/>
                    <Border Height="2" Width="12"
                            CornerRadius="1"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,2"
                            Visibility="{x:Bind SelectionIndicatorVisibility, Mode=OneWay}"/>
                </Grid>
            </DataTemplate>

            <!--
                The whole column remains clickable, but only the compact label
                surface receives hover/pressed fill. This avoids turning the wide
                name column into a long pill that visually runs into fixed columns.
                The direction glyph is toggled in code-behind.
            -->
            <Style x:Key="SortHeaderButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="Margin" Value="0,0,2,0"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="MinHeight" Value="24"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="IsTabStop" Value="True"/>
                <Setter Property="AllowFocusOnInteraction" Value="False"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="InteractionSurface"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="InteractionSurface"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="InteractionSurface"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <ContentPresenter
                                        Padding="{TemplateBinding Padding}"
                                        Content="{TemplateBinding Content}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <SystemBackdropElement x:Name="PopupMaterialSurface" Grid.RowSpan="5"
                               IsHitTestVisible="False" CornerRadius="0"/>
        <Border x:Name="PopupSurfacePlate" Grid.RowSpan="5"
                IsHitTestVisible="False" CornerRadius="16"/>

        <!-- ── Row 0: search box with icon, input, keycap badge and focus underline ── -->
        <Grid x:Name="SearchBoxRow" Grid.Row="0" Height="56" Padding="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SearchBoxBorder" Grid.Column="0" CornerRadius="12" Height="40" Margin="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1">
                <Grid Padding="11,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid x:Name="DefaultSearchIconGrid" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE721;" FontSize="15.5"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="ScopeHeaderCluster" Orientation="Horizontal" Spacing="6" Margin="-3,0,10,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                            <Button svc:Localized.AutomationNameKey="Search.Scope.Back"
                                    x:Name="ScopeBackButton"
                                    Style="{StaticResource ClearInputButtonStyle}"
                                    Width="28" Height="28"
                                    Click="ScopeBackButton_Click"
                                    svc:Localized.ToolTipKey="Search.Scope.Back">
                                <FontIcon Glyph="&#xE76B;" FontSize="11.5"/>
                            </Button>
                            <Border Width="22" Height="22" CornerRadius="5"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <FontIcon x:Name="ScopeHeaderIcon" Glyph="&#xE71D;" FontSize="12.5"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="ScopeHeaderImage" Width="15" Height="15" Stretch="Uniform"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <Border x:Name="ScopePrefixBadge" Visibility="Collapsed"
                                Padding="7,2,7,3" CornerRadius="6" Margin="0,0,8,0"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Image x:Name="ScopePrefixBadgeIcon" Width="13" Height="13" Stretch="Uniform"
                                       Visibility="Collapsed" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ScopePrefixBadgeText" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBox svc:Localized.AutomationNameKey="Search.Placeholder" x:Name="SearchTextBox" Grid.Column="1"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="15"
                             Padding="0"
                             MinHeight="0"
                             VerticalAlignment="Center"
                             Loaded="SearchTextBox_Loaded"
                             GotFocus="SearchTextBox_GotFocus"
                             LostFocus="SearchTextBox_LostFocus"
                             TextChanged="SearchTextBox_TextChanged"
                             KeyDown="SearchTextBox_KeyDown">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4" Margin="8,0,0,0">
                        <Button svc:Localized.AutomationNameKey="Common.Close"
                                x:Name="ClearQueryButton"
                                Style="{StaticResource ClearInputButtonStyle}"
                                Visibility="Collapsed"
                                Click="ClearQueryButton_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="10.5"/>
                        </Button>
                        <Border x:Name="HotkeyHintBadge" Padding="6,2,6,3" CornerRadius="5"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="0"
                                Opacity="0.68"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="HotkeyHintText" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Button svc:Localized.AutomationNameKey="Common.Close" x:Name="ClosePopupButton" Grid.Column="1" Visibility="Collapsed"
                    Width="32" Height="32" Padding="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0"
                    Click="ClosePopupButton_Click"
                    svc:Localized.ToolTipKey="Common.Close">
                <FontIcon Glyph="&#xE8BB;" FontSize="16"/>
            </Button>

            <ProgressBar x:Name="SearchProgressBar" Height="2"
                         Grid.Column="0"
                         Margin="18,0,18,-5" VerticalAlignment="Bottom"
                         IsIndeterminate="False" Visibility="Collapsed"/>

            <Border x:Name="HeaderBottomDivider" Grid.ColumnSpan="2"
                    Height="1" Margin="-8,0,-8,-8" VerticalAlignment="Bottom"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>

        <!-- ── Row 1: Everything connection guidance banner ── -->
        <Border x:Name="EverythingPromptBanner" Grid.Row="1" Visibility="Collapsed"
                Margin="12,10,12,6" Padding="12,7" CornerRadius="8"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="EverythingPromptIcon" Grid.Column="0"
                          Glyph="&#xE946;" FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center"/>
                <TextBlock x:Name="EverythingPromptTextBlock" Grid.Column="1"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                <Button svc:Localized.AutomationNameKey="Search.EverythingBanner.ConnectAction"
                        x:Name="EverythingConnectButton" Grid.Column="2"
                        AllowFocusOnInteraction="False" IsTabStop="False"
                        Padding="10,3" MinHeight="26" CornerRadius="6"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        Click="EverythingConnectButton_Click">
                    <TextBlock x:Name="EverythingConnectButtonText" FontSize="12" FontWeight="SemiBold"/>
                </Button>
                <Button svc:Localized.AutomationNameKey="Search.EverythingBanner.DontRemind"
                        x:Name="EverythingDismissButton" Grid.Column="3"
                        AllowFocusOnInteraction="False" IsTabStop="False"
                        Width="26" Height="26" Padding="0" CornerRadius="6"
                        Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center"
                        Click="EverythingDismissButton_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="11"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Row 2: smart lightweight category capsule bar ── -->
        <Grid x:Name="TabsAndFilterRow" Grid.Row="2" Margin="8,0,8,0" Visibility="Collapsed">
            <ListView x:Name="TabsList"
                      SelectionMode="Single" IsTabStop="False"
                      AllowFocusOnInteraction="False"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      Margin="0,2,0,4"
                      ItemContainerStyle="{StaticResource TabPillItemStyle}"
                      ItemTemplate="{StaticResource TabPillTemplate}"
                      SelectionChanged="TabsList_SelectionChanged">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <toolkit:WrapPanel Orientation="Horizontal"
                                           HorizontalSpacing="0" VerticalSpacing="0"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>
        </Grid>

        <!-- ── Row 3: results area (optional sort header + list + empty states) ── -->
        <Grid x:Name="BodyContentRow" Grid.Row="3" MinHeight="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--
                Optional sortable column headers (hidden by default; configurable in Settings).
                Column structure mirrors SearchResultRowControl (33, *, 72, 84, 104) with exact
                left-edge alignment (50px for Name/Title, +6px inside fixed metadata columns).
            -->
            <Grid x:Name="SortHeaderRow" Grid.Row="1" Visibility="Collapsed"
                  Height="28" Margin="8,0,8,2" Padding="9,0,9,1"
                  Background="Transparent"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="33"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="104"/>
                </Grid.ColumnDefinitions>

                <Button svc:Localized.AutomationNameKey="Search.Sort.Name" x:Name="SortNameHeader" Grid.Column="1"
                        Margin="-6,0,2,0" Padding="6,0,8,0" HorizontalContentAlignment="Left"
                        Style="{StaticResource SortHeaderButtonStyle}" Click="SortNameHeader_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SortNameLabel" FontSize="11.5"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <FontIcon x:Name="SortNameDirection" Glyph="&#xE74A;" FontSize="8.5"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Margin="4,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button svc:Localized.AutomationNameKey="Search.Sort.Type" x:Name="SortTypeHeader" Grid.Column="2"
                        Padding="6,0" HorizontalContentAlignment="Left"
                        Style="{StaticResource SortHeaderButtonStyle}" Click="SortTypeHeader_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SortTypeLabel" FontSize="11.5"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <FontIcon x:Name="SortTypeDirection" Glyph="&#xE74B;" FontSize="8.5"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Margin="4,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button svc:Localized.AutomationNameKey="Search.Sort.Size" x:Name="SortSizeHeader" Grid.Column="3"
                        Padding="6,0" HorizontalContentAlignment="Left"
                        Style="{StaticResource SortHeaderButtonStyle}" Click="SortSizeHeader_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SortSizeLabel" FontSize="11.5"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <FontIcon x:Name="SortSizeDirection" Glyph="&#xE74B;" FontSize="8.5"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Margin="4,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button svc:Localized.AutomationNameKey="Search.Sort.Date" x:Name="SortDateHeader" Grid.Column="4"
                        Margin="0" Padding="6,0" HorizontalContentAlignment="Left"
                        Style="{StaticResource SortHeaderButtonStyle}" Click="SortDateHeader_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SortDateLabel" FontSize="11.5"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <FontIcon x:Name="SortDateDirection" Glyph="&#xE74B;" FontSize="8.5"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Margin="4,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border x:Name="SortTypeDivider" Grid.Column="2"
                        Width="1" Height="12" HorizontalAlignment="Left"
                        VerticalAlignment="Center" IsHitTestVisible="False"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Opacity="0.18"/>
                <Border x:Name="SortSizeDivider" Grid.Column="3"
                        Width="1" Height="12" HorizontalAlignment="Left"
                        VerticalAlignment="Center" IsHitTestVisible="False"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Opacity="0.18"/>
                <Border x:Name="SortDateDivider" Grid.Column="4"
                        Width="1" Height="12" HorizontalAlignment="Left"
                        VerticalAlignment="Center" IsHitTestVisible="False"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Opacity="0.18"/>
            </Grid>

            <!-- Split body: left compact single-line result list (3*) + right CmdPal-style Details sidebar card (2*) -->
            <Grid x:Name="ResultsSplitGrid" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ResultsListColumn" Width="3*"/>
                    <ColumnDefinition x:Name="DetailsPaneColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- Result rows (SearchResultRowControl owns hover/selection visuals) -->
                <ScrollViewer x:Name="ResultsPanel" Grid.Column="0" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" Padding="8,6,8,8"
                              Background="Transparent"
                              ViewChanged="ResultsPanel_ViewChanged"
                              SizeChanged="ResultsPanel_SizeChanged"
                              KeyDown="ResultsPanel_KeyDown"
                              PointerPressed="ResultsPanel_PointerPressed"
                              PointerMoved="ResultsPanel_PointerMoved"
                              PointerReleased="ResultsPanel_PointerReleased"
                              PointerCaptureLost="ResultsPanel_PointerCaptureLost"
                              DoubleTapped="ResultsPanel_DoubleTapped"
                              RightTapped="ResultsPanel_RightTapped">
                    <ScrollViewer.RenderTransform>
                        <TranslateTransform x:Name="ResultsTranslateTransform"/>
                    </ScrollViewer.RenderTransform>
                    <Grid x:Name="ResultsSurface" Background="Transparent">
                        <ItemsRepeater x:Name="ResultsRepeater">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <controls:SearchResultRowControl/>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <Rectangle x:Name="RubberBandRect" Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                   Opacity="0.9" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                   RadiusX="2" RadiusY="2" StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>
                </ScrollViewer>

                <!-- Right-side Details Sidebar Card (PowerToys Command Palette style) -->
                <Border x:Name="DetailsPaneCard" Grid.Column="1" Visibility="Collapsed"
                        Margin="0,6,8,8" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="DetailsTranslateTransform"/>
                    </Border.RenderTransform>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,18,18,16" IsTabStop="False">
                        <StackPanel Spacing="14">
                            <!-- Hero Icon (56x56) -->
                            <Grid x:Name="DetailsHeroIconHost" Width="56" Height="56" HorizontalAlignment="Left">
                                <Border x:Name="DetailsHeroGlyphPlate" Width="56" Height="56" CornerRadius="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <FontIcon x:Name="DetailsHeroGlyph" Glyph="&#xE8A5;" FontSize="24"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="DetailsHeroImagePlate" Width="56" Height="56" CornerRadius="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Visibility="Collapsed">
                                    <Image x:Name="DetailsHeroImage" Width="44" Height="44"
                                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Optional Rich Image / Video / PDF Thumbnail Preview -->
                            <Border x:Name="DetailsImagePreviewBorder" Visibility="Collapsed"
                                    CornerRadius="8" Padding="4" MaxHeight="152"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Image x:Name="DetailsImagePreview" MaxHeight="142" Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border x:Name="DetailsVideoBadge" Visibility="Collapsed"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="4" Width="24" Height="24" CornerRadius="12"
                                            Background="#B8000000" IsHitTestVisible="False">
                                        <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="White"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="1,0,0,0"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Hero Title -->
                            <TextBlock x:Name="DetailsTitleText" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                       IsTextSelectionEnabled="True"/>

                            <!-- Optional Multi-line Text / Document / Code / Expression Preview -->
                            <Border x:Name="DetailsBodyPreviewBorder" Visibility="Collapsed"
                                    Padding="10,8" CornerRadius="8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <TextBlock x:Name="DetailsBodyPreviewText" FontSize="12.5"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap" MaxLines="9" TextTrimming="CharacterEllipsis"
                                           IsTextSelectionEnabled="True"/>
                            </Border>

                            <!-- Metadata Rows -->
                            <StackPanel Spacing="12" Margin="0,2,0,0">
                                <!-- Type Badge -->
                                <StackPanel x:Name="DetailsTypeSection" Spacing="4">
                                    <TextBlock x:Name="DetailsTypeLabel" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Border HorizontalAlignment="Left" Padding="7,2,7,3" CornerRadius="4"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <TextBlock x:Name="DetailsTypeBadgeText" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Path / Target -->
                                <StackPanel x:Name="DetailsPathSection" Spacing="3" Visibility="Collapsed">
                                    <TextBlock x:Name="DetailsPathLabel" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="DetailsPathValue" FontSize="12.5"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis"
                                               IsTextSelectionEnabled="True"/>
                                </StackPanel>

                                <!-- Extra Metadata Grid (Size / Modified or Source App / Stats) -->
                                <Grid x:Name="DetailsExtraGrid" ColumnSpacing="12" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="DetailsMeta1Section" Grid.Column="0" Spacing="2" Visibility="Collapsed">
                                        <TextBlock x:Name="DetailsMeta1Label" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="DetailsMeta1Value" FontSize="12.5"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    </StackPanel>
                                    <StackPanel x:Name="DetailsMeta2Section" Grid.Column="1" Spacing="2" Visibility="Collapsed">
                                        <TextBlock x:Name="DetailsMeta2Label" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="DetailsMeta2Value" FontSize="12.5"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Empty tab: the selected tab has no items (empty state browsing) -->
            <StackPanel x:Name="EmptyTabHintPanel" Grid.Row="2" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="0,20">
                <FontIcon Glyph="&#xE8B7;" FontSize="26"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyTabHintText" FontSize="12.5"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- No-results empty state (query returned nothing) -->
            <StackPanel x:Name="NoResultsPanel" Grid.Row="2" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="0,24">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="12"/>
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <FontIcon Glyph="&#xE721;" FontSize="30"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock x:Name="NoResultsTitle" FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock x:Name="NoResultsSubtitle" FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock x:Name="NoResultsEverythingHint" FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,12,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Loading indicator -->
            <StackPanel x:Name="LoadingPanel" Grid.Row="2" Visibility="Collapsed"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top"
                        Padding="18,16,18,0" Spacing="10">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="8" IsStaggeringEnabled="True"/>
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <ProgressRing x:Name="LoadingRing" Width="18" Height="18" IsActive="False"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <TextBlock x:Name="LoadingStatusText" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" TextWrapping="NoWrap"/>
                </StackPanel>
                <Border Height="46" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                <Border Height="46" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0.82"/>
                <Border Height="46" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0.64"/>
                <Border Height="46" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0.46"/>
            </StackPanel>

            <!-- Skeleton placeholder shown while app icons are loading -->
            <ScrollViewer x:Name="AppsSkeletonPanel" Grid.Row="2" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Disabled" Padding="12,4,12,12">
                <ItemsRepeater x:Name="AppsSkeletonRepeater">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="98" MinItemHeight="92"
                                           MinColumnSpacing="6" MinRowSpacing="6"
                                           ItemsStretch="Fill"
                                           ItemsJustification="Start"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Stretch" MinWidth="98" Height="92" Padding="6,7" CornerRadius="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="36" Height="36" CornerRadius="8"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"/>
                                <Border Grid.Row="1" Width="56" Height="10" CornerRadius="5"
                                        HorizontalAlignment="Center" Margin="0,8,0,0"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Empty-query application launcher (Win11 Start Menu style: single-click launch, drag reorder/folder merge, batch edit mode). -->
            <Grid x:Name="RecommendedAppsPanel" Grid.Row="2" Visibility="Collapsed">
                <ScrollViewer x:Name="RecommendedAppsScrollViewer"
                              VerticalScrollBarVisibility="Auto" Padding="12,4,12,12"
                              Background="Transparent"
                              SizeChanged="RecommendedAppsScrollViewer_SizeChanged"
                              RightTapped="RecommendedAppsPanel_RightTapped">
                    <Grid x:Name="RecommendedAppsSurface" Background="Transparent"
                          PointerPressed="RecommendedAppsSurface_PointerPressed"
                          PointerMoved="RecommendedAppsSurface_PointerMoved"
                          PointerReleased="RecommendedAppsSurface_PointerReleased"
                          PointerCaptureLost="RecommendedAppsSurface_PointerCaptureLost">
                        <ItemsRepeater x:Name="RecommendedAppsRepeater">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="98" MinItemHeight="92"
                                                   MinColumnSpacing="6" MinRowSpacing="6"
                                                   ItemsStretch="Fill"
                                                   ItemsJustification="Start"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:RecommendedGridEntry">
                                    <Grid HorizontalAlignment="Stretch" MinWidth="98" Height="92" Padding="0" Margin="0"
                                          Background="Transparent" CornerRadius="8"
                                          PointerPressed="RecommendedApp_PointerPressed"
                                          PointerMoved="RecommendedApp_PointerMoved"
                                          PointerReleased="RecommendedApp_PointerReleased"
                                          PointerCaptureLost="RecommendedApp_PointerCaptureLost"
                                          PointerEntered="RecommendedApp_PointerEntered"
                                          PointerExited="RecommendedApp_PointerExited">
                                        <Grid x:Name="CardContentHost">
                                            <Border x:Name="CardEditSlotPlate" Visibility="Collapsed"
                                                    IsHitTestVisible="False"
                                                    CornerRadius="8"
                                                    Background="Transparent"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"/>

                                            <Border x:Name="CardSelectionPlate" Visibility="Collapsed"
                                                    IsHitTestVisible="False"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"/>

                                            <Grid Padding="6,8,6,6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid x:Name="SingleIconHost"
                                                          Visibility="{x:Bind SingleIconVisibility, Mode=OneTime}"
                                                          Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Image x:Name="SingleAppIcon" Width="36" Height="36"
                                                               Stretch="Uniform"
                                                               ImageOpened="OnAppIcon_ImageOpened"
                                                               ImageFailed="OnAppIcon_ImageFailed"/>
                                                    </Grid>
                                                    <Border x:Name="FolderPreviewPlate"
                                                            Visibility="{x:Bind FolderPreviewVisibility, Mode=OneTime}"
                                                            Width="44" Height="44" CornerRadius="8" Padding="5"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1">
                                                        <Grid RowSpacing="3" ColumnSpacing="3">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Image x:Name="FolderMiniIcon0" Grid.Row="0" Grid.Column="0" Width="15" Height="15" Stretch="Uniform"/>
                                                            <Image x:Name="FolderMiniIcon1" Grid.Row="0" Grid.Column="1" Width="15" Height="15" Stretch="Uniform"/>
                                                            <Image x:Name="FolderMiniIcon2" Grid.Row="1" Grid.Column="0" Width="15" Height="15" Stretch="Uniform"/>
                                                            <Image x:Name="FolderMiniIcon3" Grid.Row="1" Grid.Column="1" Width="15" Height="15" Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                                <TextBlock x:Name="CardLabelTextBlock" Grid.Row="1" Text="{x:Bind Label, Mode=OneTime}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" TextWrapping="NoWrap"/>
                                            </Grid>

                                            <Grid x:Name="CardSelectionCheckBox" Visibility="Collapsed"
                                                  IsHitTestVisible="False"
                                                  Width="16" Height="16"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                                  Margin="6,6,0,0">
                                                <Border x:Name="CardSelectionUncheckedBox"
                                                        CornerRadius="4"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                                                        BorderThickness="1"/>
                                                <Border x:Name="CardSelectionCheckedBox" Visibility="Collapsed"
                                                        CornerRadius="4"
                                                        Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="9.5"
                                                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>

                                            <Button svc:Localized.AutomationNameKey="Search.Recommend.Hide"
                                                    svc:Localized.ToolTipKey="Search.Recommend.Hide"
                                                    x:Name="CardQuickHideButton"
                                                    Style="{StaticResource EditCardQuickActionButtonStyle}"
                                                    Visibility="Collapsed"
                                                    AllowFocusOnInteraction="False"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,4,4,0"
                                                    Click="CardQuickHideButton_Click">
                                                <FontIcon Glyph="&#xED1A;" FontSize="10.5"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <Border x:Name="RecMergeTargetHighlight" Visibility="Collapsed" IsHitTestVisible="False"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Width="104" Height="92" CornerRadius="10"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                BorderThickness="1.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="RecMergeTargetTransform"/>
                            </Border.RenderTransform>
                        </Border>

                        <Border x:Name="RecDropInsertIndicator" Visibility="Collapsed" IsHitTestVisible="False"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Width="3" Height="68" CornerRadius="1.5"
                                Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="RecDropInsertTransform"/>
                            </Border.RenderTransform>
                        </Border>

                        <Border x:Name="RecRubberBandRect" Visibility="Collapsed" IsHitTestVisible="False"
                                HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="RecRubberBandTransform"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <StackPanel x:Name="AllRecommendedHiddenHintPanel" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="8" Padding="24">
                    <FontIcon Glyph="&#xED1A;" FontSize="26"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock x:Name="AllRecommendedHiddenHintText" FontSize="12.5"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="RecDragGhostBorder" Visibility="Collapsed"
                        IsHitTestVisible="False" Canvas.ZIndex="15"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Width="104" Height="92" Padding="8,7" CornerRadius="10" Opacity="0.92"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="RecDragGhostTransform"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="RecDragGhostImage" Width="36" Height="36" Stretch="Uniform"/>
                            <FontIcon x:Name="RecDragGhostFolderGlyph" Glyph="&#xE8B7;" FontSize="26"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="RecDragGhostTitle" Grid.Row="1" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxLines="1" TextWrapping="NoWrap"/>
                        <Border x:Name="RecDragGhostCountBadge" Grid.Row="0" Visibility="Collapsed"
                                MinWidth="20" Height="20" Padding="5,0" CornerRadius="10"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-3,-2,0"
                                Background="{ThemeResource ControlFillColorTertiaryBrush}"
                                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="RecDragGhostCountText" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Persistent footer: contextual result actions on the left, settings on the right. -->
        <Grid x:Name="FooterBar" Grid.Row="4" Visibility="Collapsed">
            <!-- Layer fill is the Win11 command-bar/footer material on a Mica
                 base; large in-app acrylic reads as a washed-out hole. -->
            <Border x:Name="FooterAcrylicSurface" CornerRadius="0,0,16,16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    IsHitTestVisible="False"/>
            <Grid Padding="12,7" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

            <toolkit:WrapPanel x:Name="SelectionActionBar" Grid.Column="0"
                               Orientation="Horizontal" HorizontalSpacing="6"
                               VerticalSpacing="6" Visibility="Collapsed">
                <Button svc:Localized.AutomationNameKey="Search.Menu.Open" x:Name="OpenSelectedButton" Padding="10,5"
                        Click="OpenSelectedButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                        <TextBlock x:Name="OpenSelectedLabel"/>
                    </StackPanel>
                </Button>
                <Button svc:Localized.AutomationNameKey="Search.Menu.OpenLocation" x:Name="OpenLocationButton" Padding="10,5"
                        Click="OpenLocationButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE838;" FontSize="16"/>
                        <TextBlock x:Name="OpenLocationLabel"/>
                    </StackPanel>
                </Button>
                <Button svc:Localized.AutomationNameKey="Search.Menu.AttachToTodo" x:Name="AttachSelectedButton" Padding="10,5"
                        Click="AttachSelectedButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE723;" FontSize="16"/>
                        <TextBlock x:Name="AttachSelectedLabel"/>
                    </StackPanel>
                </Button>
                <Button svc:Localized.AutomationNameKey="Search.Menu.SaveToNote" x:Name="SaveSelectedButton" Padding="10,5"
                        Click="SaveSelectedButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE70B;" FontSize="16"/>
                        <TextBlock x:Name="SaveSelectedLabel"/>
                    </StackPanel>
                </Button>
                <Button svc:Localized.AutomationNameKey="Common.Copy" x:Name="CopySelectedButton" Padding="10,5"
                        Click="CopySelectedButton_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="16"/>
                        <TextBlock x:Name="CopySelectedLabel"/>
                    </StackPanel>
                </Button>
                <Button svc:Localized.AutomationNameKey="Common.Cut" x:Name="CutSelectedButton" Padding="10,5"
                        Click="CutSelectedButton_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C6;" FontSize="16"/>
                        <TextBlock x:Name="CutSelectedLabel"/>
                    </StackPanel>
                </Button>
                <Button svc:Localized.AutomationNameKey="Search.Delete.Action" x:Name="DeleteSelectedButton" Padding="10,5"
                        Click="DeleteSelectedButton_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                        <TextBlock x:Name="DeleteSelectedLabel"/>
                    </StackPanel>
                </Button>
            </toolkit:WrapPanel>

            <Grid x:Name="StatusBar" Grid.Column="0" Visibility="Collapsed"
                  VerticalAlignment="Center" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button svc:Localized.AutomationNameKey="Search.Recommend.Hide"
                        x:Name="BatchHideSelectedButton"
                        Grid.Column="0"
                        Style="{StaticResource QuickButtonStyle}"
                        Visibility="Collapsed"
                        AllowFocusOnInteraction="False" IsTabStop="False"
                        HorizontalAlignment="Left"
                        MinHeight="30" Padding="9,0"
                        Click="BatchHideSelectedButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xED1A;" FontSize="13.5"/>
                        <TextBlock x:Name="BatchHideSelectedLabel"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="StatusTextBlock" Grid.Column="1" FontSize="11.5"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxLines="1"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>

                <StackPanel x:Name="RecommendationFooterRightPanel" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button svc:Localized.AutomationNameKey="Search.Recommend.HiddenTitle"
                            x:Name="HiddenAppsEntryButton"
                            Style="{StaticResource QuickButtonStyle}"
                            Visibility="Collapsed"
                            AllowFocusOnInteraction="False" IsTabStop="False"
                            MinHeight="30" Padding="9,0"
                            Click="HiddenAppsEntryButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xED1A;" FontSize="14"/>
                            <TextBlock x:Name="HiddenAppsEntryLabel"/>
                        </StackPanel>
                    </Button>
                    <Button svc:Localized.AutomationNameKey="Search.Recommend.Edit"
                            x:Name="EditRecommendationsButton"
                            Style="{StaticResource QuickButtonStyle}"
                            Visibility="Collapsed"
                            AllowFocusOnInteraction="False" IsTabStop="False"
                            MinHeight="30" Padding="9,0"
                            Click="EditRecommendationsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="EditRecommendationsIcon" Glyph="&#xE70F;" FontSize="14"/>
                            <TextBlock x:Name="EditRecommendationsLabel"/>
                        </StackPanel>
                    </Button>
                    <Button svc:Localized.AutomationNameKey="Search.Action.OpenSettings" x:Name="OpenSettingsButton"
                            Style="{StaticResource QuickButtonStyle}"
                            MinHeight="30" Padding="9,0"
                            HorizontalAlignment="Right"
                            Click="OpenSettingsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE713;" FontSize="16"/>
                            <TextBlock x:Name="OpenSettingsLabel"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- CmdPal-style single-result CommandBar: scope label on left, keycap-badged actions + Ctrl+K flyout on right -->
                <Grid x:Name="CmdPalResultFooterGrid" Grid.ColumnSpan="2" Visibility="Collapsed"
                      VerticalAlignment="Center" MinHeight="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="CmdBarContextTitle" FontSize="12.5"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button svc:Localized.AutomationNameKey="Search.Menu.Open"
                                x:Name="CmdBarPrimaryButton"
                                Style="{StaticResource QuickButtonStyle}"
                                AllowFocusOnInteraction="False" IsTabStop="False"
                                MinHeight="28" Padding="8,0"
                                Click="CmdBarPrimaryButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="CmdBarPrimaryLabel" FontSize="12.5" VerticalAlignment="Center"/>
                                <Border Padding="5,1,5,2" CornerRadius="4"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock Text="&#x21B5;" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Border x:Name="CmdBarPrimaryDivider" Width="1" Height="14" Margin="2,0"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Opacity="0.6" VerticalAlignment="Center" IsHitTestVisible="False"/>

                        <Button svc:Localized.AutomationNameKey="Search.Menu.OpenLocation"
                                x:Name="CmdBarSecondaryButton"
                                Style="{StaticResource QuickButtonStyle}"
                                AllowFocusOnInteraction="False" IsTabStop="False"
                                MinHeight="28" Padding="8,0"
                                Visibility="Collapsed"
                                Click="CmdBarSecondaryButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="CmdBarSecondaryLabel" FontSize="12.5" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Border Padding="5,1,5,2" CornerRadius="4"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="Ctrl" FontSize="10.5"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                    <Border Padding="5,1,5,2" CornerRadius="4"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="&#x21B5;" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button svc:Localized.AutomationNameKey="Search.CmdBar.More"
                                x:Name="CmdBarMoreButton"
                                Style="{StaticResource QuickButtonStyle}"
                                AllowFocusOnInteraction="False" IsTabStop="False"
                                MinHeight="28" Padding="8,0">
                            <Button.Flyout>
                                <Flyout x:Name="CmdBarActionsFlyout"
                                        Placement="TopEdgeAlignedRight"
                                        Opening="CmdBarActionsFlyout_Opening"
                                        Opened="CmdBarActionsFlyout_Opened"
                                        Closed="CmdBarActionsFlyout_Closed">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="CornerRadius" Value="10"/>
                                            <Setter Property="MinWidth" Value="288"/>
                                            <Setter Property="MaxWidth" Value="320"/>
                                            <Setter Property="Background" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"/>
                                            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <Grid Width="292">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ListView x:Name="CmdBarActionsListView" Grid.Row="0"
                                                  MaxHeight="252" Padding="4,4,4,2"
                                                  SelectionMode="Single"
                                                  IsItemClickEnabled="True"
                                                  AllowFocusOnInteraction="False"
                                                  IsTabStop="False"
                                                  ItemClick="CmdBarActionsListView_ItemClick"/>
                                        <TextBlock x:Name="CmdBarActionsEmptyText" Grid.Row="0"
                                                   Visibility="Collapsed"
                                                   Padding="12,16" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <Border Grid.Row="1" Height="1"
                                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                        <Grid Grid.Row="2" Padding="10,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="12.5"
                                                      Margin="0,0,8,0" VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBox svc:Localized.AutomationNameKey="Search.Actions.FilterPlaceholder"
                                                     x:Name="CmdBarActionsFilterBox" Grid.Column="1"
                                                     FontSize="12.5" Padding="0" MinHeight="24"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center"
                                                     TextChanged="CmdBarActionsFilterBox_TextChanged"
                                                     PreviewKeyDown="CmdBarActionsFilterBox_PreviewKeyDown">
                                                <TextBox.Resources>
                                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                                </TextBox.Resources>
                                            </TextBox>
                                        </Grid>
                                    </Grid>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="CmdBarMoreLabel" FontSize="12.5" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Border Padding="5,1,5,2" CornerRadius="4"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="Ctrl" FontSize="10.5"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                    <Border Padding="5,1,5,2" CornerRadius="4"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="K" FontSize="10.5"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button svc:Localized.AutomationNameKey="Search.Details.ToggleHide"
                                x:Name="ToggleDetailsPaneButton"
                                Style="{StaticResource ClearInputButtonStyle}"
                                Width="28" Height="28" Margin="2,0,0,0"
                                Click="ToggleDetailsPaneButton_Click">
                            <FontIcon x:Name="ToggleDetailsPaneIcon" Glyph="&#xE8A0;" FontSize="13.5"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Centered frosted overlays for Win11-style recommendation folders and hidden items. -->
        <Grid x:Name="RecommendationOverlaysLayer" Grid.Row="1" Grid.RowSpan="4"
              Canvas.ZIndex="18" Visibility="Collapsed"
              SizeChanged="RecommendationOverlaysLayer_SizeChanged">
            <Grid.Resources>
                <DataTemplate x:Key="OverlayAppTileTemplate" x:DataType="models:SearchResultItem">
                    <Grid HorizontalAlignment="Stretch" MinWidth="80" Height="84" Padding="6,6" Margin="0"
                          Background="Transparent" CornerRadius="8"
                          PointerPressed="OverlayAppCard_PointerPressed"
                          PointerMoved="OverlayAppCard_PointerMoved"
                          PointerReleased="OverlayAppCard_PointerReleased"
                          PointerCaptureLost="OverlayAppCard_PointerCaptureLost"
                          PointerEntered="OverlayAppCard_PointerEntered"
                          PointerExited="OverlayAppCard_PointerExited">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Width="40" Height="40" HorizontalAlignment="Center">
                            <Image Source="{x:Bind Icon, Mode=OneTime}" Width="36" Height="36"
                                   Stretch="Uniform"
                                   ImageOpened="OnAppIcon_ImageOpened"
                                   ImageFailed="OnAppIcon_ImageFailed"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{x:Bind AppDisplayName, Mode=OneTime}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxLines="1" TextWrapping="NoWrap"/>
                    </Grid>
                </DataTemplate>
            </Grid.Resources>

            <!-- Win11 Start Menu centered frosted folder overlay -->
            <Grid x:Name="FolderOverlayHost" Visibility="Collapsed">
                <Border x:Name="FolderOverlayScrim" Background="#48000000"
                        PointerPressed="FolderOverlayScrim_PointerPressed"/>

                <Border x:Name="FolderOverlayCard"
                        MinHeight="208" MaxHeight="356"
                        Margin="16,8,16,14" Padding="18,16,18,18"
                        CornerRadius="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                        BorderThickness="1">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" HorizontalAlignment="Center" MinHeight="34">
                            <Button svc:Localized.AutomationNameKey="Search.Recommend.RenameFolder"
                                    x:Name="FolderOverlayTitleButton"
                                    AllowFocusOnInteraction="False" IsTabStop="False"
                                    Padding="12,4" CornerRadius="6"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Click="FolderOverlayTitleButton_Click">
                                <TextBlock x:Name="FolderOverlayTitleText"
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           MaxWidth="340" MaxLines="1"/>
                            </Button>
                            <TextBox svc:Localized.AutomationNameKey="Search.Recommend.RenameFolder"
                                     x:Name="FolderOverlayTitleEditor"
                                     Visibility="Collapsed"
                                     MinWidth="160" MaxWidth="340"
                                     FontSize="18" FontWeight="SemiBold"
                                     TextAlignment="Center"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     KeyDown="FolderOverlayTitleEditor_KeyDown"
                                     LostFocus="FolderOverlayTitleEditor_LostFocus"/>
                        </Grid>

                        <ScrollViewer x:Name="FolderOverlayScrollViewer" Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="Transparent"
                                      RightTapped="FolderOverlayScrollViewer_RightTapped">
                            <Grid x:Name="FolderOverlaySurface" Background="Transparent">
                                <ItemsRepeater x:Name="FolderAppsRepeater"
                                               ItemTemplate="{StaticResource OverlayAppTileTemplate}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="84" MinItemHeight="84"
                                                           MinColumnSpacing="6" MinRowSpacing="6"
                                                           MaximumRowsOrColumns="4"
                                                           ItemsStretch="Fill"
                                                           ItemsJustification="Start"/>
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>

                                <Border x:Name="FolderDropInsertIndicator" Visibility="Collapsed" IsHitTestVisible="False"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Width="3" Height="64" CornerRadius="1.5"
                                        Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="FolderDropInsertTransform"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border x:Name="FolderDragGhostBorder" Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Width="92" Height="84" Padding="6,6" CornerRadius="10" Opacity="0.92"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="FolderDragGhostTransform"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image x:Name="FolderDragGhostImage" Grid.Row="0" Width="36" Height="36"
                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FolderDragGhostTitle" Grid.Row="1" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxLines="1" TextWrapping="NoWrap"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Centered frosted hidden-items overlay -->
            <Grid x:Name="HiddenAppsOverlayHost" Visibility="Collapsed">
                <Border x:Name="HiddenAppsOverlayScrim" Background="#48000000"
                        PointerPressed="HiddenAppsOverlayScrim_PointerPressed"/>

                <Border x:Name="HiddenAppsOverlayCard"
                        MinHeight="208" MaxHeight="356"
                        Margin="16,8,16,14" Padding="18,16,18,18"
                        CornerRadius="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                        BorderThickness="1">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="HiddenOverlayTitleText"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <TextBlock x:Name="HiddenOverlaySubtitleText"
                                           FontSize="11.5"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            </StackPanel>
                            <Button svc:Localized.AutomationNameKey="Search.Recommend.UnhideAll"
                                    x:Name="UnhideAllButton" Grid.Column="1"
                                    AllowFocusOnInteraction="False" IsTabStop="False"
                                    Padding="10,4" MinHeight="28" CornerRadius="6"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Click="UnhideAllButton_Click">
                                <TextBlock x:Name="UnhideAllButtonText" FontSize="12"/>
                            </Button>
                            <Button svc:Localized.AutomationNameKey="Common.Close"
                                    x:Name="CloseHiddenOverlayButton" Grid.Column="2"
                                    AllowFocusOnInteraction="False" IsTabStop="False"
                                    Width="28" Height="28" Padding="0" CornerRadius="6"
                                    Background="Transparent" BorderThickness="0"
                                    VerticalAlignment="Center"
                                    Click="CloseHiddenOverlayButton_Click">
                                <FontIcon Glyph="&#xE711;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <ScrollViewer x:Name="HiddenOverlayScrollViewer" Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="Transparent"
                                      RightTapped="HiddenOverlayScrollViewer_RightTapped">
                            <ItemsRepeater x:Name="HiddenAppsRepeater"
                                           ItemTemplate="{StaticResource OverlayAppTileTemplate}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="84" MinItemHeight="84"
                                                       MinColumnSpacing="6" MinRowSpacing="6"
                                                       MaximumRowsOrColumns="4"
                                                       ItemsStretch="Fill"
                                                       ItemsJustification="Start"/>
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--
            Settings-driven border overlay: thickness/color follow the widget border
            style settings (see ApplyMaterialFromSettings). Hit testing stays off so it
            never intercepts row interaction.
        -->
        <Border x:Name="PopupBorderOverlay" Grid.RowSpan="5" Canvas.ZIndex="60"
                BorderBrush="Transparent" BorderThickness="0"
                IsHitTestVisible="False" CornerRadius="16"/>

        <controls:WidgetFeedbackPresenter
            x:Name="SearchFeedbackPresenter"
            Grid.RowSpan="5"
            Margin="18,0,18,48"
            Canvas.ZIndex="80" />

        <!--
            Drag hot zone is intentionally limited to a thin strip at the very top of
            the window so it no longer overlaps the search input box. The search box
            (SearchTextBox) lives inside SearchBoxRow (Grid.Row=0) below this strip and
            must remain fully clickable for text input. Only the top edge is draggable.
        -->
        <Grid x:Name="TopDragHotZone" Grid.Row="0"
              HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="10"
              Background="Transparent"
              PointerEntered="TopDragHotZone_PointerEntered"
              PointerExited="TopDragHotZone_PointerExited"
              PointerPressed="TopDragHotZone_PointerPressed"
              PointerMoved="WindowInteraction_PointerMoved"
              PointerReleased="WindowInteraction_PointerReleased"
              PointerCaptureLost="WindowInteraction_PointerCaptureLost"
              DoubleTapped="TopDragHotZone_DoubleTapped"/>

        <Grid x:Name="ResizeGrid" Grid.RowSpan="5" Canvas.ZIndex="20" Visibility="Collapsed" IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="7"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="7"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="Transparent" Tag="TopLeft" PointerEntered="ResizeBorder_PointerEntered" PointerPressed="ResizeBorder_PointerPressed" PointerMoved="WindowInteraction_PointerMoved" PointerReleased="WindowInteraction_PointerReleased" PointerCaptureLost="WindowInteraction_PointerCaptureLost"/>
            <Border Grid.Row="0" Grid.Column="1" Background="Transparent" Tag="Top" PointerEntered="ResizeBorder_PointerEntered" PointerPressed="ResizeBorder_PointerPressed" PointerMoved="WindowInteraction_PointerMoved" PointerReleased="WindowInteraction_PointerReleased" PointerCaptureLost="WindowInteraction_PointerCaptureLost"/>
            <Border Grid.Row="0" Grid.Column="2" Background="Transparent" Tag="TopRight" PointerEntered="ResizeBorder_PointerEntered" PointerPressed="ResizeBorder_PointerPressed" PointerMoved="WindowInteraction_PointerMoved" PointerReleased="WindowInteraction_PointerReleased" PointerCaptureLost="WindowInteraction_PointerCaptureLost"/>
            <Border Grid.Row="1" Grid.Column="0" Background="Transparent" Tag="Left" PointerEntered="ResizeBorder_PointerEntered" PointerPressed="ResizeBorder_PointerPressed" PointerMoved="WindowInteraction_PointerMoved" PointerReleased="WindowInteraction_PointerReleased" PointerCaptureLost="WindowInteraction_PointerCaptureLost"/>
            <Border Grid.Row="1" Grid.Column="2" Background="Transparent" Tag="Right" PointerEntered="ResizeBorder_PointerEntered" PointerPressed="ResizeBorder_PointerPressed" PointerMoved="WindowInteraction_PointerMoved" PointerReleased="WindowInteraction_PointerReleased" PointerCaptureLost="WindowInteraction_PointerCaptureLost"/>
            <Border Grid.Row="2" Grid.Column="0" Background="Transparent" Tag="BottomLeft" PointerEntered="ResizeBorder_PointerEntered" PointerPressed="ResizeBorder_PointerPressed" PointerMoved="WindowInteraction_PointerMoved" PointerReleased="WindowInteraction_PointerReleased" PointerCaptureLost="WindowInteraction_PointerCaptureLost"/>
            <Border Grid.Row="2" Grid.Column="1" Background="Transparent" Tag="Bottom" PointerEntered="ResizeBorder_PointerEntered" PointerPressed="ResizeBorder_PointerPressed" PointerMoved="WindowInteraction_PointerMoved" PointerReleased="WindowInteraction_PointerReleased" PointerCaptureLost="WindowInteraction_PointerCaptureLost"/>
            <Border Grid.Row="2" Grid.Column="2" Background="Transparent" Tag="BottomRight" PointerEntered="ResizeBorder_PointerEntered" PointerPressed="ResizeBorder_PointerPressed" PointerMoved="WindowInteraction_PointerMoved" PointerReleased="WindowInteraction_PointerReleased" PointerCaptureLost="WindowInteraction_PointerCaptureLost"/>
        </Grid>
    </Grid>
</Window>
