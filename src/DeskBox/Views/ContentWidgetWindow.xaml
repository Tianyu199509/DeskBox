<?xml version="1.0" encoding="utf-8"?>
<views:WidgetWindowBase
    x:Class="DeskBox.Views.ContentWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeskBox.Controls"
    xmlns:helpers="using:DeskBox.Helpers"
    xmlns:views="using:DeskBox.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DeskBox Content Widget">

    <Grid
        x:Name="RootGrid"
        helpers:WidgetTextShadow.Scope="True"
        AllowDrop="True"
        Background="Transparent"
        IsTabStop="True"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop"
        PreviewKeyDown="RootGrid_PreviewKeyDown"
        PreviewKeyUp="RootGrid_PreviewKeyUp"
        KeyDown="RootGrid_KeyDown">
        <Grid.Resources>
            <!-- Widget-local semantic foreground resources. The brushes are mutated
                 in place so every ThemeResource consumer updates immediately. -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#E8FFFFFF" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#8FFFFFFF" />
            <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="ControlStrongFillColorDisabledBrush" Color="#8FFFFFFF" />
            <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#E8FFFFFF" />
            <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="#8FFFFFFF" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="WidgetDragHandleBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E8FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#8FFFFFFF" />
            <SolidColorBrush x:Key="SubtleButtonForeground" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="SubtleButtonForegroundPointerOver" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="SubtleButtonForegroundPressed" Color="#E8FFFFFF" />
            <SolidColorBrush x:Key="SubtleButtonForegroundDisabled" Color="#8FFFFFFF" />

            <!-- Keep native text controls and virtualized item containers in the
                 same widget-local foreground scope. These aliases share the
                 mutable semantic brushes above, so mode changes update all
                 realized and future containers without walking the visual tree. -->
            <StaticResource x:Key="DefaultTextForegroundThemeBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="TextControlForeground" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
            <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="TextControlPlaceholderForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
            <StaticResource x:Key="GridViewItemForeground" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="GridViewItemForegroundPointerOver" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="GridViewItemForegroundSelected" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ListViewItemForeground" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ListViewItemForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ListViewItemForegroundPressed" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ListViewItemForegroundSelectedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ListViewItemForegroundSelectedPressed" ResourceKey="TextFillColorPrimaryBrush" />
        </Grid.Resources>

        <controls:WidgetShell
            x:Name="ContentWidgetShell"
            CloseRequested="CloseButton_Click"
            DragHandlePointerMoved="DragHandle_PointerMoved"
            DragHandlePointerPressed="DragHandle_PointerPressed"
            DragHandlePointerReleased="DragHandle_PointerReleased"
            AddRequested="AddButton_Click"
            MoreRequested="MoreButton_Click"
            PositionLockRequested="PositionLockButton_Click"
            SizeLockRequested="SizeLockButton_Click"
            OverlayTitle="{Binding DisplayName}"
            TitleDoubleTapped="ContentWidgetShell_TitleDoubleTapped"
            TitlePointerMoved="TitleBarGrid_PointerMoved"
            TitlePointerPressed="TitleBarGrid_PointerPressed"
            TitlePointerReleased="TitleBarGrid_PointerReleased"
            TitleRightTapped="TitleBarGrid_RightTapped" />

        <Grid
            x:Name="ResizeGrid"
            IsHitTestVisible="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="4" />
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="Transparent" Tag="TopLeft" PointerPressed="ResizeBorder_PointerPressed" />
            <Border Grid.Row="0" Grid.Column="1" Background="Transparent" Tag="Top" PointerPressed="ResizeBorder_PointerPressed" />
            <Border Grid.Row="0" Grid.Column="2" Background="Transparent" Tag="TopRight" PointerPressed="ResizeBorder_PointerPressed" />
            <Border Grid.Row="1" Grid.Column="0" Background="Transparent" Tag="Left" PointerPressed="ResizeBorder_PointerPressed" />
            <Border Grid.Row="1" Grid.Column="2" Background="Transparent" Tag="Right" PointerPressed="ResizeBorder_PointerPressed" />
            <Border Grid.Row="2" Grid.Column="0" Background="Transparent" Tag="BottomLeft" PointerPressed="ResizeBorder_PointerPressed" />
            <Border Grid.Row="2" Grid.Column="1" Background="Transparent" Tag="Bottom" PointerPressed="ResizeBorder_PointerPressed" />
            <Border Grid.Row="2" Grid.Column="2" Background="Transparent" Tag="BottomRight" PointerPressed="ResizeBorder_PointerPressed" />
        </Grid>
    </Grid>
</views:WidgetWindowBase>
