<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Views.SettingsSections.AppearanceSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeskBox.Controls"
    xmlns:svc="using:DeskBox.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <controls:SettingsBoolToVisibilityConverter x:Key="SettingsBoolToVisibilityConverter" />
            <controls:SettingsColorStringConverter x:Key="SettingsColorStringConverter" />
            <Style x:Key="InlineMetricSliderStyle" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
                <Setter Property="Width" Value="200" />
                <Setter Property="MinWidth" Value="160" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsThumbToolTipEnabled" Value="False" />
                <Setter Property="ManipulationMode" Value="TranslateX" />
            </Style>
            <Style x:Key="SliderSettingValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingValueTextStyle}">
                <Setter Property="MinWidth" Value="42" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="CompactNumberBoxStyle" TargetType="NumberBox">
                <Setter Property="Width" Value="128" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Style="{StaticResource SectionPanelStyle}">
        <TextBlock Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level1" svc:Localized.Key="Settings.Section.Appearance" />
        <StackPanel Margin="0,8,0,0" Spacing="4">
            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Settings.Theme.Description"
                svc:Localized.HeaderKey="Settings.Theme.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox svc:Localized.AutomationNameKey="Settings.Theme.Title"
                    MinWidth="{StaticResource SettingsControlMinWidth}"
                    ItemsSource="{Binding AvailableThemeOptions}"
                    controls:SettingsComboBox.Value="{Binding Theme, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Settings.TrayIcon.Description"
                svc:Localized.HeaderKey="Settings.TrayIcon.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE713;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox svc:Localized.AutomationNameKey="Settings.TrayIcon.Title"
                    MinWidth="{StaticResource SettingsControlMinWidth}"
                    ItemsSource="{Binding AvailableTrayIconStyleOptions}"
                    controls:SettingsComboBox.Value="{Binding TrayIconStyle, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <toolkit:SettingsExpander
                HorizontalContentAlignment="Stretch"
                IsExpanded="False"
                svc:Localized.DescriptionKey="Settings.Accent.Source.Description"
                svc:Localized.HeaderKey="Settings.Accent.Source.Title">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7E6;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <ComboBox svc:Localized.AutomationNameKey="Settings.Accent.Source.Title"
                    MinWidth="{StaticResource SettingsControlMinWidth}"
                    ItemsSource="{Binding AvailableAccentColorSourceOptions}"
                    controls:SettingsComboBox.Value="{Binding AccentColorSource, Mode=TwoWay}" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        Description="{Binding AccentColorDescription}"
                        HorizontalContentAlignment="Right"
                        IsEnabled="{Binding CanEditCustomAccent}"
                        svc:Localized.HeaderKey="Settings.Accent.Title">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Vertical" Spacing="8">
                            <toolkit:ColorPickerButton
                                Width="72"
                                Height="34"
                                MinWidth="72"
                                HorizontalAlignment="Right"
                                SelectedColor="{Binding SelectedAccentColorHex, Mode=TwoWay, Converter={StaticResource SettingsColorStringConverter}}"
                                svc:Localized.ToolTipKey="Settings.Accent.Tooltip" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                <Button svc:Localized.AutomationNameKey="Settings.Accent.Preset.Blue" Click="AccentPresetButton_Click" Style="{StaticResource AccentSwatchButtonStyle}" Tag="#0078D4" svc:Localized.ToolTipKey="Settings.Accent.Preset.Blue">
                                    <Border Width="16" Height="16" Background="#0078D4" CornerRadius="8" />
                                </Button>
                                <Button svc:Localized.AutomationNameKey="Settings.Accent.Preset.Coral" Click="AccentPresetButton_Click" Style="{StaticResource AccentSwatchButtonStyle}" Tag="#EF6950" svc:Localized.ToolTipKey="Settings.Accent.Preset.Coral">
                                    <Border Width="16" Height="16" Background="#EF6950" CornerRadius="8" />
                                </Button>
                                <Button svc:Localized.AutomationNameKey="Settings.Accent.Preset.Green" Click="AccentPresetButton_Click" Style="{StaticResource AccentSwatchButtonStyle}" Tag="#2D7D46" svc:Localized.ToolTipKey="Settings.Accent.Preset.Green">
                                    <Border Width="16" Height="16" Background="#2D7D46" CornerRadius="8" />
                                </Button>
                                <Button svc:Localized.AutomationNameKey="Settings.Accent.Preset.Purple" Click="AccentPresetButton_Click" Style="{StaticResource AccentSwatchButtonStyle}" Tag="#8764B8" svc:Localized.ToolTipKey="Settings.Accent.Preset.Purple">
                                    <Border Width="16" Height="16" Background="#8764B8" CornerRadius="8" />
                                </Button>
                                <Button svc:Localized.AutomationNameKey="Settings.Accent.Preset.Orange" Click="AccentPresetButton_Click" Style="{StaticResource AccentSwatchButtonStyle}" Tag="#D83B01" svc:Localized.ToolTipKey="Settings.Accent.Preset.Orange">
                                    <Border Width="16" Height="16" Background="#D83B01" CornerRadius="8" />
                                </Button>
                                <Button svc:Localized.AutomationNameKey="Settings.Accent.Preset.Teal" Click="AccentPresetButton_Click" Style="{StaticResource AccentSwatchButtonStyle}" Tag="#038387" svc:Localized.ToolTipKey="Settings.Accent.Preset.Teal">
                                    <Border Width="16" Height="16" Background="#038387" CornerRadius="8" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <toolkit:SettingsExpander
                HorizontalContentAlignment="Stretch"
                IsExpanded="False"
                Description="{Binding MaterialTypeText}"
                svc:Localized.HeaderKey="Settings.Material.Title">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <ComboBox svc:Localized.AutomationNameKey="Settings.Material.Title"
                    MinWidth="{StaticResource SettingsControlMinWidth}"
                    ItemsSource="{Binding AvailableMaterialTypeOptions}"
                    controls:SettingsComboBox.Value="{Binding MaterialType, Mode=TwoWay}" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        IsEnabled="{Binding ShowOpacitySlider}"
                        svc:Localized.DescriptionKey="Settings.Opacity.Description"
                        svc:Localized.HeaderKey="Settings.Opacity.Title"
                        svc:InfoTip.TitleKey="Settings.Opacity.InfoTip.Title"
                        svc:InfoTip.BodyKey="Settings.Opacity.InfoTip.Description">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource SliderSettingValueTextStyle}" Text="{Binding WidgetOpacityValueText}" />
                            <Slider svc:Localized.AutomationNameKey="Settings.Opacity.Title"
                                Maximum="1"
                                Minimum="0"
                                StepFrequency="0.02"
                                Style="{StaticResource InlineMetricSliderStyle}"
                                Value="{Binding WidgetTransparency, Mode=TwoWay}" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        IsEnabled="{Binding ShowMaterialIntensitySlider}"
                        svc:Localized.DescriptionKey="Settings.MaterialIntensity.Description"
                        svc:Localized.HeaderKey="Settings.MaterialIntensity.Title">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource SliderSettingValueTextStyle}" Text="{Binding MaterialIntensityValueText}" />
                            <Slider svc:Localized.AutomationNameKey="Settings.MaterialIntensity.Title"
                                Maximum="1"
                                Minimum="0"
                                StepFrequency="0.02"
                                Style="{StaticResource InlineMetricSliderStyle}"
                                Value="{Binding MaterialIntensity, Mode=TwoWay}" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        Click="NestedSettingsButton_Click"
                        IsClickEnabled="True"
                        Tag="AppearanceMaterialSettings"
                        svc:Localized.DescriptionKey="Settings.Material.MoreSettings.Description"
                        svc:Localized.HeaderKey="Settings.Material.MoreSettings" />
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <toolkit:SettingsExpander
                HorizontalContentAlignment="Stretch"
                IsExpanded="False"
                Description="{Binding LayoutDensityText}"
                svc:Localized.HeaderKey="Settings.Density.Title">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <ComboBox svc:Localized.AutomationNameKey="Settings.Density.Title"
                    MinWidth="{StaticResource SettingsControlMinWidth}"
                    ItemsSource="{Binding AvailableLayoutDensityOptions}"
                    controls:SettingsComboBox.Value="{Binding LayoutDensity, Mode=TwoWay}" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Settings.Density.Scale.Description"
                        svc:Localized.HeaderKey="Settings.Density.Scale.Title">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource SliderSettingValueTextStyle}" Text="{Binding LayoutDensityValueText}" />
                            <Slider svc:Localized.AutomationNameKey="Settings.Density.Scale.Title"
                                Maximum="1"
                                Minimum="0"
                                StepFrequency="0.02"
                                Style="{StaticResource InlineMetricSliderStyle}"
                                Value="{Binding LayoutDensityScale, Mode=TwoWay}" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Settings.TextSize.Description"
                        svc:Localized.HeaderKey="Settings.TextSize.Title">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource SliderSettingValueTextStyle}" Text="{Binding TextSizeValueText}" />
                            <Slider svc:Localized.AutomationNameKey="Settings.TextSize.Title"
                                Maximum="16"
                                Minimum="10"
                                StepFrequency="0.5"
                                Style="{StaticResource InlineMetricSliderStyle}"
                                Value="{Binding TextSize, Mode=TwoWay}" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Settings.IconSize.Description"
                        svc:Localized.HeaderKey="Settings.IconSize.Title">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource SliderSettingValueTextStyle}" Text="{Binding IconSizeValueText}" />
                            <Slider svc:Localized.AutomationNameKey="Settings.IconSize.Title"
                                Maximum="56"
                                Minimum="24"
                                StepFrequency="2"
                                Style="{StaticResource InlineMetricSliderStyle}"
                                Value="{Binding IconSize, Mode=TwoWay}" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Settings.HorizontalSpacing.Description"
                        svc:Localized.HeaderKey="Settings.HorizontalSpacing.Title">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource SliderSettingValueTextStyle}" Text="{Binding HorizontalSpacingValueText}" />
                            <Slider svc:Localized.AutomationNameKey="Settings.HorizontalSpacing.Title"
                                Maximum="1"
                                Minimum="0"
                                StepFrequency="0.02"
                                Style="{StaticResource InlineMetricSliderStyle}"
                                Value="{Binding HorizontalSpacingScale, Mode=TwoWay}" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Settings.VerticalSpacing.Description"
                        svc:Localized.HeaderKey="Settings.VerticalSpacing.Title">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource SliderSettingValueTextStyle}" Text="{Binding VerticalSpacingValueText}" />
                            <Slider svc:Localized.AutomationNameKey="Settings.VerticalSpacing.Title"
                                Maximum="1"
                                Minimum="0"
                                StepFrequency="0.02"
                                Style="{StaticResource InlineMetricSliderStyle}"
                                Value="{Binding VerticalSpacingScale, Mode=TwoWay}" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <toolkit:SettingsExpander
                HorizontalContentAlignment="Stretch"
                IsExpanded="False"
                Description="{Binding TitleIconModeText}"
                svc:Localized.HeaderKey="Settings.Group.AppVisual.Title">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <ComboBox svc:Localized.AutomationNameKey="Settings.Group.AppVisual.Title"
                    MinWidth="{StaticResource SettingsControlMinWidth}"
                    ItemsSource="{Binding AvailableTitleIconModeOptions}"
                    controls:SettingsComboBox.Value="{Binding TitleIconMode, Mode=TwoWay}" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Settings.DisplayWidgetChrome.Description"
                        svc:Localized.HeaderKey="Settings.DisplayWidgetChrome.Title">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button svc:Localized.AutomationNameKey="Settings.DisplayWidgetChrome.ResetTooltip"
                                Command="{x:Bind ViewModel.ResetDisplayWidgetChromeOverridesCommand, Mode=OneWay}"
                                Style="{StaticResource IconActionButtonStyle}"
                                svc:Localized.ToolTipKey="Settings.DisplayWidgetChrome.ResetTooltip">
                                <FontIcon FontSize="16" Glyph="&#xE72C;" />
                            </Button>
                            <ComboBox svc:Localized.AutomationNameKey="Settings.DisplayWidgetChrome.Title"
                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                ItemsSource="{Binding AvailableDisplayChromeModeOptions}"
                                controls:SettingsComboBox.Value="{Binding DisplayChromeMode, Mode=TwoWay}" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Settings.InteractiveWidgetChrome.Description"
                        svc:Localized.HeaderKey="Settings.InteractiveWidgetChrome.Title">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button svc:Localized.AutomationNameKey="Settings.InteractiveWidgetChrome.ResetTooltip"
                                Command="{x:Bind ViewModel.ResetInteractiveWidgetChromeOverridesCommand, Mode=OneWay}"
                                Style="{StaticResource IconActionButtonStyle}"
                                svc:Localized.ToolTipKey="Settings.InteractiveWidgetChrome.ResetTooltip">
                                <FontIcon FontSize="16" Glyph="&#xE72C;" />
                            </Button>
                            <ComboBox svc:Localized.AutomationNameKey="Settings.InteractiveWidgetChrome.Title"
                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                ItemsSource="{Binding AvailableInteractiveChromeModeOptions}"
                                controls:SettingsComboBox.Value="{Binding InteractiveChromeMode, Mode=TwoWay}" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Settings.DefaultWidth.Description"
                        svc:Localized.HeaderKey="Settings.DefaultWidth.Title">
                        <controls:WrapFlowPanel VerticalAlignment="Center" HorizontalSpacing="16" VerticalSpacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SettingValueTextStyle}"
                                    svc:Localized.Key="Settings.DefaultWidth.Title" />
                                <NumberBox svc:Localized.AutomationNameKey="Settings.DefaultWidth.Title"
                                    x:Name="DefaultWidthBox"
                                    Style="{StaticResource CompactNumberBoxStyle}"
                                    Minimum="200"
                                    Maximum="1200"
                                    Value="{Binding DefaultWidth, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SettingValueTextStyle}"
                                    svc:Localized.Key="Settings.DefaultHeight.Title" />
                                <NumberBox svc:Localized.AutomationNameKey="Settings.DefaultHeight.Title"
                                    x:Name="DefaultHeightBox"
                                    Style="{StaticResource CompactNumberBoxStyle}"
                                    Minimum="200"
                                    Maximum="1200"
                                    Value="{Binding DefaultHeight, Mode=TwoWay}" />
                            </StackPanel>
                        </controls:WrapFlowPanel>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <toolkit:SettingsExpander
                HorizontalContentAlignment="Stretch"
                IsExpanded="False"
                Description="{Binding AnimationSummaryText}"
                svc:Localized.HeaderKey="Settings.Group.Animation.Title"
                svc:InfoTip.TitleKey="Settings.Group.Animation.InfoTip.Title"
                svc:InfoTip.BodyKey="Settings.Group.Animation.InfoTip.Description">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7B5;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <ComboBox svc:Localized.AutomationNameKey="Settings.Group.Animation.Title"
                    MinWidth="{StaticResource SettingsControlMinWidth}"
                    ItemsSource="{Binding AvailableAnimationEffectOptions}"
                    controls:SettingsComboBox.Value="{Binding AnimationEffect, Mode=TwoWay}" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        IsEnabled="{Binding IsDirectionEnabled}"
                        svc:Localized.DescriptionKey="Settings.Animation.Direction.Description"
                        svc:Localized.HeaderKey="Settings.Animation.Direction.Title">
                        <ComboBox svc:Localized.AutomationNameKey="Settings.Animation.Direction.Title"
                            MinWidth="{StaticResource SettingsControlMinWidth}"
                            ItemsSource="{Binding AvailableAnimationSlideDirectionOptions}"
                            controls:SettingsComboBox.Value="{Binding AnimationSlideDirection, Mode=TwoWay}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        IsEnabled="{Binding IsSpeedEnabled}"
                        svc:Localized.DescriptionKey="Settings.Animation.Speed.Description"
                        svc:Localized.HeaderKey="Settings.Animation.Speed.Title">
                        <ComboBox svc:Localized.AutomationNameKey="Settings.Animation.Speed.Title"
                            MinWidth="{StaticResource SettingsControlMinWidth}"
                            ItemsSource="{Binding AvailableAnimationSpeedOptions}"
                            controls:SettingsComboBox.Value="{Binding AnimationSpeed, Mode=TwoWay}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        IsEnabled="{Binding IsEasingEnabled}"
                        svc:Localized.DescriptionKey="Settings.Animation.Easing.Description"
                        svc:Localized.HeaderKey="Settings.Animation.Easing.Title">
                        <ComboBox svc:Localized.AutomationNameKey="Settings.Animation.Easing.Title"
                            MinWidth="{StaticResource SettingsControlMinWidth}"
                            ItemsSource="{Binding AvailableAnimationEasingIntensityOptions}"
                            controls:SettingsComboBox.Value="{Binding AnimationEasingIntensity, Mode=TwoWay}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        IsEnabled="{Binding IsStaggerEnabled}"
                        svc:Localized.DescriptionKey="Settings.Animation.Stagger.Description"
                        svc:Localized.HeaderKey="Settings.Animation.Stagger.Title"
                        svc:InfoTip.TitleKey="Settings.Animation.Stagger.InfoTip.Title"
                        svc:InfoTip.BodyKey="Settings.Animation.Stagger.InfoTip.Description">
                        <ToggleSwitch svc:Localized.AutomationNameKey="Settings.Animation.Stagger.Title"
                            MinWidth="0"
                            OffContent=""
                            OnContent=""
                            IsOn="{Binding AnimationStaggerEnabled, Mode=TwoWay}" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <toolkit:SettingsCard
                Click="NestedSettingsButton_Click"
                IsClickEnabled="True"
                Tag="WidgetGroups"
                svc:Localized.DescriptionKey="Settings.WidgetGroups.Overview.Description"
                svc:Localized.HeaderKey="Settings.Section.WidgetGroups">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE713;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

        </StackPanel>
    </StackPanel>
</UserControl>
