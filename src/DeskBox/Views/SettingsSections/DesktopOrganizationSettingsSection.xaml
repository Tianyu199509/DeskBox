<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Views.SettingsSections.DesktopOrganizationSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:DeskBox.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Style="{StaticResource SectionPanelStyle}" Spacing="12">
        <InfoBar
            x:Name="RuleStatusInfo"
            IsOpen="False"
            IsClosable="True" />

        <StackPanel x:Name="RuleListPanel" Spacing="16">
            <toolkit:SettingsCard
                x:Name="OrganizationSummaryCard"
                HorizontalContentAlignment="Right">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE74C;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button svc:Localized.AutomationNameKey="DesktopOrganization.Notification.Undo"
                        x:Name="UndoOrganizationButton"
                        Visibility="Collapsed"
                        Click="UndoOrganizationButton_Click"
                        svc:Localized.Key="DesktopOrganization.Notification.Undo" />
                        <Button svc:Localized.AutomationNameKey="DesktopOrganization.OneClick.Action"
                            x:Name="OrganizeNowButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OrganizeNowButton_Click"
                            svc:Localized.Key="DesktopOrganization.OneClick.Action" />
                </StackPanel>
            </toolkit:SettingsCard>

            <StackPanel Spacing="6">
                <toolkit:SettingsCard
                    x:Name="AutoSetupCard"
                    HorizontalContentAlignment="Right"
                    svc:Localized.DescriptionKey="DesktopOrganization.Auto.SetupDescription"
                    svc:Localized.HeaderKey="DesktopOrganization.Auto.SetupTitle">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE713;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <Button svc:Localized.AutomationNameKey="DesktopOrganization.Auto.SetupAction"
                        Click="AutoSetupButton_Click"
                        svc:Localized.Key="DesktopOrganization.Auto.SetupAction" />
                </toolkit:SettingsCard>

                <toolkit:SettingsExpander
                    x:Name="AutoToggleCard"
                    Visibility="Collapsed"
                    IsExpanded="False"
                    svc:Localized.DescriptionKey="DesktopOrganization.Auto.Description"
                    svc:Localized.HeaderKey="DesktopOrganization.Auto.Title"
                    svc:InfoTip.TitleKey="DesktopOrganization.Auto.InfoTip.Title"
                    svc:InfoTip.BodyKey="DesktopOrganization.Auto.InfoTip.Description">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <ToggleSwitch svc:Localized.AutomationNameKey="DesktopOrganization.Auto.Title"
                        x:Name="AutoOrganizationToggle"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="AutoOrganizationToggle_Toggled" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                            x:Name="AutoIntervalCard"
                            Visibility="Collapsed"
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="DesktopOrganization.Auto.Interval.Description"
                            svc:Localized.HeaderKey="DesktopOrganization.Auto.Interval.Title"
                            svc:InfoTip.TitleKey="DesktopOrganization.Auto.Interval.InfoTip.Title"
                            svc:InfoTip.BodyKey="DesktopOrganization.Auto.Interval.InfoTip.Description">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE823;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox svc:Localized.AutomationNameKey="DesktopOrganization.Auto.Interval.Title"
                                x:Name="AutoIntervalComboBox"
                                MinWidth="150"
                                SelectionChanged="AutoIntervalComboBox_SelectionChanged" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock
                    Style="{StaticResource SettingsSubsectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level2"
                    svc:Localized.Key="DesktopOrganization.Rules.SectionTitle" />
                <TextBlock
                    Margin="0,-3,0,2"
                    Style="{StaticResource SettingDescriptionTextStyle}"
                    svc:Localized.Key="DesktopOrganization.Rules.SectionDescription" />
                <AutoSuggestBox
                    x:Name="WidgetSearchBox"
                    Visibility="Collapsed"
                    QueryIcon="Find"
                    TextChanged="WidgetSearchBox_TextChanged" />
                <StackPanel x:Name="WidgetRuleCards" Spacing="4" />

                <toolkit:SettingsExpander
                    x:Name="TypeOverviewExpander"
                    IsExpanded="False"
                    svc:Localized.DescriptionKey="DesktopOrganization.Rules.ByTypeDescription"
                    svc:Localized.HeaderKey="DesktopOrganization.Rules.ByType">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel x:Name="TypeOverviewRows" Spacing="4" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
            </StackPanel>

        </StackPanel>

        <StackPanel x:Name="RuleDetailPanel" Visibility="Collapsed" Spacing="12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button svc:Localized.AutomationNameKey="DesktopOrganization.Common.Back"
                    Width="36"
                    Height="36"
                    Padding="0"
                    Click="CloseRuleDetailButton_Click"
                    svc:Localized.ToolTipKey="DesktopOrganization.Common.Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="13" />
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="RuleDetailTitle" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="RuleDetailPath"
                        Style="{StaticResource SettingDescriptionTextStyle}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind RuleDetailPath.Text, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <toolkit:SettingsCard
                x:Name="RuleEnabledCard"
                HorizontalContentAlignment="Right"
                svc:Localized.HeaderKey="DesktopOrganization.Rule.Enable.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch svc:Localized.AutomationNameKey="DesktopOrganization.Rule.Enable.Title"
                    x:Name="RuleEnabledToggle"
                    MinWidth="0"
                    OffContent=""
                    OnContent=""
                    Toggled="RuleEnabledToggle_Toggled" />
            </toolkit:SettingsCard>

            <toolkit:SettingsExpander
                x:Name="FileTypeExpander"
                IsExpanded="False"
                svc:Localized.HeaderKey="DesktopOrganization.Rule.AddFileTypes">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        ContentAlignment="Vertical"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Style="{StaticResource SettingTitleTextStyle}"
                                svc:Localized.Key="DesktopOrganization.Rule.Categories" />
                            <TextBlock
                                Margin="0,-8,0,0"
                                Style="{StaticResource SettingDescriptionTextStyle}"
                                TextWrapping="Wrap"
                                svc:Localized.Key="DesktopOrganization.Rule.CategoriesDescription" />
                            <StackPanel x:Name="CategoryChecks" Spacing="4" />
                            <TextBlock
                                Style="{StaticResource SettingTitleTextStyle}"
                                svc:Localized.Key="DesktopOrganization.Rule.SpecificTypes" />
                            <TextBlock
                                Margin="0,-8,0,0"
                                Style="{StaticResource SettingDescriptionTextStyle}"
                                TextWrapping="Wrap"
                                svc:Localized.Key="DesktopOrganization.Rule.SpecificTypesDescription" />
                            <StackPanel x:Name="SubtypeChecks" Spacing="4" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <toolkit:SettingsExpander
                IsExpanded="False"
                svc:Localized.HeaderKey="DesktopOrganization.Rule.Advanced">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE713;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        ContentAlignment="Vertical"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Style="{StaticResource SettingTitleTextStyle}"
                                svc:Localized.Key="DesktopOrganization.Rule.Extensions" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox
                                    x:Name="ExtensionInput"
                                    KeyDown="ExtensionInput_KeyDown" />
                                <Button svc:Localized.AutomationNameKey="DesktopOrganization.Common.Add"
                                    Grid.Column="1"
                                    Click="AddExtensionButton_Click"
                                    svc:Localized.Key="DesktopOrganization.Common.Add" />
                            </Grid>
                            <StackPanel x:Name="ExtensionChips" Orientation="Horizontal" Spacing="6" />

                            <TextBlock
                                Style="{StaticResource SettingTitleTextStyle}"
                                svc:Localized.Key="DesktopOrganization.Rule.Exclusions" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox
                                    x:Name="ExcludedExtensionInput"
                                    KeyDown="ExcludedExtensionInput_KeyDown" />
                                <Button svc:Localized.AutomationNameKey="DesktopOrganization.Common.Add"
                                    Grid.Column="1"
                                    Click="AddExcludedExtensionButton_Click"
                                    svc:Localized.Key="DesktopOrganization.Common.Add" />
                            </Grid>
                            <StackPanel x:Name="ExcludedExtensionChips" Orientation="Horizontal" Spacing="6" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
    </StackPanel>
</UserControl>
