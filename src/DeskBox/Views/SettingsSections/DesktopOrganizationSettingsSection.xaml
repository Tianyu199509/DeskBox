<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Views.SettingsSections.DesktopOrganizationSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeskBox.Controls"
    xmlns:svc="using:DeskBox.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <InfoBar
            x:Name="RuleStatusInfo"
            IsOpen="False"
            IsClosable="True" />

        <!-- Level 1: Overview inside "文件与整理" -->
        <StackPanel x:Name="OrganizationOverviewPanel" Spacing="4">
            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource SettingsSubsectionTitleTextStyle}"
                AutomationProperties.HeadingLevel="Level2"
                svc:Localized.Key="DesktopOrganization.Settings.Title" />

            <toolkit:SettingsCard
                x:Name="OrganizeNowCard"
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="DesktopOrganization.OrganizeNow.Description"
                svc:Localized.HeaderKey="DesktopOrganization.Action.OpenWorkbench">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button
                    x:Name="OrganizeNowButton"
                    Style="{StaticResource AccentActionButtonStyle}"
                    Click="OrganizeNowButton_Click"
                    svc:Localized.AutomationNameKey="DesktopOrganization.Action.OpenWorkbench">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                        <TextBlock svc:Localized.Key="DesktopOrganization.Action.OpenWorkbench" />
                    </StackPanel>
                </Button>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                x:Name="AutoOrganizationEntryCard"
                Click="AutoOrganizationEntryCard_Click"
                HorizontalContentAlignment="Right"
                IsClickEnabled="True"
                svc:Localized.HeaderKey="DesktopOrganization.Auto.Title"
                svc:InfoTip.TitleKey="DesktopOrganization.Auto.InfoTip.Title"
                svc:InfoTip.BodyKey="DesktopOrganization.Auto.InfoTip.Description">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="AutoOrganizationEntryToggle"
                    MinWidth="0"
                    OffContent=""
                    OnContent=""
                    Toggled="AutoOrganizationEntryToggle_Toggled"
                    svc:Localized.AutomationNameKey="DesktopOrganization.Auto.Title" />
            </toolkit:SettingsCard>
        </StackPanel>

        <!-- Level 2: Dedicated Auto-Organization & Rules Subpage (zero 3rd-level hops) -->
        <StackPanel x:Name="AutoOrganizationSubPagePanel" Visibility="Collapsed" Spacing="4">
            <InfoBar
                x:Name="NoRulesGuidanceInfoBar"
                IsOpen="False"
                IsClosable="False"
                Severity="Informational"
                Visibility="Collapsed"
                svc:Localized.HeaderKey="DesktopOrganization.Auto.NeedRulesActiveTitle"
                svc:Localized.DescriptionKey="DesktopOrganization.Auto.NeedRulesActiveBody" />

            <toolkit:SettingsCard
                x:Name="AutoToggleCard"
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="DesktopOrganization.Auto.Description"
                svc:Localized.HeaderKey="DesktopOrganization.Auto.Title"
                svc:InfoTip.TitleKey="DesktopOrganization.Auto.InfoTip.Title"
                svc:InfoTip.BodyKey="DesktopOrganization.Auto.InfoTip.Description">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="AutoOrganizationToggle"
                    MinWidth="0"
                    OffContent=""
                    OnContent=""
                    Toggled="AutoOrganizationToggle_Toggled"
                    svc:Localized.AutomationNameKey="DesktopOrganization.Auto.Title" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                x:Name="AutoIntervalCard"
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="DesktopOrganization.Auto.Interval.Description"
                svc:Localized.HeaderKey="DesktopOrganization.Auto.Interval.Title"
                svc:InfoTip.TitleKey="DesktopOrganization.Auto.Interval.InfoTip.Title"
                svc:InfoTip.BodyKey="DesktopOrganization.Auto.Interval.InfoTip.Description">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE823;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="AutoIntervalComboBox"
                    MinWidth="{StaticResource SettingsControlMinWidth}"
                    MaxWidth="{StaticResource SettingsControlMaxWidth}"
                    SelectionChanged="AutoIntervalComboBox_SelectionChanged"
                    svc:Localized.AutomationNameKey="DesktopOrganization.Auto.Interval.Title" />
            </toolkit:SettingsCard>

            <Grid Margin="0,12,0,4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Style="{StaticResource SettingsSubsectionTitleTextStyle}"
                        AutomationProperties.HeadingLevel="Level2"
                        svc:Localized.Key="DesktopOrganization.Rules.SectionTitle" />
                    <TextBlock
                        Style="{StaticResource SettingDescriptionTextStyle}"
                        TextWrapping="Wrap"
                        svc:Localized.Key="DesktopOrganization.Rules.SectionDescription" />
                </StackPanel>
                <SelectorBar
                    x:Name="RulesViewSelectorBar"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    SelectionChanged="RulesViewSelectorBar_SelectionChanged">
                    <SelectorBarItem
                        x:Name="ByTypeViewTab"
                        IsSelected="True"
                        Tag="ByType"
                        svc:Localized.Key="DesktopOrganization.Rules.ViewByType" />
                    <SelectorBarItem
                        x:Name="ByWidgetViewTab"
                        Tag="ByWidget"
                        svc:Localized.Key="DesktopOrganization.Rules.ViewByWidget" />
                </SelectorBar>
            </Grid>

            <toolkit:SettingsCard
                x:Name="NoFileWidgetsCard"
                Visibility="Collapsed"
                HorizontalContentAlignment="Right"
                svc:Localized.HeaderKey="DesktopOrganization.Rules.Empty">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button
                    Style="{StaticResource AccentActionButtonStyle}"
                    Click="OrganizeNowButton_Click"
                    svc:Localized.AutomationNameKey="DesktopOrganization.Action.OpenWorkbench">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                        <TextBlock svc:Localized.Key="DesktopOrganization.Action.OpenWorkbench" />
                    </StackPanel>
                </Button>
            </toolkit:SettingsCard>

            <!-- View 1 (Default): By File Type — 7 clean rows + ToolTip extensions + ComboBox target -->
            <StackPanel x:Name="ByTypeRulesPanel" Spacing="4">
                <StackPanel x:Name="CategoryMappingCards" Spacing="4" />

                <toolkit:SettingsExpander
                    x:Name="ByTypeAdvancedExpander"
                    Margin="0,4,0,0"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="False"
                    svc:Localized.DescriptionKey="DesktopOrganization.Rules.SubtypesAndCustom.Description"
                    svc:Localized.HeaderKey="DesktopOrganization.Rules.SubtypesAndCustom.Title">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE713;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch"
                            svc:Localized.DescriptionKey="DesktopOrganization.Rule.SpecificTypesDescription"
                            svc:Localized.HeaderKey="DesktopOrganization.Rule.SpecificTypes">
                            <StackPanel x:Name="SubtypeMappingRows" Spacing="8" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch"
                            svc:Localized.DescriptionKey="DesktopOrganization.Rule.Advanced.Description"
                            svc:Localized.HeaderKey="DesktopOrganization.Rule.Advanced">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Style="{StaticResource SettingTitleTextStyle}"
                                    svc:Localized.Key="DesktopOrganization.Rule.Extensions" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox
                                        x:Name="ByTypeExtensionInput"
                                        Grid.Column="0"
                                        KeyDown="ByTypeExtensionInput_KeyDown" />
                                    <ComboBox
                                        x:Name="ByTypeExtensionTargetComboBox"
                                        Grid.Column="1"
                                        MinWidth="148"
                                        MaxWidth="220" />
                                    <Button
                                        Grid.Column="2"
                                        Click="ByTypeAddExtensionButton_Click"
                                        Style="{StaticResource ActionButtonStyle}"
                                        svc:Localized.AutomationNameKey="DesktopOrganization.Common.Add"
                                        svc:Localized.Key="DesktopOrganization.Common.Add" />
                                </Grid>
                                <controls:WrapFlowPanel
                                    x:Name="ByTypeExtensionChips"
                                    HorizontalSpacing="6"
                                    VerticalSpacing="6" />

                                <TextBlock
                                    Style="{StaticResource SettingTitleTextStyle}"
                                    svc:Localized.Key="DesktopOrganization.Rule.Exclusions" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox
                                        x:Name="ByTypeExcludedExtensionInput"
                                        Grid.Column="0"
                                        KeyDown="ByTypeExcludedExtensionInput_KeyDown" />
                                    <ComboBox
                                        x:Name="ByTypeExcludedTargetComboBox"
                                        Grid.Column="1"
                                        MinWidth="148"
                                        MaxWidth="220" />
                                    <Button
                                        Grid.Column="2"
                                        Click="ByTypeAddExcludedExtensionButton_Click"
                                        Style="{StaticResource ActionButtonStyle}"
                                        svc:Localized.AutomationNameKey="DesktopOrganization.Common.Add"
                                        svc:Localized.Key="DesktopOrganization.Common.Add" />
                                </Grid>
                                <controls:WrapFlowPanel
                                    x:Name="ByTypeExcludedExtensionChips"
                                    HorizontalSpacing="6"
                                    VerticalSpacing="6" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
            </StackPanel>

            <!-- View 2: By Widget — expandable card per File Widget with compact ToggleButton pills + ToolTip -->
            <StackPanel x:Name="ByWidgetRulesPanel" Visibility="Collapsed" Spacing="4">
                <AutoSuggestBox
                    x:Name="WidgetSearchBox"
                    Visibility="Collapsed"
                    QueryIcon="Find"
                    TextChanged="WidgetSearchBox_TextChanged" />
                <StackPanel x:Name="WidgetRuleCards" Spacing="4" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
