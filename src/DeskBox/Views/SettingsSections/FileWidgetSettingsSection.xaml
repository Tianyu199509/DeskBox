<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Views.SettingsSections.FileWidgetSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeskBox.Controls"
    xmlns:svc="using:DeskBox.Services">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Style="{StaticResource SectionPanelStyle}">
        <TextBlock Style="{StaticResource SectionTitleTextStyle}" svc:Localized.Key="Settings.Appearance.DetailTitle" />
        <StackPanel Margin="0,8,0,0" Spacing="4">
            <Border Style="{StaticResource SettingsGroupStyle}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="4">
                    <Button Grid.Column="0" Click="NestedSettingsButton_Click" Style="{StaticResource DrillDownRowStyle}" Tag="DesktopOrganizationSettings">
                        <Grid ColumnDefinitions="Auto,*" Style="{StaticResource SettingCardIdentityGridStyle}">
                            <FontIcon Grid.Column="0" FontSize="18" Glyph="&#xE74C;" IsHitTestVisible="False" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" IsHitTestVisible="False" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}" svc:Localized.Key="DesktopOrganization.Settings.Title" />
                                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" svc:Localized.Key="DesktopOrganization.Settings.EntryDescription" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Click="OrganizeDesktopButton_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="13" Glyph="&#xE74C;" />
                            <TextBlock svc:Localized.Key="DesktopOrganization.Settings.StartAction" />
                        </StackPanel>
                    </Button>
                    <FontIcon Grid.Column="2" FontSize="12" Glyph="&#xE76C;" IsHitTestVisible="False" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsGroupStyle}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="4">
                    <Button Grid.Column="0" Click="NestedSettingsButton_Click" Style="{StaticResource DrillDownRowStyle}" Tag="FileDisplaySettings">
                        <Grid ColumnDefinitions="Auto,*" Style="{StaticResource SettingCardIdentityGridStyle}">
                            <FontIcon Grid.Column="0" FontSize="18" Glyph="&#xE8A5;" IsHitTestVisible="False" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" IsHitTestVisible="False" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}" svc:Localized.Key="Settings.Group.FileLayout.Title" />
                                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" svc:Localized.Key="Settings.Group.FileLayout.Description" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <FontIcon
                        Grid.Column="1"
                        FontSize="12"
                        Glyph="&#xE76C;"
                        IsHitTestVisible="False"
                        VerticalAlignment="Center"
                        />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsGroupStyle}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="4">
                    <Button Grid.Column="0" Click="NestedSettingsButton_Click" Style="{StaticResource DrillDownRowStyle}" Tag="FileStackSettings">
                        <Grid ColumnDefinitions="Auto,*" Style="{StaticResource SettingCardIdentityGridStyle}">
                            <FontIcon Grid.Column="0" FontSize="18" Glyph="&#xE81E;" IsHitTestVisible="False" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" IsHitTestVisible="False" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}" svc:Localized.Key="Settings.FileStacks.Title" />
                                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" Text="{x:Bind ViewModel.FileStackSettingsSummaryText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OnContent=""
                        OffContent=""
                        IsOn="{x:Bind ViewModel.FileStacksEnabled, Mode=TwoWay}" />
                    <FontIcon Grid.Column="2" FontSize="12" Glyph="&#xE76C;" IsHitTestVisible="False" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsGroupStyle}">
                <Grid
                    MinHeight="{StaticResource SettingsRowMinHeight}"
                    Padding="{StaticResource SettingsRowPadding}"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">
                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*" Style="{StaticResource SettingCardIdentityGridStyle}">
                        <FontIcon Grid.Column="0" FontSize="18" Glyph="&#xE838;" IsHitTestVisible="False" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" IsHitTestVisible="False" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingTitleTextStyle}" svc:Localized.Key="Settings.FileWidget.FolderOpenBehavior.Title" />
                            <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" svc:Localized.Key="Settings.FileWidget.FolderOpenBehavior.Description" />
                        </StackPanel>
                    </Grid>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="{StaticResource SettingsControlMinWidth}"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.AvailableFileWidgetFolderOpenBehaviorOptionItems, Mode=OneWay}"
                        controls:SettingsComboBox.Value="{x:Bind ViewModel.SelectedFileWidgetFolderOpenBehavior, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsGroupStyle}">
                <Grid
                    MinHeight="{StaticResource SettingsRowMinHeight}"
                    Padding="{StaticResource SettingsRowPadding}"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">
                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*" Style="{StaticResource SettingCardIdentityGridStyle}">
                        <FontIcon Grid.Column="0" FontSize="18" Glyph="&#xE712;" IsHitTestVisible="False" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" IsHitTestVisible="False" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingTitleTextStyle}" svc:Localized.Key="Settings.FileWidget.SystemContextMenu.Title" />
                            <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" svc:Localized.Key="Settings.FileWidget.SystemContextMenu.Description" />
                        </StackPanel>
                    </Grid>
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OnContent=""
                        OffContent=""
                        IsOn="{x:Bind ViewModel.FileItemSystemContextMenuEnabled, Mode=TwoWay}" />
                </Grid>
            </Border>

        </StackPanel>
    </StackPanel>
</UserControl>
