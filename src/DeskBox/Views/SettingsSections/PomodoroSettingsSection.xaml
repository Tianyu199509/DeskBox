<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Views.SettingsSections.PomodoroSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:DeskBox.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PomodoroNumberBoxStyle" TargetType="NumberBox">
                <Setter Property="Width" Value="128" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="SpinButtonPlacementMode" Value="Compact" />
                <Setter Property="ValidationMode" Value="InvalidInputOverwritten" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Style="{StaticResource SectionPanelStyle}">
        <StackPanel Margin="0,8,0,0" Spacing="4">
            <toolkit:SettingsCard
                ContentAlignment="Vertical"
                HorizontalContentAlignment="Stretch"
                svc:Localized.DescriptionKey="Settings.Pomodoro.Description"
                svc:Localized.HeaderKey="Settings.Pomodoro.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE916;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Grid Margin="0,4" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Width="52"
                        Height="52"
                        VerticalAlignment="Center">
                        <Ellipse
                            Width="52"
                            Height="52"
                            Fill="#24F47B67" />
                        <Ellipse
                            Width="43"
                            Height="43"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Fill="#F47B67"
                            Stroke="#DB5549"
                            StrokeThickness="1" />
                        <Path
                            Width="31"
                            Height="19"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Data="M50,72 C35,55 17,60 5,75 C22,91 41,84 50,72 Z M50,72 C45,47 48,21 57,7 C70,28 66,55 50,72 Z M52,72 C69,54 87,59 97,75 C78,91 61,84 52,72 Z"
                            Fill="#4D8D6C"
                            Stretch="Fill" />
                    </Grid>

                    <TextBlock
                        x:Name="ScheduleSummaryText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />
                </Grid>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Settings.Pomodoro.RoundCount.Description"
                svc:Localized.HeaderKey="Settings.Pomodoro.RoundCount.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8EE;" />
                </toolkit:SettingsCard.HeaderIcon>
                <NumberBox
                    x:Name="RoundCountNumberBox"
                    LargeChange="2"
                    SmallChange="1"
                    Style="{StaticResource PomodoroNumberBoxStyle}"
                    ValueChanged="RoundCountNumberBox_ValueChanged" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Settings.Pomodoro.FocusMinutes.Description"
                svc:Localized.HeaderKey="Settings.Pomodoro.FocusMinutes.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE823;" />
                </toolkit:SettingsCard.HeaderIcon>
                <NumberBox
                    x:Name="FocusMinutesNumberBox"
                    LargeChange="5"
                    SmallChange="1"
                    Style="{StaticResource PomodoroNumberBoxStyle}"
                    ValueChanged="FocusMinutesNumberBox_ValueChanged" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Settings.Pomodoro.ShortBreakMinutes.Description"
                svc:Localized.HeaderKey="Settings.Pomodoro.ShortBreakMinutes.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;" />
                </toolkit:SettingsCard.HeaderIcon>
                <NumberBox
                    x:Name="ShortBreakMinutesNumberBox"
                    LargeChange="5"
                    SmallChange="1"
                    Style="{StaticResource PomodoroNumberBoxStyle}"
                    ValueChanged="ShortBreakMinutesNumberBox_ValueChanged" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Settings.Pomodoro.LongBreakMinutes.Description"
                svc:Localized.HeaderKey="Settings.Pomodoro.LongBreakMinutes.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE787;" />
                </toolkit:SettingsCard.HeaderIcon>
                <NumberBox
                    x:Name="LongBreakMinutesNumberBox"
                    LargeChange="5"
                    SmallChange="1"
                    Style="{StaticResource PomodoroNumberBoxStyle}"
                    ValueChanged="LongBreakMinutesNumberBox_ValueChanged" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Settings.Pomodoro.CompletionSound.Description"
                svc:Localized.HeaderKey="Settings.Pomodoro.CompletionSound.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="CompletionSoundToggle"
                    MinWidth="0"
                    OffContent=""
                    OnContent=""
                    Toggled="CompletionSoundToggle_Toggled" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Settings.Pomodoro.CompletionNotification.Description"
                svc:Localized.HeaderKey="Settings.Pomodoro.CompletionNotification.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEA8F;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="CompletionNotificationToggle"
                    MinWidth="0"
                    OffContent=""
                    OnContent=""
                    Toggled="CompletionNotificationToggle_Toggled" />
            </toolkit:SettingsCard>
        </StackPanel>
    </StackPanel>
</UserControl>
