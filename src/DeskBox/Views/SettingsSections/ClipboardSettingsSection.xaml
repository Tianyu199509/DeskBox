<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Views.SettingsSections.ClipboardSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeskBox.Controls"
    xmlns:svc="using:DeskBox.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Style="{StaticResource SectionPanelStyle}">
        <!-- Master enable card sits outside the body panel (batch 1 gating
             fix): the whole body is grayed while the clipboard widget is
             disabled, matching the Quick Capture "off = grayed" convention. -->
        <toolkit:SettingsCard
            x:Name="EnableClipboardCard"
            Margin="0,8,0,0"
            HorizontalContentAlignment="Right"
            svc:Localized.DescriptionKey="Settings.Clipboard.Enable.Description"
            svc:Localized.HeaderKey="Settings.Clipboard.Enable.Title">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE77F;" />
            </toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch svc:Localized.AutomationNameKey="Settings.Clipboard.Enable.Title"
                x:Name="EnableClipboardToggle"
                MinWidth="0"
                OffContent=""
                OnContent=""
                Toggled="EnableClipboardToggle_Toggled" />
        </toolkit:SettingsCard>

        <StackPanel
            x:Name="ClipboardSettingsBodyPanel"
            Margin="0,4,0,0"
            Spacing="4">

            <!-- Flat Capture Types Card -->
            <toolkit:SettingsCard
                x:Name="CaptureTypesCard"
                ContentAlignment="Vertical"
                HorizontalContentAlignment="Stretch"
                svc:Localized.DescriptionKey="Clipboard.Settings.CaptureTypes.Description"
                svc:Localized.HeaderKey="Clipboard.Settings.CaptureTypes.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8C8;" />
                </toolkit:SettingsCard.HeaderIcon>
                <controls:WrapFlowPanel
                    Margin="0,4,0,0"
                    HorizontalSpacing="16"
                    VerticalSpacing="6">
                    <CheckBox
                        x:Name="CaptureTextCheckBox"
                        MinWidth="0"
                        Click="CaptureTextCheckBox_Click"
                        svc:Localized.AutomationNameKey="Clipboard.Settings.CaptureTypes.Text">
                        <TextBlock svc:Localized.Key="Clipboard.Settings.CaptureTypes.Text" />
                    </CheckBox>
                    <CheckBox
                        x:Name="CaptureImagesCheckBox"
                        MinWidth="0"
                        Click="CaptureImagesCheckBox_Click"
                        svc:Localized.AutomationNameKey="Clipboard.Settings.CaptureTypes.Images">
                        <TextBlock svc:Localized.Key="Clipboard.Settings.CaptureTypes.Images" />
                    </CheckBox>
                    <CheckBox
                        x:Name="CaptureFilesCheckBox"
                        MinWidth="0"
                        Click="CaptureFilesCheckBox_Click"
                        svc:Localized.AutomationNameKey="Clipboard.Settings.CaptureTypes.Files">
                        <TextBlock svc:Localized.Key="Clipboard.Settings.CaptureTypes.Files" />
                    </CheckBox>
                </controls:WrapFlowPanel>
            </toolkit:SettingsCard>

            <!-- Core Interaction & Card Appearance -->
            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Settings.Clipboard.ClickBehavior.Description"
                svc:Localized.HeaderKey="Settings.Clipboard.ClickBehavior.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B0;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox svc:Localized.AutomationNameKey="Settings.Clipboard.ClickBehavior.Title"
                    x:Name="ClickBehaviorComboBox"
                    MinWidth="{StaticResource SettingsControlMinWidth}"
                    SelectionChanged="ClickBehaviorComboBox_SelectionChanged">
                    <ComboBoxItem Tag="CopyOnSinglePasteOnDouble">
                        <TextBlock svc:Localized.Key="Settings.Clipboard.ClickBehavior.CopySinglePasteDouble" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="PasteOnSingle">
                        <TextBlock svc:Localized.Key="Settings.Clipboard.ClickBehavior.PasteOnSingle" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="CopyOnDouble">
                        <TextBlock svc:Localized.Key="Settings.Clipboard.ClickBehavior.CopyOnDouble" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="CopyOnSingle">
                        <TextBlock svc:Localized.Key="Settings.Clipboard.ClickBehavior.CopyOnSingle" />
                    </ComboBoxItem>
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Settings.Clipboard.DefaultPlainText.Description"
                svc:Localized.HeaderKey="Settings.Clipboard.DefaultPlainText.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8E4;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch svc:Localized.AutomationNameKey="Settings.Clipboard.DefaultPlainText.Title"
                    x:Name="DefaultPlainTextToggle"
                    MinWidth="0"
                    OffContent=""
                    OnContent=""
                    Toggled="DefaultPlainTextToggle_Toggled" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Settings.Clipboard.MoveToTop.Description"
                svc:Localized.HeaderKey="Settings.Clipboard.MoveToTop.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE74A;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch svc:Localized.AutomationNameKey="Settings.Clipboard.MoveToTop.Title"
                    x:Name="MoveToTopToggle"
                    MinWidth="0"
                    OffContent=""
                    OnContent=""
                    Toggled="MoveToTopToggle_Toggled" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Clipboard.Settings.CardStyle.Description"
                svc:Localized.HeaderKey="Clipboard.Settings.CardStyle.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A1;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox svc:Localized.AutomationNameKey="Clipboard.Settings.CardStyle.Title"
                    x:Name="CardStyleComboBox"
                    MinWidth="{StaticResource SettingsControlMinWidth}"
                    SelectionChanged="CardStyleComboBox_SelectionChanged">
                    <ComboBoxItem Tag="Minimalist">
                        <TextBlock svc:Localized.Key="Clipboard.Settings.CardStyle.Minimalist" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Compact">
                        <TextBlock svc:Localized.Key="Clipboard.Settings.CardStyle.Compact" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Standard">
                        <TextBlock svc:Localized.Key="Clipboard.Settings.CardStyle.Standard" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Spacious">
                        <TextBlock svc:Localized.Key="Clipboard.Settings.CardStyle.Spacious" />
                    </ComboBoxItem>
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Clipboard.Settings.TabDisplayMode.Description"
                svc:Localized.HeaderKey="Clipboard.Settings.TabDisplayMode.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE71D;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox svc:Localized.AutomationNameKey="Clipboard.Settings.TabDisplayMode.Title"
                    x:Name="TabDisplayModeComboBox"
                    MinWidth="{StaticResource SettingsControlMinWidth}"
                    SelectionChanged="TabDisplayModeComboBox_SelectionChanged">
                    <ComboBoxItem Tag="IconAndText">
                        <TextBlock svc:Localized.Key="Clipboard.Settings.TabDisplayMode.IconAndText" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="IconOnly">
                        <TextBlock svc:Localized.Key="Clipboard.Settings.TabDisplayMode.IconOnly" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="TextOnly">
                        <TextBlock svc:Localized.Key="Clipboard.Settings.TabDisplayMode.TextOnly" />
                    </ComboBoxItem>
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                x:Name="ShowSourceAppCard"
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Settings.Clipboard.ShowSourceApp.Description"
                svc:Localized.HeaderKey="Settings.Clipboard.ShowSourceApp.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xECAA;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch svc:Localized.AutomationNameKey="Settings.Clipboard.ShowSourceApp.Title"
                    x:Name="ShowSourceAppToggle"
                    MinWidth="0"
                    OffContent=""
                    OnContent=""
                    Toggled="ShowSourceAppToggle_Toggled" />
            </toolkit:SettingsCard>

            <!-- Expander 1: Quick-Paste Popup -->
            <toolkit:SettingsExpander
                x:Name="QuickPastePopupExpander"
                IsExpanded="False"
                svc:Localized.HeaderKey="Clipboard.Settings.Group.QuickPastePopup"
                svc:InfoTip.TitleKey="Settings.GlobalHotkey.ElevatedNotice.Title"
                svc:InfoTip.BodyKey="Settings.GlobalHotkey.ElevatedNotice.Description">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE765;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        x:Name="ClipboardHotkeyCaptureButton"
                        Click="ClipboardHotkeyCaptureButton_Click"
                        Style="{StaticResource ShortcutCaptureButtonStyle}"
                        svc:Localized.ToolTipKey="Clipboard.Settings.Hotkey.ChangeTooltip" />
                    <ToggleSwitch svc:Localized.AutomationNameKey="Clipboard.Settings.Group.QuickPastePopup"
                        x:Name="ClipboardHotkeyToggle"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="ClipboardHotkeyToggle_Toggled" />
                </StackPanel>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        x:Name="PopupPlacementCard"
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Settings.Clipboard.PopupPlacement.Description"
                        svc:Localized.HeaderKey="Settings.Clipboard.PopupPlacement.Title">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE740;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox svc:Localized.AutomationNameKey="Settings.Clipboard.PopupPlacement.Title"
                            x:Name="PopupPlacementComboBox"
                            MinWidth="{StaticResource SettingsControlMinWidth}"
                            SelectionChanged="PopupPlacementComboBox_SelectionChanged">
                            <ComboBoxItem Tag="FollowCaret">
                                <TextBlock svc:Localized.Key="Settings.Clipboard.PopupPlacement.FollowCaret" />
                            </ComboBoxItem>
                            <ComboBoxItem Tag="FollowMouse">
                                <TextBlock svc:Localized.Key="Settings.Clipboard.PopupPlacement.FollowMouse" />
                            </ComboBoxItem>
                            <ComboBoxItem Tag="ScreenCenter">
                                <TextBlock svc:Localized.Key="Settings.Clipboard.PopupPlacement.ScreenCenter" />
                            </ComboBoxItem>
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        x:Name="DoubleCopyCard"
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Settings.Clipboard.DoubleCopy.Description"
                        svc:Localized.HeaderKey="Settings.Clipboard.DoubleCopy.Title">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox svc:Localized.AutomationNameKey="Settings.Clipboard.DoubleCopy.Title"
                            x:Name="DoubleCopyComboBox"
                            MinWidth="{StaticResource SettingsControlMinWidth}"
                            SelectionChanged="DoubleCopyComboBox_SelectionChanged">
                            <ComboBoxItem Tag="None">
                                <TextBlock svc:Localized.Key="Settings.Clipboard.DoubleCopy.None" />
                            </ComboBoxItem>
                            <ComboBoxItem Tag="Pin">
                                <TextBlock svc:Localized.Key="Settings.Clipboard.DoubleCopy.Pin" />
                            </ComboBoxItem>
                            <ComboBoxItem Tag="SaveToQuickCapture">
                                <TextBlock svc:Localized.Key="Settings.Clipboard.DoubleCopy.SaveToQuickCapture" />
                            </ComboBoxItem>
                        </ComboBox>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <InfoBar
                x:Name="ClipboardHotkeyReservedWarning"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning"
                Visibility="Collapsed"
                svc:Localized.DescriptionKey="Settings.GlobalHotkey.ReservedWarning"
                svc:Localized.HeaderKey="Clipboard.Settings.Group.QuickPastePopup" />

            <!-- Expander 2: Privacy & Excluded Apps -->
            <toolkit:SettingsExpander
                x:Name="PrivacyExpander"
                IsExpanded="False"
                svc:Localized.DescriptionKey="Clipboard.Settings.Group.Privacy.Description"
                svc:Localized.HeaderKey="Clipboard.Settings.Group.Privacy">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE72E;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Settings.Clipboard.IgnorePrivacyFormats.Description"
                        svc:Localized.HeaderKey="Settings.Clipboard.IgnorePrivacyFormats.Title">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE72E;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ToggleSwitch svc:Localized.AutomationNameKey="Settings.Clipboard.IgnorePrivacyFormats.Title"
                            x:Name="IgnorePrivacyFormatsToggle"
                            MinWidth="0"
                            OffContent=""
                            OnContent=""
                            Toggled="IgnorePrivacyFormatsToggle_Toggled" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Settings.Clipboard.SecretProtection.Description"
                        svc:Localized.HeaderKey="Settings.Clipboard.SecretProtection.Title">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEA18;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox svc:Localized.AutomationNameKey="Settings.Clipboard.SecretProtection.Title"
                            x:Name="SecretProtectionComboBox"
                            MinWidth="{StaticResource SettingsControlMinWidth}"
                            SelectionChanged="SecretProtectionComboBox_SelectionChanged">
                            <ComboBoxItem Tag="Mask">
                                <TextBlock svc:Localized.Key="Settings.Clipboard.SecretProtection.Mask" />
                            </ComboBoxItem>
                            <ComboBoxItem Tag="Skip">
                                <TextBlock svc:Localized.Key="Settings.Clipboard.SecretProtection.Skip" />
                            </ComboBoxItem>
                            <ComboBoxItem Tag="None">
                                <TextBlock svc:Localized.Key="Settings.Clipboard.SecretProtection.None" />
                            </ComboBoxItem>
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        ContentAlignment="Vertical"
                        HorizontalContentAlignment="Stretch"
                        svc:Localized.DescriptionKey="Settings.Clipboard.ExcludedApps.Description"
                        svc:Localized.HeaderKey="Settings.Clipboard.ExcludedApps.Title">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8F8;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <StackPanel Margin="0,4,0,2" Spacing="8">
                            <Button
                                x:Name="BrowseExcludedAppButton"
                                HorizontalAlignment="Left"
                                Click="BrowseExcludedAppButton_Click"
                                Style="{StaticResource ActionButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    <TextBlock svc:Localized.Key="Settings.Clipboard.ExcludedApps.Browse" />
                                </StackPanel>
                            </Button>
                            <TextBlock
                                x:Name="ExcludedAppsEmptyText"
                                Style="{StaticResource SettingDescriptionTextStyle}"
                                svc:Localized.Key="Settings.Clipboard.ExcludedApps.Empty" />
                            <StackPanel x:Name="ExcludedAppsListPanel" Spacing="4" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        ContentAlignment="Vertical"
                        HorizontalContentAlignment="Stretch"
                        svc:Localized.DescriptionKey="Settings.Clipboard.ExcludedApps.ObservedDescription"
                        svc:Localized.HeaderKey="Settings.Clipboard.ExcludedApps.ObservedTitle">
                        <StackPanel Margin="0,4,0,2" Spacing="6">
                            <TextBlock
                                x:Name="ObservedAppsEmptyText"
                                Style="{StaticResource SettingDescriptionTextStyle}"
                                svc:Localized.Key="Settings.Clipboard.ExcludedApps.ObservedEmpty" />
                            <StackPanel x:Name="ObservedAppsListPanel" Spacing="4" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <!-- Expander 3: Storage Quota & Cleanup -->
            <toolkit:SettingsExpander
                x:Name="StorageExpander"
                IsExpanded="False"
                svc:Localized.DescriptionKey="Clipboard.Settings.Group.Storage.Description"
                svc:Localized.HeaderKey="Clipboard.Settings.Group.Storage">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xEDA2;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Settings.Clipboard.MaxItems.Description"
                        svc:Localized.HeaderKey="Settings.Clipboard.MaxItems.Title">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8FD;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox svc:Localized.AutomationNameKey="Settings.Clipboard.MaxItems.Title"
                            x:Name="MaxItemsComboBox"
                            MinWidth="{StaticResource SettingsControlMinWidth}"
                            SelectionChanged="MaxItemsComboBox_SelectionChanged">
                            <ComboBoxItem Tag="100" Content="100" />
                            <ComboBoxItem Tag="200" Content="200" />
                            <ComboBoxItem Tag="500" Content="500" />
                            <ComboBoxItem Tag="1000" Content="1000" />
                            <ComboBoxItem Tag="2000" Content="2000" />
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Settings.Clipboard.RetentionDays.Description"
                        svc:Localized.HeaderKey="Settings.Clipboard.RetentionDays.Title">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE823;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox svc:Localized.AutomationNameKey="Settings.Clipboard.RetentionDays.Title"
                            x:Name="RetentionDaysComboBox"
                            MinWidth="{StaticResource SettingsControlMinWidth}"
                            SelectionChanged="RetentionDaysComboBox_SelectionChanged">
                            <ComboBoxItem Tag="1">
                                <TextBlock svc:Localized.Key="Settings.Clipboard.RetentionDays.Days1" />
                            </ComboBoxItem>
                            <ComboBoxItem Tag="7">
                                <TextBlock svc:Localized.Key="Settings.Clipboard.RetentionDays.Days7" />
                            </ComboBoxItem>
                            <ComboBoxItem Tag="30">
                                <TextBlock svc:Localized.Key="Settings.Clipboard.RetentionDays.Days30" />
                            </ComboBoxItem>
                            <ComboBoxItem Tag="90">
                                <TextBlock svc:Localized.Key="Settings.Clipboard.RetentionDays.Days90" />
                            </ComboBoxItem>
                            <ComboBoxItem Tag="0">
                                <TextBlock svc:Localized.Key="Settings.Clipboard.RetentionDays.Forever" />
                            </ComboBoxItem>
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        x:Name="MaxImageSizeCard"
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Settings.Clipboard.MaxImageSize.Description"
                        svc:Localized.HeaderKey="Settings.Clipboard.MaxImageSize.Title">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEB9F;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox svc:Localized.AutomationNameKey="Settings.Clipboard.MaxImageSize.Title"
                            x:Name="MaxImageSizeComboBox"
                            MinWidth="{StaticResource SettingsControlMinWidth}"
                            SelectionChanged="MaxImageSizeComboBox_SelectionChanged">
                            <ComboBoxItem Tag="8" Content="8 MB" />
                            <ComboBoxItem Tag="16" Content="16 MB" />
                            <ComboBoxItem Tag="32" Content="32 MB" />
                            <ComboBoxItem Tag="64" Content="64 MB" />
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        x:Name="StorageSummaryCard"
                        HorizontalContentAlignment="Right"
                        svc:Localized.HeaderKey="Settings.Clipboard.StorageSummary.Title">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEDA2;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <Button
                            x:Name="ClearUnpinnedButton"
                            Style="{StaticResource DangerActionButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock svc:Localized.Key="Clipboard.Action.ClearUnpinned" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="ClearUnpinnedConfirmFlyout" Placement="BottomEdgeAlignedRight">
                                    <StackPanel MaxWidth="260" Spacing="10">
                                        <TextBlock
                                            TextWrapping="Wrap"
                                            svc:Localized.Key="Settings.Clipboard.ClearUnpinned.ConfirmPrompt" />
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="CancelClearUnpinnedButton"
                                                Click="CancelClearUnpinnedButton_Click"
                                                Style="{StaticResource ActionButtonStyle}">
                                                <TextBlock svc:Localized.Key="Common.Cancel" />
                                            </Button>
                                            <Button
                                                x:Name="ConfirmClearUnpinnedButton"
                                                Click="ConfirmClearUnpinnedButton_Click"
                                                Style="{StaticResource DangerActionButtonStyle}">
                                                <TextBlock svc:Localized.Key="Clipboard.Action.ClearUnpinned" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        x:Name="ResetClipboardCard"
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Clipboard.Settings.Reset.Description"
                        svc:Localized.HeaderKey="Clipboard.Settings.Reset.Title">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE777;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <Button
                            x:Name="ResetClipboardButton"
                            Click="ResetClipboardButton_Click"
                            Style="{StaticResource DangerActionButtonStyle}"
                            svc:Localized.ToolTipKey="Settings.FeatureWidgets.ResetTooltip">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE777;" FontSize="14" />
                                <TextBlock svc:Localized.Key="Settings.FeatureWidgets.ResetConfirm" />
                            </StackPanel>
                        </Button>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

        </StackPanel>
    </StackPanel>
</UserControl>
