<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Views.SettingsSections.DisplaySettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:DeskBox.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Style="{StaticResource SectionPanelStyle}">
        <InfoBar
            x:Name="DisplaysStatusInfo"
            IsClosable="True"
            IsOpen="False" />

        <Border
            x:Name="PreviewArea"
            Style="{StaticResource SettingsGroupStyle}"
            CornerRadius="6">
            <StackPanel>
                <Border Padding="20,18,20,18">
                    <Viewbox
                        x:Name="PreviewViewbox"
                        MaxHeight="260"
                        HorizontalAlignment="Stretch"
                        Stretch="Uniform">
                        <Canvas x:Name="DisplayPreviewCanvas" />
                    </Viewbox>
                </Border>

                <Border
                    x:Name="WorkspaceFooterDivider"
                    Height="1" />

                <Grid
                    x:Name="ScreenDetailBar"
                    MinHeight="56"
                    Padding="16,10"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="SelectPromptText"
                            Style="{StaticResource SettingDescriptionTextStyle}"
                            Visibility="Collapsed"
                            svc:Localized.Key="Settings.Displays.SelectPrompt" />

                        <Grid
                            x:Name="SelectedScreenInfoPanel"
                            ColumnSpacing="14"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                x:Name="SelectedScreenIcon"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Glyph="&#xE7F4;" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    x:Name="SelectedScreenTitleText"
                                    Style="{StaticResource SettingTitleTextStyle}" />
                                <TextBlock
                                    x:Name="SelectedScreenDescriptionText"
                                    Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="MoveAllWidgetsButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="MoveAllWidgetsButton_Click"
                            Visibility="Collapsed"
                            svc:Localized.AutomationNameKey="Settings.Displays.MoveAll"
                            svc:Localized.Key="Settings.Displays.MoveAll" />
                        <Button
                            x:Name="IdentifyMonitorsButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="IdentifyButton_Click"
                            svc:Localized.AutomationNameKey="Settings.Displays.Identify"
                            svc:Localized.Key="Settings.Displays.Identify" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <toolkit:SettingsCard
            x:Name="NewWidgetsCard"
            HorizontalContentAlignment="Right"
            svc:Localized.DescriptionKey="Settings.Displays.NewWidgets.Description"
            svc:Localized.HeaderKey="Settings.Displays.NewWidgets.Header">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE740;" />
            </toolkit:SettingsCard.HeaderIcon>
            <ComboBox
                x:Name="NewPlacementCombo"
                MinWidth="{StaticResource SettingsControlMinWidth}"
                SelectionChanged="NewPlacementCombo_SelectionChanged"
                svc:Localized.AutomationNameKey="Settings.Displays.NewWidgets.Header" />
        </toolkit:SettingsCard>

        <toolkit:SettingsExpander
            x:Name="PolicyExpander"
            HorizontalContentAlignment="Stretch"
            IsExpanded="False"
            svc:Localized.DescriptionKey="Settings.Displays.PolicyExpander.Description"
            svc:Localized.HeaderKey="Settings.Displays.PolicyExpander.Title"
            svc:InfoTip.TitleKey="Settings.Displays.BindingInfoTip.Title"
            svc:InfoTip.BodyKey="Settings.Displays.BindingInfoTip.Description">
            <toolkit:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE80A;" />
            </toolkit:SettingsExpander.HeaderIcon>
            <toolkit:SettingsExpander.Items>
                <toolkit:SettingsCard
                    HorizontalContentAlignment="Right"
                    svc:Localized.DescriptionKey="Settings.Displays.ScalingMode.Description"
                    svc:Localized.HeaderKey="Settings.Displays.ScalingMode.Header">
                    <ComboBox
                        x:Name="ScalingModeCombo"
                        MinWidth="{StaticResource SettingsControlMinWidth}"
                        SelectionChanged="ScalingModeCombo_SelectionChanged"
                        svc:Localized.AutomationNameKey="Settings.Displays.ScalingMode.Header" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                    HorizontalContentAlignment="Right"
                    svc:Localized.DescriptionKey="Settings.Displays.Disconnect.Description"
                    svc:Localized.HeaderKey="Settings.Displays.Disconnect.Header">
                    <ComboBox
                        x:Name="DisconnectBehaviorCombo"
                        MinWidth="{StaticResource SettingsControlMinWidth}"
                        SelectionChanged="DisconnectBehaviorCombo_SelectionChanged"
                        svc:Localized.AutomationNameKey="Settings.Displays.Disconnect.Header" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                    HorizontalContentAlignment="Right"
                    svc:Localized.DescriptionKey="Settings.Displays.Recalibrate.Description"
                    svc:Localized.HeaderKey="Settings.Displays.Recalibrate">
                    <Button
                        x:Name="RecalibrateLayoutButton"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="RecalibrateLayoutButton_Click"
                        svc:Localized.AutomationNameKey="Settings.Displays.Recalibrate"
                        svc:Localized.Key="Settings.Displays.Recalibrate" />
                </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>

        <StackPanel x:Name="WidgetListPanel" Spacing="6">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SettingsSubsectionTitleTextStyle}"
                    svc:Localized.Key="Settings.Displays.Widgets.SectionTitle" />
                <ComboBox
                    x:Name="WidgetFilterCombo"
                    Grid.Column="1"
                    MinWidth="{StaticResource SettingsControlMinWidth}"
                    SelectionChanged="WidgetFilterCombo_SelectionChanged"
                    svc:Localized.AutomationNameKey="Settings.Displays.Widgets.SectionTitle" />
            </Grid>
            <StackPanel x:Name="WidgetBindingCards" Spacing="4" />
        </StackPanel>
    </StackPanel>
</UserControl>
