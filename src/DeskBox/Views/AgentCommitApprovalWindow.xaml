<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskBox.Views.AgentCommitApprovalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DeskBox">

    <Grid
        x:Name="RootGrid"
        Padding="24,22,24,18"
        RowSpacing="16"
        MinWidth="440"
        MaxWidth="540"
        KeyDown="RootGrid_KeyDown">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: Fluent Shield Badge + Title + Subtitle -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="ShieldBadgeBorder"
                Grid.Column="0"
                Width="38"
                Height="38"
                CornerRadius="8"
                VerticalAlignment="Top"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <FontIcon
                    x:Name="HeaderGlyphIcon"
                    Glyph="&#xEA18;"
                    FontSize="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="SubtitleText"
                    FontSize="13"
                    LineHeight="19"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Body: Structured Target & Impact Card + Trust Hint -->
        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            VerticalAlignment="Top">
            <StackPanel x:Name="BodyContentStack" Spacing="12">
                <Border
                    Padding="14,12"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="WidgetNameText"
                                Grid.Column="0"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <Border
                                x:Name="WidgetIdBadge"
                                Grid.Column="1"
                                Padding="7,2"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                FlowDirection="LeftToRight"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock
                                    x:Name="WidgetIdText"
                                    FontSize="11.5"
                                    FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>

                        <Border
                            Height="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Scope Row (Create vs Overwrite) -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                x:Name="ScopeGlyphIcon"
                                Grid.Column="0"
                                Glyph="&#xE895;"
                                FontSize="13"
                                Margin="0,3,0,0"
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                x:Name="ScopeReasonText"
                                Grid.Column="1"
                                FontSize="13"
                                LineHeight="19"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <!-- Privileged Capabilities Row -->
                        <Grid
                            x:Name="PrivilegedRow"
                            ColumnSpacing="10"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Grid.Column="0"
                                Glyph="&#xEA18;"
                                FontSize="13"
                                Margin="0,3,0,0"
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock
                                x:Name="PrivilegedReasonText"
                                Grid.Column="1"
                                FontSize="13"
                                LineHeight="19"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <!-- Data Loss Caution Strip -->
                        <Border
                            x:Name="DataLossBanner"
                            Padding="10,8"
                            CornerRadius="6"
                            Visibility="Collapsed"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE7BA;"
                                    FontSize="13"
                                    Margin="0,3,0,0"
                                    VerticalAlignment="Top"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock
                                    x:Name="DataLossReasonText"
                                    Grid.Column="1"
                                    FontSize="12.5"
                                    LineHeight="18"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock
                    x:Name="TrustHintText"
                    FontSize="12.5"
                    LineHeight="18"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: Countdown + Safe-Focused Action Buttons -->
        <Grid x:Name="FooterGrid" Grid.Row="2" ColumnSpacing="12" Padding="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="TimeoutNoteText"
                Grid.Column="0"
                FontSize="12"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button
                    x:Name="AllowButton"
                    TabIndex="1"
                    Click="AllowButton_Click"
                    MinWidth="104"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button
                    x:Name="DenyButton"
                    TabIndex="0"
                    Click="DenyButton_Click"
                    MinWidth="104" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
