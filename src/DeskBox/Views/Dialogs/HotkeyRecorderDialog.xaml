<ContentDialog
    x:Class="DeskBox.Views.Dialogs.HotkeyRecorderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeskBox.Controls"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
    CloseButtonStyle="{StaticResource DefaultButtonStyle}"
    Opened="OnOpened"
    Closing="OnClosing"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">440</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">548</x:Double>
        <Style x:Key="PresetButtonStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        </Style>
        <Style x:Key="DoubleTapToggleStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style x:Key="RecorderActionLinkStyle" TargetType="HyperlinkButton">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel
        MaxWidth="520"
        HorizontalAlignment="Stretch"
        Spacing="12">
        <TextBlock
            x:Name="RuleHintTextBlock"
            Style="{StaticResource BodyTextBlockStyle}"
            FontSize="13"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <!-- PowerToys-style Hero Well -->
        <Grid
            MinHeight="104"
            Margin="0,4,0,0"
            Padding="20,18"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
            CornerRadius="8">
            <StackPanel
                x:Name="KeysPanel"
                MinHeight="52"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8" />
        </Grid>

        <!-- Centered Reset / Clear / Double-Tap Action Bar -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <HyperlinkButton
                x:Name="ResetButton"
                Click="ResetButton_Click"
                Style="{StaticResource RecorderActionLinkStyle}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="11"
                        Glyph="&#xE777;" />
                    <TextBlock
                        x:Name="ResetButtonLabel"
                        Margin="0,-1,0,0"
                        VerticalAlignment="Center"
                        FontSize="12" />
                </StackPanel>
            </HyperlinkButton>

            <HyperlinkButton
                x:Name="ClearButton"
                Click="ClearButton_Click"
                Style="{StaticResource RecorderActionLinkStyle}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="11"
                        Glyph="&#xE894;" />
                    <TextBlock
                        x:Name="ClearButtonLabel"
                        Margin="0,-1,0,0"
                        VerticalAlignment="Center"
                        FontSize="12" />
                </StackPanel>
            </HyperlinkButton>

            <Border
                Width="1"
                Height="14"
                Margin="4,0"
                VerticalAlignment="Center"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <ToggleButton
                x:Name="DoubleTapToggle"
                Click="DoubleTapToggle_Click"
                Style="{StaticResource DoubleTapToggleStyle}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.85"
                        Text="×2" />
                    <TextBlock
                        x:Name="DoubleTapToggleLabel"
                        Margin="0,-1,0,0"
                        VerticalAlignment="Center"
                        FontSize="12" />
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <!-- Condensed Feedback Banners -->
        <StackPanel Spacing="6">
            <InfoBar
                x:Name="CaptureStatusInfoBar"
                BorderThickness="0"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />
            <InfoBar
                x:Name="WarningInfoBar"
                BorderThickness="0"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />
            <InfoBar
                x:Name="ErrorInfoBar"
                BorderThickness="0"
                IsClosable="False"
                IsOpen="False"
                Severity="Error" />
        </StackPanel>

        <!-- Retained DeskBox Recommended Presets -->
        <StackPanel
            x:Name="PresetsSection"
            Margin="0,2,0,0"
            Spacing="8">
            <TextBlock
                x:Name="PresetsLabel"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <controls:WrapFlowPanel
                x:Name="PresetsPanel"
                HorizontalSpacing="8"
                VerticalSpacing="8" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
