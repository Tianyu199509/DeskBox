<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <!-- Keep the compile-time SDK modern while declaring the supported Win10 floor explicitly. -->
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>DeskBox</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackage>false</AppxPackage>
    <DeskBoxDistribution Condition="'$(DeskBoxDistribution)' == ''">Direct</DeskBoxDistribution>
    <!-- Native AOT smoke scenarios are a test harness, never a retail default. -->
    <DeskBoxAotSmokeHarness Condition="'$(DeskBoxAotSmokeHarness)' == ''">false</DeskBoxAotSmokeHarness>
    <DeskBoxPgoInstrumentation Condition="'$(DeskBoxPgoInstrumentation)' == ''">false</DeskBoxPgoInstrumentation>
    <!-- Build/package deskbox_native.dll by default across Debug, Release,
         and NativeAOT builds. -->
    <DeskBoxRustNative Condition="'$(DeskBoxRustNative)' == ''">true</DeskBoxRustNative>
    <!-- Stage 7C0 keeps CRT linkage explicit so A/B outputs cannot be reused
         across incompatible native dependency policies. -->
    <DeskBoxRustCrtLinkage Condition="'$(DeskBoxRustCrtLinkage)' == ''">Static</DeskBoxRustCrtLinkage>
    <DeskBoxShellThumbnailProxy Condition="'$(DeskBoxShellThumbnailProxy)' == ''">true</DeskBoxShellThumbnailProxy>
    <DeskBoxQjsNative Condition="'$(DeskBoxQjsNative)' == ''">true</DeskBoxQjsNative>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <DefineConstants Condition="'$(DeskBoxDistribution)' == 'Store'">$(DefineConstants);DESKBOX_STORE</DefineConstants>
    <DefineConstants Condition="'$(DeskBoxPgoInstrumentation)' == 'true'">$(DefineConstants);DESKBOX_PGO_INSTRUMENTATION</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <ApplicationIcon>Assets\deskbox.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\.mimosa\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DeskBoxAotAudit)' == 'true'">
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!--
    Native AOT must not compile the legacy shortcut, music-volume, dynamic
    Explorer-shell, or Quick Access oracles. Keep this driven by PublishAot so direct AOT
    publishes and the audit profile agree.
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <DefineConstants>$(DefineConstants);DESKBOX_NATIVE_AOT</DefineConstants>
    <UseSystemResourceKeys Condition="'$(DeskBoxAotSmokeHarness)' != 'true'">true</UseSystemResourceKeys>
    <StackTraceSupport>true</StackTraceSupport>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true' and Exists('$(MSBuildProjectDirectory)\Profiles')">
    <MibcFile Include="$(MSBuildProjectDirectory)\Profiles\*.mibc" />
  </ItemGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true' and '$(DeskBoxAotSmokeHarness)' == 'true'">
    <DefineConstants>$(DefineConstants);DESKBOX_AOT_SMOKE_HARNESS</DefineConstants>
  </PropertyGroup>

  <!--
    Include the Native AOT smoke matrix only when explicitly requested via
    DeskBoxAotSmokeHarness=true. Production source trees stay completely clean
    of smoke fixtures in ordinary and retail builds.
  -->
  <ItemGroup Condition="'$(DeskBoxAotSmokeHarness)' == 'true'">
    <Compile Include="..\..\tests\DeskBox.AotSmoke\**\*.cs" LinkBase="AotSmoke" />
  </ItemGroup>

  <Target
    Name="ExcludeUnusedWinUIExReferencesFromDeskBox"
    AfterTargets="ResolvePackageAssets"
    BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference
        Remove="@(Reference)"
        Condition="'%(Reference.Filename)' == 'WinUIEx'" />
      <ResolvedCompileFileDefinitions
        Remove="@(ResolvedCompileFileDefinitions)"
        Condition="'%(ResolvedCompileFileDefinitions.Filename)' == 'WinUIEx'" />
      <ReferenceCopyLocalPaths
        Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'WinUIEx'" />
      <RuntimeCopyLocalItems
        Remove="@(RuntimeCopyLocalItems)"
        Condition="'%(RuntimeCopyLocalItems.Filename)' == 'WinUIEx'" />
      <ReferenceRelatedPaths
        Remove="@(ReferenceRelatedPaths)"
        Condition="'%(ReferenceRelatedPaths.Filename)' == 'WinUIEx'" />
    </ItemGroup>
  </Target>

  <Target
    Name="ExcludeUnusedWinUIExReferencePathsFromDeskBox"
    AfterTargets="ResolveAssemblyReferences"
    BeforeTargets="MarkupCompilePass1;CoreCompile;GenerateBuildDependencyFile;_GenerateProjectPriConfigurationFiles;GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <ReferencePath
        Remove="@(ReferencePath)"
        Condition="'%(ReferencePath.Filename)' == 'WinUIEx'" />
      <ReferenceDependencyPaths
        Remove="@(ReferenceDependencyPaths)"
        Condition="'%(ReferenceDependencyPaths.Filename)' == 'WinUIEx'" />
      <ReferenceCopyLocalPaths
        Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'WinUIEx'" />
      <ReferenceRelatedPaths
        Remove="@(ReferenceRelatedPaths)"
        Condition="'%(ReferenceRelatedPaths.Filename)' == 'WinUIEx'" />
    </ItemGroup>
  </Target>

  <Target
    Name="ExcludeUnusedWinUIExPriFromDeskBox"
    AfterTargets="_ComputeInputPriFiles"
    BeforeTargets="_GenerateProjectPriConfigurationFiles">
    <ItemGroup>
      <_PriFile
        Remove="@(_PriFile)"
        Condition="'%(_PriFile.Filename)' == 'WinUIEx'" />
    </ItemGroup>
  </Target>

  <!--
    Native AOT compiles out the legacy shortcut, music-volume, Explorer-shell,
    and Quick Access COM oracles and uses Rust for exact Recycle Bin recovery, so every supported AOT build must package a matching Rust backend.
    Reject incomplete and not-yet-supported architecture combinations before compilation.
  -->
  <Target
    Name="ValidateDeskBoxNativeAotConfiguration"
    BeforeTargets="PrepareForBuild;Publish"
    Condition="'$(DesignTimeBuild)' != 'true' and '$(PublishAot)' == 'true'">
    <Error
      Condition="('$(Platform)' != 'x64' or '$(RuntimeIdentifier)' != 'win-x64') and ('$(Platform)' != 'ARM64' or '$(RuntimeIdentifier)' != 'win-arm64')"
      Text="DeskBox Native AOT stage 7A requires a matching Platform/RuntimeIdentifier pair: x64/win-x64 or ARM64/win-arm64." />
    <Error
      Condition="'$(DeskBoxRustNative)' != 'true'"
      Text="DeskBox Native AOT requires DeskBoxRustNative=true so the Rust-only shortcut, music-volume, Explorer-shell, Quick Access, and Recycle Bin recovery paths cannot be published without deskbox_native.dll." />
    <Error
      Condition="'$(DeskBoxQjsNative)' != 'true'"
      Text="DeskBox Native AOT requires DeskBoxQjsNative=true so Custom Widget QuickJS script sandboxing cannot be published without deskbox_qjs.dll." />
    <Error
      Condition="'$(DeskBoxAotSmokeHarness)' == 'true' and '$(DeskBoxAotAudit)' != 'true'"
      Text="DeskBoxAotSmokeHarness=true is reserved for explicit DeskBoxAotAudit builds and must not be enabled for retail publishing." />
  </Target>

  <PropertyGroup Condition="'$(DeskBoxRustNative)' == 'true'">
    <DeskBoxRustNativePlatform Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</DeskBoxRustNativePlatform>
    <DeskBoxRustNativePlatform Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</DeskBoxRustNativePlatform>
    <DeskBoxRustNativePlatform Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">ARM64</DeskBoxRustNativePlatform>
    <DeskBoxRustNativePlatform Condition="'$(RuntimeIdentifier)' == '' and ('$(Platform)' == 'x64' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == '')">x64</DeskBoxRustNativePlatform>
    <DeskBoxRustNativeBuildPlatform Condition="'$(Platform)' != ''">$(Platform)</DeskBoxRustNativeBuildPlatform>
    <DeskBoxRustNativeBuildPlatform Condition="'$(Platform)' == ''">AnyCPU</DeskBoxRustNativeBuildPlatform>
    <DeskBoxRustNativeRuntimeSegment Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</DeskBoxRustNativeRuntimeSegment>
    <DeskBoxRustNativeRuntimeSegment Condition="'$(RuntimeIdentifier)' == ''">no-rid</DeskBoxRustNativeRuntimeSegment>
    <DeskBoxRustNativeIntermediateDir Condition="'$(DeskBoxRustNativeIntermediateDir)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'rust-native', '$(Configuration)', '$(DeskBoxRustNativeBuildPlatform)', '$(DeskBoxRustNativeRuntimeSegment)', '$(DeskBoxRustCrtLinkage)'))</DeskBoxRustNativeIntermediateDir>
    <DeskBoxRustNativeCargoTargetDir Condition="'$(DeskBoxRustNativeCargoTargetDir)' == ''">$(DeskBoxRustNativeIntermediateDir)\cargo-target</DeskBoxRustNativeCargoTargetDir>
    <DeskBoxRustNativeDll>$(DeskBoxRustNativeIntermediateDir)\deskbox_native.dll</DeskBoxRustNativeDll>
    <DeskBoxRustNativePdb>$(DeskBoxRustNativeIntermediateDir)\deskbox_native.pdb</DeskBoxRustNativePdb>
  </PropertyGroup>

  <ItemGroup Condition="'$(DeskBoxRustNative)' == 'true'">
    <DeskBoxRustNativeInput Include="$(MSBuildProjectDirectory)\..\..\rust-toolchain.toml" />
    <DeskBoxRustNativeInput Include="$(MSBuildProjectDirectory)\..\..\native\Cargo.toml" />
    <DeskBoxRustNativeInput Include="$(MSBuildProjectDirectory)\..\..\native\Cargo.lock" />
    <DeskBoxRustNativeInput Include="$(MSBuildProjectDirectory)\..\..\native\README.md" />
    <DeskBoxRustNativeInput Include="$(MSBuildProjectDirectory)\..\..\native\deskbox-native\Cargo.toml" />
    <DeskBoxRustNativeInput Include="$(MSBuildProjectDirectory)\..\..\native\deskbox-native\src\**\*" />
    <DeskBoxRustNativeInput Include="$(MSBuildProjectDirectory)\..\..\native\include\deskbox_native.h" />
    <DeskBoxRustNativeInput Include="$(MSBuildProjectDirectory)\..\..\scripts\build-rust-native.ps1" />
    <DeskBoxRustNativeInput Include="$(MSBuildProjectDirectory)\..\..\scripts\native-pe-contract.ps1" />
    <DeskBoxRustNativeInput Include="$(MSBuildProjectDirectory)\..\..\scripts\rust-arm64-msvc-environment.ps1" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DeskBoxShellThumbnailProxy)' == 'true'">
    <DeskBoxThumbnailProxyPlatform Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</DeskBoxThumbnailProxyPlatform>
    <DeskBoxThumbnailProxyPlatform Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</DeskBoxThumbnailProxyPlatform>
    <DeskBoxThumbnailProxyPlatform Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">ARM64</DeskBoxThumbnailProxyPlatform>
    <DeskBoxThumbnailProxyPlatform Condition="'$(RuntimeIdentifier)' == '' and ('$(Platform)' == 'x64' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == '')">x64</DeskBoxThumbnailProxyPlatform>
    <DeskBoxThumbnailProxyBuildPlatform Condition="'$(Platform)' != ''">$(Platform)</DeskBoxThumbnailProxyBuildPlatform>
    <DeskBoxThumbnailProxyBuildPlatform Condition="'$(Platform)' == ''">AnyCPU</DeskBoxThumbnailProxyBuildPlatform>
    <DeskBoxThumbnailProxyRuntimeSegment Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</DeskBoxThumbnailProxyRuntimeSegment>
    <DeskBoxThumbnailProxyRuntimeSegment Condition="'$(RuntimeIdentifier)' == ''">no-rid</DeskBoxThumbnailProxyRuntimeSegment>
    <DeskBoxThumbnailProxyIntermediateDir Condition="'$(DeskBoxThumbnailProxyIntermediateDir)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'rust-thumbnail-proxy', '$(Configuration)', '$(DeskBoxThumbnailProxyBuildPlatform)', '$(DeskBoxThumbnailProxyRuntimeSegment)', '$(DeskBoxRustCrtLinkage)'))</DeskBoxThumbnailProxyIntermediateDir>
    <DeskBoxThumbnailProxyCargoTargetDir Condition="'$(DeskBoxThumbnailProxyCargoTargetDir)' == ''">$(DeskBoxThumbnailProxyIntermediateDir)\cargo-target</DeskBoxThumbnailProxyCargoTargetDir>
    <DeskBoxThumbnailProxyExe>$(DeskBoxThumbnailProxyIntermediateDir)\DeskBox.ThumbnailProxy.exe</DeskBoxThumbnailProxyExe>
    <DeskBoxThumbnailProxyPdb>$(DeskBoxThumbnailProxyIntermediateDir)\DeskBox.ThumbnailProxy.pdb</DeskBoxThumbnailProxyPdb>
  </PropertyGroup>

  <ItemGroup Condition="'$(DeskBoxShellThumbnailProxy)' == 'true'">
    <DeskBoxThumbnailProxyInput Include="$(MSBuildProjectDirectory)\..\..\rust-toolchain.toml" />
    <DeskBoxThumbnailProxyInput Include="$(MSBuildProjectDirectory)\..\..\native\Cargo.toml" />
    <DeskBoxThumbnailProxyInput Include="$(MSBuildProjectDirectory)\..\..\native\Cargo.lock" />
    <DeskBoxThumbnailProxyInput Include="$(MSBuildProjectDirectory)\..\..\native\deskbox-thumbnail-proxy\Cargo.toml" />
    <DeskBoxThumbnailProxyInput Include="$(MSBuildProjectDirectory)\..\..\native\deskbox-thumbnail-proxy\build.rs" />
    <DeskBoxThumbnailProxyInput Include="$(MSBuildProjectDirectory)\..\..\native\deskbox-thumbnail-proxy\DeskBox.ThumbnailProxy.manifest" />
    <DeskBoxThumbnailProxyInput Include="$(MSBuildProjectDirectory)\..\..\native\deskbox-thumbnail-proxy\src\**\*" />
    <DeskBoxThumbnailProxyInput Include="$(MSBuildProjectDirectory)\..\..\scripts\build-rust-thumbnail-proxy.ps1" />
    <DeskBoxThumbnailProxyInput Include="$(MSBuildProjectDirectory)\..\..\scripts\rust-arm64-msvc-environment.ps1" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DeskBoxQjsNative)' == 'true'">
    <DeskBoxQjsPlatform Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</DeskBoxQjsPlatform>
    <DeskBoxQjsPlatform Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</DeskBoxQjsPlatform>
    <DeskBoxQjsPlatform Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">ARM64</DeskBoxQjsPlatform>
    <DeskBoxQjsPlatform Condition="'$(RuntimeIdentifier)' == '' and ('$(Platform)' == 'x64' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == '')">x64</DeskBoxQjsPlatform>
    <DeskBoxQjsBuildPlatform Condition="'$(Platform)' != ''">$(Platform)</DeskBoxQjsBuildPlatform>
    <DeskBoxQjsBuildPlatform Condition="'$(Platform)' == ''">AnyCPU</DeskBoxQjsBuildPlatform>
    <DeskBoxQjsRuntimeSegment Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</DeskBoxQjsRuntimeSegment>
    <DeskBoxQjsRuntimeSegment Condition="'$(RuntimeIdentifier)' == ''">no-rid</DeskBoxQjsRuntimeSegment>
    <DeskBoxQjsIntermediateDir Condition="'$(DeskBoxQjsIntermediateDir)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'qjs-native', '$(Configuration)', '$(DeskBoxQjsBuildPlatform)', '$(DeskBoxQjsRuntimeSegment)', '$(DeskBoxRustCrtLinkage)'))</DeskBoxQjsIntermediateDir>
    <DeskBoxQjsObjDir Condition="'$(DeskBoxQjsObjDir)' == ''">$(DeskBoxQjsIntermediateDir)\c-obj</DeskBoxQjsObjDir>
    <DeskBoxQjsDll>$(DeskBoxQjsIntermediateDir)\deskbox_qjs.dll</DeskBoxQjsDll>
    <DeskBoxQjsPdb>$(DeskBoxQjsIntermediateDir)\deskbox_qjs.pdb</DeskBoxQjsPdb>
  </PropertyGroup>

  <ItemGroup Condition="'$(DeskBoxQjsNative)' == 'true'">
    <DeskBoxQjsInput Include="$(MSBuildProjectDirectory)\..\..\native\include\deskbox_qjs.h" />
    <DeskBoxQjsInput Include="$(MSBuildProjectDirectory)\..\..\native\deskbox-qjs\deskbox_qjs_bridge.c" />
    <DeskBoxQjsInput Include="$(MSBuildProjectDirectory)\..\..\native\deskbox-qjs\vendor\quickjs.h" />
    <DeskBoxQjsInput Include="$(MSBuildProjectDirectory)\..\..\native\deskbox-qjs\vendor\quickjs-amalgam.c" />
    <DeskBoxQjsInput Include="$(MSBuildProjectDirectory)\..\..\scripts\build-qjs-native.ps1" />
    <DeskBoxQjsInput Include="$(MSBuildProjectDirectory)\..\..\scripts\native-pe-contract.ps1" />
    <DeskBoxQjsInput Include="$(MSBuildProjectDirectory)\..\..\scripts\rust-arm64-msvc-environment.ps1" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DeskBoxDistribution)' == 'Store'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <BuildProjectReferences>false</BuildProjectReferences>
    <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
    <UapAppxPackageBuildMode Condition="'$(UapAppxPackageBuildMode)' == ''">SideloadOnly</UapAppxPackageBuildMode>
    <AppxPackage Condition="'$(DeskBoxCreateMsixPackage)' == 'true'">true</AppxPackage>
    <GenerateAppxPackageOnBuild Condition="'$(DeskBoxCreateMsixPackage)' == 'true'">true</GenerateAppxPackageOnBuild>
    <AppxBundle Condition="'$(DeskBoxCreateMsixPackage)' == 'true' and '$(AppxBundle)' == ''">Never</AppxBundle>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishAot)' != 'true'">
    <ProjectReference
      Include="..\DeskBox.Updater\DeskBox.Updater.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Animations" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.ColorPicker" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <!-- WinAppSDK 2.7 transitively ships an AI/ML inference stack
         (WindowsAppSDK.ML -> Microsoft.Windows.AI.MachineLearning:
         onnxruntime + DirectML, ~39 MB of native DLLs per architecture)
         that DeskBox never references; exclude it from every package.
         Drop this override if Windows AI features are ever adopted. -->
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.5.96" ExcludeAssets="all" />
    <!-- Same policy for the Windows AI APIs, App Content Search, and Widgets
         provider components of the WinAppSDK 2.7 metapackage (~16 MB of
         native DLLs per architecture in the self-contained payload: Phi
         Silica/imaging/video, semantic index, NPU detection, widget host).
         DeskBox references none of their namespaces; drop the matching
         override if one of these features is ever adopted. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.7.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.7.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.7.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" PrivateAssets="all" />
    <PackageReference Include="WinUIEx" Version="2.9.3" />

    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="1.6.0" />
  </ItemGroup>

  <Target Name="ValidatePlatformArchitectureMatch" BeforeTargets="PrepareForBuild;Publish" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error
      Condition="('$(Platform)' == 'x64' and '$(RuntimeIdentifier)' == 'win-arm64') or ('$(Platform)' == 'ARM64' and '$(RuntimeIdentifier)' == 'win-x64')"
      Text="DeskBox requires matching Platform and RuntimeIdentifier architectures." />
  </Target>

  <ItemGroup>
    <!--
      Microsoft.WinUI.props adds every file below Assets as Content before this
      project is evaluated. Remove the Direct-only support images first, then
      opt them back in only for Direct builds so Store packaging cannot inherit
      them through the SDK wildcard.
    -->
    <Content Remove="Assets\wechat-qrcode.jpg" />
    <Content Remove="Assets\Support\*.png" />
    <Content Remove="Assets\CustomWidgets\capability-registry.json" />
    <EmbeddedResource Include="Assets\CustomWidgets\capability-registry.json" LogicalName="DeskBox.Assets.CustomWidgets.capability-registry.json" />
    <!-- city data ships as external Content (Assets\Cities\cities.json) -->



    <Content Include="Assets\wechat-qrcode.jpg" Condition="'$(DeskBoxDistribution)' != 'Store'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Support\*.png" Condition="'$(DeskBoxDistribution)' != 'Store'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Strings\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Update="Assets\deskbox.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\deskbox.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\deskbox-mark-slab-0.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\deskbox-mark-slab-1.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\deskbox-mark-slab-2.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\OnboardingScene\file-txt.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\OnboardingScene\file-zip.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\OnboardingScene\file-jpg.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\deskbox-tray-light.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\deskbox-tray-dark.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\deskbox-tray-light.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\deskbox-tray-dark.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\SettingsNavIcons\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\WeatherIcons\**\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\WeatherIcons\LICENSE-meteocons.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\WeatherIcons\LICENSE-fluent-emoji.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\WidgetTitleIcons\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\Cities\cities.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="Assets\CustomWidgets\Templates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\.mimosa\**" />
    <Page Remove="**\.mimosa\**" />
    <Content Remove="**\.mimosa\**" />
    <None Remove="**\.mimosa\**" />
    <PRIResource Remove="**\.mimosa\**" />
  </ItemGroup>

  <!-- PRI resources (.resw) in Resources/ subdirectories are auto-included by the .NET SDK -->
  <!-- They provide AppDisplayName and AppDescription for the MSIX manifest's ms-resource: references -->

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <Target Name="CopyDeskBoxUpdater" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and '$(DeskBoxDistribution)' != 'Store' and '$(PublishAot)' != 'true'">
    <MSBuild
      Projects="..\DeskBox.Updater\DeskBox.Updater.csproj"
      Targets="GetTargetPath"
      Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="_DeskBoxUpdaterTargetPath" />
    </MSBuild>
    <ItemGroup>
      <DeskBoxUpdaterOutput Include="%(_DeskBoxUpdaterTargetPath.RootDir)%(_DeskBoxUpdaterTargetPath.Directory)DeskBox.Updater.*" Condition="'@(_DeskBoxUpdaterTargetPath)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(DeskBoxUpdaterOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true">
      <Output TaskParameter="DestinationFiles" ItemName="FileWrites" />
    </Copy>
  </Target>

  <Target Name="PublishDeskBoxUpdater" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true' and '$(DeskBoxDistribution)' != 'Store'">
    <MSBuild
      Projects="..\DeskBox.Updater\DeskBox.Updater.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier);DeskBoxAotAudit=$(DeskBoxAotAudit);DeskBoxAotSmokeHarness=$(DeskBoxAotSmokeHarness);PublishAot=$(PublishAot);IlcUseEnvironmentalTools=$(IlcUseEnvironmentalTools);SelfContained=$(SelfContained);PublishSingleFile=false;PublishDir=$(PublishDir)" />
  </Target>

  <Target
    Name="BuildDeskBoxRustNative"
    BeforeTargets="CoreCompile"
    Condition="'$(DesignTimeBuild)' != 'true' and '$(DeskBoxRustNative)' == 'true'"
    Inputs="$(MSBuildAllProjects);@(DeskBoxRustNativeInput)"
    Outputs="$(DeskBoxRustNativeDll);$(DeskBoxRustNativePdb)">
    <Error
      Condition="'$(DeskBoxRustCrtLinkage)' != 'Dynamic' and '$(DeskBoxRustCrtLinkage)' != 'Static'"
      Text="DeskBox Rust CRT linkage must be Dynamic or Static." />
    <Error
      Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64' and '$(RuntimeIdentifier)' != 'win-arm64'"
      Text="DeskBox Rust native stage 7A supports RuntimeIdentifier=win-x64 or win-arm64." />
    <Error
      Condition="'$(Platform)' != '' and '$(Platform)' != 'AnyCPU' and '$(Platform)' != 'x64' and '$(Platform)' != 'ARM64'"
      Text="DeskBox Rust native stage 7A supports Platform=x64, ARM64, or canonical AnyCPU without a conflicting RID." />
    <Error
      Condition="('$(Platform)' == 'x64' and '$(RuntimeIdentifier)' == 'win-arm64') or ('$(Platform)' == 'ARM64' and '$(RuntimeIdentifier)' == 'win-x64')"
      Text="DeskBox Rust native stage 7A requires matching Platform and RuntimeIdentifier architectures." />
    <Error
      Condition="'$(DeskBoxRustNativePlatform)' == ''"
        Text="DeskBox Rust native stage 7A could not resolve an x64 or ARM64 target." />
    <Exec
      Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build-rust-native.ps1&quot; -Platform $(DeskBoxRustNativePlatform) -Configuration $(Configuration) -CrtLinkage $(DeskBoxRustCrtLinkage) -OutputDirectory &quot;$(DeskBoxRustNativeIntermediateDir)&quot; -CargoTargetDirectory &quot;$(DeskBoxRustNativeCargoTargetDir)&quot;" />
  </Target>

  <Target
    Name="CopyDeskBoxRustNativeToOutput"
    AfterTargets="Build"
    DependsOnTargets="BuildDeskBoxRustNative"
    Condition="'$(DesignTimeBuild)' != 'true' and '$(DeskBoxRustNative)' == 'true'">
    <Copy
      SourceFiles="$(DeskBoxRustNativeDll);$(DeskBoxRustNativePdb)"
      DestinationFolder="$(TargetDir)"
      SkipUnchangedFiles="true">
      <Output TaskParameter="DestinationFiles" ItemName="FileWrites" />
    </Copy>
  </Target>

  <Target
    Name="CopyDeskBoxRustNativeToPublish"
    AfterTargets="Publish"
    DependsOnTargets="BuildDeskBoxRustNative"
    Condition="'$(DesignTimeBuild)' != 'true' and '$(DeskBoxRustNative)' == 'true'">
    <Copy
      SourceFiles="$(DeskBoxRustNativeDll);$(DeskBoxRustNativePdb)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
  </Target>

  <!--
    Windows App SDK's Native AOT MSIX targets package the Publish output rather
    than blindly copying the build directory. The Rust module is generated by a
    custom target, so register it (and its symbol file) explicitly with the
    package payload before _ComputeAppxPackagePayload snapshots the inputs.

    The .NET Native AOT executable does not consume deps.json or
    runtimeconfig.json. Those files can still flow from the ordinary build
    output, so remove them from the Store AOT payload instead of shipping
    misleading managed-runtime metadata.
  -->
  <Target
    Name="PrepareDeskBoxStoreRustNativePayload"
    BeforeTargets="_ComputeAppxPackagePayload"
    DependsOnTargets="BuildDeskBoxRustNative"
    Condition="'$(DesignTimeBuild)' != 'true' and '$(DeskBoxDistribution)' == 'Store' and '$(DeskBoxRustNative)' == 'true'">
    <ItemGroup>
      <AppxPackagePayload Include="$(DeskBoxRustNativeDll)">
        <TargetPath>deskbox_native.dll</TargetPath>
      </AppxPackagePayload>
      <AppxPackagePayload Include="$(DeskBoxRustNativePdb)" Condition="Exists('$(DeskBoxRustNativePdb)') and ('$(UapAppxPackageBuildMode)' == 'StoreUpload' or '$(AppxSymbolPackageEnabled)' == 'true')">
        <TargetPath>deskbox_native.pdb</TargetPath>
      </AppxPackagePayload>
    </ItemGroup>
  </Target>

  <Target
    Name="PrepareDeskBoxStoreNativeAotPayload"
    BeforeTargets="_ComputeAppxPackagePayload"
    Condition="'$(DesignTimeBuild)' != 'true' and '$(DeskBoxDistribution)' == 'Store' and '$(PublishAot)' == 'true'">
    <ItemGroup>
      <PackagingOutputs
        Remove="@(PackagingOutputs)"
        Condition="'%(PackagingOutputs.TargetPath)' == 'DeskBox.deps.json' or '%(PackagingOutputs.TargetPath)' == 'DeskBox.runtimeconfig.json'" />
    </ItemGroup>
  </Target>

  <Target
    Name="BuildDeskBoxThumbnailProxy"
    BeforeTargets="CoreCompile"
    Condition="'$(DesignTimeBuild)' != 'true' and '$(DeskBoxShellThumbnailProxy)' == 'true'"
    Inputs="$(MSBuildAllProjects);@(DeskBoxThumbnailProxyInput)"
    Outputs="$(DeskBoxThumbnailProxyExe);$(DeskBoxThumbnailProxyPdb)">
    <Error
      Condition="'$(DeskBoxThumbnailProxyPlatform)' == ''"
      Text="DeskBox thumbnail proxy could not resolve an x64 or ARM64 target." />
    <Exec
      Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build-rust-thumbnail-proxy.ps1&quot; -Platform $(DeskBoxThumbnailProxyPlatform) -Configuration $(Configuration) -CrtLinkage $(DeskBoxRustCrtLinkage) -OutputDirectory &quot;$(DeskBoxThumbnailProxyIntermediateDir)&quot; -CargoTargetDirectory &quot;$(DeskBoxThumbnailProxyCargoTargetDir)&quot;" />
  </Target>

  <Target
    Name="CopyDeskBoxThumbnailProxyToOutput"
    AfterTargets="Build"
    DependsOnTargets="BuildDeskBoxThumbnailProxy"
    Condition="'$(DesignTimeBuild)' != 'true' and '$(DeskBoxShellThumbnailProxy)' == 'true'">
    <Copy
      SourceFiles="$(DeskBoxThumbnailProxyExe)"
      DestinationFolder="$(TargetDir)"
      SkipUnchangedFiles="true">
      <Output TaskParameter="DestinationFiles" ItemName="FileWrites" />
    </Copy>
    <Copy
      SourceFiles="$(DeskBoxThumbnailProxyPdb)"
      DestinationFolder="$(TargetDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(DeskBoxThumbnailProxyPdb)')">
      <Output TaskParameter="DestinationFiles" ItemName="FileWrites" />
    </Copy>
  </Target>

  <Target
    Name="CopyDeskBoxThumbnailProxyToPublish"
    AfterTargets="Publish"
    DependsOnTargets="BuildDeskBoxThumbnailProxy"
    Condition="'$(DesignTimeBuild)' != 'true' and '$(DeskBoxShellThumbnailProxy)' == 'true'">
    <Copy
      SourceFiles="$(DeskBoxThumbnailProxyExe)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="$(DeskBoxThumbnailProxyPdb)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(DeskBoxThumbnailProxyPdb)')" />
  </Target>

  <Target
    Name="PrepareDeskBoxStoreThumbnailProxyPayload"
    BeforeTargets="_ComputeAppxPackagePayload"
    DependsOnTargets="BuildDeskBoxThumbnailProxy"
    Condition="'$(DesignTimeBuild)' != 'true' and '$(DeskBoxDistribution)' == 'Store' and '$(DeskBoxShellThumbnailProxy)' == 'true'">
    <ItemGroup>
      <AppxPackagePayload Include="$(DeskBoxThumbnailProxyExe)">
        <TargetPath>DeskBox.ThumbnailProxy.exe</TargetPath>
      </AppxPackagePayload>
      <AppxPackagePayload Include="$(DeskBoxThumbnailProxyPdb)" Condition="Exists('$(DeskBoxThumbnailProxyPdb)') and ('$(UapAppxPackageBuildMode)' == 'StoreUpload' or '$(AppxSymbolPackageEnabled)' == 'true')">
        <TargetPath>DeskBox.ThumbnailProxy.pdb</TargetPath>
      </AppxPackagePayload>
    </ItemGroup>
  </Target>

  <Target
    Name="BuildDeskBoxQjsNative"
    BeforeTargets="CoreCompile"
    Condition="'$(DesignTimeBuild)' != 'true' and '$(DeskBoxQjsNative)' == 'true'"
    Inputs="$(MSBuildAllProjects);@(DeskBoxQjsInput)"
    Outputs="$(DeskBoxQjsDll);$(DeskBoxQjsPdb)">
    <Error
      Condition="'$(DeskBoxQjsPlatform)' == ''"
      Text="DeskBox QuickJS sandbox module could not resolve an x64 or ARM64 target." />
    <Exec
      Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build-qjs-native.ps1&quot; -Platform $(DeskBoxQjsPlatform) -Configuration $(Configuration) -CrtLinkage $(DeskBoxRustCrtLinkage) -OutputDirectory &quot;$(DeskBoxQjsIntermediateDir)&quot; -IntermediateDirectory &quot;$(DeskBoxQjsObjDir)&quot;" />
  </Target>

  <Target
    Name="CopyDeskBoxQjsNativeToOutput"
    AfterTargets="Build"
    DependsOnTargets="BuildDeskBoxQjsNative"
    Condition="'$(DesignTimeBuild)' != 'true' and '$(DeskBoxQjsNative)' == 'true'">
    <Copy
      SourceFiles="$(DeskBoxQjsDll)"
      DestinationFolder="$(TargetDir)"
      SkipUnchangedFiles="true">
      <Output TaskParameter="DestinationFiles" ItemName="FileWrites" />
    </Copy>
    <Copy
      SourceFiles="$(DeskBoxQjsPdb)"
      DestinationFolder="$(TargetDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(DeskBoxQjsPdb)')">
      <Output TaskParameter="DestinationFiles" ItemName="FileWrites" />
    </Copy>
  </Target>

  <Target
    Name="CopyDeskBoxQjsNativeToPublish"
    AfterTargets="Publish"
    DependsOnTargets="BuildDeskBoxQjsNative"
    Condition="'$(DesignTimeBuild)' != 'true' and '$(DeskBoxQjsNative)' == 'true'">
    <Copy
      SourceFiles="$(DeskBoxQjsDll)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="$(DeskBoxQjsPdb)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(DeskBoxQjsPdb)')" />
  </Target>

  <Target
    Name="PrepareDeskBoxStoreQjsPayload"
    BeforeTargets="_ComputeAppxPackagePayload"
    DependsOnTargets="BuildDeskBoxQjsNative"
    Condition="'$(DesignTimeBuild)' != 'true' and '$(DeskBoxDistribution)' == 'Store' and '$(DeskBoxQjsNative)' == 'true'">
    <ItemGroup>
      <AppxPackagePayload Include="$(DeskBoxQjsDll)">
        <TargetPath>deskbox_qjs.dll</TargetPath>
      </AppxPackagePayload>
      <AppxPackagePayload Include="$(DeskBoxQjsPdb)" Condition="Exists('$(DeskBoxQjsPdb)') and ('$(UapAppxPackageBuildMode)' == 'StoreUpload' or '$(AppxSymbolPackageEnabled)' == 'true')">
        <TargetPath>deskbox_qjs.pdb</TargetPath>
      </AppxPackagePayload>
    </ItemGroup>
  </Target>

</Project>
