<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>DeskBox.Updater</RootNamespace>
    <AssemblyName>DeskBox.Updater</AssemblyName>
    <Version>1.6.0</Version>
    <AssemblyVersion>1.6.0.0</AssemblyVersion>
    <FileVersion>1.6.0.0</FileVersion>
    <InformationalVersion>1.6.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationManifest>..\DeskBox\app.manifest</ApplicationManifest>
    <IsAotCompatible>true</IsAotCompatible>
    <DeskBoxAotAudit Condition="'$(DeskBoxAotAudit)' == ''">false</DeskBoxAotAudit>
    <!-- Switches the shared ShellUnelevatedLaunch source into this
         assembly's own namespace; see that file's header. -->
    <DefineConstants>$(DefineConstants);DESKBOX_UPDATER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DeskBoxAotAudit)' == 'true'">
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- Shared source with the app project: the shell-integrity restart
       primitive must stay byte-identical on both sides. The file is
       self-contained (BCL + P/Invoke only) because the updater build
       compiles none of the app's other sources. -->
  <ItemGroup>
    <Compile Include="..\DeskBox\Platform\ShellUnelevatedLaunch.cs" Link="Platform\ShellUnelevatedLaunch.cs" />
  </ItemGroup>

</Project>
