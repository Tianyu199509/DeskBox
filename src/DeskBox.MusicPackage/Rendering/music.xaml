<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <!-- Hallmark · pre-emit critique: P5 H4 E5 S5 R5 V4 -->
    <!-- Hallmark · component: music transport controls · genre: modern-minimal · theme: Windows native
         states: default · hover · focus · active · disabled · playback state · contrast: pass -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="WidgetLayerFillSecondaryBrush" Color="#10808080" />
        <SolidColorBrush x:Key="WidgetLayerStrokeBrush" Color="#30808080" />
        <CornerRadius x:Key="WidgetCornerRadiusLarge">10</CornerRadius>
        <Style x:Key="MusicIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="IconButtonRoot"
                            Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.083" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Target="IconButtonHoverSurface.Opacity" Value="0" />
                                            <Setter Target="IconButtonPressedSurface.Opacity" Value="0" />
                                            <Setter Target="IconButtonContentPresenter.Opacity" Value="0.92" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="IconButtonHoverSurface.Opacity" Value="1" />
                                            <Setter Target="IconButtonPressedSurface.Opacity" Value="0" />
                                            <Setter Target="IconButtonContentPresenter.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="IconButtonHoverSurface.Opacity" Value="0" />
                                            <Setter Target="IconButtonPressedSurface.Opacity" Value="1" />
                                            <Setter Target="IconButtonContentPresenter.Opacity" Value="0.78" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="IconButtonHoverSurface.Opacity" Value="0" />
                                            <Setter Target="IconButtonPressedSurface.Opacity" Value="0" />
                                            <Setter Target="IconButtonContentPresenter.Opacity" Value="0.34" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="IconButtonHoverSurface"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="IconButtonPressedSurface"
                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <ContentPresenter
                                x:Name="IconButtonContentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MusicSecondaryFontIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="MusicSourceButtonStyle" TargetType="Button" BasedOn="{StaticResource MusicIconButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="MusicPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource SystemControlHighlightAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="PrimaryButtonRoot"
                            Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.083" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Target="PrimarySurface.Opacity" Value="1" />
                                            <Setter Target="PrimaryHoverOverlay.Opacity" Value="0" />
                                            <Setter Target="PrimaryPressedOverlay.Opacity" Value="0" />
                                            <Setter Target="PrimaryContentPresenter.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="PrimarySurface.Opacity" Value="1" />
                                            <Setter Target="PrimaryHoverOverlay.Opacity" Value="0.10" />
                                            <Setter Target="PrimaryPressedOverlay.Opacity" Value="0" />
                                            <Setter Target="PrimaryContentPresenter.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="PrimarySurface.Opacity" Value="0.96" />
                                            <Setter Target="PrimaryHoverOverlay.Opacity" Value="0" />
                                            <Setter Target="PrimaryPressedOverlay.Opacity" Value="0.16" />
                                            <Setter Target="PrimaryContentPresenter.Opacity" Value="0.86" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="PrimarySurface.Opacity" Value="0.42" />
                                            <Setter Target="PrimaryHoverOverlay.Opacity" Value="0" />
                                            <Setter Target="PrimaryPressedOverlay.Opacity" Value="0" />
                                            <Setter Target="PrimaryContentPresenter.Opacity" Value="0.40" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="PrimarySurface"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False" />
                            <Border
                                x:Name="PrimaryHoverOverlay"
                                Background="#FFFFFFFF"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="PrimaryPressedOverlay"
                                Background="#66000000"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <ContentPresenter
                                x:Name="PrimaryContentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="RootGrid"
        Padding="0"
        Background="Transparent">
        <Border
            x:Name="ArtworkBackdrop"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            CornerRadius="{Binding ArtworkBackdropCornerRadius}"
            IsHitTestVisible="False"
            Visibility="{Binding ArtworkBackdropVisibility}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="{Binding ArtworkBackdropStartColor}" />
                    <GradientStop Offset="0.48" Color="{Binding ArtworkBackdropMidColor}" />
                    <GradientStop Offset="1" Color="{Binding ArtworkBackdropEndColor}" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid
            x:Name="MinimalLayout"
            Visibility="Collapsed">
            <Border
                x:Name="MinimalArtworkSurface"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{ThemeResource WidgetLayerFillSecondaryBrush}">
                <Grid>
                    <Rectangle
                        x:Name="MinimalArtworkImage"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="{Binding ThumbnailVisibility}">
                        <Rectangle.Fill>
                            <ImageBrush
                                AlignmentX="Center"
                                AlignmentY="Center"
                                ImageSource="{Binding ThumbnailImage}"
                                Stretch="UniformToFill" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <Grid Visibility="{Binding ThumbnailPlaceholderVisibility}">
                        <Rectangle Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                        <FontIcon
                            FontSize="44"
                            Glyph="&#xEC4F;"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Grid>
            </Border>

            <Border
                x:Name="MinimalControlPanel"
                Margin="6"
                MinHeight="40"
                Padding="6,5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Background="{ThemeResource SystemControlAcrylicElementBrush}"
                BorderBrush="{ThemeResource WidgetLayerStrokeBrush}"
                BorderThickness="1"
                CornerRadius="5">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="0">
                        <Button
                            x:Name="MinimalPlayPauseButton"
                            Width="28"
                            Height="28"
                            MinWidth="28"
                            MinHeight="28"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            IsEnabled="{Binding CanPlayPause}"
                            Style="{StaticResource MusicIconButtonStyle}"
                            ToolTipService.ToolTip="{Binding PlayPauseTooltip}">
                            <Grid Width="26" Height="26">
                                <Viewbox Width="26" Height="26" IsHitTestVisible="False" Visibility="{Binding PlayIconVisibility}"><Canvas
            Width="26"
            Height="26">
            <Path
                Data="M20 14.5L9 20.75C7.5 21.625 6.25 20.875 6.25 19.25L6.25 6.75C6.25 5.125 7.5 4.375 9 5.25L20 11.5C21.5 12.375 21.5 13.625 20 14.5Z"
                Fill="{Binding Foreground, ElementName=MinimalPlayPauseButton}" />
        </Canvas></Viewbox>
                                <Viewbox Width="26" Height="26" IsHitTestVisible="False" Visibility="{Binding PauseIconVisibility}"><Canvas
            Width="26"
            Height="26">
            <Rectangle
                Canvas.Left="6"
                Canvas.Top="6"
                Width="5"
                Height="14"
                Fill="{Binding Foreground, ElementName=MinimalPlayPauseButton}"
                RadiusX="1"
                RadiusY="1" />
            <Rectangle
                Canvas.Left="15"
                Canvas.Top="6"
                Width="5"
                Height="14"
                Fill="{Binding Foreground, ElementName=MinimalPlayPauseButton}"
                RadiusX="1"
                RadiusY="1" />
        </Canvas></Viewbox>
                            </Grid>
                        </Button>
                        <Button
                            x:Name="MinimalNextButton"
                            Width="28"
                            Height="28"
                            MinWidth="28"
                            MinHeight="28"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            IsEnabled="{Binding CanGoNext}"
                            Style="{StaticResource MusicIconButtonStyle}"
                            ToolTipService.ToolTip="{Binding NextTooltip}">
                            <Viewbox Width="26" Height="26" IsHitTestVisible="False" Visibility="Visible"><Canvas
            Width="26"
            Height="26">
            <Rectangle
                Canvas.Left="18"
                Canvas.Top="6"
                Width="2"
                Height="14"
                Fill="{Binding Foreground, ElementName=MinimalNextButton}"
                RadiusX="0.75"
                RadiusY="0.75" />
            <Path
                Data="M16.25 14.5L8.125 19.25C6.625 20.125 5.5 19.375 5.5 17.75L5.5 8.25C5.5 6.625 6.625 5.875 8.125 6.75L16.25 11.5C17.5 12.25 17.5 13.75 16.25 14.5Z"
                Fill="{Binding Foreground, ElementName=MinimalNextButton}" />
        </Canvas></Viewbox>
                        </Button>
                    </StackPanel>
                    <Grid
                        x:Name="MinimalTitleMarqueeHost"
                        Grid.Column="1"
                        MinWidth="0"
                        ToolTipService.ToolTip="{Binding Title}">
                        <Grid.Clip>
                            <RectangleGeometry x:Name="MinimalTitleMarqueeClip" />
                        </Grid.Clip>
                        <TextBlock
                            x:Name="MinimalTitleStaticText"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            FontSize="{Binding MinimalTitleTextSize}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            MaxLines="1"
                            MinWidth="0"
                            Text="{Binding Title}"
                            TextAlignment="Left"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <Canvas
                            x:Name="MinimalTitleMarqueeCanvas"
                            Height="{Binding ActualHeight, ElementName=MinimalTitleStaticText}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="MinimalTitleTextPrimary"
                                FontSize="{Binding MinimalTitleTextSize}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                MaxLines="1"
                                Text="{Binding Title}"
                                TextTrimming="Clip"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                x:Name="MinimalTitleTextClone"
                                FontSize="{Binding MinimalTitleTextSize}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                MaxLines="1"
                                Text="{Binding Title}"
                                TextTrimming="Clip"
                                TextWrapping="NoWrap" />
                        </Canvas>
                        <Canvas
                            Width="0"
                            Height="0"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <TextBlock
                                x:Name="MinimalTitleMeasureText"
                                FontSize="{Binding MinimalTitleTextSize}"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                Text="{Binding Title}"
                                TextTrimming="Clip"
                                TextWrapping="NoWrap" />
                        </Canvas>
                    </Grid>
                    <Button
                        x:Name="MinimalSourceButton"
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        MinWidth="28"
                        MinHeight="28"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Style="{StaticResource MusicSourceButtonStyle}">
                        <Grid Width="16" Height="16" IsHitTestVisible="False"><Viewbox Stretch="Uniform">
        <Canvas Width="20" Height="20">
            <Path
                Data="M4.34239 4.34305C4.63527 4.05028 5.11007 4.05024 5.40294 4.34305C5.69579 4.63591 5.69572 5.11069 5.40294 5.4036C2.86456 7.94197 2.86464 12.0576 5.40294 14.596C5.69577 14.8888 5.69566 15.3636 5.40294 15.6565C5.11004 15.9494 4.63528 15.9494 4.34239 15.6565C1.2183 12.5323 1.21823 7.46721 4.34239 4.34305ZM14.5953 4.34305C14.8882 4.05024 15.363 4.05028 15.6559 4.34305C18.78 7.46721 18.78 12.5323 15.6559 15.6565C15.363 15.9494 14.8882 15.9494 14.5953 15.6565C14.3026 15.3636 14.3025 14.8888 14.5953 14.596C17.1336 12.0576 17.1337 7.94197 14.5953 5.4036C14.3025 5.11069 14.3025 4.63591 14.5953 4.34305ZM6.46348 6.46414C6.75639 6.1716 7.23124 6.17141 7.52403 6.46414C7.81681 6.75693 7.81659 7.23177 7.52403 7.52469C6.1572 8.89153 6.1572 11.1081 7.52403 12.4749C7.81675 12.7677 7.81672 13.2426 7.52403 13.5354C7.23118 13.8283 6.75639 13.8282 6.46348 13.5354C4.51086 11.5828 4.51086 8.41676 6.46348 6.46414ZM12.4732 6.46414C12.766 6.17139 13.2409 6.17163 13.5338 6.46414C15.4864 8.41676 15.4864 11.5828 13.5338 13.5354C13.2409 13.8282 12.7661 13.8283 12.4732 13.5354C12.1806 13.2426 12.1806 12.7677 12.4732 12.4749C13.8401 11.1081 13.8401 8.89153 12.4732 7.52469C12.1807 7.23177 12.1805 6.75691 12.4732 6.46414ZM9.99962 8.75028C10.69 8.75028 11.2496 9.30992 11.2496 10.0003C11.2495 10.6905 10.6899 11.2503 9.99962 11.2503C9.30952 11.2501 8.74976 10.6904 8.74962 10.0003C8.74962 9.31004 9.30943 8.75048 9.99962 8.75028Z"
                Fill="{ThemeResource TextFillColorPrimaryBrush}" />
        </Canvas>
    </Viewbox></Grid>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="ContentGrid"
            Padding="12,12,12,11"
            ColumnSpacing="12"
            RowSpacing="8"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="AlbumColumn" Width="82" />
                <ColumnDefinition Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopRow" Height="82" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                x:Name="AlbumArtShadow"
                Grid.Row="0"
                Grid.Column="0"
                Width="82"
                Height="82"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="#66000000"
                CornerRadius="{StaticResource WidgetCornerRadiusLarge}"
                Opacity="0.12"
                Translation="0,2,0"
                Visibility="{Binding ThumbnailVisibility}" />

            <Border
                x:Name="AlbumArtSurface"
                Grid.Row="0"
                Grid.Column="0"
                Width="82"
                Height="82"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{ThemeResource WidgetLayerFillSecondaryBrush}"
                BorderBrush="{ThemeResource WidgetLayerStrokeBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource WidgetCornerRadiusLarge}">
                <Grid>
                    <Image
                        x:Name="AlbumArtworkImage"
                        Source="{Binding ThumbnailImage}"
                        Stretch="UniformToFill"
                        Visibility="{Binding ThumbnailVisibility}" />
                    <Border
                        IsHitTestVisible="False"
                        Opacity="0.34"
                        Visibility="{Binding ThumbnailVisibility}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#66FFFFFF" />
                                <GradientStop Offset="0.42" Color="#12FFFFFF" />
                                <GradientStop Offset="1" Color="#33000000" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border
                        Margin="1"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        CornerRadius="11"
                        IsHitTestVisible="False"
                        Visibility="{Binding ThumbnailVisibility}"
                        x:Name="AlbumArtInnerBorder" />
                    <Grid Visibility="{Binding ThumbnailPlaceholderVisibility}">
                        <Border
                            x:Name="AlbumArtPlaceholderBackground"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                        <FontIcon
                            FontSize="30"
                            Glyph="&#xEC4F;"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Grid>
            </Border>

            <Grid
                x:Name="TrackInfoGrid"
                Grid.Row="0"
                Grid.Column="1"
                MinWidth="0"
                RowSpacing="4"
                VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="TitleMarqueeHost"
                    Grid.Row="0"
                    MinWidth="0">
                    <Grid.Clip>
                        <RectangleGeometry x:Name="TitleMarqueeClip" />
                    </Grid.Clip>
                    <TextBlock
                        x:Name="TitleStaticText"
                        FontSize="{Binding TitleTextSize}"
                        FontWeight="SemiBold"
                        MaxLines="1"
                        MinWidth="0"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <Canvas
                        x:Name="TitleMarqueeCanvas"
                        Height="{Binding ActualHeight, ElementName=TitleStaticText}"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="TitleTextPrimary"
                            FontSize="{Binding TitleTextSize}"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{Binding Title}"
                            TextTrimming="Clip"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            x:Name="TitleTextClone"
                            FontSize="{Binding TitleTextSize}"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{Binding Title}"
                            TextTrimming="Clip"
                            TextWrapping="NoWrap" />
                    </Canvas>
                    <Canvas
                        Width="0"
                        Height="0"
                        IsHitTestVisible="False"
                        Opacity="0">
                        <TextBlock
                            x:Name="TitleMeasureText"
                            FontSize="{Binding TitleTextSize}"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{Binding Title}"
                            TextTrimming="Clip"
                            TextWrapping="NoWrap" />
                    </Canvas>
                </Grid>

                <Grid
                    Grid.Row="1"
                    MinWidth="0"
                    ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="{Binding SecondaryTextSize}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        MinWidth="0"
                        Text="{Binding Artist}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="SourceButton"
                        Grid.Column="1"
                        Style="{StaticResource MusicSourceButtonStyle}">
                        <Grid Width="16" Height="16" IsHitTestVisible="False"><Viewbox Stretch="Uniform">
        <Canvas Width="20" Height="20">
            <Path
