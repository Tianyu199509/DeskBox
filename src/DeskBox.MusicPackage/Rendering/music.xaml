                RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="RecordHorizontalVinylRotateTransform" Angle="0" />
                </Grid.RenderTransform>
                <Viewbox>
                    <Grid Width="160" Height="160">
                        <Ellipse Fill="#40000000" Opacity="0.32" Margin="-1,5,-1,-1" />
                        <Ellipse Fill="#080808" />
                        <Ellipse Stroke="#1A1A1A" StrokeThickness="0.7" Margin="3" />
                        <Ellipse Stroke="#222222" StrokeThickness="0.6" Margin="6" />
                        <Ellipse Stroke="#1B1B1B" StrokeThickness="0.5" Margin="9" />
                        <Ellipse Stroke="#262626" StrokeThickness="0.5" Margin="13" />
                        <Ellipse Stroke="#1D1D1D" StrokeThickness="0.45" Margin="17" />
                        <Ellipse Stroke="#242424" StrokeThickness="0.4" Margin="21" />
                        <Ellipse Stroke="#1A1A1A" StrokeThickness="0.4" Margin="25" />
                        <Ellipse Stroke="#222222" StrokeThickness="0.35" Margin="30" />
                        <Ellipse Stroke="#1B1B1B" StrokeThickness="0.35" Margin="35" />
                        <Ellipse>
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.30,0.24" Center="0.5,0.5" RadiusX="0.55" RadiusY="0.55">
                                    <GradientStop Offset="0" Color="#70FFFFFF" />
                                    <GradientStop Offset="0.35" Color="#10FFFFFF" />
                                    <GradientStop Offset="1" Color="#00000000" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Stroke="#000000" StrokeThickness="1" Margin="31" />
                        <Ellipse x:Name="RecordHorizontalVinylLabel" Margin="32">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding ThumbnailImage}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#50000000" StrokeThickness="0.8">
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.32,0.28" Center="0.5,0.5" RadiusX="0.62" RadiusY="0.62">
                                    <GradientStop Offset="0" Color="#FFF3F3F6" />
                                    <GradientStop Offset="0.7" Color="#FFB6B6BE" />
                                    <GradientStop Offset="1" Color="#FF7E7E86" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="3" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#CC1A1A1E" />
                    </Grid>
                </Viewbox>
            </Grid>

            <!-- Info (right) -->
            <Grid Grid.Column="1" RowSpacing="6" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Spacing="1">
                    <TextBlock
                        x:Name="RecordHorizontalTitleText"
                        MaxLines="1"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis" />
                    <Grid MinWidth="0" ColumnSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="RecordHorizontalArtistText"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            MaxLines="1"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding Artist}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Name="RecordHorizontalSourceButton"
                            Grid.Column="1"
                            Style="{StaticResource MusicSourceButtonStyle}">
                            <Grid Width="16" Height="16" IsHitTestVisible="False"><Viewbox Stretch="Uniform">
        <Canvas Width="20" Height="20">
            <Path
                Data="M4.34239 4.34305C4.63527 4.05028 5.11007 4.05024 5.40294 4.34305C5.69579 4.63591 5.69572 5.11069 5.40294 5.4036C2.86456 7.94197 2.86464 12.0576 5.40294 14.596C5.69577 14.8888 5.69566 15.3636 5.40294 15.6565C5.11004 15.9494 4.63528 15.9494 4.34239 15.6565C1.2183 12.5323 1.21823 7.46721 4.34239 4.34305ZM14.5953 4.34305C14.8882 4.05024 15.363 4.05028 15.6559 4.34305C18.78 7.46721 18.78 12.5323 15.6559 15.6565C15.363 15.9494 14.8882 15.9494 14.5953 15.6565C14.3026 15.3636 14.3025 14.8888 14.5953 14.596C17.1336 12.0576 17.1337 7.94197 14.5953 5.4036C14.3025 5.11069 14.3025 4.63591 14.5953 4.34305ZM6.46348 6.46414C6.75639 6.1716 7.23124 6.17141 7.52403 6.46414C7.81681 6.75693 7.81659 7.23177 7.52403 7.52469C6.1572 8.89153 6.1572 11.1081 7.52403 12.4749C7.81675 12.7677 7.81672 13.2426 7.52403 13.5354C7.23118 13.8283 6.75639 13.8282 6.46348 13.5354C4.51086 11.5828 4.51086 8.41676 6.46348 6.46414ZM12.4732 6.46414C12.766 6.17139 13.2409 6.17163 13.5338 6.46414C15.4864 8.41676 15.4864 11.5828 13.5338 13.5354C13.2409 13.8282 12.7661 13.8283 12.4732 13.5354C12.1806 13.2426 12.1806 12.7677 12.4732 12.4749C13.8401 11.1081 13.8401 8.89153 12.4732 7.52469C12.1807 7.23177 12.1805 6.75691 12.4732 6.46414ZM9.99962 8.75028C10.69 8.75028 11.2496 9.30992 11.2496 10.0003C11.2495 10.6905 10.6899 11.2503 9.99962 11.2503C9.30952 11.2501 8.74976 10.6904 8.74962 10.0003C8.74962 9.31004 9.30943 8.75048 9.99962 8.75028Z"
                Fill="{ThemeResource TextFillColorSecondaryBrush}" />
        </Canvas>
    </Viewbox></Grid>
                        </Button>
                    </Grid>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,2,0,0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{Binding PositionText}" />
                    <Grid
                        x:Name="RecordHorizontalProgressHost"
                        Grid.Column="1"
                        Height="4"
                        MinWidth="60"
                        VerticalAlignment="Center">
                        <Border
                            x:Name="RecordHorizontalProgressTrack"
                            Height="4"
                            Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                            CornerRadius="2"
                            Opacity="0.36" />
                        <Border
                            x:Name="RecordHorizontalProgressFill"
                            Height="4"
                            Width="0"
                            HorizontalAlignment="Left"
                            Background="{Binding MusicAccentBrush}"
                            CornerRadius="2" />
                    </Grid>
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{Binding DurationText}" />
                </Grid>
                <StackPanel
                    x:Name="RecordHorizontalControlsPanel"
                    Grid.Row="2"
                    Margin="0,2,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="RecordHorizontalPlaybackModeButton"
                        IsEnabled="{Binding CanChangePlaybackMode}"
                        Opacity="{Binding PlaybackModeOpacity}"
                        Style="{StaticResource MusicIconButtonStyle}"
                        ToolTipService.ToolTip="{Binding PlaybackModeTooltip}">
                        <FontIcon
                            Glyph="{Binding PlaybackModeGlyph}"
                            Style="{StaticResource MusicSecondaryFontIconStyle}" />
                    </Button>
                    <Button
                        x:Name="RecordHorizontalPreviousButton"
                        IsEnabled="{Binding CanGoPrevious}"
                        Style="{StaticResource MusicIconButtonStyle}"
                        ToolTipService.ToolTip="{Binding PreviousTooltip}">
                        <Viewbox Width="26" Height="26" IsHitTestVisible="False" Visibility="Visible"><Canvas
            Width="26"
            Height="26">
            <Rectangle
                Canvas.Left="6"
                Canvas.Top="6"
                Width="2"
                Height="14"
                Fill="{Binding Foreground, ElementName=RecordHorizontalPreviousButton}"
                RadiusX="0.75"
                RadiusY="0.75" />
            <Path
                Data="M9.5 14.5L17.75 19.25C19.25 20.125 20.25 19.375 20.25 17.75L20.25 8.25C20.25 6.625 19.25 5.875 17.75 6.75L9.5 11.5C8.25 12.25 8.25 13.75 9.5 14.5Z"
                Fill="{Binding Foreground, ElementName=RecordHorizontalPreviousButton}" />
        </Canvas></Viewbox>
                    </Button>
                    <Button
                        x:Name="RecordHorizontalPlayPauseButton"
                        IsEnabled="{Binding CanPlayPause}"
                        Style="{StaticResource MusicIconButtonStyle}"
                        ToolTipService.ToolTip="{Binding PlayPauseTooltip}">
                        <Grid Width="26" Height="26">
                            <Viewbox Width="26" Height="26" IsHitTestVisible="False" Visibility="{Binding PlayIconVisibility}"><Canvas
            Width="26"
            Height="26">
            <Path
                Data="M20 14.5L9 20.75C7.5 21.625 6.25 20.875 6.25 19.25L6.25 6.75C6.25 5.125 7.5 4.375 9 5.25L20 11.5C21.5 12.375 21.5 13.625 20 14.5Z"
                Fill="{Binding Foreground, ElementName=RecordHorizontalPlayPauseButton}" />
        </Canvas></Viewbox>
                            <Viewbox Width="26" Height="26" IsHitTestVisible="False" Visibility="{Binding PauseIconVisibility}"><Canvas
            Width="26"
            Height="26">
            <Rectangle
                Canvas.Left="6"
                Canvas.Top="6"
                Width="5"
                Height="14"
                Fill="{Binding Foreground, ElementName=RecordHorizontalPlayPauseButton}"
                RadiusX="1"
                RadiusY="1" />
            <Rectangle
                Canvas.Left="15"
                Canvas.Top="6"
                Width="5"
                Height="14"
                Fill="{Binding Foreground, ElementName=RecordHorizontalPlayPauseButton}"
                RadiusX="1"
                RadiusY="1" />
        </Canvas></Viewbox>
                        </Grid>
                    </Button>
                    <Button
                        x:Name="RecordHorizontalNextButton"
                        IsEnabled="{Binding CanGoNext}"
                        Style="{StaticResource MusicIconButtonStyle}"
                        ToolTipService.ToolTip="{Binding NextTooltip}">
                        <Viewbox Width="26" Height="26" IsHitTestVisible="False" Visibility="Visible"><Canvas
            Width="26"
            Height="26">
            <Rectangle
                Canvas.Left="18"
                Canvas.Top="6"
                Width="2"
                Height="14"
                Fill="{Binding Foreground, ElementName=RecordHorizontalNextButton}"
                RadiusX="0.75"
                RadiusY="0.75" />
            <Path
                Data="M16.25 14.5L8.125 19.25C6.625 20.125 5.5 19.375 5.5 17.75L5.5 8.25C5.5 6.625 6.625 5.875 8.125 6.75L16.25 11.5C17.5 12.25 17.5 13.75 16.25 14.5Z"
                Fill="{Binding Foreground, ElementName=RecordHorizontalNextButton}" />
        </Canvas></Viewbox>
                    </Button>
                    <Button
                        x:Name="RecordHorizontalVolumeButton"
                        Style="{StaticResource MusicIconButtonStyle}"
                        ToolTipService.ToolTip="{Binding VolumeTooltip}">
                        <FontIcon
                            Glyph="&#xE767;"
                            Style="{StaticResource MusicSecondaryFontIconStyle}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Border
            x:Name="InlineVolumePanel"
            Width="238"
            Height="48"
            Padding="10,8"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{ThemeResource SystemControlAcrylicElementBrush}"
            BorderBrush="{ThemeResource WidgetLayerStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource WidgetCornerRadiusLarge}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{Binding VolumeTextSize}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="{Binding SystemVolumeText}"
                    TextAlignment="Center" />

                <Slider
                    x:Name="InlineSystemVolumeSlider"
                    Grid.Column="1"
                    Height="28"
                    Margin="0,-4,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    IsThumbToolTipEnabled="False"
                    LargeChange="0.1"
                    Maximum="1"
                    Minimum="0"
                    Orientation="Horizontal"
                    SmallChange="0.01"
                    StepFrequency="0.01"
                    Value="{Binding SystemVolume, Mode=TwoWay}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
