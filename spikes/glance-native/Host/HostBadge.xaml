<?xml version="1.0" encoding="utf-8"?>
<!-- Host-owned compiled control used by the package text-XAML resolution probe:
     if <host:HostBadge /> resolves inside runtime-parsed package XAML, the host
     XamlMetaDataProvider chain reaches package XAML for host types. The nested
     toolkit Segmented registers that control type in the same provider. -->
<UserControl
    x:Class="DeskBox.Glance.NativeHost.HostBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Width="10" Height="10" CornerRadius="5" Background="#FF4CC2FF" VerticalAlignment="Center" />
        <TextBlock x:Name="LabelText" FontSize="11" Foreground="White" VerticalAlignment="Center" Text="host" />
        <toolkit:Segmented x:Name="HostSegmented" Visibility="Collapsed">
            <toolkit:SegmentedItem Content="a" />
            <toolkit:SegmentedItem Content="b" />
        </toolkit:Segmented>
    </StackPanel>
</UserControl>
